# ====== Fashion AI — variáveis de ambiente do backend (copie para .env) ======
# Obrigatórias para subir: só o MySQL. Todo o resto tem fallback local.

# Aplicação
PORT=8080
APP_BASE_URL=http://localhost:8080            # URL pública da API (usada nas URLs de mídia local)
FRONTEND_URL=http://localhost:3000            # links dos e-mails (confirmar e-mail, redefinir senha)
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000 # separe por vírgula (ex.: https://sai-tcc-2026.vercel.app)
LOG_LEVEL=INFO

# MySQL — fonte da verdade (Flyway cria/atualiza o schema)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=fashionai
MYSQL_USER=fashionai
MYSQL_PASSWORD=change-me
MYSQL_USE_SSL=false
MYSQL_SSL_MODE=PREFERRED                       # produção: REQUIRED (usuário fai_app só aceita TLS)
MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=false
MYSQL_BACKUP_USER=                             # produção: fai_backup (só leitura, infra/railway/mysql)
MYSQL_BACKUP_PASSWORD=
MYSQL_POOL_SIZE=10

# JWT RS256 — sem as chaves a API gera um par efêmero (só desenvolvimento)
JWT_ISSUER=fashionai
JWT_ACCESS_TTL_MINUTES=15
JWT_PRIVATE_KEY_PEM=                          # conteúdo PEM PKCS#8 (use \n para quebras) — gere com scripts/keys/generate_jwt_keys.sh
JWT_PUBLIC_KEY_PEM=
JWT_REQUIRE_KEYS=false                         # produção: true (não sobe sem as chaves)

# Criptografia de campos sensíveis (AES-GCM) — 32 bytes em base64
DATA_ENCRYPTION_KEY=base64-32-byte-key-placeholder

# Mídia: local (padrão) ou s3 (S3/MinIO/R2)
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./data/media
STORAGE_PUBLIC_BASE_URL=                      # CDN/bucket público quando STORAGE_TYPE=s3
S3_ENDPOINT=                                  # vazio = AWS; http://localhost:9000 para MinIO
S3_REGION=us-east-1
S3_BUCKET=fashionai-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PATH_STYLE=                                 # vazio = automático (path-style com endpoint); Railway Buckets: false
S3_SERVE_THROUGH_API=false                     # true para bucket privado (Railway Buckets): a API serve /media/**

# Serviços opcionais (false = adaptadores em memória / MySQL)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=                                # produção: fashionai (ACL, infra/railway/redis); vazio = default
REDIS_PASSWORD=
REDIS_SSL=false                                # true para Upstash, Redis Cloud e a maioria dos gerenciados
REDIS_TIMEOUT_MS=3000
CASSANDRA_ENABLED=false                       # ligue também o perfil: SPRING_PROFILES_ACTIVE=cassandra
CASSANDRA_CONTACT_POINTS=localhost
CASSANDRA_PORT=9042
CASSANDRA_LOCAL_DATACENTER=datacenter1
CASSANDRA_KEYSPACE=fashionai_feed
CASSANDRA_CREATE_KEYSPACE=false                # true para Cassandra próprio (Railway/Docker): a API cria o keyspace
CASSANDRA_REPLICATION_FACTOR=1
CASSANDRA_USERNAME=                            # Astra DB: token
CASSANDRA_PASSWORD=                            # Astra DB: AstraCS:... (Application Token)
CASSANDRA_SECURE_BUNDLE_PATH=                  # Astra DB: caminho do secure-connect-*.zip
CASSANDRA_SECURE_BUNDLE_BASE64=                # ou o zip em base64 (base64 -w0 secure-connect-*.zip)
CASSANDRA_SSL=false                            # produção: true (TLS cliente→nó, infra/railway/cassandra)
CASSANDRA_CA_CERT_PEM=                         # certificado da CA impresso no log do Cassandra (público)
CASSANDRA_SSL_HOSTNAME_VALIDATION=false
CASSANDRA_RESOLVE_CONTACT_POINTS=false         # false: resolve o nome a cada reconexão (IP muda a cada deploy)
OPENSEARCH_ENABLED=false
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_CA_CERT_PEM=                        # produção: CA do log do OpenSearch; URL https://opensearch.railway.internal:9200
OPENSEARCH_TLS_VERIFY_HOSTNAME=true
OPENSEARCH_TLS_INSECURE=false                  # nunca true fora da rede privada

# E-mail transacional: log (imprime no console) ou resend
EMAIL_PROVIDER=log
RESEND_API_KEY=
RESEND_FROM_EMAIL=nao-responda@fashionai.app

# Clima (Open-Meteo, gratuito, sem chave)
WEATHER_ENABLED=true

# IA — chaves só no backend (RF24). Sem chave, cada capacidade usa o motor local.
AI_REMOTE_ENABLED=true
AI_DAILY_BUDGET_USD=5.00                       # teto global de gasto com IA por dia (UTC); 0 = sem teto
AI_USER_DAILY_BUDGET_USD=0.50                  # teto por pessoa por dia
GOOGLE_VISION_API_KEY=                         # moderação de upload (SafeSearch); vai no cabeçalho, nunca na URL
UPLOAD_MODERATION_ENABLED=true
IMAGE_MAX_PIXELS=40000000                      # teto contra bomba de descompressão
IMAGE_MAX_SIDE=12000
AI_REQUEST_TIMEOUT_SECONDS=30
ANTHROPIC_API_KEY=                            # Claude (composição, DNA, Copilot, visão)
GOOGLE_AI_API_KEY=                            # Gemini (visão/texto econômico)
REPLICATE_API_TOKEN=                          # FLUX schnell (arte de fundo RF11)
FASHN_API_KEY=                                # provador virtual RF18
MESHY_API_KEY=                                # modelo 3D RF16 (Meshy image-to-3D, assíncrono)
STABILITY_API_KEY=                            # RF16 Stable Fast 3D + RF4 estúdio (Upscale Fast)
PHOTOROOM_API_KEY=                            # RF4 estúdio: fundo + AI lighting + AI shadow
REMOVE_BG_API_KEY=                            # remove.bg (remoção de fundo paga)
REMBG_URL=                                    # rembg auto-hospedado, ex.: http://localhost:7000
FEATURE_RF16_3D=true                          # sem chave de 3D, o relevo local gera o .glb
RF16_3D_TIMEOUT_MINUTES=10

# Segurança de produção (docs/seguranca/SEGURANCA_PRODUCAO.md)
DEV_GATE_ENABLED=false                         # produção antes do lançamento: true
DEV_GATE_SECRET=                               # o MESMO valor do Vercel
DEV_GATE_USER=matheushaliskitcc20233
DEV_GATE_MODE=builtin                          # builtin | cloudflare (Cloudflare Access)
DEV_GATE_ALLOWED_EMAILS=                       # mesma lista do Vercel: revoga uma pessoa na API também
DEV_GATE_ACCEPT_LEGACY=true                    # token v1 do front antigo; false depois que o front novo estiver no ar
CF_ACCESS_TEAM_DOMAIN=                         # modo cloudflare: <time>.cloudflareaccess.com
CF_ACCESS_AUD=                                 # modo cloudflare: AUD da aplicação no Access
EDGE_PROXY_SECRET=                             # o MESMO do Vercel: assina o IP do cliente que o BFF repassa
CLIENT_IP_HEADER=X-Real-IP                     # cabeçalho do IP real definido pela borda do Railway
JWT_AUDIENCE=fashionai-api
EMAIL_LOG_BODIES=false                         # true só em dev: imprime o corpo dos e-mails (códigos) no log
FAI_ADMIN_EMAIL=                               # primeira conta ADMIN (docs/dashboard/DASHBOARD_ADMIN.md)
FAI_ADMIN_PASSWORD=
FAI_ADMIN_USERNAME=
FAI_ADMIN_DISPLAY_NAME=
BACKUP_CRON="0 0 3 * * *"                      # backup do MySQL (restricted/backups); "-" desliga
BACKUP_RETENTION_COUNT=14
BACKUP_TIMEOUT_MINUTES=10
API_DOCS_ENABLED=true                          # produção: false (Swagger fechado)
MANAGEMENT_EXPOSURE=health,info,metrics,prometheus   # produção: health,info
AUTH_RATE_LIMIT_ENABLED=true

# Trello — usado somente pelos scripts de rubricas (não é lido pela aplicação)
# Nunca cole aqui valores reais: copie estas chaves para .env ou configure-as
# como segredos/variáveis do ambiente que executa o agente.
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
