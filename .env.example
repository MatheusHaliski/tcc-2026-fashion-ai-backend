# Aplicacao
APP_ENV=dev
APP_BASE_URL=http://localhost:8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# MySQL - fonte da verdade
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=fashionai
MYSQL_USER=fashionai
MYSQL_PASSWORD=change-me
MYSQL_SSL_MODE=DISABLED
MYSQL_POOL_SIZE=10

# Cassandra - timeline e notificacoes
CASSANDRA_CONTACT_POINTS=localhost
CASSANDRA_PORT=9042
CASSANDRA_LOCAL_DATACENTER=datacenter1
CASSANDRA_KEYSPACE=fashionai_feed
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=

# Redis - contadores, cache e rate limit
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_TTL_SECONDS=3600

# OpenSearch - busca
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# S3 / MinIO - midia
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=fashionai-media
S3_ACCESS_KEY_ID=placeholder
S3_SECRET_ACCESS_KEY=placeholder

# JWT RSA
JWT_ISSUER=fashionai
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
JWT_PRIVATE_KEY_PEM=placeholder-private-key
JWT_PUBLIC_KEY_PEM=placeholder-public-key

# Criptografia de dados sensiveis
DATA_ENCRYPTION_KEY=base64-32-byte-key-placeholder
PASSWORD_HASH_ALGORITHM=argon2id
PASSWORD_HASH_MEMORY_KB=19456
PASSWORD_HASH_ITERATIONS=2

# Provedores de IA - backend only
ANTHROPIC_API_KEY=placeholder
GOOGLE_AI_API_KEY=placeholder
REPLICATE_API_KEY=placeholder
FIREFLY_API_KEY=placeholder
FASHN_API_KEY=placeholder
CLEANUP_AI_API_KEY=placeholder
REMBG_API_KEY=placeholder
MESHY_API_KEY=placeholder
RUNPOD_API_KEY=placeholder
RUNPOD_ENDPOINT_ID=placeholder
CLOUDINARY_URL=cloudinary://placeholder
AI_DAILY_QUOTA_PER_USER=50
AI_REQUEST_TIMEOUT_SECONDS=30
AI_CIRCUIT_BREAKER_FAILURE_RATE=50

# E-mail transacional
RESEND_API_KEY=placeholder
RESEND_FROM_EMAIL=nao-responda@fashionai.app

# Observabilidade
LOG_LEVEL=INFO
LOG_FORMAT=json
AUDIT_RETENTION_DAYS=365
