exports[`retrato da página Meu Quarto > com WebGL: Ir ao espelho abre a prova no quarto e Voltar ao quarto devolve > url na prova 1`] = `"/room?espelho=1"`;

exports[`retrato da página Meu Quarto > com WebGL: ações vindas da cena (etiqueta, chaves, gaveta vazia, abrir módulo, luz, Vista-me e o look) > chamadas 1`] = `
[
  "GET /api/me/preferences null",
