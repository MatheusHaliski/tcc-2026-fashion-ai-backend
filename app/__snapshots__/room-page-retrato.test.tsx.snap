exports[`retrato da página Meu Quarto > sem WebGL: aviso, Configurações, espelho plano e o diálogo do módulo pelo link da peça > sem webgl com o módulo aberto 1`] = `"<div><header class="page-header" data-rf="RF27"><div class="min-w-0"><h1 class="type-h1 text-ink">Meu Quarto</h1><p class="type-body text-muted mt-1.5 max-w-prose">Nível LOFT · industrial · 3 peças em 12 posições</p></div><div class="page-header-actions"><button type="button" class="btn"><img width="24" height="24" alt="" decoding="async" draggable="false" srcset="/icons/fai/glyph/act-30-48.png 2x" src="/icons/fai/glyph/act-30-24.png">Organizar</button><button type="button" class="btn"><img width="24" height="24" alt="" decoding="async" draggable="false" srcset="/icons/fai/glyph/act-32-48.png 2x" src="/icons/fai/glyph/act-32-24.png">Ir ao espelho</button><a href="/points" class="btn"><img width="24" height="24" alt="" decoding="async" draggable="false" srcset="/icons/fai/glyph/act-41-48.png 2x" src="/icons/fai/glyph/act-41-24.png">Loja</a></div></header><p class="mb-3 rounded-md bg-chalk-soft p-2 type-body-sm">🎉 Conquista: PRIMEIRA_LUZ</p><p class="mb-2 rounded-md bg-surface-2 p-2 type-caption text-muted">Este aparelho não exibe 3D: as configurações do quarto e o espelho continuam disponíveis.</p><div class="room3d-side room3d-side-flat"><section class="room-settings" aria-labelledby="room-settings-title" data-testid="room-settings"><header class="room-settings-head"><h2 id="room-settings-title" class="type-h3">Configurações do quarto</h2></header><div class="room-settings-cards"><article class="room-settings-card" aria-labelledby="rs-light"><h3 id="rs-light" class="type-label">Luz</h3><div class="switch-row"><span class="min-w-0"><span id="#1-label" class="block">Luz do teto acesa</span></span><button id="#1" type="button" role="switch" aria-checked="false" aria-labelledby="#1-label" class="switch-track"><span class="switch-thumb"></span></button></div><label class="room-settings-range"><span>Intensidade da luz</span><input min="0" max="100" step="1" aria-label="Intensidade da luz" type="range" value="50"><output class="type-caption tabular">50%</output></label></article><article class="room-settings-card" aria-labelledby="rs-outfit"><h3 id="rs-outfit" class="type-label">Roupa do avatar</h3><p class="type-body-sm">Peça a</p><div class="room-settings-actions"><button type="button" class="btn btn-primary btn-sm">Trocar roupa</button><button type="button" class="btn btn-sm">+ ✨ Vista-me</button></div></article><article class="room-settings-card" aria-labelledby="rs-furniture"><h3 id="rs-furniture" class="type-label">Trocar um móvel</h3><p class="type-caption text-muted">Veja a prévia no quarto antes de comprar e monte no lugar do móvel atual.</p><button type="button" class="btn btn-sm">Abrir móveis</button></article></div><details class="room-settings-section"><summary>Foto e visitas</summary><div class="room-settings-actions"><button type="button" class="btn btn-sm">Chaves do quarto</button></div></details><details class="room-settings-section"><summary>Acessibilidade</summary><div role="radiogroup" aria-label="Movimento" class="segmented"><button type="button" role="radio" aria-checked="true" tabindex="0" class="is-active">Do sistema</button><button type="button" role="radio" aria-checked="false" tabindex="-1">Reduzido</button><button type="button" role="radio" aria-checked="false" tabindex="-1">Normal</button></div><div class="switch-row"><span class="min-w-0"><span id="#2-label" class="block">Conforto contra enjoo</span><span id="#2-hint" class="type-caption block text-muted">Campo de visão mais aberto, trocas por corte seco e nenhuma câmera girando sozinha.</span></span><button id="#2" type="button" role="switch" aria-checked="false" aria-labelledby="#2-label" aria-describedby="#2-hint" class="switch-track"><span class="switch-thumb"></span></button></div><button type="button" class="btn btn-ghost btn-sm">Restaurar padrões</button></details></section></div><div class="pointer-events-none fixed bottom-4 left-1/2 z-[70] flex w-[min(92vw,460px)] -translate-x-1/2 flex-col gap-2" aria-live="polite" aria-atomic="false"></div></div>"`;
