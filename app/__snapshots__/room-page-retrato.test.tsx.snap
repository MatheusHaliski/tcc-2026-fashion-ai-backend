exports[`retrato da página Meu Quarto > com WebGL: ações vindas da cena (etiqueta, chaves, gaveta vazia, abrir módulo, luz, Vista-me e o look) > etiqueta 1`] = `"<div><header class="page-header" data-rf="RF27"><div class="min-w-0"><h1 class="type-h1 text-ink">Meu Quarto</h1><p class="type-body text-muted mt-1.5 max-w-prose">Nível LOFT · industrial · 3 peças em 12 posições</p></div><div class="page-header-actions"><button type="button" class="btn"><img width="24" height="24" alt="" decoding="async" draggable="false" srcset="/icons/fai/glyph/act-30-48.png 2x" src="/icons/fai/glyph/act-30-24.png">Organizar</button><button type="button" class="btn"><img width="24" height="24" alt="" decoding="async" draggable="false" srcset="/icons/fai/glyph/act-32-48.png 2x" src="/icons/fai/glyph/act-32-24.png">Ir ao espelho</button><a href="/points" class="btn"><img width="24" height="24" alt="" decoding="async" draggable="false" srcset="/icons/fai/glyph/act-41-48.png 2x" src="/icons/fai/glyph/act-41-24.png">Loja</a></div></header><p class="mb-3 rounded-md bg-chalk-soft p-2 type-body-sm">🎉 Conquista: PRIMEIRA_LUZ</p><div class="room3d-toolbar" role="toolbar" aria-label="Ações do quarto"><button type="button" class="btn btn-primary"><img width="20" height="20" alt="" decoding="async" draggable="false" srcset="/icons/fai/glyph/act-32-48.png 2x" src="/icons/fai/glyph/act-32-24.png">+ ✨ Vista-me</button><button type="button" class="btn"><img width="20" height="20" alt="" decoding="async" draggable="false" srcset="/icons/fai/glyph/act-13-48.png 2x" src="/icons/fai/glyph/act-13-24.png">Busto · Copilot</button><button type="button" class="btn">Receber compra (1 pendentes)</button><div class="relative inline-flex"><button type="button" class="btn btn-icon" aria-haspopup="menu" aria-expanded="false" aria-label="Câmera: Geral" title="Câmera: Geral"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h.01M12 12h.01M19 12h.01"></path></svg></button></div></div><div class="room3d"><div class="room3d-stage"><div data-testid="room-scene"></div><i data-still="true|1|transparent"></i><p class="room3d-hint">arraste ou use ↺ ↻ para girar · toque numa porta ou gaveta para abrir · toque numa peça para ver os detalhes</p><p class="room3d-walk-status" role="status" aria-live="polite"></p></div><aside class="room3d-side"><div class="mirror-hands is-room" data-phase="room"><div class="mirror-hands-help" role="note"><p class="font-semibold">Aproxime-se do espelho para experimentar suas peças</p><p class="type-caption text-muted">Caminhe com as setas até o espelho (ou toque em Ir ao espelho e o avatar vai andando): a prova abre sozinha, com o que você veste e a peça que está na mão. Afastar-se volta ao quarto.</p><button type="button" class="btn btn-ghost btn-sm">Não mostrar novamente</button></div></div><section class="room-settings" aria-labelledby="room-settings-title" data-testid="room-settings"><header class="room-settings-head"><h2 id="room-settings-title" class="type-h3">Configurações do quarto</h2><button type="button" class="btn">Ver comandos ilustrados</button></header><div class="room-settings-cards"><article class="room-settings-card" aria-labelledby="rs-light"><h3 id="rs-light" class="type-label">Luz</h3><div class="switch-row"><span class="min-w-0"><span id="#1-label" class="block">Luz do teto acesa</span></span><button id="#1" type="button" role="switch" aria-checked="false" aria-labelledby="#1-label" class="switch-track"><span class="switch-thumb"></span></button></div><label class="room-settings-range"><span>Intensidade da luz</span><input min="0" max="100" step="1" aria-label="Intensidade da luz" type="range" value="50"><output class="type-caption tabular">50%</output></label></article><article class="room-settings-card" aria-labelledby="rs-outfit"><h3 id="rs-outfit" class="type-label">Roupa do avatar</h3><p cla