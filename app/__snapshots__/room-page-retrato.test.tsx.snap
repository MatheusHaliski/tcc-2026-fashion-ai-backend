exports[`retrato da página Meu Quarto > com WebGL: quarto, props da cena e diálogos da barra (Organizar, Vista-me, Copilot) > copilot aberto 1`] = `"<div><header class="page-header" data-rf="RF27"><div class="min-w-0"><h1 class="type-h1 text-ink">Meu Quarto</h1><p class="type-body text-muted mt-1.5 max-w-prose">Nível LOFT · industrial · 3 peças em 12 posições</p></div><div class="page-header-actions"><button type="button" class="btn"><img width="24" height="24" alt="" decoding="async" draggable="false" srcset="/icons/fai/glyph/act-30-48.png 2x" src="/icons/fai/glyph/act-30-24.png">Organizar</button><button type="button" class="btn"><img width="24" height="24" alt="" decoding="async" draggable="false" srcset="/icons/fai/glyph/act-32-48.png 2x" src="/icons/fai/glyph/act-32-24.png">Ir ao espelho</button><a href="/points" class="btn"><img width="24" height="24" alt="" decoding="async" draggable="false" srcset="/icons/fai/glyph/act-41-48.png 2x" src="/icons/fai/glyph/act-41-24.png">Loja</a></div></header><p class="mb-3 rounded-md bg-chalk-soft p-2 type-body-sm">🎉 Conquista: PRIMEIRA_LUZ</p><div class="room3d-toolbar" role="toolbar" aria-label="Ações do quarto"><button type="button" class="btn btn-primary"><img width="20" height="20" alt="" decoding="async" draggable="false" srcset="/icons/fai/glyph/act-32-48.png 2x" src="/icons/fai/glyph/act-32-24.png">+ ✨ Vista-me</button><button type="button" class="btn"><img width="20" height="20" alt="" decoding="async" draggable="false" srcset="/icons/fai/glyph/act-13-48.png 2x" src="/icons/fai/glyph/act-13-24.png">Busto · Copilot</button><button type="button" class="btn">Receber compra (1 pendentes)</button><div class="relative inline-flex"><button type="button" class="btn btn-icon" aria-haspopup="menu" aria-expanded="false" aria-label="Câmera: Geral" title="Câmera: Geral"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h.01M12 12h.01M19 12h.01"></path></svg></button></div></div><div class="room3d"><div class="room3d-stage"><div data-testid="room-scene"></div><i data-still="true|1|transparent"></i><p class="room3d-hint">arraste ou use ↺ ↻ para girar · toque numa porta ou gaveta para abrir · toque numa peça para ver os detalhes</p><p class="room3d-walk-status" role="status" aria-live="polite"></p></div><aside class="room3d-side"><div class="mirror-hands is-room" data-phase="room"><div class="mirror-hands-help" role="note"><p class="font-semibold">Aproxime-se do espelho para experimentar suas peças</p><p class="type-caption text-muted">Caminhe com as setas até o espelho (ou toque em Ir ao espelho e o avatar vai andando): a prova abre sozinha, com o que você veste e a peça que está na mão. Afastar-se volta ao quarto.</p><button type="button" class="btn btn-ghost btn-sm">Não mostrar novamente</button></div></div><section class="room-settings" aria-labelledby="room-settings-title" data-testid="room-settings"><header class="room-settings-head"><h2 id="room-settings-title" class="type-h3">Configurações do quarto</h2><button type="button" class="btn">Ver comandos ilustrados</button></header><div class="room-settings-cards"><article class="room-settings-card" aria-labelledby="rs-light"><h3 id="rs-light" class="type-label">Luz</h3><div class="switch-row"><span class="min-w-0"><span id="#1-label" class="block">Luz do teto acesa</span></span><button id="#1" type="button" role="switch" aria-checked="false" aria-labelledby="#1-label" class="switch-track"><span class="switch-thumb"></span></button></div><label class="room-settings-range"><span>Intensidade da luz</span><input min="0" max="100" step="1" aria-label="Intensidade da luz" type="range" value="50"><output class="type-caption tabular">50%</output></label></article><article class="room-settings-card" aria-labelledby="rs-outfit"><h3 id="rs-outfit" class="type-label">Roupa do avatar</h3><p class="type-body-sm">Peça a</p><div class="room-settings-actions"><button type="button" class="btn btn-primary btn-sm">Trocar roupa</button><button type="button" class="btn btn-sm">+ ✨ Vista-me</button></div></article><article class="room-settings-card" aria-labelledby="rs-furniture"><h3 id="rs-furniture" class="type-label">Trocar um móvel</h3><p class="type-caption text-muted">Veja a prévia no quarto antes de comprar e monte no lugar do móvel atual.</p><button type="button" class="btn btn-sm">Abrir móveis</button></article></div><details class="room-settings-section" open=""><summary>Câmera e pontos de vista</summary><div role="radiogroup" aria-label="Modo da câmera" class="segmented"><button type="button" role="radio" aria-checked="true" tabindex="0" class="is-active">Andar com o avatar</button><button type="button" role="radio" aria-checked="false" tabindex="-1">Câmera livre</button></div><div role="radiogroup" aria-label="Quarto" class="room-settings-views"><p class="type-caption text-muted">Quarto</p><button type="button" class="chip" role="radio" aria-checked="true">Geral</button><button type="button" class="chip" role="radio" aria-checked="false">Planta (de cima)</button><button type="button" class="chip" role="radio" aria-checked="false">Casa de bonecas</button><button type="button" class="chip" role="radio" aria-checked="false">Guarda-roupa</button><button type="button" class="chip" role="radio" aria-checked="false">Entrada (da porta)</button><button type="button" class="chip" role="radio" aria-checked="false">O que o espelho vê</button></div><div role="radiogroup" aria-label="Cantos do teto" class="room-settings-views"><p class="type-caption text-muted">Cantos do teto</p><button type="button" class="chip" role="radio" aria-checked="false">Canto da porta</button><button type="button" class="chip" role="radio" aria-checked="false">Canto da janela</button><button type="button" class="chip" role="radio" aria-checked="false">Canto da cama</button><button type="button" class="chip" role="radio" aria-checked="false">Canto da arara</button></div><div role="radiogroup" aria-label="Avatar e cinema" class="room-settings-views"><p class="type-caption text-muted">Avatar e cinema</p><button type="button" class="chip" role="radio" aria-checked="false">Primeira pessoa</button><button type="button" class="chip" role="radio" aria-checked="false">Cinematográfica</button></div><div class="room-settings-favorites" role="group" aria-label="Vistas favoritas"><p class="type-caption text-muted">Vistas favoritas</p><ol><li><span class="tabular">1</span><button type="button" disabled="" aria-label="Vista favorita 1" class="btn btn-ghost btn-sm">Vazia</button><button type="button" aria-label="Salvar a câmera atual na vista 1" class="btn btn-ghost btn-sm">Salvar</button></li><li><span class="tabular">2</span><button type="button" disabled="" aria-label="Vista favorita 2" class="btn btn-ghost btn-sm">Vazia</button><button type="button" aria-label="Salvar a câmera atual na vista 2" class="btn btn-ghost btn-sm">Salvar</button></li><li><span class="tabular">3</span><button type="button" disabled="" aria-label="Vista favorita 3" class="btn btn-ghost btn-sm">Vazia</button><button type="button" aria-label="Salvar a câmera atual na vista 3" class="btn btn-ghost btn-sm">Salvar</button></li><li><span class="tabular">4</span><button type="button" disabled="" aria-label="Vista favorita 4" class="btn btn-ghost btn-sm">Vazia</button><button type="button" aria-label="Salvar a câmera atual na vista 4" class="btn btn-ghost btn-sm">Salvar</button></li><li><span class="tabular">5</span><button type="button" disabled="" aria-label="Vista favorita 5" class="btn btn-ghost btn-sm">Vazia</button><button type="button" aria-label="Salvar a câmera atual na vista 5" class="btn btn-ghost btn-sm">Salvar</button></li></ol><p class="type-caption text-muted">Teclado: V troca a vista, 1–5 volta a uma vista salva e Shift+1–5 salva. Nos cantos do teto, Q/E passam ao canto vizinho. Controle: direcional ← →.</p></div><div class="switch-row"><span class="min-w-0"><span id="#2-label" class="block">Campo de visão automático</span></span><button id="#2" type="button" role="switch" aria-checked="true" aria-labelledby="#2-label" class="switch-track"><span class="switch-thumb"></span></button></div><label class="room-settings-range"><span>Sensibilidade da câmera</span><input min="10" max="100" step="5" aria-label="Sensibilidade da câmera" type="range" value="50"><output class="type-caption tabular">50%</output></label><div class="switch-row"><span class="min-w-0"><span id="#3-label" class="block">Inverter eixo horizontal</span></span><button id="#3" type="button" role="switch" aria-checked="false" aria-labelledby="#3-label" class="switch-track"><span class="switch-thumb"></span></button></div><div class="switch-row"><span class="min-w-0"><span id="#4-label" class="block">Inverter eixo vertical</span></span><button id="#4" type="button" role="switch" aria-checked="false" aria-labelledby="#4-label" class="switch-track"><span class="switch-thumb"></span></button></div><div class="switch-row"><span class="min-w-0"><span id="#5-label" class="block">Câmera segue o avatar</span><span id="#5-hint" class="type-caption block text-muted">Desligado, o olhar fica no quarto enquanto você anda.</span></span><button id="#5" type="button" role="switch" aria-checked="true" aria-labelledby="#5-label" aria-describedby="#5-hint" class="switch-track"><span class="switch-thumb"></span></button></div><div role="radiogroup" aria-label="Troca de vista" class="segmented"><button type="button" role="radio" aria-checked="true" tabindex="0" class="is-active">Suave</button><button type="button" role="radio" aria-checked="false" tabindex="-1">Corte seco</button></div></details><details class="room-settings-section"><summary>Paredes</summary><div role="radiogroup" aria-label="Paredes" class="segmented"><button type="button" role="radio" aria-checked="false" tabindex="-1">Inteiras</button><button type="button" role="radio" aria-checked="true" tabindex="0" class="is-active">Recortadas</button><button type="button" role="radio" aria-checked="false" tabindex="-1">Baixas</button></div><p class="type-caption text-muted">Somem só as paredes que tapam a vista.</p></details><details class="room-settings-section"><summary>Ambiente</summary><label class="room-settings-field"><span>Hora do dia</span><div class="dd is-block"><button type="button" class="input dd-trigger" aria-haspopup="listbox" aria-expanded="false"><span class="dd-value">Automática</span><svg class="dd-icon" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg></button></div></label><label class="room-settings-field"><span>Temperatura da lâmpada</span><div class="dd is-block"><button type="button" class="input dd-trigger" aria-haspopup="listbox" aria-expanded="false"><span class="dd-value">A do quarto</span><svg class="dd-icon" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg></button></div></label><p class="type-caption text-muted">Para avaliar a cor das roupas, use a luz neutra.</p></details><details class="room-settings-section"><summary>Gráficos</summary><label class="room-settings-field"><span>Qualidade</span><div class="dd is-block"><button type="button" class="input dd-trigger" aria-haspopup="listbox" aria-expanded="false"><span class="dd-value">Automática</span><svg class="dd-icon" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg></button></div></label><label class="room-settings-field"><span>Reflexo do espelho</span><div class="dd is-block"><button type="button" class="input dd-trigger" aria-haspopup="listbox" aria-expanded="false"><span class="dd-value">Automático</span><svg class="dd-icon" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg></button></div></label><div class="switch-row"><span class="min-w-0"><span id="#6-label" class="block">Resolução dinâmica</span><span id="#6-hint" class="type-caption block text-muted">Baixa a resolução quando o aparelho fica lento.</span></span><button id="#6" type="button" role="switch" aria-checked="true" aria-labelledby="#6-label" aria-describedby="#6-hint" class="switch-track"><span class="switch-thumb"></span></button></div></details><details class="room-settings-section"><summary>Interface na cena</summary><div role="radiogroup" aria-label="Interface na cena" class="segmented"><button type="button" role="radio" aria-checked="true" tabindex="0" class="is-active">Completa</button><button type="button" role="radio" aria-checked="false" tabindex="-1">Mínima</button><button type="button" role="radio" aria-checked="false" tabindex="-1">Oculta</button></div><div class="switch-row"><span class="min-w-0"><span id="#7-label" class="block">Mostrar o nome da vista ao trocar</span></span><button id="#7" type="button" role="switch" aria-checked="true" aria-labelledby="#7-label" class="switch-track"><span class="switch-thumb"></span></button></div></details><details class="room-settings-section"><summary>Foto e visitas</summary><div class="room-settings-actions"><button type="button" class="btn btn-sm">Modo foto</button><button type="button" class="btn btn-sm">Chaves do quarto</button></div></details><details class="room-settings-section"><summary>Acessibilidade</summary><div role="radiogroup" aria-label="Movimento" class="segmented"><button type="button" role="radio" aria-checked="true" tabindex="0" class="is-active">Do sistema</button><button type="button" role="radio" aria-checked="false" tabindex="-1">Reduzido</button><button type="button" role="radio" aria-checked="false" tabindex="-1">Normal</button></div><div class="switch-row"><span class="min-w-0"><span id="#8-label" class="block">Conforto contra enjoo</span><span id="#8-hint" class="type-caption block text-muted">Campo de visão mais aberto, trocas por corte seco e nenhuma câmera girando sozinha.</span></span><button id="#8" type="button" role="switch" aria-checked="false" aria-labelledby="#8-label" aria-describedby="#8-hint" class="switch-track"><span class="switch-thumb"></span></button></div><button type="button" class="btn btn-ghost btn-sm">Restaurar padrões</button></details></section></aside></div><div class="pointer-events-none fixed bottom-4 left-1/2 z-[70] flex w-[min(92vw,460px)] -translate-x-1/2 flex-col gap-2" aria-live="polite" aria-atomic="false"></div></div><div class="dialog-backdrop"><div role="dialog" aria-modal="true" aria-labelledby="#9" tabindex="-1" class="dialog "><div class="dialog-head"><h2 id="#9" class="type-h2">Busto de costura · Copilot</h2><button type="button" class="btn btn-ghost btn-icon" aria-label="Fechar"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div><div class="p-4"><div class="mb-3"><label for="cp-q" class="label">Pergunte ao Copilot</label><textarea id="cp-q" rows="2" placeholder="onde está meu blazer azul?" class="input min-h-24"></textarea></div></div><div class="dialog-foot"><button type="button" disabled="" class="btn btn-primary">Perguntar</button></div></div></div>"`;

