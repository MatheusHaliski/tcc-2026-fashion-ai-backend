igger" aria-haspopup="listbox" aria-expanded="false"><span class="dd-value">Automático</span><svg class="dd-icon" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg></button></div></label><div class="switch-row"><span class="min-w-0"><span id="#6-label" class="block">Resolução dinâmica</span><span id="#6-hint" class="type-caption block text-muted">Baixa a resolução quando o aparelho fica lento.</span></span><button id="#6" type="button" role="switch" aria-checked="true" aria-labelledby="#6-label" aria-describedby="#6-hint" class="switch-track"><span class="switch-thumb"></span></button></div></details><details class="room-settings-section"><summary>Interface na cena</summary><div role="radiogroup" aria-label="Interface na cena" class="segmented"><button type="button" role="radio" aria-checked="true" tabindex="0" class="is-active">Completa</button><button type="button" role="radio" aria-checked="false" tabindex="-1">Mínima</button><button type="button" role="radio" aria-checked="false" tabindex="-1">Oculta</button></div><div class="switch-row"><span class="min-w-0"><span id="#7-label" class="block">Mostrar o nome da vista ao trocar</span></span><button id="#7" type="button" role="switch" aria-checked="true" aria-labelledby="#7-label" class="switch-track"><span class="switch-thumb"></span></button></div></details><details class="room-settings-section"><summary>Foto e visitas</summary><div class="room-settings-actions"><button type="button" class="btn btn-sm">Modo foto</button><button type="button" class="btn btn-sm">Chaves do quarto</button></div></details><details class="room-settings-section"><summary>Acessibilidade</summary><div role="radiogroup" aria-label="Movimento" class="segmented"><button type="button" role="radio" aria-checked="true" tabindex="0" class="is-active">Do sistema</button><button type="button" role="rad