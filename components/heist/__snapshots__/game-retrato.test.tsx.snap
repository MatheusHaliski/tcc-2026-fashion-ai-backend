exports[`retrato do jogo (HeistGame) > briefing: DOM da tela, do canvas e da cena; depois de Começar: HUD, dica de clique e classes 1`] = `
{
  "brief": "<div class="hz-game is-dimmed  has-glbox " data-stage="brief"><div data-testid="canvas" data-props="{&quot;shadows&quot;:true,&quot;dpr&quot;:[1,1.75],&quot;gl&quot;:{&quot;antialias&quot;:true,&quot;powerPreference&quot;:&quot;high-performance&quot;},&quot;camera&quot;:{&quot;fov&quot;:62,&quot;near&quot;:0.05,&quot;far&quot;:500,&quot;position&quot;:[-18,0.5,52]},&quot;onCreated&quot;:&quot;[fn]&quot;}"><div data-testid="camera" data-shot="null" data-reduced="false"></div><div data-testid="scene" data-quality="high" data-debug="false" data-letterbox="false" data-pieces="heist-gown-noir,heist-heels-noir"></div><div data-testid="fx"></div></div><div class="hz-screen hz-briefing" role="dialog" aria-modal="true" aria-labelledby="hz-brief-title"><div class="hz-brief-col"><p class="hz-eyebrow">FLAIR Metamorfose · Gala Lumière</p><h1 id="hz-brief-title">MET Gala Heist</h1><p class="hz-brief-lead">Vera passou dez anos costurando vestidos que outras pessoas levaram para a foto. Hoje à noite, na Gala Lumière do Museu Vesper, ela volta — pela porta da frente ou por qualquer outra. Na Sala das Joias, sob uma redoma e uma teia de lasers, está a Estrela do Norte: um diamante de US$ 15 mil da coleção de Celine Dion, emprestado à exposição Aurora.</p><p class="hz-brief-lead is-goal">Objetivo: entrar na festa, abrir caminho até a Sala das Joias, pegar o diamante e fugir.</p><ol class="hz-brief-steps"><li>Na avenida, consiga um jeito de entrar: convite, um look de prestígio, o uniforme do bufê ou a escada de incêndio.</li><li>Dentro, aja como convidada: correr, mostrar uma arma ou entrar em área restrita faz alguém reparar.</li><li>Suas peças viram recursos: vista, use como Visão, munição ou curativo — ou troque no revendedor por armas e kits.</li><li>Com o diamante, as portas da frente fecham e os seguranças atiram. Escolha a rota e corra até um carro.</li></ol><fieldset class="hz-choices is-stack"><legend>Dificuldade</legend><label class="hz-chip is-wide"><input type="radio" name="hz-diff"><b>Fácil</b><small>Reconhecem mais devagar, erram mais e tiram menos vida; a vida volta até a metade; tudo mais barato.</small></label><label class="hz-chip is-wide is-on"><input type="radio" checked="" name="hz-diff"><b>Normal</b><small>O golpe do jeito que foi planejado.</small></label><label class="hz-chip is-wide"><input type="radio" name="hz-diff"><b>Difícil</b><small>Reconhecem mais rápido, acertam mais e tudo custa mais caro.</small></label><label class="hz-chip is-wide"><input type="radio" name="hz-diff"><b>Lenda</b><small>Um deslize e a gala inteira vem atrás de você.</small></label></fieldset><fieldset class="hz-choices is-stack"><legend>Desafio</legend><label class="hz-chip is-wide is-on"><input type="radio" checked="" name="hz-ch"><b>Sem desafio</b><small>Só o golpe.</small></label><label class="hz-chip is-wide"><input type="radio" name="hz-ch"><b>Golpe Fantasma</b><small>Nenhum segurança pode entrar em alerta por sua causa.</small></label><label class="hz-chip is-wide"><input type="radio" name="hz-ch"><b>Corrida do Diamante</b><small>O diamante nas mãos em até 6 minutos.</small></label><label class="hz-chip is-wide"><input type="radio" name="hz-ch"><b>Fuga da Meia-Noite</b><small>Comece na Sala das Joias com a energia cortada e chegue a um carro em até 2 minutos depois do alarme.</small></label><label class="hz-chip is-wide"><input type="radio" name="hz-ch"><b>Camaleão Social<span class="hz-badge">da semana</span></b><small>Chegue à Sala das Joias sem disparar, nocautear ou abater ninguém — e trocando de roupa pelo caminho.</small></label></fieldset><div class="hz-brief-actions"><button type="button" class="hz-btn is-primary is-big" aria-describedby="hz-load">Começar o golpe</button></div><p id="hz-load" class="hz-fine" aria-live="polite">Tudo pronto.</p></div><div class="hz-brief-col"><div class="hz-tabs" role="tablist"><button type="button" role="tab" aria-selected="true" class="hz-tab is-active">Seu deck</button><button type="button" role="tab" aria-selected="false" class="hz-tab">Revendedor</button><button type="button" role="tab" aria-selected="false" class="hz-tab">Controles</button><button type="button" role="tab" aria-selected="false" class="hz-tab">Opções</button></div><p class="hz-muted">O que cada peça do seu look faz na partida (até 8 peças, as mais valiosas primeiro).</p><ul class="hz-cardlist is-compact"></ul></div></div></div>",
  "play": "<div class="hz-game   has-glbox " data-stage="play"><div data-testid="canvas" data-props="{&quot;shadows&quot;:true,&quot;dpr&quot;:[1,1.75],&quot;gl&quot;:{&quot;antialias&quot;:true,&quot;powerPreference&quot;:&quot;high-performance&quot;},&quot;camera&quot;:{&quot;fov&quot;:62,&quot;near&quot;:0.05,&quot;far&quot;:500,&quot;position&quot;:[-18,0.5,52]},&quot;onCreated&quot;:&quot;[fn]&quot;}"><div data-testid="camera" data-shot="null" data-reduced="false"></div><div data-testid="scene" data-quality="high" data-debug="false" data-letterbox="false" data-pieces="heist-gown-noir,heist-heels-noir"></div><div data-testid="fx"></div></div><div class="hz-hud sub-m" style="--hz-ui: 1;" aria-live="off"><div class="hz-letterbox" aria-hidden="true"><span></span><span></span></div><div class="hz-vignette" style="opacity: 0;" aria-hidden="true"></div><div class="hz-hitflash" style="opacity: 0;" aria-hidden="true"></div><section class="hz-mission" aria-label="Objetivo da missão"><p class="hz-mission-goal"><span class="hz-mission-mark" aria-hidden="true">◆</span>Infiltrar a gala</p><ol class="hz-mission-steps"><li class="is-current"><span class="hz-step-box" aria-hidden="true"></span><span>Chegar à escadaria do museu</span><span class="sr-only">atual</span></li><li class="is-next"><span class="hz-step-box" aria-hidden="true"></span><span>Conseguir um jeito de entrar</span><span class="sr-only">a seguir</span></li><li class="is-next"><span class="hz-step-box" aria-hidden="true"></span><span>Entrar no museu</span><span class="sr-only">a seguir</span></li></ol><p class="hz-mission-hint">Atravesse a avenida até o tapete. Na calçada, a barraca do Tião troca peças por equipamento.</p></section><section class="hz-status" aria-label="Onde você está"><p class="hz-room">Avenida da Gala</p><p class="hz-access is-ok">Rua · qualquer roupa passa</p><div class="hz-alertpips" role="meter" aria-valuemin="0" aria-valuemax="3" aria-valuenow="0" aria-label="Alerta do prédio"><span class="hz-alertpips-label">Calmo</span><i class=""></i><i class=""></i><i class=""></i></div><ul class="hz-inv" aria-label="Itens-chave"></ul></section><div class="hz-marks" aria-hidden="true"><span class="hz-mark is-edge" style="left: 50%; top: 50%; --a: 0rad;"><i>➤</i></span></div><div class="hz-detect" aria-hidden="true"></div><section class="hz-vitals" aria-label="Vida e recursos"><div class="hz-compass" aria-hidden="true"><div class="hz-compass-strip"><span class="hz-tick is-major" style="left: 50%;">N</span><span class="hz-tick" style="left: 60.47197551196598%;"></span><span class="hz-tick" style="left: 70.94395102393194%;"></span><span class="hz-tick is-major" style="left: 81.41592653589794%;">NE</span><span class="hz-tick" style="left: 91.88790204786389%;"></span><span class="hz-tick" style="left: 8.112097952136104%;"></span><span class="hz-tick is-major" style="left: 18.58407346410207%;">NO</span><span class="hz-tick" style="left: 29.056048976068034%;"></span><span class="hz-tick" style="left: 39.528024488034035%;"></span><span class="hz-compass-mark is-main" style="left: 84.65209050210714%;">◆</span></div></div><div class="hz-hprow"><div class="hz-hp" role="meter" aria-valuemin="0" aria-valuemax="100" aria-valuenow="100" aria-label="Vida"><span class="hz-hp-fill" style="width: 100%;"></span><span class="hz-hp-seg" style="left: 25%;" aria-hidden="true"></span><span class="hz-hp-seg" style="left: 50%;" aria-hidden="true"></span><span class="hz-hp-seg" style="left: 75%;" aria-hidden="true"></span></div><span class="hz-hp-text hz-num">100</span><span class="hz-quickheal is-empty" title="Atalho de cura"><kbd>H</kbd><span aria-hidden="true">✚</span><span class="hz-num">0</span><span class="sr-only">sem kits e nenhum curativo</span></span></div><ul class="hz-gadgets"><li class="" title="Garrafas para distrair"><span aria-hidden="true">🍾</span><b class="hz-num">1</b><kbd>G</kbd></li><li class="" title="Esquiva"><span aria-hidden="true">↯</span><kbd>Espaço</kbd></li><li 