@startuml Anatomia_Esquema_Estados
!pragma layout smetana
title Ciclo de vida do esquema (look)\nMáquina de estados
skinparam backgroundColor #FFFFFF
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  ArrowColor #52606D
}
[*] --> DRAFT : Criar Look (manual/IA), provador,\nremix, copiloto, DNA, autopiloto, espelho
state DRAFT : edição livre entre as etapas;\n1 peça por tipo
state PUBLISHED {
  state "Visibilidade" as Vis {
    [*] --> Privado
    state "PRIVATE" as Privado
    state "FOLLOWERS" as Seguidores
    state "PUBLIC" as Publico
    Privado --> Seguidores
    Seguidores --> Publico
    Publico --> Privado
  }
  state "Disponibilidade" as Disp {
    [*] --> Disponivel
    state "disponivel = true" as Disponivel
    state "disponivel = false" as Indisponivel
    Disponivel --> Indisponivel : dono marca
    Indisponivel --> Disponivel : dono marca
  }
  state "Selos" as Sel {
    [*] --> EmDia
    state "selos em dia" as EmDia
    state "revalidationPending" as Revalidando
    EmDia --> Revalidando : dono edita as peças de um look\ncom vínculo APPROVED (emissor avisado)
    Revalidando --> EmDia : emissor revisa\n(mantém ou revoga)
  }
}
note bottom of PUBLISHED : as três dimensões variam de forma independente
DRAFT --> PUBLISHED : salvar / publicar
PUBLISHED --> PUBLISHED : usar como look do dia (lookDoDiaCount +1)
PUBLISHED --> ARCHIVED : excluir (RF31): vínculos de selo revogados,\nfoto do look sai de "Minhas Fotos"
ARCHIVED --> [*]
note right of ARCHIVED : exclusão lógica: some do perfil,\ndas contagens e da busca
@enduml
