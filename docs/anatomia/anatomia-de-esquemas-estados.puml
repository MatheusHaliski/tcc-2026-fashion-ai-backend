@startuml Anatomia_Esquema_Estados
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  StartColor #20A77A
  EndColor #4B5563
}
title ciclo de vida de Scheme.status\nDiagrama de máquina de estados — gerado do código em 2026-10-06 (scripts/diagramas/v5)\nenum SchemeStatus · tabela schemes

state "Scheme.status" as Ciclo_Scheme {
  state Ciclo_Scheme_DRAFT as "DRAFT"
  state Ciclo_Scheme_PUBLISHED as "PUBLISHED"
  state Ciclo_Scheme_ARCHIVED as "ARCHIVED"
}
[*] --> Ciclo_Scheme_DRAFT : criação
Ciclo_Scheme --> Ciclo_Scheme_ARCHIVED : purgeScheduledDeletions(), archive()
Ciclo_Scheme --> Ciclo_Scheme_PUBLISHED : create(), publish(),\npublishInternal(), update()
note right of Ciclo_Scheme
  Setas que saem da borda: a mudança vale
  a partir de qualquer estado (o código não
  testa o estado anterior).
end note
@enduml
