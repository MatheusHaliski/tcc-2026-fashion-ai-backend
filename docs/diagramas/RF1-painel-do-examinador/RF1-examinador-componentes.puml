@startuml RF1_Examinador_Componentes
title RF1.CA07/CA09 — Verificação do emissor e Central do emissor: componentes
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam component {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  ArrowColor #52606D
}
package "Frontend (Next.js)" {
  [IssuerCenter + IssuerCenterButton\n(components/issuer-review.tsx)] as Center
  [dashboard/page.tsx\n(Central aberta enquanto não aprovado)] as Dash
  [brands/{slug}/page.tsx\n(aba Central do emissor)] as Prof
  [AdminApprovals\n(components/admin-approvals.tsx,\n/admin/users?tab=approvals)] as Adm
}
package "Backend (Spring Boot)" {
  [IssuerReviewController\n/api/me/issuer-review(/resubmit)] as RC
  [AdminController\n/api/admin/approvals(/{userId}(/documents/{tipo}))] as AC
  [IssuerReviewService] as RS
  [IssuerVerificationPolicy] as POL
  [IdentityService] as IS
  [SealService.ensureDefaultSeals] as SS
  [NotificationService] as NS
  [Audit] as AU
}
cloud "EmailPort (Resend)" as Mail
database "MySQL\n(V31: review_attempts, review_reasons,\nreview_checklist, review_owner_message)" as DB
cloud "Armazenamento\nrestricted/ (só ADMIN)" as ST
Prof --> Center
Dash --> Center
Center --> RC
Adm --> AC
RC --> RS
AC --> RS
IS --> RS : submitted(userId)\nemailConfirmed(user)
RS --> POL : checks · código · motivos
RS --> SS : aprovação
RS --> NS
RS --> AU
RS --> Mail : avisos aos admins\ne decisão ao dono
RS --> DB
RS --> ST : documentos
@enduml
