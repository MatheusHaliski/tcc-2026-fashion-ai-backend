@startuml RF1_Atividades
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam activity {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  DiamondBackgroundColor #FFF5F8
  DiamondBorderColor #F08DB1
  StartColor #20A77A
  EndColor #4B5563
}
skinparam swimlane {
  BorderColor #CBC6BE
  TitleFontColor #2D2438
}
title RF1 — Cadastrar conta na plataforma (perfil Pessoal, Marca ou Celebridade)\nDiagrama de atividades — gerado do código em 2026-10-06 (scripts/diagramas/v5)

|Pessoa usuária|
start
:Abre /verify-email, /register, /closet;
|Tela (Next.js)|
:Carrega os dados da tela\nGET /api/auth/username-suggestions\nGET /api/admin/approvals\nGET /api/admin/approvals/{userId}/documents/{kind};
|Pessoa usuária|
:Cadastrar conta (pessoal, marca ou\ncelebridade) e abrir ses…;
|Tela (Next.js)|
:POST /api/auth/register;
|API (Spring Boot)|
:AuthController.register\n→ IdentityService.register;
if (tipo inválido?) then (sim)
  :400 TIPO_INVALIDO\n«Tipo de perfil não permitido no\ncadastro.»\n→ a tela mostra o aviso;
  stop
endif
if (formulario inválido?) then (sim)
  :400 FORMULARIO_INVALIDO\n«Corrija os campos destacados.»\n→ a tela mostra o aviso;
  stop
endif
if (e-mail em uso?) then (sim)
  :409 EMAIL_EM_USO\n«Este e-mail já está cadastrado.\nFaça login ou recupere a senha.»\n→ a tela mostra o aviso;
  stop
endif
if (username em uso?) then (sim)
  :400 USERNAME_EM_USO\n«Este @ já está em uso.»\n→ a tela mostra o aviso;
  stop
endif
|Dados e serviços|
:Lê: users\nbrand_profiles\ncelebrity_profiles\nverification_codes\nuser_preferences;
:Usa: MediaStoragePort.get\nPasswordHasherPort.hash\nMediaStoragePort.put\nEmailSenderPort.send\nIssuerReviewService.submitted\nNotificationService.notify (+2);
:Grava: users\nuser_preferences\nbrand_profiles\ncelebrity_profiles\nverification_codes\nrefresh_tokens;
:Estado: profileType → ?type\nprivateAccount → true\ntermsAcceptedAt → set\nstatus → PENDING_EMAIL_VERIFICATION\navatarUrl → set\nlogoUrl → set (+12);
|Tela (Next.js)|
:Atualiza a tela com a resposta;
|Pessoa usuária|
if (Faz outra ação?) then (sim)
  switch (Qual?)
  case (Enviar foto de perfil [ou logo, f…)
    :POST /api/auth/uploads\n→ IdentityService.preRegistrationUpload\nvalida: ARQUIVO_GRANDE, LIMITE_ENVIOS, TIPO_INVALIDO\nusa: MediaStoragePort.put;
  case (Confirmar e-mail com o código rec…)
    :POST /api/auth/email-verification\n→ IdentityService.verifyEmail\nvalida: CODIGO_EXPIRADO, ERRO, MUITAS_TENTATIVAS\nlê: users, verification_codes, brand_profiles …\nusa: IssuerReviewService.emailConfirmed\nestado: consumedAt → set, emailVerified → true;
  case (Reenviar código de confirmação de…)
    :POST /api/auth/email-verification/resend\n→ IdentityService.resendEmailVerification\nvalida: MUITAS_TENTATIVAS\nlê: users, verification_codes, user_preferences\nusa: EmailSenderPort.send\ngrava: verification_codes;
  case (Decidir a verificação: APROVAR [c…)
    :POST /api/admin/approvals/{userId}\n→ IssuerReviewService.decide\nvalida: ACESSO_NEGADO, CRITERIOS_PENDENTES,\nDECISAO_INVALIDA, EMAIL_NAO_CONFIRMADO …\nlê: users, brand_profiles, celebrity_profiles\nusa: Guard.requireAdmin,\nIssuerVerificationPolicy.checks,\nSealService.ensureDefaultSeals …\ngrava: users;
  endswitch
  |Tela (Next.js)|
  :Atualiza a tela;
endif
|Pessoa usuária|
stop
@enduml
