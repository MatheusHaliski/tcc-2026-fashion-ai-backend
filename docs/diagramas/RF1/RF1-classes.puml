@startuml RF1_Classes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  StereotypeFontColor #6B6470
}
hide empty members
left to right direction
title RF1 — Cadastrar conta na plataforma (perfil Pessoal, Marca ou Celebridade)\nDiagrama de classes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "fai-domain (entidades JPA)" {
  class BrandProfile <<brand_profiles>> {
    +id: UUID
    +owner: User
    +brandName: String
    +slug: String
    +logoUrl: String
    +coverUrl: String
    +bio: String
    +storeUrl: String
    +cnpj: String
    +razaoSocial: String
    .. +21 campos ..
  }
  class CelebrityProfile <<celebrity_profiles>> {
    +id: UUID
    +owner: User
    +stageName: String
    +slug: String
    +avatarUrl: String
    +coverUrl: String
    +bio: String
    +realName: String
    +areasJson: String
    +verifiableFollowersJson: String
    .. +20 campos ..
  }
  class RefreshToken <<refresh_tokens>> {
    +id: UUID
    +user: User
    +tokenHash: String
    +familyId: UUID
    +expiresAt: Instant
    +revokedAt: Instant
    +rotatedFromId: UUID
    +createdIp: String
    +userAgent: String
    +deviceName: String
    .. +3 campos ..
  }
  class User <<users>> {
    +id: UUID
    +username: String
    +displayName: String
    +email: String
    +emailHash: String
    +emailVerified: boolean
    +phone: String
    +birthDate: String
    +passwordHash: String
    +profileType: ProfileType
    .. +24 campos ..
  }
  class UserPreferences <<user_preferences>> {
    +id: UUID
    +user: User
    +theme: ThemeMode
    +language: UiLanguage
    +density: UiDensity
    +fontScale: int
    +highContrast: boolean
    +reduceMotion: boolean
    +chromeBackgroundId: String
    +sizeSystem: SizeSystem
    .. +16 campos ..
  }
  class VerificationCode <<verification_codes>> {
    +id: UUID
    +user: User
    +purpose: VerificationPurpose
    +codeHash: String
    +target: String
    +expiresAt: Instant
    +consumedAt: Instant
    +attempts: int
    +sendCount: int
    +lastSentAt: Instant
  }
}
package "fai-domain (enums)" {
  enum ApprovalStatus {
    PENDENTE
    AJUSTES
    APROVADO
    RECUSADO
    SUSPENSO
  }
  enum AccountStatus {
    PENDING_EMAIL_VERIFICATION
    ACTIVE
    PENDING_VALIDATION
    SUSPENDED
    DELETION_SCHEDULED
    DELETED
  }
  enum ProfileType {
    PESSOAL
    MARCA
    CELEBRIDADE
    ADMIN
  }
  enum ThemeMode {
    LIGHT
    DARK
    AUTO
  }
  enum UiLanguage {
    PT_BR
    EN
    ES
  }
  enum MannequinSex {
    MASCULINO
    FEMININO
  }
}
package "fai-application" {
  class IdentityService <<service>> {
    +register()
    +preRegistrationUpload()
    +usernameSuggestions()
    +suggestUsername()
    +verifyEmail()
    +resendEmailVerification()
  }
}
IdentityService ..> BrandProfile : usa
IdentityService ..> CelebrityProfile : usa
IdentityService ..> RefreshToken : usa
IdentityService ..> User : usa
IdentityService ..> UserPreferences : usa
IdentityService ..> VerificationCode : usa
BrandProfile "1" --> "1" User : owner
BrandProfile --> ApprovalStatus
CelebrityProfile "1" --> "1" User : owner
CelebrityProfile --> ApprovalStatus
RefreshToken "*" --> "1" User : user
User --> AccountStatus
User --> ProfileType
UserPreferences "1" --> "1" User : user
UserPreferences --> MannequinSex
UserPreferences --> ThemeMode
UserPreferences --> UiLanguage
VerificationCode "*" --> "1" User : user
@enduml
