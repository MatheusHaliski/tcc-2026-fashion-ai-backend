@startuml RF1_Sequencia
title RF1 — Cadastrar conta na plataforma (Pessoal, Marca ou Celebridade)\nDiagrama de sequência — cadastro, envio de imagens e confirmação do e-mail
skinparam backgroundColor #FFFFFF
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
}
autonumber
actor "Pessoa" as P
participant "register/page.tsx\nverify-email/page.tsx\n(PhotoPicker)" as FE
participant "BFF\n/bff/auth/[action]" as BFF
participant "AuthRateLimitFilter\n(limite por IP)" as RLF
participant "AuthController" as AC
participant "PreferencesController" as PC
participant "IdentityService" as IS
participant "MediaStoragePort\n(S3 / local)" as ST
participant "EmailSenderPort\n(Resend)" as EM
participant "NotificationService" as NS
participant "IssuerReviewService" as IRS
database "MySQL" as DB

P -> FE: escolhe o tipo de perfil e preenche o formulário
opt foto de perfil, logo, foto oficial, documento ou comprovante
  FE -> RLF: POST /api/auth/uploads?kind=avatar|logo|official-photo|identity|activity-proof
  RLF -> AC: até 40 envios/h por IP (senão 429 MUITAS_TENTATIVAS)
  AC -> IS: preRegistrationUpload(bytes, kind, ip)
  alt tipo fora da lista · mais de 8 MB · 30 envios/h por IP
    IS --> FE: 400 TIPO_INVALIDO · 400 ARQUIVO_GRANDE · 429 LIMITE_ENVIOS
  else imagem aceita
    IS -> ST: put("pending/{uuid}/{kind}.jpg" ou "restricted/pending/{uuid}/{kind}.jpg")
    AC --> FE: 201 {url, kind, width, height}
  end
end
FE -> PC: GET /api/usernames/{username}/availability
PC --> FE: 200 {username, available, suggestions}
FE -> BFF: POST /bff/auth/register (RegisterCommand)
BFF -> RLF: POST /api/auth/register (X-Dev-Gate, IP assinado)
RLF -> AC: até 10 cadastros/h por IP · vaga no teto de hashes (senão 503 AUTENTICACAO_OCUPADA)
AC -> IS: register(cmd, ip, userAgent)
IS -> IS: validatePassword · validCnpj · termos · idade ≥ 13 · campos de MARCA/CELEBRIDADE (CA01, CA03)
IS -> ST: get(chave pendente) — confere cada envio do formulário
alt formulário inválido
  IS --> BFF: 400 FORMULARIO_INVALIDO {errors}
else e-mail já cadastrado (CA02)
  IS -> DB: existsByEmailHash(emailHash)
  IS --> BFF: 409 EMAIL_EM_USO (sem dados da conta existente)
else @ já usado
  IS --> BFF: 400 USERNAME_EM_USO {suggestions}
else cadastro aceito
  IS -> DB: INSERT users (passwordHash Argon2id, PENDING_EMAIL_VERIFICATION, PRIVATE)
  IS -> ST: put(users/{id}/profile/… | restricted/users/{id}/documents/…)
  IS -> DB: INSERT user_preferences (language, mannequinSex)
  opt MARCA ou CELEBRIDADE
    IS -> DB: INSERT brand_profiles | celebrity_profiles (PENDENTE, reviewAttempts = 1)
  end
  IS -> DB: INSERT verification_codes (EMAIL_VERIFICATION, 24 h)
  IS -> EM: send(e-mail, "Confirme seu e-mail", código de 6 dígitos)
  opt MARCA ou CELEBRIDADE
    IS -> EM: send(e-mail, "Cadastro recebido — pendente de validação") (CA06/CA09)
    IS -> IRS: submitted(userId)
    note right of IRS: aviso aos administradores só\ndepois do commit (ver RF1_Sequencia_Verificacao)
  end
  IS -> NS: notify(WELCOME) · notify(EMAIL_CONFIRMATION)
  IS -> DB: INSERT audit_log CADASTRO_CONTA · INSERT refresh_tokens (família nova, 30 dias)
  AC --> BFF: 201 Session {accessToken, refreshToken, user, status, emailVerified = false, warnings}
  BFF --> FE: 201 Session sem refreshToken + Set-Cookie fai_rt (HttpOnly, SameSite=Strict, Path=/bff/auth)
  FE -> FE: signIn (access em memória) · avisos · vai para /verify-email
end
== Confirmação do e-mail (CA05) ==
P -> FE: digita o código
FE -> AC: POST /api/auth/email-verification {code} (Bearer)
AC -> IS: verifyEmail(user, code)
IS -> DB: verification_codes (último código aberto)
alt mais de 10 tentativas por hora
  IS --> FE: 429 MUITAS_TENTATIVAS
else código expirado ou errado
  IS -> DB: attempts + 1 (o 5º erro invalida o código)
  IS --> FE: 400 CODIGO_INVALIDO (restam n) | CODIGO_EXPIRADO
else código correto
  IS -> DB: consumedAt · users.emailVerified = true
  alt PESSOAL, ou perfil já APROVADO
    IS -> DB: users.status = ACTIVE
  else MARCA ou CELEBRIDADE aguardando a análise
    IS -> DB: users.status = PENDING_VALIDATION
    IS -> IRS: emailConfirmed(user) → reviewSubmittedAt = agora (o prazo começa)
  end
  IS -> DB: audit_log EMAIL_CONFIRMADO
  AC --> FE: 200 UserCard
  FE -> FE: refreshMe · vai para /closet
end
opt reenviar o código
  FE -> AC: POST /api/auth/email-verification/resend
  AC -> IS: resendEmailVerification(user)
  alt mais de 5 reenvios no dia
    IS --> FE: 429 {resetAt}
  else
    IS -> DB: invalida os códigos abertos · INSERT verification_codes
    IS -> EM: send(novo código)
    AC --> FE: 202
  end
end
@enduml
