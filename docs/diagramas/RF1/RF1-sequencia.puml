@startuml RF1_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."
title RF1 — Cadastrar conta na plataforma (perfil Pessoal, Marca ou Celebridade)\nDiagrama de sequência — gerado do código em 2026-10-06 (scripts/diagramas/v5)

actor "Pessoa usuária" as U
boundary "Tela (Next.js)" as P
control "AuthController" as AuthController
participant "IdentityService" as IdentityService
participant "MediaStoragePort\n(LocalFileMediaStorage, S3MediaStorageAdapter)" as MediaStoragePort
database "MySQL" as DB_MySQL
participant "PasswordHasherPort\n(Argon2PasswordHasher)" as PasswordHasherPort
== Cadastrar conta (pessoal, marca ou celebridade) e abrir sessão ==
U -> P : Cadastrar conta (pessoal, marca ou celebridade) e…
P -> AuthController : POST /api/auth/register
AuthController -> IdentityService : register()
activate IdentityService
alt tipo inválido
IdentityService --> AuthController : 400 TIPO_INVALIDO
AuthController --> P : 400 + mensagem
end
IdentityService -> MediaStoragePort : get()
alt formulario inválido
IdentityService --> AuthController : 400 FORMULARIO_INVALIDO
AuthController --> P : 400 + mensagem
end
alt e-mail em uso
IdentityService --> AuthController : 409 EMAIL_EM_USO
AuthController --> P : 409 + mensagem
end
IdentityService -> DB_MySQL : SELECT users
alt username em uso
IdentityService --> AuthController : 400 USERNAME_EM_USO
AuthController --> P : 400 + mensagem
end
IdentityService -> IdentityService : new User()
IdentityService -> PasswordHasherPort : hash()
IdentityService -> IdentityService : profileType = ?type
IdentityService -> IdentityService : privateAccount = true
IdentityService -> IdentityService : termsAcceptedAt = set
IdentityService -> IdentityService : status = PENDING_EMAIL_VERIFICATION
IdentityService -> DB_MySQL : INSERT/UPDATE users
IdentityService -> MediaStoragePort : put()
IdentityService -> IdentityService : avatarUrl = set (×3)
IdentityService -> IdentityService : new UserPreferences()
IdentityService -> DB_MySQL : INSERT/UPDATE user_preferences
IdentityService -> IdentityService : new BrandProfile()
IdentityService -> DB_MySQL : SELECT brand_profiles
IdentityService -> IdentityService : logoUrl = set
IdentityService -> IdentityService : storeUrl = set
IdentityService -> IdentityService : activityProofUrl = set
note over IdentityService : … e mais 33 passos no código
deactivate IdentityService
IdentityService --> AuthController : resultado
AuthController --> P : 201 JSON
P --> U : atualiza a tela
@enduml
