@startuml RF1_Sequencia
title RF1 — Cadastrar conta na plataforma (perfil Pessoal, Marca ou Celebridade)\nDiagrama de sequência — endpoints reais
skinparam backgroundColor #FFFFFF
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
}
autonumber
actor "Pessoa" as P
participant "Frontend\n(auth)/register · verify-email" as FE
participant "AuthController" as AC
participant "IdentityService" as IS
participant "MediaStoragePort\n(S3 / local)" as ST
participant "EmailSenderPort\n(Resend)" as EM
participant "NotificationService" as NS
database "MySQL" as DB
actor "Administrador" as ADM
participant "AdminController" as ADC
participant "AdminService" as ADS

P -> FE: escolhe o tipo de perfil e preenche o formulário
opt foto de perfil / logo / documento / foto oficial
  FE -> AC: POST /api/auth/uploads?kind=... (multipart)
  AC -> IS: preRegistrationUpload(bytes, kind, ip)
  IS -> ST: put("pending/{uuid}/{kind}.jpg" | "restricted/pending/...")
  AC --> FE: 201 {url, kind, width, height}
end
FE -> AC: GET /api/auth/username-suggestions?name=
AC --> FE: 200 {suggested, suggestions}
FE -> AC: POST /api/auth/register (RegisterCommand: profileType, fullName,\nemail, password, confirmPassword, acceptTerms, brand | celebrity, avatarUrl, sex)
AC -> IS: register(cmd, ip, userAgent)
IS -> IS: validatePassword / validCnpj / termos / idade ≥ 13 (CA01, CA03)
alt formulário inválido
  IS --> FE: 400 FORMULARIO_INVALIDO {errors}
else e-mail já cadastrado (CA02)
  IS -> DB: existsByEmailHash
  IS --> FE: 409 EMAIL_EM_USO (sem dados da conta existente)
else cadastro aceito
  IS -> DB: INSERT users (passwordHash Argon2, status PENDING_EMAIL_VERIFICATION)
  IS -> DB: INSERT user_preferences (language, mannequinSex)
  opt MARCA ou CELEBRIDADE
    IS -> DB: INSERT brand_profiles | celebrity_profiles (PENDENTE)
    IS -> EM: send("Cadastro recebido — pendente de validação") (CA06/CA09)
  end
  IS -> ST: copia uploads pendentes para users/{id}/profile ou restricted/users/{id}/documents
  IS -> DB: INSERT verification_codes (EMAIL_VERIFICATION, 24 h)
  IS -> EM: send("Confirme seu e-mail", código de 6 dígitos)
  IS -> NS: notify(WELCOME) · notify(EMAIL_CONFIRMATION)
  IS -> DB: INSERT refresh_tokens (família nova) · audit CADASTRO_CONTA
  AC --> FE: 201 Session {accessToken, refreshToken, user, status, emailVerified=false, warnings}
end
FE -> FE: redireciona para /verify-email (CA05: acesso limitado)
P -> FE: digita o código
FE -> AC: POST /api/auth/email-verification {code}
AC -> IS: verifyEmail(user, code)
IS -> DB: verification_codes (consumedAt, attempts) · users.emailVerified = true
alt PESSOAL
  IS -> DB: users.status = ACTIVE
else MARCA / CELEBRIDADE aguardando aprovação
  IS -> DB: users.status = PENDING_VALIDATION
end
AC --> FE: 200 UserCard
ADM -> ADC: GET /api/admin/approvals
ADC -> ADS: approvals(admin)
ADC --> ADM: 200 {brands[], celebrities[]} (PENDENTE)
ADM -> ADC: POST /api/admin/approvals/{userId} {approve, notes}
ADC -> ADS: decide(admin, userId, approve, notes)
ADS -> DB: brand_profiles.approvalStatus | celebrity_profiles.verificationStatus = APROVADO | RECUSADO
opt aprovado (CA07/CA10)
  ADS -> DB: users.status = ACTIVE · ensureDefaultSeals
end
ADS -> NS: notify(ACCOUNT_APPROVAL, motivo quando recusado)
ADC --> ADM: 200 {userId, approved}
@enduml
