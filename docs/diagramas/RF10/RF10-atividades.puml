@startuml RF10_Atividades
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam activity {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  DiamondBackgroundColor #FFF5F8
  DiamondBorderColor #F08DB1
  StartColor #20A77A
  EndColor #4B5563
}
skinparam swimlane {
  BorderColor #CBC6BE
  TitleFontColor #2D2438
}
title RF10 — Possibilitar que o usuário gere recomendações de esquemas de vestimenta & de peças de roupa através da aba 'Copilot'\nDiagrama de atividades — gerado do código em 2026-10-06 (scripts/diagramas/v5)

|Pessoa usuária|
start
:Abre /autopilot, /copilot,\n/u/[username];
|Tela (Next.js)|
:Carrega os dados da tela\nGET /api/copilot/suggestions\nGET /api/copilot/context\nGET /api/me/daily-looks/pending-feedback\nGET /api/autopilot/weeks/current;
|Pessoa usuária|
:Perguntar ao Copilot (roteamento de\nintenção, chips de peça…;
|Tela (Next.js)|
:POST /api/copilot/messages;
|API (Spring Boot)|
:AutopilotController.ask\n→ CopilotService.ask;
if (mensagem vazia?) then (sim)
  :400 MENSAGEM_VAZIA\n«Escreva o que você precisa.»\n→ a tela mostra o aviso;
  stop
endif
if (acervo insuficiente?) then (sim)
  :422 ACERVO_INSUFICIENTE\n«Cadastre ao menos 3 peças\ndisponíveis.»\n→ a tela mostra o aviso;
  stop
endif
if (acervo insuficiente?) then (sim)
  :422 ACERVO_INSUFICIENTE\n«O Copilot precisa de ao menos 3\npeças disponíveis para sugerir\nlooks. Cadastre suas peças.»\n→ a tela mostra o aviso;
  stop
endif
|Dados e serviços|
:Lê: style_dna\nschemes\nscheme_items\nwardrobe_items\nuser_preferences;
:Usa: RoomService.locateAll\nRoomService.locate\nHypeQueryService.currentOf\nHypeQueryService.config\nRoomService.lastDiaryDates\nInventoryScoreService.improvementHints (+8);
:IA: COPILOT;
:Estado: category → ?cat\ndisponivel → true\navailabilityStatus → AVAILABLE;
|Tela (Next.js)|
:Atualiza a tela com a resposta;
|Pessoa usuária|
if (Faz outra ação?) then (sim)
  switch (Qual?)
  case (Planejar a semana [um look por di…)
    :POST /api/autopilot/weeks\n→ AutopilotService.planWeek\nvalida: ACERVO_INSUFICIENTE\nlê: week_plans, users, wardrobe_items …\nusa: WardrobeService.eligible,\nWeatherService.resolve,\nLookScorer.scoreLooks\ngrava: week_plans, week_plan_days;
  case (Aceitar um look sugerido pelo Cop…)
    :POST /api/copilot/looks\n→ CopilotService.accept\nusa: AutopilotService.createScheme,\nDailyLookService.register,\nDailyLookService.view;
  case (Sugerir o look de hoje [ocasião,…)
    :POST /api/autopilot/daily\n→ AutopilotService.daily\nusa: InsightService.itemsOrEmpty;
  case (Confirmar a sugestão como esquema…)
    :POST /api/autopilot/daily/confirmation\n→ AutopilotService.confirmDaily\nusa: DailyLookService.register,\nDailyLookService.view;
  case (Trocar as peças de um dia)
    :PUT /api/autopilot/days/{dayId}\n→ AutopilotService.editDay\nvalida: COMBINACAO_REPETIDA, SEM_PECAS\nlê: week_plan_days, wardrobe_items\nusa: Guard.requireOwner, LookScorer.scoreLooks\ngrava: week_plan_days;
  endswitch
  note right
  Outras ações deste RF:
  Feedback do look (ADOREI / OK…, Usar o look do dia
  planejado…, Descartar a semana planejada
  end note
  |Tela (Next.js)|
  :Atualiza a tela;
endif
|Pessoa usuária|
stop
@enduml
