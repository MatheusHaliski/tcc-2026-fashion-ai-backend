@startuml RF10_Classes
title RF10 — Possibilitar que o usuário gere recomendações de esquemas de vestimenta & de peças de roupa através da aba "Copilot"\nDiagrama de classes — entidades JPA reais (fai-domain) e enums
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  HeaderBackgroundColor #E4DEF0
}
skinparam packageStyle rectangle
hide empty methods

package "fai-domain · model" {
class User {
  +username: String
  +displayName: String
}
class WardrobeItem {
  +user: User
  +name: String
  +category: String
  +subcategory: String
  +color: String
  +material: String
  +styleTags: String
  +occasionTags: String
  +disponivel: boolean
  +availabilityStatus: AvailabilityStatus
  +wearCount: int
  +lastWornDate: LocalDate
}
class Scheme {
  +user: User
  +title: String
  +occasion: String
  +style: String
  +origin: SchemeOrigin
  +status: SchemeStatus
  +favorite: boolean
  +lookDoDiaCount: int
  +hypeScore: BigDecimal
}
class WeekPlan {
  +user: User
  +weekStart: LocalDate
  +status: WeekPlanStatus
  +gapsJson: String
}
class WeekPlanDay {
  +weekPlan: WeekPlan
  +dayDate: LocalDate
  +eventLabel: String
  +occasion: String
  +scheme: Scheme
  +pieceIdsJson: String
  +combinationKey: String
  +rationale: String
  +editedManually: boolean
}
class DailyLook {
  +user: User
  +scheme: Scheme
  +source: DailyLookSource
  +weekPlanDayId: UUID
}
class PieceUsageDiaryEntry {
  +wardrobeItemId: UUID
  +userId: UUID
  +usedOn: LocalDate
  +occasion: String
  +source: String
  +schemeId: UUID
}
class HypeScoreCurrent <<RF49>> {
  +entityType: HypeEntityType
  +entityId: UUID
  +ownerId: UUID
  +algorithmVersion: String
  +status: HypeStatus
  +score: BigDecimal
  +dimensions: HypeDimensions
  +deltaPoints: BigDecimal
  +publicEligible: boolean
}
}
package "fai-domain · enums" {
enum WeekPlanStatus {
  ACTIVE
  DISCARDED
  COMPLETED
}
enum SchemeOrigin {
  CRIAR_LOOK
  PROVADOR
  REMIX
  COPILOT
  DNA_DUPLICATE
  SMART_MIRROR
  VISTA_ME
  AUTOPILOTO
}
enum DailyLookSource {
  MANUAL
  AUTOPILOTO
  COPILOT
  VISTA_ME
  SMART_MIRROR
}
}
package "fai-application · service" {
class CopilotService {
  +context(user, view, selection, city, lat, lon)
  +suggestions(user, city, lat, lon)
  +ask(user, AskRequest)
  +accept(user, pieceIds, title, occasion, style, mood, season, description, background)
  ~hypeAnswer(user, message) <<RF49>>
  ~scoreLooks(user, cards, mode) <<RF49>>
}
class "CopilotService.AskRequest" as AskRequest <<record>> {
  +message: String
  +view: String
  +selection: List<UUID>
  +occasion: List<String>
  +mood: String
  +city: String
  +latitude: Double
  +longitude: Double
  +excludeKeys: List<String>
  +mode: String <<RF49>>
}
class CopilotLexicon {
  {static} +matches(vocab, message)
  {static} +first(vocab, message)
  {static} +weatherBand(message)
  {static} +seasonOfBand(band)
}
class WeatherService {
  +resolve(lat, lon, city): Context
  {static} +band(t)
  {static} +season(t)
  {static} +unsuitable(subcategory, band)
}
class AutopilotService {
  +daily(user, DailyRequest)
  +planWeek(user, WeekRequest)
  +currentWeek(user)
  +editDay(user, dayId, pieceIds)
  +useDay(user, dayId)
  +discardWeek(user)
}
}
package "fai-application · hype <<RF49>>" {
class HypeQueryService {
  +currentOf(type, ids): Map<UUID, HypeScoreCurrent>
  +wardrobe(user)
}
class RecommendationScoring {
  {static} WEIGHTS: Map<Mode, double[]>
  {static} +rankValue(mode, Scores): double
  {static} +novelty(pieces, seenPairs): Integer
  {static} +reuse(idleDays): Integer
  {static} +pair(a, b): String
}
enum "RecommendationScoring.Mode" as Mode {
  SAFE
  DISCOVERY
  EXPERIMENTAL
  {static} +parse(raw)
}
class "RecommendationScoring.Scores" as Scores <<record>> {
  +compatibility: Integer
  +hype: Integer
  +novelty: Integer
  +reuse: Integer
}
class StyleCompatibility {
  {static} +score(dna, item): Map
  {static} +profile(styles, colors, occasions): Profile
}
}
WardrobeItem "*" --> "1" User : user
Scheme "*" --> "1" User : user
Scheme --> SchemeOrigin
WeekPlan "*" --> "1" User : user
WeekPlan --> WeekPlanStatus
WeekPlanDay "*" --> "1" WeekPlan : weekPlan
WeekPlanDay "*" --> "0..1" Scheme : scheme
DailyLook "*" --> "1" Scheme : scheme
DailyLook --> DailyLookSource
PieceUsageDiaryEntry ..> WardrobeItem : wardrobeItemId
CopilotService ..> CopilotLexicon
CopilotService ..> WeatherService
CopilotService ..> AutopilotService : createScheme (COPILOT)
CopilotService ..> WardrobeItem : eligible / forgotten
AutopilotService ..> WeekPlan
AutopilotService ..> WeekPlanDay
AutopilotService ..> DailyLook
AskRequest ..> Mode : mode (parse)
CopilotService ..> AskRequest
CopilotService ..> HypeQueryService : currentOf (HYPE, scoreLooks,\ntrendingLooks)
CopilotService ..> RecommendationScoring : scoreLooks
CopilotService ..> StyleCompatibility : DNA × peça/look
RecommendationScoring ..> Mode
RecommendationScoring ..> Scores
HypeQueryService ..> HypeScoreCurrent
note top of WeekPlan : tabela week_plans
note top of WeekPlanDay : tabela week_plan_days
note top of DailyLook : tabela daily_looks
note top of PieceUsageDiaryEntry : tabela piece_usage_diary\n(gravada por WardrobeEventListeners; base de "peças esquecidas")
note top of WardrobeItem : tabela wardrobe_items
note top of HypeScoreCurrent : tabela hype_scores\nnovo (RF49 · HypeScore v2)
note bottom of Mode : pesos [compat, hype, novidade, reuso]\nSAFE 0,60/0,10/0,10/0,20\nDISCOVERY 0,35/0,20/0,25/0,20\nEXPERIMENTAL 0,15/0,20/0,45/0,20\nparse aceita SEGURO · DESCOBERTA · EXPERIMENTAL
@enduml
