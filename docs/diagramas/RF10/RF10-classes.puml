@startuml RF10_Classes
title RF10 — Gerar recomendações de esquemas e peças na aba Copilot\nDiagrama de classes — CopilotService, intenções, LookScorer/RecommendationScoring (seis números, três modos) e HypeScore v2 como contexto
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  HeaderBackgroundColor #E4DEF0
}
skinparam packageStyle rectangle
hide empty methods

package "fai-application · service" {
  class CopilotService {
    {static} +MIN_PIECES = 3
    +context(user, view, selection, city, lat, lon): Map
    +suggestions(user, city, lat, lon): Map
    +ask(user, AskRequest): Map
    +accept(user, pieceIds, title, occasion, style, mood,\nseason, description, background): Map
    {static} ~intent(message): Intent
    ~looks(user, req, message): Map
    ~hypeAnswer(user, message): Map
    ~scoreLooks(user, cards, Mode): List<Map>
    ~general(user, message, view): Map
    ~whereIs() · forgotten() · different() · diagnosis() · improveInventory(): Map
  }
  class "CopilotService.AskRequest" as AskRequest <<record>> {
    +message: String
    +view: String
    +selection: List<UUID>
    +occasion: List<String>
    +mood: String
    +city: String
    +latitude: Double
    +longitude: Double
    +excludeKeys: List<String>
    +mode: String
  }
  enum "CopilotService.Intent" as Intent {
    WHERE_IS
    HYPE
    FORGOTTEN
    DIFFERENT
    IMPROVE_INVENTORY
    DIAGNOSIS
    LOOKS
    GENERAL
  }
  class CopilotLexicon {
    {static} ~matches(vocabulary, text): List<String>
    {static} ~weatherBand(text): String
    {static} ~seasonOfBand(band): String
    {static} ~signalsLook(text): boolean
  }
  class LookScorer {
    ~context(userId): Context
    ~hypeOf(pieceIds): Map<UUID, HypeScoreCurrent>
    {static} ~scores(ctx, ids, look, hypeById): Scores
    ~scoreLooks(userId, looks): List<Scores>
    ~scoreCards(user, cards, Mode): List<Map>
  }
  class "LookScorer.Context" as LSContext <<record>> {
    +userId: UUID
    +dna: StyleCompatibility.Profile
    +seenPairs: Set<String>
    +today: LocalDate
  }
  class AutopilotService {
    {static} +MIN_PIECES = 3
    +daily(user, DailyRequest, requiredPieceIds, weatherBand): Map
    ~createScheme(user, pieceIds, title, occasion, origin,\nstyle, mood, season, description, background): Scheme
  }
  class DailyLookService {
    +register(user, scheme, source, date): DailyLook
    +view(dailyLook): Map
  }
  class WeatherService {
    +resolve(latitude, longitude, city): Context
    {static} +band(t): String
    {static} +unsuitable(subcategory, band): boolean
    {static} +isLayer(subcategory): boolean
  }
  class RoomService {
    {static} +FORGOTTEN_DAYS = 60
    {static} +forgotten(piece, last, today): boolean
    +locateAll(userId): Map<UUID, Location>
  }
}

package "fai-application · hype" {
  class RecommendationScoring <<final>> {
    {static} ~WEIGHTS: Map<Mode, double[6]>
    {static} +rankValue(Mode, Scores): double
    {static} +pair(a, b): String
    {static} +novelty(pieces, seenPairs): Integer
    {static} +reuse(idleDays): Integer
    {static} +usage(wearCounts): Integer
    {static} +sustainability(wearCounts, owned, total): Integer
  }
  enum "RecommendationScoring.Mode" as Mode {
    SAFE
    DISCOVERY
    EXPERIMENTAL
    {static} +parse(raw): Mode
  }
  class "RecommendationScoring.Scores" as Scores <<record>> {
    +compatibility: Integer
    +hype: Integer
    +novelty: Integer
    +reuse: Integer
    +usage: Integer
    +sustainability: Integer
    +toMap(): Map
  }
  class StyleCompatibility {
    {static} +profile(styles, colors, occasions): Profile
    {static} +score(dna, item): Map
  }
  class HypeQueryService {
    +currentOf(type, ids): Map<UUID, HypeScoreCurrent>
    +wardrobe(user): Map
    {static} +profileOf(StyleDna | WardrobeItem): Profile
    {static} +idleDays(piece, today): long
  }
}

package "fai-application · insights" {
  class InsightService {
    +itemsOrEmpty(user, InsightContext.COPILOT): List<Map>
  }
}

package "fai-domain" {
  class WardrobeItem <<table wardrobe_items>> {
    +subcategory: String
    +color: String
    +styleTags: String
    +occasionTags: String
    +disponivel: boolean
    +availabilityStatus: AvailabilityStatus
    +wearCount: int
    +lastWornDate: LocalDate
  }
  class Scheme <<table schemes>> {
    +title: String
    +origin: SchemeOrigin
    +creationMode: CreationMode
    +favorite: boolean
    +lookDoDiaCount: int
  }
  class StyleDna <<table style_dna>> {
    +styleKeywords: String
  }
  class DailyLook <<table daily_looks>> {
    +lookDate: LocalDate
    +source: DailyLookSource
  }
  class HypeScoreCurrent <<table hype_scores>> {
    +entityType: HypeEntityType
    +score: BigDecimal
    +dimensions: HypeDimensions
    +deltaPoints: BigDecimal
    +signalsJson: String
    +publicEligible: boolean
  }
  enum SchemeOrigin {
    CRIAR_LOOK
    PROVADOR
    REMIX
    COPILOT
    DNA_DUPLICATE
    SMART_MIRROR
    VISTA_ME
    AUTOPILOTO
  }
  enum DailyLookSource {
    MANUAL
    AUTOPILOTO
    COPILOT
    VISTA_ME
    SMART_MIRROR
  }
}

CopilotService ..> AskRequest
CopilotService ..> Intent
CopilotService ..> CopilotLexicon
CopilotService *-- "1" LookScorer : cria (mesma régua\ndo Autopiloto)
CopilotService --> AutopilotService : daily (LOOKS) · createScheme (aceite)
CopilotService --> DailyLookService : register(COPILOT)
CopilotService --> WeatherService
CopilotService --> RoomService : esquecidas · endereço
CopilotService --> HypeQueryService : currentOf (HYPE, em alta)
CopilotService --> InsightService
CopilotService ..> StyleCompatibility : DNA × peça (HYPE)
AskRequest ..> Mode : mode (parse)
LookScorer ..> LSContext
LookScorer --> HypeQueryService : currentOf(PIECE)
LookScorer ..> RecommendationScoring
LookScorer ..> StyleCompatibility
RecommendationScoring ..> Mode
RecommendationScoring ..> Scores
HypeQueryService ..> HypeScoreCurrent : lê
LSContext ..> StyleDna : perfil do DNA
Scheme --> SchemeOrigin
DailyLook "*" --> "1" Scheme : scheme
DailyLook --> DailyLookSource
LookScorer ..> WardrobeItem : wearCount · lastWornDate

note bottom of Mode
  Pesos [compat, hype, novidade, reuso, uso, sustent.]
  SAFE .50/.10/.05/.10/.15/.10
  DISCOVERY .30/.20/.20/.10/.10/.10
  EXPERIMENTAL .15/.20/.40/.10/.05/.10
  parse aceita SEGURO · DESCOBERTA · EXPERIMENTACAO;
  valor desconhecido = sem modo (ordem do motor)
end note
note bottom of Scores
  0–100 cada; nulo = sem base (sem DNA,
  peças sem Hype). Na ordenação, nulo = 50.
  Hype do look = média do Hype v2 das peças.
end note
note top of Intent
  HYPE = HYPE_QUESTION e não BUILD_REQUEST
  ("monte um look em alta" é LOOKS)
end note
@enduml
