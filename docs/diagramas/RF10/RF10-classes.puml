package "fai-domain (enums)" {
  enum HypeStatus {
    AVAILABLE
    INSUFFICIENT_DATA
  }
  enum SchemeStatus {
    DRAFT
    PUBLISHED
    ARCHIVED
  }
  enum RenderStatus {
    PENDING
    RENDERING
    ENHANCING
    COMPOSITING
    CACHED
    COMPLETED
    FAILED
  }
  enum AccountStatus {
    PENDING_EMAIL_VERIFICATION
    ACTIVE
    PENDING_VALIDATION
    SUSPENDED
    DELETION_SCHEDULED
    DELETED
  }
  enum AvailabilityStatus {
    AVAILABLE
    UNAVAILABLE
    ARCHIVED
  }
  enum ModerationStatus {
    PENDING
    APPROVED
    REJECTED_POLICY
    REJECTED_NOT_CLOTHING
  }
}
package "fai-application" {
  class AutopilotService <<service>> {
    +daily()
    +confirmDaily()
    +planWeek()
    +currentWeek()
    +editDay()
    +useDay()
    +discardWeek()
  }
}
AutopilotService ..> Scheme : usa
AutopilotService ..> User : usa
AutopilotService ..> WardrobeItem : usa
AutopilotService ..> WeekPlan : usa
AutopilotService ..> WeekPlanDay : usa
DailyLook "*" --> "1" Scheme : scheme
DailyLook "*" --> "1" User : user
HypeScoreCurrent --> HypeStatus
HypeScoreCurrent ..> User : ownerId
PieceUsageDiaryEntry ..> Scheme : schemeId
PieceUsageDiaryEntry ..> User : userId
PieceUsageDiaryEntry ..> WardrobeItem : wardrobeItemId
Scheme "*" --> "1" User : user
Scheme --> RenderStatus
Scheme --> SchemeStatus
User --> AccountStatus
WardrobeItem "*" --> "1" User : user
WardrobeItem --> AvailabilityStatus
WardrobeItem --> ModerationStatus
WeekPlan "*" --> "1" User : user
WeekPlanDay "*" --> "1" Scheme : scheme
WeekPlanDay "*" --> "1" WeekPlan : weekPlan
@enduml
