@startuml RF10_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF10 — Possibilitar que o usuário gere recomendações de esquemas de vestimenta & de peças de roupa através da aba 'Copilot'\nDiagrama de componentes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "Frontend (Next.js)" {
  component "/autopilot\n(site)/(app)/autopilot/page.tsx" as FE0
  component "/copilot\n(site)/(app)/copilot/page.tsx" as FE1
  component "/u/[username]\n(site)/(app)/u/[username]/page.tsx" as FE2
  component "lib/api/client.ts" as APIC
}
package "fai-web (REST)" {
  component "AutopilotController\n/api/autopilot/daily\n/api/autopilot/daily/confirmation\n/api/autopilot/days/{…}\n/api/autopilot/days/{…}/use\n(+6 rotas)" as AutopilotController
  component "HypeController\n/api/hype/looks/{…}\n/api/hype/ranking\n/api/me/hype/wardrobe" as HypeController
  component "LookbookController\n/api/me/daily-looks/pending-feedback\n/api/me/daily-looks/{…}/feedback" as LookbookController
}
package "fai-application (casos de uso)" {
  component "AutopilotService" as AutopilotService
  component "CopilotService" as CopilotService
  component "HypeQueryService" as HypeQueryService
  component "DailyLookService" as DailyLookService
  component "WardrobeService" as WardrobeService <<apoio>>
  component "SchemeService" as SchemeService <<apoio>>
  component "PreferenceModel" as PreferenceModel <<apoio>>
  component "WeatherService" as WeatherService <<apoio>>
  component "InsightService" as InsightService <<apoio>>
  component "RoomService" as RoomService <<apoio>>
  component "MirrorService" as MirrorService <<apoio>>
  component "InventoryScoreService" as InventoryScoreService <<apoio>>
}
package "fai-domain (repositórios)" {
  component "WardrobeItemRepository\nSchemeRepository\nSchemeItemRepository\nWeekPlanRepository\nWeekPlanDayRepository\nUserRepository\nUserPreferencesRepository\nStyleDnaRepository\nDailyLookRepository\nHypeScoreCurrentRepository\n(+2)" as REPO_MySQL
}
database "MySQL\n• brand_profiles\n• daily_looks\n• hype_score_snapshots\n• hype_scores\n• scheme_items\n• schemes\n• style_dna\n• user_preferences\n• users\n• wardrobe_items\n• week_plan_days\n• week_plans" as DB_MySQL
cloud "Motor de IA (RF24)\nprovedores externos + reserva local" as AI
component "Eventos de domínio\n(@TransactionalEventListener)" as EV
APIC --> AutopilotController : HTTPS/JSON
APIC --> HypeController : HTTPS/JSON
APIC --> LookbookController : HTTPS/JSON
AutopilotController --> AutopilotService
AutopilotController --> CopilotService
AutopilotService --> AI
AutopilotService --> REPO_MySQL
AutopilotService ..> DailyLookService
AutopilotService ..> HypeQueryService
AutopilotService ..> InsightService
AutopilotService ..> PreferenceModel
AutopilotService ..> SchemeService
AutopilotService ..> WardrobeService
AutopilotService ..> WeatherService
CopilotService --> AI
CopilotService --> REPO_MySQL
CopilotService ..> AutopilotService
CopilotService ..> DailyLookService
CopilotService ..> HypeQueryService
CopilotService ..> InsightService
CopilotService ..> InventoryScoreService
CopilotService ..> MirrorService
CopilotService ..> RoomService
CopilotService ..> SchemeService
CopilotService ..> WardrobeService
CopilotService ..> WeatherService
DailyLookService --> EV
DailyLookService --> REPO_MySQL
FE0 --> APIC
FE1 --> APIC
FE2 --> APIC
HypeController --> HypeQueryService
HypeQueryService --> REPO_MySQL
HypeQueryService ..> SchemeService
HypeQueryService ..> WardrobeService
LookbookController --> DailyLookService
REPO_MySQL --> DB_MySQL : JPA/Flyway
@enduml
