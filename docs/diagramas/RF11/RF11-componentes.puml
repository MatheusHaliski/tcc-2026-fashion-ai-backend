@startuml RF11_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF11 — Compor a arte de fundo (Background Studio) do card de um esquema ou de uma peça\nDiagrama de componentes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "Frontend (Next.js)" {
  component "/dna-schemes/[id]/edit\n(site)/(app)/dna-schemes/[id]/edit/page.tsx" as FE0
  component "/dna-schemes/new\n(site)/(app)/dna-schemes/new/page.tsx" as FE1
  component "/dna\n(site)/(app)/dna/page.tsx" as FE2
  component "/pieces/new\n(site)/(app)/pieces/new/page.tsx" as FE3
  component "/schemes/[id]/edit\n(site)/(app)/schemes/[id]/edit/page.tsx" as FE4
  component "/schemes/new\n(site)/(app)/schemes/new/page.tsx" as FE5
  component "lib/api/client.ts" as APIC
}
package "fai-web (REST)" {
  component "BackgroundController\n/api/admin/skins/{…}/thumbnail\n/api/assets/mosaics\n/api/assets/skins\n/api/backgrounds/art\n(+6 rotas)" as BackgroundController
  component "SchemeController\n/api/schemes\n/api/schemes/builder\n/api/schemes/preview\n/api/schemes/{…}\n(+1 rotas)" as SchemeController
}
package "fai-application (casos de uso)" {
  component "BackgroundStudioService" as BackgroundStudioService
  component "AssetCatalogService" as AssetCatalogService
  component "SchemeService" as SchemeService
  component "MediaService" as MediaService <<apoio>>
  component "WardrobeService" as WardrobeService <<apoio>>
  component "SealService" as SealService <<apoio>>
  component "SchemeCardRenderer" as SchemeCardRenderer <<apoio>>
  component "ProjectionService" as ProjectionService <<apoio>>
  component "NotificationService" as NotificationService <<apoio>>
  component "DailyLookService" as DailyLookService <<apoio>>
  component "HypeScoreConfig" as HypeScoreConfig <<apoio>>
  component "CounterStorePort\n«InMemoryCounterStore»" as CounterStorePort <<port>>
}
package "fai-domain (repositórios)" {
  component "AssetPresetRepository\nSchemeRepository\nWardrobeItemRepository\nUserRepository\nCelebrityProfileRepository\nSchemeItemRepository\nReactionRepository\nSavedItemRepository\nStyleDnaRepository\nHypeScoreCurrentRepository" as REPO_MySQL
}
database "MySQL\n• asset_presets\n• celebrity_profiles\n• hype_scores\n• reactions\n• saved_items\n• scheme_items\n• schemes\n• style_dna\n• users\n• wardrobe_items" as DB_MySQL
cloud "Motor de IA (RF24)\nprovedores externos + reserva local" as AI
component "Eventos de domínio\n(@TransactionalEventListener)" as EV
APIC --> BackgroundController : HTTPS/JSON
APIC --> SchemeController : HTTPS/JSON
AssetCatalogService --> REPO_MySQL
BackgroundController --> AssetCatalogService
BackgroundController --> BackgroundStudioService
BackgroundStudioService --> AI
BackgroundStudioService --> REPO_MySQL
BackgroundStudioService ..> AssetCatalogService
BackgroundStudioService ..> MediaService
FE0 --> APIC
FE1 --> APIC
FE2 --> APIC
FE3 --> APIC
FE4 --> APIC
FE5 --> APIC
REPO_MySQL --> DB_MySQL : JPA/Flyway
SchemeController --> SchemeService
SchemeService --> AI
SchemeService --> CounterStorePort
SchemeService --> EV
SchemeService --> REPO_MySQL
SchemeService ..> BackgroundStudioService
SchemeService ..> DailyLookService
SchemeService ..> HypeScoreConfig
SchemeService ..> MediaService
SchemeService ..> NotificationService
SchemeService ..> ProjectionService
SchemeService ..> SchemeCardRenderer
SchemeService ..> SealService
SchemeService ..> WardrobeService
@enduml
