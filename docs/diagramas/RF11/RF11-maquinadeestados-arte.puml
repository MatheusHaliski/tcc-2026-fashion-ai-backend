@startuml RF11_MaquinaDeEstados_Arte
!pragma layout smetana
title RF11 — Arte do card do esquema (Scheme · containerOrigin): do padrão ao rascunho do modal e à arte aplicada
skinparam backgroundColor #FFFFFF
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  ArrowColor #52606D
}
state "Padrão\n(#F4F2EF, sem arte, NONE)" as Padrao
state "Rascunho no modal\n(só no frontend, nada gravado)" as Rascunho
state "Aplicada" as Aplicada {
  state "INDEFINIDA" as Indef
  state "MANUAL" as Manual
  state "AUTO\n(containerMandatory = true)" as Auto
}

[*] --> Padrao : esquema criado sem fundo
Padrao --> Rascunho : abre o Background Studio\n(etapa 4 ou "Editar arte")
Aplicada --> Rascunho : reabre o Background Studio
Rascunho --> Rascunho : modos 1 · 2 · 3 em qualquer ordem\nPOST /api/backgrounds/art · uploads\nPOST /api/schemes/preview
Rascunho --> Padrao : cancelar (0 pedidos)
Rascunho --> Indef : salvar sem cor de container\nPOST/PUT /api/schemes · PUT /api/schemes/{id}/background
Rascunho --> Manual : salvar com container.color
Rascunho --> Auto : salvar com applyRecommendedDirection = true
Manual --> Indef : container.color vazio
Auto --> Auto : cor diferente no container\n409 CONTAINER_TRAVADO
Aplicada --> Padrao : DELETE /api/schemes/{id}/background\n(resetScheme — CA05)

note right of Auto
  A direção recomendada define cardSkin e a cor
  nativa do container; resetScheme mantém o
  container travado (containerMandatory)
end note
note left of Rascunho
  Peça (modo 3): PUT /api/pieces/{id}/background
  grava backgroundConfigJson com rev + 1;
  baseRev antigo → 409 ARTE_ALTERADA
end note
@enduml
