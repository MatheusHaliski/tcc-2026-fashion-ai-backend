@startuml RF12_MaquinaDeEstados_ItemLote
!pragma layout smetana
title RF12 — Visualizar & Editar a página "Minhas Fotos" & Adicionar mais de uma peça por vez dentro do sistema\nDiagrama de máquina de estados — item de "várias peças": rascunho (PipelineJob) até a peça cadastrada e o reprocessamento
skinparam backgroundColor #FFFFFF
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  ArrowColor #52606D
}
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
}

state "Foto enviada\n(lote ≤ 12 ou peça detectada\nnuma foto MULTI_PIECE_DRAFT)" as Env
state "Recusada\n(Draft.rejection {code, message}\nou 400 CONTEUDO_BLOQUEADO)" as Rec
state "Rascunho pronto\nPipelineJob PIECE_DRAFT · COMPLETED\n(targetType PIECE_DRAFT)" as Rasc
state "Peça cadastrada\n(PipelineJob targetType = PIECE,\ninputResourceId = peça)" as Cad {
  state "Com recorte\nphotoProcessingStatus = COMPLETED" as ComRec
  state "Sem recorte\nphotoProcessingStatus = PROCESSING" as SemRec
}
state "Reprocessamento\n(PipelineJob PIECE_REPROCESS)" as Rep {
  state "PENDING\n(fila jobs:flatlay-reprocess)" as Pend
  state "RUNNING" as Run
  state "COMPLETED" as Ok
  state "FAILED" as Fail
}

[*] --> Env : POST /api/pieces/analysis/batch\nou /analysis/multi/{draftId}/pieces?index=n
Env --> Rec : critérios de aceite da foto (FOTO_RECUSADA)\nou moderação REJECTED_POLICY
Env --> Rasc : Flat Lay + análise + moderação ok
Rasc --> Rasc : revisão (MultiPieceReview)\ncópia por IA: …/ai-images/{aiImageId}/piece
Rasc --> [*] : linha excluída na revisão\n(nada entra no Closet)
Rasc --> ComRec : POST /api/pieces {draftId}\n(backgroundRemoved = true)
Rasc --> SemRec : POST /api/pieces {draftId}\n(backgroundRemoved = false)
Rec --> [*] : a pessoa troca a foto
SemRec --> Pend : createInternal: INSERT pipeline_jobs\n+ JobQueuePort.enqueue (RF4.CA06)
SemRec --> ComRec : POST /api/pieces/{id}/background-removal\nou PUT /api/pieces/{id}/image (RF4/RF15)
Pend --> Run : reprocessPending()\n(provedor remoto e cota livres)
Run --> Ok : fundo removido → peça COMPLETED,\nestúdio oferecido, notificação AI_JOB_FINISHED
Run --> Pend : sem recorte e attempts < 3
Run --> Fail : attempts ≥ 3 ou SEM_ORIGINAL
Ok --> ComRec
ComRec --> [*]
Fail --> [*]

note right of Pend
  Ninguém chama reprocessPending() hoje
  (sem @Scheduled nem consumidor da fila):
  o item fica PENDING até a pessoa remover
  o fundo sob demanda ou trocar a foto.
end note
note left of Rasc
  RENDERING, ENHANCING, COMPOSITING e
  CANCELLED existem em PipelineJobStatus,
  mas não são usados neste fluxo.
end note
@enduml
