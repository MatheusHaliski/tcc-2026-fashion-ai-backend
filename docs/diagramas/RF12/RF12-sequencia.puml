@startuml RF12_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."
title RF12 — Visualizar & Editar a página 'Minhas Fotos' & Adicionar mais de uma peça por vez dentro do sistema\nDiagrama de sequência — gerado do código em 2026-10-06 (scripts/diagramas/v5)

actor "Pessoa usuária" as U
boundary "Tela /photos" as P
control "PhotoController" as PhotoController
participant "PhotoService" as PhotoService
database "MySQL" as DB_MySQL
== Minhas fotos com filtros (origem, ocasião, estilo, cor, mês, período)… ==
U -> P : Minhas fotos com filtros (origem, ocasião, estilo…
P -> PhotoController : GET /api/me/photos
PhotoController -> PhotoService : gallery()
activate PhotoService
PhotoService -> DB_MySQL : SELECT photos
PhotoService -> DB_MySQL : SELECT wardrobe_items
PhotoService -> DB_MySQL : SELECT schemes
deactivate PhotoService
PhotoService --> PhotoController : resultado
PhotoController --> P : 200 JSON
P --> U : atualiza a tela
== Excluir várias fotos ==
U -> P : Excluir várias fotos
P -> PhotoController : POST /api/photos/bulk-deletion
PhotoController -> PhotoService : bulkDelete()
activate PhotoService
PhotoService -> DB_MySQL : SELECT photos
PhotoService -> DB_MySQL : SELECT wardrobe_items (×2)
PhotoService -> PhotoService : deletedAt = set
deactivate PhotoService
PhotoService --> PhotoController : resultado
PhotoController --> P : 201 JSON
P --> U : atualiza a tela
@enduml
