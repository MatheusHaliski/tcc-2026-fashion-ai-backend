title RF13 — Criar um esquema de identidade pessoal de moda na página 'DNA de Estilo'\nDiagrama de classes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "fai-domain (entidades JPA)" {
  class DnaScheme <<dna_schemes>> {
    +id: UUID
    +user: User
    +title: String
    +identityPhrase: String
    +archetype: StyleArchetype
    +boldnessIndex: Integer
    +iconSchemeId: UUID
    +colorPaletteJson: String
    +narrativeType: NarrativeType
    +seasonalTheme: Season
    .. +25 campos ..
  }
  class DnaSchemeItem <<dna_scheme_items>> {
    +id: UUID
    +dnaScheme: DnaScheme
    +scheme: Scheme
    +cell: DnaCell
    +eraLabel: String
    +duplicate: boolean
    +sourceSchemeId: UUID
    +appliedToOriginal: boolean
    +milestone: boolean
  }
  class Scheme <<schemes>> {
    +id: UUID
    +user: User
    +originalScheme: Scheme
    +title: String
    +description: String
    +creationMode: CreationMode
    +origin: SchemeOrigin
    +style: String
    +occasion: String
    +season: Season
    .. +46 campos ..
  }
  class StyleDna <<style_dna>> {
    +id: UUID
    +user: User
    +archetype: StyleArchetype
    +boldnessIndex: int
    +identityPhrase: String
    +colorPalette: String
    +styleKeywords: String
    +occasionKeywords: String
    +iconPieceName: String
    +latestDnaSchemeId: UUID
    .. +9 campos ..
  }
  class StyleDnaVersion <<style_dna_versions>> {
    +id: UUID
    +userId: UUID
    +snapshotJson: String
  }
  class User <<users>> {
    +id: UUID
    +username: String
    +displayName: String
    +email: String
    +emailHash: String
    +emailVerified: boolean
    +phone: String
    +birthDate: String
    +passwordHash: String
    +profileType: ProfileType
    .. +24 campos ..
  }
}
package "fai-domain (enums)" {
  enum SchemeStatus {
    DRAFT
    PUBLISHED
    ARCHIVED
  }
  enum RenderStatus {
    PENDING
    RENDERING
    ENHANCING
    COMPOSITING
    CACHED
    COMPLETED
    FAILED
  }
  enum AccountStatus {
    PENDING_EMAIL_VERIFICATION
    ACTIVE
    PENDING_VALIDATION
    SUSPENDED
    DELETION_SCHEDULED
    DELETED
  }
  enum StyleArchetype {
    ROMANTIC
    DRAMATIC
    CLASSIC
    NATURAL
    GAMINE
  }
  enum NarrativeType {
    TIMELINE
    MOMENTOS_MARCANTES
    PRIMEIRA_VEZ
    CAPSULA_VERSATILIDADE
    POR_OCASIAO
    MOOD_BOARD
    PALETA_DOMINANTE
    HARMONIA_CROMATICA
    MARCAS_FAVORITAS
    HYPE_FOCUS
    ..
  }
  enum Season {
    SPRING
    SUMMER
    AUTUMN
    WINTER
  }
}
package "fai-application" {
  class DnaService <<service>> {
    +overview()
    +socialProof()
    +generate()
    +updateLife()
    +setPrivateFields()
    +setColorSeason()
    +shareCard()
    +builder()
    +preview()
    +compositions()
  }
}
DnaService ..> DnaScheme : usa
DnaService ..> DnaSchemeItem : usa
DnaService ..> Scheme : usa
DnaService ..> StyleDna : usa
DnaService ..> StyleDnaVersion : usa
DnaService ..> User : usa
DnaScheme "*" --> "1" User : user
DnaScheme --> NarrativeType
DnaScheme --> SchemeStatus
DnaScheme --> Season
DnaScheme --> StyleArchetype
DnaSchemeItem "*" --> "1" DnaScheme : dnaScheme
DnaSchemeItem "*" --> "1" Scheme : scheme
Scheme "*" --> "1" User : user
Scheme --> RenderStatus
Scheme --> SchemeStatus
Scheme --> Season
StyleDna "1" --> "1" User : user
StyleDna --> StyleArchetype
StyleDnaVersion ..> User : userId
User --> AccountStatus
