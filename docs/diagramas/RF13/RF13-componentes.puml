@startuml RF13_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF13 — Criar um esquema de identidade pessoal de moda na página 'DNA de Estilo'\nDiagrama de componentes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "Frontend (Next.js)" {
  component "/dna-schemes/[id]/edit\n(site)/(app)/dna-schemes/[id]/edit/page.tsx" as FE0
  component "/dna-schemes/new\n(site)/(app)/dna-schemes/new/page.tsx" as FE1
  component "/dna\n(site)/(app)/dna/page.tsx" as FE2
  component "lib/api/client.ts" as APIC
}
package "fai-web (REST)" {
  component "DnaController\n/api/dna-schemes\n/api/dna-schemes/builder\n/api/dna-schemes/compositions\n/api/dna-schemes/preview\n(+8 rotas)" as DnaController
}
package "fai-application (casos de uso)" {
  component "DnaService" as DnaService
  component "MediaService" as MediaService <<apoio>>
  component "NotificationService" as NotificationService <<apoio>>
  component "SchemeService" as SchemeService <<apoio>>
  component "HypeScoreConfig" as HypeScoreConfig <<apoio>>
}
package "fai-domain (repositórios)" {
  component "StyleDnaRepository\nStyleDnaVersionRepository\nDnaSchemeRepository\nDnaSchemeItemRepository\nWardrobeItemRepository\nSchemeRepository\nSchemeItemRepository\nDailyLookRepository\nUserRepository\nHypeScoreCurrentRepository" as REPO_MySQL
}
database "MySQL\n• daily_looks\n• dna_scheme_items\n• dna_schemes\n• hype_scores\n• scheme_items\n• schemes\n• style_dna\n• style_dna_versions\n• users\n• wardrobe_items" as DB_MySQL
cloud "Motor de IA (RF24)\nprovedores externos + reserva local" as AI
APIC --> DnaController : HTTPS/JSON
DnaController --> DnaService
DnaService --> AI
DnaService --> REPO_MySQL
DnaService ..> HypeScoreConfig
DnaService ..> MediaService
DnaService ..> NotificationService
DnaService ..> SchemeService
FE0 --> APIC
FE1 --> APIC
FE2 --> APIC
REPO_MySQL --> DB_MySQL : JPA/Flyway
@enduml
