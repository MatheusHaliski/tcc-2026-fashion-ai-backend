@startuml RF14_Atividades
title RF14 — Visualizar a aba "Marcas" — Feed de Perfil de Marcas de roupa cadastradas dentro do sistema do FashionAI\nDiagrama de atividades — fluxo da pessoa e do sistema
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 18
skinparam ArrowColor #52606D
skinparam activity {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  DiamondBackgroundColor #FFF5F8
  DiamondBorderColor #F08DB1
  StartColor #20A77A
  EndColor #4B5563
  BarColor #4B4B4B
}
skinparam swimlane {
  BorderColor #CBC6BE
  TitleFontColor #2D2438
}
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
|Pessoa|
start
:Abre a aba "Marcas" (/brands);
|Frontend (brands/page.tsx)|
:GET /api/brands?term=&order=\n(anônimo quando não está logado);
|Backend (InstitutionalService)|
:Lê brand_profiles com approval_status = APROVADO;
note right
  RN (RF1.CA06): marca PENDENTE, RECUSADO
  ou SUSPENSO não aparece no feed
  nem tem página pública
end note
if (Há termo de busca?) then (sim)
  :Filtra por brandName (contains, sem caixa);
else (não)
endif
if (Logado, com DNA e order != RECENTES?) then (sim)
  :Calcula afinidade (styleKeywords do StyleDna × catálogo da marca)\nAiEngine.local(AFFINITY);
  :Ordena por afinidade desc (order = AFINIDADE);
  note right: ver RF13 (DNA de Estilo) e RF24 (motor de IA)
else (não)
  :Ordena por createdAt desc (order = RECENTES);
endif
:Monta cards: slug, nome, logo, categoria,\nbonds aprovados, seguidores;
|Frontend (brands/page.tsx)|
:Exibe grade de cards (BrandLogo + nome + seguidores + selos);
if (Logo da marca ausente no card?) then (sim)
  :GET /api/brand-logos?name= (cache / busca na web);
  note right: ver RF4 (buscador web de marcas)
else (não)
endif
|Pessoa|
:Toca em um card ou alterna para a aba "Celebridades";
if (Abriu uma marca?) then (sim)
  |Frontend (brands/[slug]/page.tsx)|
  :GET /api/institutional/{slug};
  |Backend (InstitutionalService)|
  if (Marca APROVADA ou visitante é o dono/admin?) then (não)
    #FFE3E3:404 Marca;
    stop
  else (sim)
  endif
  :Header estilo Instagram: logo, bio, storeUrl, status "Validada",\nseguidores/seguindo, peças, esquemas, selos ativos, métricas RF19;
  :mode = VISITANTE → abas PROMOCOES, LOOKS_CONSAGRADOS, CATALOGO\nmode = ADMINISTRADOR → abas de gestão;
  |Frontend (brands/[slug]/page.tsx)|
  :Carrega abas: /tabs/{tab}, /api/users/{ownerId}/seals,\n/api/users/{ownerId}/promotions, Coleções (RF22), FLAIR, Guarda-roupa 3D (RF39);
  |Pessoa|
  if (Quer seguir a marca?) then (sim)
    :POST /api/users/{ownerId}/followers;
    note right: ver RF17 (seguir perfis)
  else (não)
  endif
else (não)
  |Frontend (brands/page.tsx)|
  :GET /api/celebrities (mesmo feed, RF22);
endif
stop
@enduml
