@startuml RF14_Classes
title RF14 — Aba "Marcas": feed e perfil das marcas cadastradas\nDiagrama de classes — InstitutionalService, política de exibição (Promoted), Hype da marca e entidades
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  HeaderBackgroundColor #E4DEF0
}
skinparam packageStyle rectangle
hide empty methods

package "fai-web · controller" {
class ProfileController {
  +brands(viewer, term, order): Map
  +celebrities(viewer, term, order): Map
  +institutional(viewer, slugOrId): Map
  +institutionalTab(viewer, slugOrId, tab, filter, groupingId): Object
  +store(slugOrId): Map
  +updateBrand(user, fields): Map
  +follow(user, targetId) · unfollow(user, targetId)
}
class HypeController {
  +groups(viewer, type, keys, window): Map
}
}

package "fai-application" {
class InstitutionalService {
  {static} +FEED_ORDERS = AFINIDADE, RECENTES, EM_ALTA
  {static} +HIDDEN_AUTHORS = SUSPENDED, DELETION_SCHEDULED, DELETED
  {static} +DESTAQUES_LIMIT = 12
  {static} +TAB_LIMIT = 60
  +brandFeed(viewer, term, order): Map
  +celebrityFeed(viewer, term, order): Map
  +profile(viewer, slugOrId): Map
  +tab(viewer, slugOrId, tab, filter, groupingId): Object
  +store(slugOrId): Map
  +updateBrand(user, fields): Map
  ~brandCard(BrandProfile): Map
  ~affinity(userStyles, ownerId): double
  ~feedHype(viewer, RankGroup, keys): Map
  ~displayable(viewer, Scheme): boolean
  ~displayable(viewer, WardrobeItem): boolean
  ~promoted(viewer, User, history, now): List<Promoted>
  ~filterLooks(list, filter, groupingId, personal): List<Promoted>
  ~pieceEntries(viewer, looks): List
  ~catalog(viewer, User, filter, admin): List
  {static} ~covers(SealBond, pieceId): boolean
  {static} ~lookHype(hype, schemeId, personal): Double
  {static} ~lookGrowth(hype, schemeId, personal): Double
}
class Promoted <<record>> {
  +scheme: Scheme
  +bonds: List<SealBond>
  +issuedAt: Instant
  +expiresAt: Instant
  +expired: boolean
  +revalidationPending: boolean
}
class HypeQueryService {
  {static} ~MIN_GROUP_ITEMS = 3
  {static} ~GROUP_TOP_ITEMS = 5
  +groups(viewer, RankGroup, keys, window): Map
  +currentOf(HypeEntityType, ids): Map<UUID, HypeScoreCurrent>
  {static} +brandKey(name): String
}
enum RankGroup {
  BRAND
  CREATOR
}
class SealService {
  +sealsOf(viewer, ownerId): List
  +promotionsOf(viewer, ownerId): List
  {static} +badge(SealBond): Map
}
class SchemeService {
  +canView(viewer, Scheme): boolean
  +view(viewer, Scheme, items): SchemeView
}
}

package "fai-domain · model" {
class BrandProfile {
  +owner: User
  +brandName: String
  +slug: String
  +logoUrl, coverUrl: String
  +bio: String — cifrada
  +storeUrl: String
  +fashionCategory: String
  +officialHashtag: String
  +country: String
  +approvalStatus: ApprovalStatus = PENDENTE
  +requiresSealReview: boolean
  +sealConfidenceThreshold: BigDecimal = 0.600
}
class User {
  +username: String
  +avatarUrl: String
  +profileType: ProfileType
  +status: AccountStatus
}
class Follow {
  +follower: User
  +following: User
  +status: FollowStatus
}
class SealBond {
  +scheme: Scheme
  +targetOwner: User
  +status: SealBondStatus
  +tier: SealTier
  +linkedPieceIdsJson: String
  +issuedAt, expiresAt: Instant
}
class Scheme {
  +user: User
  +status: SchemeStatus
  +visibility: Visibility
  +disponivel: boolean
  +lookDoDiaCount: int
  +groupingId: UUID
  +revalidationPending: boolean
}
class WardrobeItem {
  +availabilityStatus: AvailabilityStatus
  +moderationStatus: ModerationStatus
  +styleTags: String
}
class HypeScoreCurrent {
  +status: HypeStatus
  +score: BigDecimal
  +publicEligible: boolean
  +dimensions.trend: BigDecimal
  +deltaPoints: BigDecimal
}
class StyleDna {
  +styleKeywords: String
  .. ver RF13 ..
}
}
package "fai-domain · enums" {
enum ApprovalStatus {
  PENDENTE
  AJUSTES
  APROVADO
  RECUSADO
  SUSPENSO
}
enum SealBondStatus {
  SUGGESTED
  ACCEPTED
  EDITED
  REFUSED
  PENDING_REVIEW
  APPROVED
  REJECTED
  REVOKED
}
enum SealTier {
  PECA
  LOOK
}
enum FollowStatus {
  PENDENTE
  ACEITO
  BLOQUEADO
}
}

ProfileController --> InstitutionalService
HypeController --> HypeQueryService
InstitutionalService --> HypeQueryService : feedHype · currentOf
InstitutionalService --> SealService
InstitutionalService --> SchemeService : canView · view
InstitutionalService ..> Promoted
HypeQueryService ..> RankGroup
Promoted "*" --> "1" Scheme
Promoted "*" --> "1..*" SealBond
InstitutionalService ..> BrandProfile : feed só APROVADO
InstitutionalService ..> StyleDna : afinidade
InstitutionalService ..> HypeScoreCurrent : ordem HYPE / GROWTH
BrandProfile "0..1" --> "1" User : owner
Follow "*" --> "1" User : following
SealBond "*" --> "1" Scheme
SealBond "*" --> "1" User : targetOwner
Scheme "*" --> "1" User : user
BrandProfile --> ApprovalStatus
SealBond --> SealBondStatus
SealBond --> SealTier
Follow --> FollowStatus
note bottom of BrandProfile : tabela brand_profiles
note bottom of SealBond : tabela seal_bonds — só APPROVED põe\num look no perfil (vigente = destaque;\nexpirado/revalidação = consagrado)
note bottom of HypeScoreCurrent : tabela hype_scores (HypeScore v2)
@enduml
