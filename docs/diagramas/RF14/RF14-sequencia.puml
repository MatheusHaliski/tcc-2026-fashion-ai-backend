@startuml RF14_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."
title RF14 — Visualizar a aba 'Marcas' — Feed de Perfil de Marcas de roupa cadastradas dentro do sistema do FashionAI\nDiagrama de sequência — gerado do código em 2026-10-06 (scripts/diagramas/v5)

actor "Pessoa usuária" as U
boundary "Tela (Next.js)" as P
control "ProfileController" as ProfileController
participant "InstitutionalService" as InstitutionalService
database "MySQL" as DB_MySQL
participant "HypeQueryService" as HypeQueryService
participant "AiEngine\n(provedor de IA + reserva local)" as AI
participant "Guard" as Guard
== Marcas (busca e ordenação) ==
U -> P : Marcas (busca e ordenação)
P -> ProfileController : GET /api/brands
ProfileController -> InstitutionalService : brandFeed()
activate InstitutionalService
InstitutionalService -> DB_MySQL : SELECT brand_profiles
InstitutionalService -> DB_MySQL : SELECT style_dna
InstitutionalService -> HypeQueryService : groups()
HypeQueryService -> DB_MySQL : SELECT hype_scores
HypeQueryService -> DB_MySQL : SELECT hype_score_snapshots
HypeQueryService -> DB_MySQL : SELECT wardrobe_items
HypeQueryService -> DB_MySQL : SELECT schemes
HypeQueryService --> InstitutionalService
InstitutionalService -> DB_MySQL : SELECT seal_bonds
InstitutionalService -> DB_MySQL : SELECT follows
InstitutionalService -> DB_MySQL : SELECT wardrobe_items
InstitutionalService -> AI : AFFINITY
AI --> InstitutionalService : resposta (ou reserva local)
deactivate InstitutionalService
InstitutionalService --> ProfileController : resultado
ProfileController --> P : 200 JSON
P --> U : atualiza a tela
== Marca edita seus dados institucionais ==
U -> P : Marca edita seus dados institucionais
P -> ProfileController : PATCH /api/me/brand-profile
ProfileController -> InstitutionalService : updateBrand()
activate InstitutionalService
InstitutionalService -> DB_MySQL : SELECT brand_profiles
InstitutionalService -> Guard : deny()
alt url inválida
InstitutionalService --> ProfileController : 400 URL_INVALIDA
ProfileController --> P : 400 + mensagem
end
InstitutionalService -> InstitutionalService : storeUrl = set
InstitutionalService -> InstitutionalService : logoUrl = set
InstitutionalService -> InstitutionalService : coverUrl = set
InstitutionalService -> DB_MySQL : INSERT/UPDATE brand_profiles
InstitutionalService -> DB_MySQL : SELECT seal_bonds
InstitutionalService -> DB_MySQL : SELECT follows
deactivate InstitutionalService
InstitutionalService --> ProfileController : resultado
ProfileController --> P : 200 JSON
P --> U : atualiza a tela
@enduml
