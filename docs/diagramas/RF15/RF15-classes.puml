@startuml RF15_Classes
title RF15 — Editar uma fotografia de uma peça de roupa através de um Editor Canvas Interativo 2D\nDiagrama de classes — o que existe hoje: PhotoService.saveEdit, WardrobeService.replaceImage e versões do estúdio
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  HeaderBackgroundColor #E4DEF0
}
skinparam packageStyle rectangle
hide empty members

package "Frontend (components)" {
  class PhotoEditor <<React>> {
    props: photoId?, pieceId?, imageUrl?, title
    steps : Step[] ; at : number
    +rotate() ; +applyCrop() ; +removeBg()
    +undo() ; +redo() ; +save()
  }
  class "Step" as Step <<interface TS>> {
    src : string
    rotation : 0 | 90 | 180 | 270
    crop : Rect | null
    brightness, contrast : number «40–180»
    label : string
  }
  class EditImageDialog <<React>> {
    seções: framing · cut · compare · logo
    onStudio(backdrop) ; onReplace(file)
    onManual() ; onApprove() ; onDiscard()
  }
  class ApprovalPanel <<React>>
  class "studioVersion(p)" as SV <<função>> {
    version : number ; approved : boolean
    pending : {url, feedUrl, version, backdrop}
  }
}

package "fai-web · controller" {
  class PhotoController <<RestController>> {
    +download(user, id) «GET /api/photos/{id}/file»
    +saveEdit(user, id, file) «POST /api/photos/{id}/edits»
    +removeBackground(user, file) «POST /api/photos/background-removal»
  }
  class WardrobeController <<RestController>> {
    +replaceImage(user, id, file, editedFromPhotoId) «PUT /api/pieces/{id}/image»
    +studioPiece(user, id, backdrop) «POST /api/pieces/{id}/studio»
    +approveStudio(user, id) «POST /api/pieces/{id}/studio/approve»
    +discardStudio(user, id) «DELETE /api/pieces/{id}/studio/pending»
  }
}

package "fai-application" {
  class PhotoService <<Service>> {
    +saveEdit(user, id, bytes) : Map
    +removeBackground(user, bytes) : Map
    +download(user, id) : byte[]
    ~owned(user, id) : Photo
  }
  class WardrobeService <<Service>> {
    +replaceImage(user, id, bytes, editedFromPhotoId) : PieceView
    +governedFlatLay(userId, bytes) : FlatLayPipeline.Result
    +studioPiece(user, id, backdrop) : PieceView
    +approveStudio(user, id) : PieceView
    +discardStudio(user, id) : PieceView
    ~offerStudio(w, info, sourceChanged) : String
    ~refreshStudio(w, cutout, createIfMissing, sameSource)
    -applyStudio(w, info, approved)
  }
  class MediaService <<Service>> {
    +put(key, bytes, contentType) : StoredObject
    +register(owner, origin, sourceEntityId, stored, ...) : Photo
  }
  class ImageOps {
    +MAX_UPLOAD_BYTES = 10 MB
    +requireAcceptedImage(bytes) : String
  }
  class FlatLayPipeline <<Component>>
  class StudioPipeline <<Component>>
  class QualityMetrics {
    +ACCEPTANCE_THRESHOLD = 0.6
  }
}

package "fai-domain · model" {
  class Photo <<Entity>> <<table photos>> {
    origin : PhotoOrigin ; sourceEntityId : UUID
    publicUrl, originalUrl, thumbnailUrl : String
    moderationStatus : ModerationStatus
    editedFromPhotoId : UUID
    metadataJson : String «sourceMime, editedFrom»
    deletedAt : Instant
  }
  class WardrobeItem <<Entity>> <<table wardrobe_items>> {
    imageUrl, originalImageUrl, thumbnailUrl : String
    defaultImage, aiGeneratedImage : boolean
    photoProcessingStatus : PhotoProcessingStatus
    studioImageUrl, studioBackdrop, studioDetailUrl : String
    flatLayMetadataJson : String
  }
  class "flatLayMetadata.studio" as Studio <<JSON>> {
    version : int ; approved : boolean
    url, thumbUrl, feedUrl, detailUrl : String
    backdrop : String ; createdAt, approvedAt
    pending : {mesmos campos, version n+1}
    previous : {version, url, feedUrl, backdrop}
  }
  class PieceImage <<Entity>> <<table piece_images>> {
    imageType : PieceImageType
    derivedFromId : UUID
    processingStatus : PieceImageStatus
    superseded : boolean
  }
}

PhotoEditor *-- "1..*" Step : histórico da sessão
PhotoEditor ..> PhotoController : photoId
PhotoEditor ..> WardrobeController : pieceId
EditImageDialog *-- ApprovalPanel
EditImageDialog ..> SV
EditImageDialog ..> PhotoEditor : onManual
PhotoController --> PhotoService
WardrobeController --> WardrobeService
PhotoService --> WardrobeService : replaceImage · governedFlatLay
PhotoService --> MediaService
WardrobeService --> MediaService
WardrobeService ..> ImageOps
WardrobeService --> FlatLayPipeline
WardrobeService --> StudioPipeline
FlatLayPipeline ..> QualityMetrics
PhotoService ..> Photo
MediaService ..> Photo : register (EDITOR)
Photo ..> Photo : editedFromPhotoId
Photo "*" ..> "0..1" WardrobeItem : sourceEntityId
WardrobeService ..> WardrobeItem
WardrobeItem *-- "0..1" Studio : flatLayMetadataJson
PieceImage ..> WardrobeItem : pieceId

note bottom of PhotoEditor
  Destrutivo ao salvar: envia um PNG "assado".
  Sem receita, sem proporções/zonas seguras,
  sem balanço de branco nem medida de cor;
  o histórico (Step[]) some ao fechar.
end note
note bottom of PieceImage
  piece_images (V29): base proposta para versões,
  mas o plano do RF15 escolhe uma tabela nova
  (image_edit_versions — RF15-classes-planejado).
end note
@enduml
