@startuml RF15_MaquinaDeEstados_Foto
!pragma layout smetana
title RF15 — Photo: da foto original da peça à cópia editada no Editor Canvas 2D (ModerationStatus / PhotoOrigin)
skinparam backgroundColor #FFFFFF
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  ArrowColor #52606D
}
[*] --> Original : cadastro da peça (RF4) ou esquema (RF5)\nMediaService.register(origin WARDROBE_ITEM | SCHEME)
state "Foto original\n(photos · moderation_status)" as Original {
  state "PENDING" as Pend
  state "APPROVED" as Appr
  state "REJECTED_POLICY /\nREJECTED_NOT_CLOTHING" as Rej
  [*] --> Pend
  Pend --> Appr : moderação de conteúdo (RF4)
  Pend --> Rej : moderação de conteúdo (RF4)
}
state "Em edição no navegador\n(canvas 2D, histórico de passos)" as Editing
state "Cópia editada\n(origin = EDITOR, APPROVED,\nedited_from_photo_id = original)" as Edited
state "Imagem da peça substituída\n(wardrobe_items.image_url,\nphoto_processing_status = COMPLETED)" as Replaced
state "Excluída\n(deleted_at)" as Deleted

Appr --> Editing : GET /api/photos/{id}/file\nou card da peça → "Editar"
Editing --> Editing : recortar · girar 90 · brilho · contraste\nPOST /api/photos/background-removal
Editing --> Appr : fechar e descartar (confirmação, CA05)
Editing --> Edited : POST /api/photos/{id}/edits\n(foto solta ou de esquema)
Editing --> Replaced : POST /api/photos/{id}/edits (foto de peça ativa)\nou PUT /api/pieces/{id}/image
Replaced --> Edited : registra também um Photo EDITOR
Edited --> Editing : editar de novo (nova cópia)
Edited --> Deleted : DELETE /api/photos/{id}
Appr --> Deleted : DELETE /api/photos/{id}?confirmed=true\n(pede confirmação se há peça vinculada)
Deleted --> [*]
note right of Original : a original nunca é alterada (CA02):\noriginal_url preservado em "Minhas Fotos"
note right of Edited : cada salvamento gera uma nova linha em photos;\nmoderação herdada como APPROVED
@enduml
