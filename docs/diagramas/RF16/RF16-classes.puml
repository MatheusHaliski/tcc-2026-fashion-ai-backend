    +brandProfile: BrandProfile
    +brand: Brand
    +name: String
    +category: String
    +subcategory: String
    +sex: String
    +brandName: String
    +brandLogoUrl: String
    .. +70 campos ..
  }
}
package "fai-domain (enums)" {
  enum PipelineJobStatus {
    PENDING
    RUNNING
    RENDERING
    ENHANCING
    COMPOSITING
    COMPLETED
    FAILED
    CANCELLED
  }
  enum AccountStatus {
    PENDING_EMAIL_VERIFICATION
    ACTIVE
    PENDING_VALIDATION
    SUSPENDED
    DELETION_SCHEDULED
    DELETED
  }
  enum AvailabilityStatus {
    AVAILABLE
    UNAVAILABLE
    ARCHIVED
  }
  enum ModerationStatus {
    PENDING
    APPROVED
    REJECTED_POLICY
    REJECTED_NOT_CLOTHING
  }
  enum PhotoProcessingStatus {
    NEW
    MODERATING
    PROCESSING
    COMPLETED
    NEEDS_REUPLOAD
    FAILED
  }
  enum Model3dStatus {
    QUEUED
    PROCESSING
    COMPLETED
    FAILED
  }
}
package "fai-application" {
  class ShowcaseService <<service>> {
    +requestModels()
    +piece3d()
  }
}
ShowcaseService ..> User : usa
ShowcaseService ..> WardrobeItem : usa
AiInferenceLog ..> User : userId
PipelineJob "*" --> "1" User : user
PipelineJob --> PipelineJobStatus
ProcessingJobLog ..> PipelineJob : pipelineJobId
ProcessingJobLog ..> User : userId
ProcessingJobLog ..> WardrobeItem : wardrobeItemId
RenderJobLog ..> PipelineJob : pipelineJobId
RenderJobLog ..> User : userId
User --> AccountStatus
WardrobeItem "*" --> "1" User : user
WardrobeItem --> AvailabilityStatus
WardrobeItem --> Model3dStatus
WardrobeItem --> ModerationStatus
WardrobeItem --> PhotoProcessingStatus
