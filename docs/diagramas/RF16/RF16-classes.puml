    +stageTimesJson: String
    +finalQualityScore: BigDecimal
    +totalCostUsd: BigDecimal
    .. +4 campos ..
  }
  class RenderJobLog <<render_jobs_log>> {
    +id: UUID
    +pipelineJobId: UUID
    +schemeId: UUID
    +userId: UUID
    +renderingType: String
    +status: String
    +totalProcessingTimeMs: Integer
    +stageTimesJson: String
