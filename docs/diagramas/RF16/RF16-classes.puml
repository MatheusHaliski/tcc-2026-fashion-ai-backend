    +inputJson: String
    +outputUrl: String
    .. +13 campos ..
  }
  class ProcessingJobLog <<processing_jobs_log>> {
    +id: UUID
    +pipelineJobId: UUID
    +wardrobeItemId: UUID
    +userId: UUID
    +jobType: String
    +status: String
