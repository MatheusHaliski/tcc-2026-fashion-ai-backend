@startuml RF16_Classes
title RF16 — Implementar geração de imagem 3D das peças do guarda-roupa utilizando serviços de API externas\nDiagrama de classes — Model3dService, porta Model3dPort e adaptadores, PipelineJob e estado 3D da peça
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  HeaderBackgroundColor #E4DEF0
}
skinparam packageStyle rectangle
hide empty members

package "fai-web · controller" {
  class WardrobeController <<RestController>> {
    +request3d(user, id) «POST /api/pieces/{id}/model3d» 202
    +status3d(user, id) «GET /api/pieces/{id}/model3d»
  }
  class ShowcaseController <<RestController>> {
    +requestModels(user, id) «POST /api/schemes/{id}/model3d»
  }
}

package "fai-application" {
  class WardrobeService <<Service>> {
    +request3d(user, id) : Map
    +status3d(user, id) : Map
  }
  class ShowcaseService <<Service>> {
    +requestModels(user, schemeId) : Map
  }
  class Model3dService <<Service>> {
    ~MAX_GLB_BYTES = 40 MB
    -enabled «fashionai.features.rf16-3d»
    -timeout «rf16-3d-timeout-minutes = 10»
    +request(w) : Map
    +status(w) : Map
    ~latest(pieceId) : Optional<PipelineJob>
    +tick() «@Scheduled 5 s»
    ~start(jobId)
    ~follow(jobId)
    -complete(job, glb, stages, relief)
    -fail(job, code, message)
    ~{static} heightOf(slot, subcategory) : double
  }
  class "Model3dService.Started" as Started <<record>> {
    provider, taskId : String
    glb : byte[] ; costUsd : BigDecimal
    local : boolean ; relief : Model
  }
  interface "ImageProviderPorts.Model3dPort" as Port <<port>> {
    +available() : boolean
    +submit(image) : Optional<String>
    +providerId() : String
    +async() : boolean
    +poll(taskId) : Optional<TaskStatus>
    +generateNow(image) : Optional<byte[]>
    +costUsd() : BigDecimal
  }
  class "ImageProviderPorts.TaskStatus" as TaskStatus <<record>> {
    state : PENDING | RUNNING | SUCCEEDED | FAILED
    progress : int ; glbUrl, error : String
  }
  class ReliefModelGenerator {
    +GRID = 128
    +{static} generate(cutout, heightMeters) : Model
    +{static} isGlb(bytes) : boolean
  }
  class "ReliefModelGenerator.Model" as Model <<record>> {
    glb : byte[] ; vertices, triangles : int
    widthM, heightM, depthM : double
  }
  class AiEngine {
    +execute(userId, capability, inputs, ..., remoteSteps, local) : AiOutcome
  }
  interface WebFetchPort <<port>> {
    +get(url, maxBytes, ...) : Optional<Fetched>
  }
  class MediaService <<Service>>
  class FaiPointsService <<Service>> {
    +awardIsolated(userId, "PIECE_3D", ...)
  }
  class NotificationService <<Service>>
}

package "fai-infrastructure · ai-providers" {
  class MeshyModel3dAdapter <<Component>> {
    api.meshy.ai · MESHY_API_KEY
    async = true · poll(taskId)
  }
  class StabilityFast3dAdapter <<Component>> {
    api.stability.ai · STABILITY_API_KEY
    async = false · generateNow(png)
  }
}

package "fai-domain" {
  class PipelineJob <<Entity>> <<table pipeline_jobs>> {
    type = THREE_D_GENERATION
    status : PipelineJobStatus
    targetType = "PIECE" ; inputResourceId : UUID
    provider, externalJobId : String
    inputJson «freeRetry, image»
    resultJson «progress, progressReal, model»
    stagesJson ; outputUrl : String
    fallbackUsed : boolean ; totalCostUsd : BigDecimal
    errorCode, errorMessage : String
    attempts, retryCount : int
    queuedAt, startedAt, finishedAt : Instant
  }
  class WardrobeItem <<Entity>> <<table wardrobe_items>> {
    imageUrl : String ; defaultImage : boolean
    model3dStatus : Model3dStatus
    model3dUrl : String
    model3dGeneratedAt : Instant «não preenchido»
  }
  enum Model3dStatus {
    QUEUED
    PROCESSING
    COMPLETED
    FAILED
  }
  enum PipelineJobStatus {
    PENDING
    RUNNING
    COMPLETED
    FAILED
    .. não usados no 3D ..
    RENDERING · ENHANCING
    COMPOSITING · CANCELLED
  }
  interface PipelineJobRepository {
    +findByStatusOrderByQueuedAtAsc(status)
    +findByTypeAndInputResourceIdOrderByCreatedAtDesc(type, id)
  }
}

WardrobeController --> WardrobeService
ShowcaseController --> ShowcaseService
WardrobeService --> Model3dService
ShowcaseService --> Model3dService : request(w) por peça
Model3dService --> "0..*" Port : providers (ordem do contexto)
Model3dService --> AiEngine : THREE_D_GENERATOR (cota 3/dia)
Model3dService ..> ReliefModelGenerator : plano B local
Model3dService --> WebFetchPort : baixa o GLB (https, ≤ 40 MB)
Model3dService --> MediaService : read foto · put .glb
Model3dService --> FaiPointsService
Model3dService --> NotificationService : AI_JOB_FINISHED
Model3dService --> PipelineJobRepository
Model3dService ..> Started
Port ..> TaskStatus
ReliefModelGenerator ..> Model
MeshyModel3dAdapter ..|> Port
StabilityFast3dAdapter ..|> Port
PipelineJobRepository ..> PipelineJob
PipelineJob --> PipelineJobStatus
WardrobeItem --> Model3dStatus
PipelineJob "*" ..> "1" WardrobeItem : inputResourceId

note bottom of MeshyModel3dAdapter
  Adaptadores sem teste automatizado e sem chave
  no ambiente: não testados com o provedor real.
end note
note right of Model3dStatus
  DomainEvents.Model3dGenerated tem ouvinte
  (WardrobeEventListeners.onModel3d), mas ninguém
  publica: os pontos saem direto em complete().
end note
@enduml
