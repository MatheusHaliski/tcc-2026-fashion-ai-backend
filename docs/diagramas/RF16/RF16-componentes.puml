@startuml RF16_Componentes
title RF16 — Implementar geração de imagem 3D das peças do guarda-roupa utilizando serviços de API externas\nDiagrama de componentes — gerado do código (controllers → serviços → repositórios/ports)
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
left to right direction

package "Frontend (Next.js)" {
  component "pieces/[id] — ExpandedPiece\n(aba Modelo 3D)" as FE0
  component "Model3dPanel\n(components/model3d-panel.tsx)" as FE1
  component "PieceModelViewer\n(room3d/piece-model-viewer.tsx)" as FE2
  component "Generate3d\n(components/generate-3d.tsx)" as FE3
}
package "fai-web · controllers" {
  [WardrobeController] as WC
  [ShowcaseController] as SC
}
package "fai-application · services" {
  [WardrobeService] as WS
  [ShowcaseService] as SS
  [Model3dService\n(@Scheduled tick)] as M3
  [AiEngine (RF24)\nAiCapability.THREE_D_GENERATOR] as AI
  [ReliefModelGenerator\n(relevo local)] as REL
  [MediaService] as MS
  [NotificationService] as NS
  [FaiPointsService] as FP
}
package "fai-infrastructure · adapters" {
  [MeshyModel3dAdapter] as MESHY
  [StabilityFast3dAdapter] as SF3D
  [WebFetchPort (https)] as WEB
  [PipelineJobRepository\nWardrobeItemRepository\nAiInferenceLogRepository] as REPOS
  [storage-s3] as S3
}
database "MySQL\n• pipeline_jobs\n• wardrobe_items\n• ai_inference_log\n• notifications\n• fai_points_ledger" as DB
cloud "Meshy image-to-3D" as X1
cloud "Stability Stable Fast 3D" as X2
component "Blender" <<planejado>> as BL
note bottom of BL : não implementado — conforme Trello\n(dependência "Blender/cloud"; atendida pelos provedores cloud)

FE0 --> FE1
FE1 --> FE2
FE1 --> WC : POST/GET /api/pieces/{id}/model3d
FE3 --> SC : GET /api/pieces/{id}/look3d\nPOST /api/schemes/{id}/model3d
WC --> WS : chama
SC --> SS : chama
WS --> M3 : request / status
SS --> M3 : request
M3 --> AI : execute
AI --> MESHY : chama
AI --> SF3D : chama
M3 --> REL : plano B
M3 --> WEB : baixa GLB
M3 --> MS : grava .glb
M3 --> NS : publica
M3 --> FP : awardIsolated(PIECE_3D, 15 pts)
MS --> S3
MESHY --> X1
SF3D --> X2
M3 --> REPOS : lê/grava
AI --> REPOS : grava log
REPOS --> DB : JPA/Flyway
@enduml
