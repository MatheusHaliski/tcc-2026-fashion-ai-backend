@startuml RF16_Componentes
title RF16 — Implementar geração de imagem 3D das peças do guarda-roupa utilizando serviços de API externas\nDiagrama de componentes — página da peça → API → Model3dService (worker) → Meshy/Stability/relevo local → storage
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
}
skinparam component<<port>> {
  BackgroundColor #FFFFFF
  BorderColor #7C5FC0
}
skinparam package {
  BorderColor #CBC6BE
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}

package "Frontend (Next.js)" {
  component "expanded-card.tsx · ExpandedPiece\n(«Ver em 3D» em diálogo)" as FE_EXP
  component "model3d-panel.tsx\nuseModel3d (poll 2,5 s) · Model3dAction\n· Model3dTechnical" as FE_PANEL
  component "room3d/piece-model-viewer.tsx\nPieceModelViewer (React Three Fiber)" as FE_VIEW
  component "room3d/room-scene.tsx (Meu Quarto 3D)\n+ generate-3d.tsx (manequim)" as FE_ROOM
}

package "fai-web · controllers" {
  [WardrobeController\nPOST /api/pieces/{id}/model3d (202)\nGET /api/pieces/{id}/model3d] as C_WR
  [ShowcaseController\nPOST /api/schemes/{id}/model3d\n(sem chamada no frontend)] as C_SH
}

package "fai-application" {
  [WardrobeService\nrequest3d · status3d (owned)] as S_WR
  [ShowcaseService\nrequestModels] as S_SH
  [Model3dService\nrequest · status · tick() @Scheduled 5 s\nstart · follow · complete · fail] as S_M3D
  [AiEngine (RF24)\nTHREE_D_GENERATOR · cota 3/dia\nai_inference_log] as S_AI
  [ReliefModelGenerator\n(relevo local, sempre disponível)] as S_REL
  [MediaService] as S_MEDIA
  [FaiPointsService (PIECE_3D +15)\nNotificationService (AI_JOB_FINISHED)] as S_SIDE
}

package "portas" {
  component "ImageProviderPorts.Model3dPort" <<port>> as P_3D
  component "WebFetchPort" <<port>> as P_WEB
  component "MediaStoragePort" <<port>> as P_MEDIA
}

package "fai-infrastructure" {
  [MeshyModel3dAdapter\n(assíncrono · MESHY_API_KEY)] as I_MESHY
  [StabilityFast3dAdapter\n(síncrono · STABILITY_API_KEY)] as I_SF3D
  [JdkWebFetchAdapter\n(https, anti-SSRF, ≤ 40 MB)] as I_WEB
  [S3MediaStorageAdapter /\nLocalFileMediaStorage] as I_S3
  [Repositórios JPA\nPipelineJobRepository · WardrobeItemRepository] as I_JPA
}
database "MySQL\n• pipeline_jobs (THREE_D_GENERATION)\n• wardrobe_items (model3d_status, model3d_url)\n• fai_points_ledger · notifications" as DB
database "Storage\nusers/{u}/pieces/{id}/model-*.glb" as STO
cloud "Meshy image-to-3D\nStability Stable Fast 3D" as X_3D

FE_EXP --> FE_PANEL
FE_EXP --> FE_VIEW : modelUrl
FE_ROOM ..> FE_VIEW : mesmo .glb
FE_PANEL --> C_WR : POST (só "Tentar de novo")\nGET a cada 2,5 s
C_WR --> S_WR
C_SH --> S_SH
S_WR --> S_M3D
S_SH --> S_M3D
S_M3D --> S_AI
S_AI --> P_3D : passos remotos
S_M3D --> S_REL : plano B
S_M3D --> P_WEB : baixa o GLB do Meshy
S_M3D --> S_MEDIA
S_M3D --> S_SIDE
S_MEDIA --> P_MEDIA
I_MESHY ..|> P_3D
I_SF3D ..|> P_3D
I_WEB ..|> P_WEB
I_S3 ..|> P_MEDIA
S_M3D --> I_JPA
S_SIDE --> I_JPA
I_JPA --> DB : JPA / Flyway (V2, V14)
I_S3 --> STO
I_MESHY --> X_3D : HTTPS
I_SF3D --> X_3D : HTTPS
I_WEB --> X_3D : GET glbUrl

note bottom of X_3D
  Provedores externos: código pronto, mas sem
  teste automatizado e sem chave no ambiente
  (não testados). Sem eles, o relevo local
  responde sempre.
end note
@enduml
