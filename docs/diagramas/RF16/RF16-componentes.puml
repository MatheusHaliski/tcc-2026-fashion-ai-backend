}
package "fai-domain (repositórios)" {
  component "FollowRepository\nUserRepository\nSchemeRepository\nSchemeItemRepository\nWardrobeItemRepository\nSchemeGroupingRepository\nDailyLookRepository\nUserPreferencesRepository\nCelebrityProfileRepository\nHypeScoreCurrentRepository\n(+8)" as REPO_MySQL
