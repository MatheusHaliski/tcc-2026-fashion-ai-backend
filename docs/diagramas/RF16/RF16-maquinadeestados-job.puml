@startuml RF16_MaquinaDeEstados_Job
!pragma layout smetana
title RF16 — PipelineJob THREE_D_GENERATION: ciclo do job 3D da peça (e model3dStatus da peça)
skinparam backgroundColor #FFFFFF
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  ArrowColor #52606D
}
state "PENDING\n(peça: QUEUED)" as Pend
state "RUNNING\n(peça: PROCESSING)" as Run {
  state "provedor externo\n(externalJobId)" as Ext
  state "relevo local\n(ReliefModelGenerator)" as Rel
  [*] --> Ext : Meshy submit
  [*] --> Rel : sem chave / cota esgotada
  Ext --> Rel : FAILED ou TEMPO_LIMITE (fallback)
}
state "COMPLETED\n(peça: COMPLETED)" as Done
state "FAILED\n(peça: FAILED)" as Fail
[*] --> Pend : POST /api/pieces/{id}/model3d
Pend --> Run : tick() → start()
Pend --> Fail : PECA_REMOVIDA / SEM_ARQUIVO
Run --> Done : GLB salvo no storage\n(notificação + FAI Points +15)
Run --> Fail : PROVEDOR_FALHOU / TEMPO_LIMITE / ERRO_INTERNO
Fail --> Pend : POST /api/pieces/{id}/model3d\n(1º reprocessamento grátis)
Done --> [*]
note right of Fail : errorCode + errorMessage legíveis;\ncanRetryFree enquanto retryCount = 0
note right of Pend : pedido repetido em QUEUED/PROCESSING\ndevolve o mesmo job (CA04)
@enduml
