@startuml RF17_Atividades
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam activity {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  DiamondBackgroundColor #FFF5F8
  DiamondBorderColor #F08DB1
  StartColor #20A77A
  EndColor #4B5563
}
skinparam swimlane {
  BorderColor #CBC6BE
  TitleFontColor #2D2438
}
title RF17 — Permitir que o Usuário visualize a página de perfil de outros Usuários cadastrados dentro da rede social do FashionAI\nDiagrama de atividades — gerado do código em 2026-10-06 (scripts/diagramas/v5)

|Pessoa usuária|
start
:Abre /closet, /brands/[slug],\n/u/[username];
|Tela (Next.js)|
:Carrega os dados da tela\nGET /api/users/{userId}/connections\nGET /api/me/follow-requests;
|Pessoa usuária|
:Perfil público (por id ou\n@username); sort = recent | hype_…;
|Tela (Next.js)|
:GET /api/profiles/{idOrUsername};
|API (Spring Boot)|
:ProfileController.profile\n→ ProfileService.profile;
|Dados e serviços|
:Monta a resposta;
|Tela (Next.js)|
:Atualiza a tela com a resposta;
|Pessoa usuária|
if (Faz outra ação?) then (sim)
  switch (Qual?)
  case (Aceitar ou recusar pedido)
    :POST /api/follow-requests/{followId}\n→ ProfileService.respond\nvalida: PEDIDO_RESPONDIDO\nlê: follows\nusa: Guard.requireOwner,\nNotificationService.notify\ngrava: follows;
  case (Seguir [ou pedir para seguir perf…)
    :POST /api/users/{targetId}/followers\n→ ProfileService.follow\nvalida: NAO_ENCONTRADO, SEGUIR_A_SI\nlê: users, follows\nusa: NotificationService.notify\ngrava: follows;
  case (Deixar de seguir)
    :DELETE /api/users/{targetId}/followers/me\n→ ProfileService.unfollow\nlê: follows;
  case (Bloquear/desbloquear usuário)
    :PUT /api/users/{targetId}/block\n→ ProfileService.block\nvalida: BLOQUEIO_INVALIDO\nlê: users, follows\ngrava: follows\nestado: status → BLOQUEADO;
  endswitch
  |Tela (Next.js)|
  :Atualiza a tela;
endif
|Pessoa usuária|
stop
@enduml
