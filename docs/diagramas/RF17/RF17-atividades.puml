@startuml RF17_Atividades
title RF17 — Visualizar a página de perfil de outros usuários\nDiagrama de atividades — abrir o perfil, privacidade e bloqueio, Hype do criador, seguir, pedir para seguir e bloquear
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 18
skinparam ArrowColor #52606D
skinparam activity {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  DiamondBackgroundColor #FFF5F8
  DiamondBorderColor #F08DB1
  StartColor #20A77A
  EndColor #4B5563
  BarColor #4B4B4B
}
skinparam swimlane {
  BorderColor #CBC6BE
  TitleFontColor #2D2438
}
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
|Pessoa|
start
:Toca em @username (feed, busca,\ncomentário, lista de seguidores);
|Frontend|
:Abre /u/[username] (u/[username]/page.tsx);\nsem login a chamada vai anônima;
:GET /api/profiles/{idOrUsername};
|API e serviços|
:ProfileService.profile → resolve(id ou @username);
if (Conta existe e não está DELETED\nnem DELETION_SCHEDULED?) then (não)
  #FFE3E3:404 Perfil;
  |Frontend|
  :ErrorState com "tentar de novo";
  stop
endif
|API e serviços|
if (O dono bloqueou quem visita\n(Follow dono→visitante = BLOQUEADO)?) then (sim)
  #FFE3E3:404 Perfil (como se não existisse);
  stop
endif
:relation = Follow visitante→dono\n(NENHUMA · PENDENTE · ACEITO · BLOQUEADO);
:counters: seguidores e seguindo (ACEITO), publicados,\npeças não arquivadas, esquemas não arquivados;
:contentVisible = dono, admin ou Guard.canView(profileVisibility):\nPUBLIC = todos · FOLLOWERS = Follow ACEITO · PRIVATE = ninguém;\nbloqueio em qualquer direção = falso;
if (contentVisible?) then (sim)
  :schemes PUBLISHED visíveis (visibilidade mais restritiva\nentre look e perfil), ordem sort = recent · hype_desc\n· hype_asc · growth (Hype público elegível; sem Hype por último);
  :pieces visíveis (até 60, não arquivadas);
else (não)
  :invite {SEGUIR}: "mostra as publicações só a seguidores"\nou "perfil privado"; schemes e pieces vazios;
endif
|Frontend|
if (layout = INSTITUCIONAL (marca ou celebridade)?) then (sim)
  :router.replace(/brands/{username})\n(perfil oficial — RF14/RF22);
  stop
endif
:ProfileHeader: avatar, capa, @, pronomes, bio, link,\ncontadores (abrem Conexões), selo verificado;
if (contentVisible?) then (sim)
  :HypeGroupBadge CREATOR (cabeçalho)\nGET /api/hype/groups?type=CREATOR&keys={id};
  if (Grupo suficiente (≥ 3 itens públicos), sem opt-out\ne sem bloqueio?) then (sim)
    :Mostra "Hype do criador": faixa, número,\nbase de itens públicos e posição no ranking\n(link Explorador › Em alta);
  else (não)
    :Nada no cabeçalho (nunca "0");
  endif
  if (visibility = PUBLIC?) then (sim)
    :InsightStrip CREATOR_PROFILE\nGET /api/insights?context=CREATOR_PROFILE&key=@;
  endif
  :LookbookTabs: Closet (GET /api/users/{id}/closet) · Looks\n(GET /api/profiles/{id}?sort) · Publicações · Favoritos\n· Agrupamentos (abas do dono ficam ocultas);
else (não)
  :EmptyState "Perfil privado" + botão\n"Pedir para seguir" (logado, sem pedido)\nou "Entrar" (sem login);
endif
|Pessoa|
if (Ação?) then (seguir / pedir)
  |Frontend|
  :POST /api/users/{targetId}/followers;
  |API e serviços|
  if (Seguir a si mesmo?) then (sim)
    #FFE3E3:400 SEGUIR_A_SI;
    stop
  elseif (Dono bloqueou quem pede?) then (sim)
    #FFE3E3:404 Perfil;
    stop
  elseif (privateAccount, visibilidade não PUBLIC\ne perfil PESSOAL?) then (sim)
    :Follow PENDENTE + notificação FOLLOW_REQUEST;
    note right
      O dono responde por POST /api/follow-requests/{followId}
      (aceito → ACEITO + FOLLOW_ACCEPTED; recusa apaga a linha).
      Não há tela de pedidos no frontend.
    end note
  else (não)
    :Follow ACEITO + notificação NEW_FOLLOWER;
  endif
elseif (deixar de seguir / cancelar pedido) then
  |Frontend|
  :DELETE /api/users/{targetId}/followers/me;
  |API e serviços|
  :Apaga o Follow (nunca um BLOQUEADO);\nsem notificação;
elseif (bloquear / desbloquear) then
  |Frontend|
  :Confirma no Dialog (só para bloquear)\nPUT /api/users/{targetId}/block {blocked};
  |API e serviços|
  if (Bloquear a si mesmo?) then (sim)
    #FFE3E3:400 BLOQUEIO_INVALIDO;
    stop
  endif
  :Apaga o Follow do outro para mim;\nbloquear: meu Follow vira BLOQUEADO;\ndesbloquear: apaga meu BLOQUEADO;
elseif (ver conexões) then
  |Frontend|
  :GET /api/users/{userId}/connections;
  |API e serviços|
  if (Pode ver o perfil?) then (não)
    #FFE3E3:403 (Guard.deny, auditado);
    stop
  endif
  :followers e following (só ACEITO);
else (copiar link)
  |Frontend|
  :Copia a URL do perfil;
  stop
endif
|Frontend|
:reload() do perfil com a nova relação e contadores;
stop
@enduml
