@startuml RF17_Classes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  StereotypeFontColor #6B6470
}
hide empty members
left to right direction
title RF17 — Permitir que o Usuário visualize a página de perfil de outros Usuários cadastrados dentro da rede social do FashionAI\nDiagrama de classes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "fai-domain (entidades JPA)" {
  class Follow <<follows>> {
    +id: UUID
    +follower: User
    +following: User
    +status: FollowStatus
    +respondedAt: Instant
  }
  class Notification <<notifications>> {
    +id: UUID
    +recipient: User
    +actor: User
    +type: NotificationType
    +category: NotificationCategory
    +resourceType: String
    +resourceId: UUID
    +title: String
    +body: String
    +payloadJson: String
    .. +3 campos ..
  }
  class Scheme <<schemes>> {
    +id: UUID
    +user: User
    +originalScheme: Scheme
    +title: String
    +description: String
    +creationMode: CreationMode
    +origin: SchemeOrigin
    +style: String
    +occasion: String
    +season: Season
    .. +46 campos ..
  }
  class User <<users>> {
    +id: UUID
    +username: String
    +displayName: String
    +email: String
    +emailHash: String
    +emailVerified: boolean
    +phone: String
    +birthDate: String
    +passwordHash: String
    +profileType: ProfileType
    .. +24 campos ..
  }
  class WardrobeItem <<wardrobe_items>> {
    +id: UUID
    +user: User
    +brandProfile: BrandProfile
    +brand: Brand
    +name: String
    +category: String
    +subcategory: String
    +sex: String
    +brandName: String
    +brandLogoUrl: String
    .. +70 campos ..
  }
}
package "fai-domain (enums)" {
  enum FollowStatus {
    PENDENTE
    ACEITO
    BLOQUEADO
  }
  enum SchemeStatus {
    DRAFT
    PUBLISHED
    ARCHIVED
  }
  enum RenderStatus {
    PENDING
    RENDERING
    ENHANCING
    COMPOSITING
    CACHED
    COMPLETED
    FAILED
  }
  enum AccountStatus {
    PENDING_EMAIL_VERIFICATION
    ACTIVE
    PENDING_VALIDATION
    SUSPENDED
    DELETION_SCHEDULED
    DELETED
  }
  enum AvailabilityStatus {
    AVAILABLE
    UNAVAILABLE
    ARCHIVED
  }
  enum ModerationStatus {
    PENDING
    APPROVED
    REJECTED_POLICY
    REJECTED_NOT_CLOTHING
  }
}
package "fai-application" {
  class ProfileService <<service>> {
    +profile()
    +follow()
    +unfollow()
    +requests()
    +respond()
    +connections()
    +block()
  }
}
ProfileService ..> Follow : usa
ProfileService ..> Scheme : usa
ProfileService ..> User : usa
ProfileService ..> WardrobeItem : usa
Follow "*" --> "1" User : follower
Follow "*" --> "1" User : following
Follow --> FollowStatus
Notification "*" --> "1" User : actor
Notification "*" --> "1" User : recipient
Scheme "*" --> "1" User : user
Scheme --> RenderStatus
Scheme --> SchemeStatus
User --> AccountStatus
WardrobeItem "*" --> "1" User : user
WardrobeItem --> AvailabilityStatus
WardrobeItem --> ModerationStatus
@enduml
