@startuml RF17_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF17 — Permitir que o Usuário visualize a página de perfil de outros Usuários cadastrados dentro da rede social do FashionAI\nDiagrama de componentes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "Frontend (Next.js)" {
  component "/closet\n(site)/(app)/closet/page.tsx" as FE0
  component "/brands/[slug]\n(site)/(app)/brands/[slug]/page.tsx" as FE1
  component "/notifications\n(site)/(app)/notifications/page.tsx" as FE2
  component "/u/[username]\n(site)/(app)/u/[username]/page.tsx" as FE3
  component "lib/api/client.ts" as APIC
}
package "fai-web (REST)" {
  component "NotificationController\n/api/notifications\n/api/notifications/preferences\n/api/notifications/read\n/api/notifications/read-all\n(+1 rotas)" as NotificationController
  component "ProfileController\n/api/follow-requests/{…}\n/api/me/follow-requests\n/api/profiles/{…}\n/api/users/{…}/block\n(+3 rotas)" as ProfileController
  component "WardrobeController\n/api/me/closet\n/api/me/pieces/studio\n/api/users/{…}/closet" as WardrobeController
}
package "fai-application (casos de uso)" {
  component "NotificationService" as NotificationService
  component "ProfileService" as ProfileService
  component "WardrobeService" as WardrobeService
  component "SchemeService" as SchemeService <<apoio>>
  component "HypeScoreConfig" as HypeScoreConfig <<apoio>>
  component "FlatLayPipeline" as FlatLayPipeline <<apoio>>
  component "MediaService" as MediaService <<apoio>>
  component "AssetCatalogService" as AssetCatalogService <<apoio>>
  component "ProjectionService" as ProjectionService <<apoio>>
  component "Model3dService" as Model3dService <<apoio>>
  component "BrandLogoService" as BrandLogoService <<apoio>>
  component "NotificationProjectionPort\n«CassandraProjectionAdapter»" as NotificationProjectionPort <<port>>
  component "JobQueuePort\n«InMemoryJobQueue»" as JobQueuePort <<port>>
}
package "fai-domain (repositórios)" {
  component "NotificationRepository\nUserRepository\nUserPreferencesRepository\nFollowRepository\nSchemeRepository\nSchemeItemRepository\nWardrobeItemRepository\nHypeScoreCurrentRepository\nBrandRepository\nPipelineJobRepository\n(+6)" as REPO_MySQL
}
database "MySQL\n• brands\n• follows\n• hype_scores\n• moderation_queue\n• notifications\n• photos\n• pipeline_jobs\n• processing_jobs_log\n• quality_scores\n• reactions\n• saved_items\n• scheme_items\n(+4)" as DB_MySQL
cloud "Motor de IA (RF24)\nprovedores externos + reserva local" as AI
component "Eventos de domínio\n(@TransactionalEventListener)" as EV
cloud "Cassandra" as CL_Cassandra
APIC --> NotificationController : HTTPS/JSON
APIC --> ProfileController : HTTPS/JSON
APIC --> WardrobeController : HTTPS/JSON
FE0 --> APIC
FE1 --> APIC
FE2 --> APIC
FE3 --> APIC
NotificationController --> NotificationService
NotificationProjectionPort --> CL_Cassandra
NotificationService --> NotificationProjectionPort
NotificationService --> REPO_MySQL
ProfileController --> ProfileService
ProfileService --> REPO_MySQL
ProfileService ..> HypeScoreConfig
ProfileService ..> NotificationService
ProfileService ..> SchemeService
REPO_MySQL --> DB_MySQL : JPA/Flyway
WardrobeController --> WardrobeService
WardrobeService --> AI
WardrobeService --> EV
WardrobeService --> JobQueuePort
WardrobeService --> REPO_MySQL
WardrobeService ..> AssetCatalogService
WardrobeService ..> BrandLogoService
WardrobeService ..> FlatLayPipeline
WardrobeService ..> MediaService
WardrobeService ..> Model3dService
WardrobeService ..> NotificationService
WardrobeService ..> ProjectionService
@enduml
