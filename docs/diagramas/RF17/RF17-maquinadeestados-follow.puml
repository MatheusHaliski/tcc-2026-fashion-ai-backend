@startuml RF17_MaquinaDeEstados_Follow
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  StartColor #20A77A
  EndColor #4B5563
}
title RF17 — ciclo de vida de Follow.status\nDiagrama de máquina de estados — gerado do código em 2026-10-06 (scripts/diagramas/v5)\nenum FollowStatus · tabela follows

state "Follow.status" as Ciclo_Follow {
  state Ciclo_Follow_PENDENTE as "PENDENTE"
  state Ciclo_Follow_ACEITO as "ACEITO"
  state Ciclo_Follow_BLOQUEADO as "BLOQUEADO"
}
[*] --> Ciclo_Follow_ACEITO : criação
Ciclo_Follow --> Ciclo_Follow_BLOQUEADO : block()\nPUT /api/users/{targetId}/block
Ciclo_Follow_PENDENTE --> Ciclo_Follow_ACEITO : respond()\nPOST /api/follow-requests/{followId}
note bottom of Ciclo_Follow
  Sem mudança explícita no código para: PENDENTE
  (valor vindo de importação, regra calculada ou dado legado)
end note
note right of Ciclo_Follow
  Setas que saem da borda: a mudança vale
  a partir de qualquer estado (o código não
  testa o estado anterior).
end note
@enduml
