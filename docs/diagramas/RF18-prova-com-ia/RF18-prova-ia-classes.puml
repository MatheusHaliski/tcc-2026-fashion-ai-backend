@startuml RF18_ProvaIA_Classes
' v5: escrito à mão — o caminho passa pelo worker e pela GPU em Python (services/anatomical_vton), que scripts/diagramas/v5 não lê
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  StereotypeFontColor #6B6470
}
hide empty members
left to right direction
title RF18 — Prova com IA: tipos do diálogo, da API, do worker e da GPU\nDiagrama de classes — escrito à mão e conferido com o código em 2026-10-18

package "Frontend · components/try-on" {
  class GpuLookDialog <<React>> {
    mode: "look" | "piece"
    photo: {url, preview} | null
    consent: boolean
    busy: "upload" | "render" | null
    result: Render | null
    error: string | null
    upload(file) · generate() · message(e)
  }
  class "gpu-look-dialog.tsx" as GLDMod <<module>> {
    GPU_CATEGORIES = [full_body_piece, lower_piece, upper_piece]
    MAX_SIDE = 1536
    isGpuCategory(category)
    gpuLook(pieces): GpuPiece[]
    refusalKey(reason): string | null
    fitted(file): Blob
  }
  class GpuPiece <<interface>> {
    pieceId: string
    name: string
    category: string
  }
  class Render <<interface>> {
    status · url
    diagnostics {gpuName, latencyMs}
    steps[] {pieceId, category, url}
    skipped[]
  }
  class AiTryOnDialog <<React>> {
    aiCandidates(items: FittingItem[])
  }
}
package "API · fai-web / fai-application / fai-infrastructure" {
  class TryOnPersonPhotoController <<RestController>> {
    upload() POST /person-photos
  }
  class TryOnPersonPhotoService <<Service>> {
    upload(user, bytes): Map
    grava em restricted/users/{id}/tryon/person/
  }
  class AnatomicalTryOnController <<RestController>> {
    look() POST /look-renders
    render() POST /anatomical-renders
  }
  class AnatomicalTryOnService <<Service>> {
    LOOK_ORDER = [full_body_piece, lower_piece, upper_piece]
    renderLook(user, LookRequest): Map
    render(user, Request): Map
    validateOutput(png)
  }
  class LookRequest <<record>> {
    pieceIds: List<UUID>
    personMediaUrl: String
    processingConsent: boolean
  }
  class AnatomicalTryOnPort <<interface>> {
    available(): boolean
    render(garmentId, garment, person, category, bodyEvidence, mirror): Map
  }
  class AnatomicalTryOnAdapter <<Component>> {
    url · token · timeout (75–650 s, padrão 650)
    post(path, body)
    reasonOf(body): String
  }
  enum "MediaService.MediaScope" as MediaScope {
    OWNER
    PRIVATE_TRY_ON
  }
}
package "Worker · services/anatomical_vton (Cloud Run)" {
  class TryOnInput <<pydantic>> {
    garment_id · garment_image
    person_image
    garment_category
    mirror: bool
  }
  class VertexPredictionClient {
    payload_limit (9 MB no host dedicado)
    timeout (600 s no host dedicado)
    predict(instance): dict
  }
  class "google_cloud.py" as GCMod <<module>> {
    SERVER_CODES: frozenset
    server_code(response): str | None
    predict_fashn(person, garment, category)
  }
  class AlignmentError <<ValueError>> {
    código curto → HTTP 422 {"code"}
  }
}
package "GPU · vertex_runtime (Vertex AI · T4)" {
  class Instance <<pydantic>> {
    task: virtual_try_on | …
    person_image · garment_image
    category: tops | bottoms | one-pieces
    garment_photo_type = auto
    num_timesteps = 30 · seed = 42
  }
  class NativeFashnRuntime {
    tasks = (virtual_try_on,)
    ready: bool
    predict(instance): dict
  }
  class "fashn_runtime.py" as FRMod <<module>> {
    CATEGORIES · fashion_category(category)
    serving_dtype(torch): bfloat16 | float32
    detected_pose(rgb, estimator, detector)
    pose_screen(original, rendered, …)
    inferred_photo_type(garment_pose)
  }
}

AiTryOnDialog --> GpuLookDialog : peças do guarda-roupa
GpuLookDialog ..> GLDMod
GpuLookDialog --> "0..*" GpuPiece
GpuLookDialog --> "0..1" Render
GpuLookDialog ..> TryOnPersonPhotoController : foto (multipart)
GpuLookDialog ..> AnatomicalTryOnController : HTTPS/JSON
TryOnPersonPhotoController --> TryOnPersonPhotoService
TryOnPersonPhotoService ..> MediaScope : PRIVATE_TRY_ON
AnatomicalTryOnController --> AnatomicalTryOnService
AnatomicalTryOnService ..> LookRequest
AnatomicalTryOnService ..> MediaScope
AnatomicalTryOnService --> AnatomicalTryOnPort
AnatomicalTryOnAdapter ..|> AnatomicalTryOnPort
AnatomicalTryOnAdapter ..> TryOnInput : POST /try-on
TryOnInput ..> GCMod
GCMod --> VertexPredictionClient
VertexPredictionClient ..> Instance : POST :predict
GCMod ..> AlignmentError
Instance ..> NativeFashnRuntime
NativeFashnRuntime ..> FRMod
FRMod ..> AlignmentError
@enduml
