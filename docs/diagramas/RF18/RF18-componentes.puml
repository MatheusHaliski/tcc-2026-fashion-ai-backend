@startuml RF18_Componentes
title RF18 — Usar o Provador virtual de lojas\nDiagrama de componentes — telas → controllers → serviços → portas/repositórios → MySQL e navegador
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
left to right direction
package "Frontend (Next.js · React Three Fiber)" {
  component "app/(site)/(app)/try-on/page.tsx\n(FittingRoom: abas Lojas · Meu guarda-roupa · Provas salvas)" as P
  component "components/catalog/catalog-search.tsx\n(CatalogSearch modo navegação, botão Provar)" as CSF
  component "components/three/fitting-room-scene.tsx\n(loja 3D: faixa do logo, letreiro, painéis)" as SCN
  component "components/three/mannequin.tsx\n(Avatar 3D / manequim de referência)" as MAN
  component "lib/tryon/fitting-room.ts\n(wearItem · visibleItems · resolveEnvironment ·\nenvironmentFor · encode/decodeTryOn)" as ENV
  component "lib/api/catalog.ts (catalogApi)\nlib/api/client.ts (api)" as API
}
component "Navegador\nsessionStorage fai.tryon.fitting\nlocalStorage fai.tryon.saved" as BR
package "fai-web · controllers" {
  component "TryOnController\nGET /api/try-on\n(PUT /preferences · POST /renders ·\nPOST /schemes — legado, a tela não usa)" as TC
  component "CatalogController\nGET /api/catalog/stores · /search · /products/{id}\nPOST /api/catalog/discover\nPOST /api/pieces/from-catalog" as CC
}
package "fai-application · services" {
  component "TryOnService" as TS
  component "Avatar3dService\n(forMannequin)" as AV
  component "CatalogService\n(catalogBrands · search · product ·\ndiscover · addToWardrobe)" as CS
  component "WardrobeService\n(createFromCatalog)" as WS
  component "AiEngine (RF24)\nTRY_ON — só no render legado" as AI
}
package "fai-domain · repositórios" {
  component "UserPreferencesRepository · UserRepository\nUserAvatar3dRepository · WardrobeItemRepository\nBrandRepository · CatalogProductRepository\nCatalogVariantRepository · CatalogImageRepository" as REP
}
database "MySQL\n• user_preferences · users\n• user_avatars_3d · wardrobe_items\n• brands · catalog_products\n• catalog_variants · catalog_images" as DB

P --> CSF : usa
P --> ENV : estado da prova e ambiente
P --> SCN : pieces + environment + luz + vista
SCN --> MAN : veste o Avatar
P --> API
CSF --> API
API --> TC : HTTPS/JSON
API --> CC : HTTPS/JSON
P --> BR : prova da sessão e provas salvas
TC --> TS
TS --> AV
TS ..> AI
CC --> CS
CS --> WS : cria por referência
TS --> REP
AV --> REP
CS --> REP
WS --> REP
REP --> DB : JPA/Flyway
@enduml
