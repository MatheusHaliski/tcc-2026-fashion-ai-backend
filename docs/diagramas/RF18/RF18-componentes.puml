@startuml RF18_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF18 — Usar o Provador virtual de lojas: peças de várias marcas do catálogo no Avatar 3D, com ambiente por marca\nDiagrama de componentes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "Frontend (Next.js)" {
  component "/pieces/new\n(site)/(app)/pieces/new/page.tsx" as FE0
  component "/try-on\n(site)/(app)/try-on/page.tsx" as FE1
  component "lib/api/client.ts" as APIC
}
package "fai-web (REST)" {
  component "CatalogController\n/api/catalog/brands\n/api/catalog/products/{…}\n/api/catalog/search\n/api/catalog/stores\n(+1 rotas)" as CatalogController
  component "TryOnController\n/api/try-on\n/api/try-on/preferences\n/api/try-on/renders\n/api/try-on/schemes" as TryOnController
  component "WardrobeController\n/api/pieces\n/api/pieces/{…}" as WardrobeController
}
package "fai-application (casos de uso)" {
  component "CatalogService" as CatalogService
  component "TryOnService" as TryOnService
  component "WardrobeService" as WardrobeService
  component "CatalogIngestService" as CatalogIngestService <<apoio>>
  component "OfficialCatalogDiscovery" as OfficialCatalogDiscovery <<apoio>>
  component "SchemeService" as SchemeService <<apoio>>
  component "TryOnCompositor" as TryOnCompositor <<apoio>>
  component "MediaService" as MediaService <<apoio>>
  component "Avatar3dService" as Avatar3dService <<apoio>>
  component "OwnMedia" as OwnMedia <<apoio>>
  component "FlatLayPipeline" as FlatLayPipeline <<apoio>>
  component "JobQueuePort\n«InMemoryJobQueue»" as JobQueuePort <<port>>
}
package "fai-domain (repositórios)" {
  component "CatalogProductRepository\nCatalogVariantRepository\nCatalogImageRepository\nCatalogProductAliasRepository\nCatalogSourceRepository\nBrandRepository\nBrandAliasRepository\nWardrobeItemRepository\nUserPreferencesRepository\nUserRepository\n(+9)" as REPO_MySQL
}
database "MySQL\n• brand_aliases\n• brands\n• catalog_images\n• catalog_product_aliases\n• catalog_products\n• catalog_sources\n• catalog_variants\n• moderation_queue\n• photos\n• pipeline_jobs\n• processing_jobs_log\n• quality_scores\n(+7)" as DB_MySQL
cloud "Motor de IA (RF24)\nprovedores externos + reserva local" as AI
component "Eventos de domínio\n(@TransactionalEventListener)" as EV
APIC --> CatalogController : HTTPS/JSON
APIC --> TryOnController : HTTPS/JSON
APIC --> WardrobeController : HTTPS/JSON
CatalogController --> CatalogService
CatalogService --> REPO_MySQL
CatalogService ..> CatalogIngestService
CatalogService ..> OfficialCatalogDiscovery
CatalogService ..> WardrobeService
FE0 --> APIC
FE1 --> APIC
REPO_MySQL --> DB_MySQL : JPA/Flyway
TryOnController --> TryOnService
TryOnService --> AI
TryOnService --> REPO_MySQL
TryOnService ..> Avatar3dService
TryOnService ..> MediaService
TryOnService ..> OwnMedia
TryOnService ..> SchemeService
TryOnService ..> TryOnCompositor
TryOnService ..> WardrobeService
WardrobeController --> WardrobeService
WardrobeService --> AI
WardrobeService --> EV
WardrobeService --> JobQueuePort
WardrobeService --> REPO_MySQL
WardrobeService ..> FlatLayPipeline
WardrobeService ..> MediaService
WardrobeService ..> OwnMedia
@enduml
