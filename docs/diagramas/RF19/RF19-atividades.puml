@startuml RF19_Atividades
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam activity {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  DiamondBackgroundColor #FFF5F8
  DiamondBorderColor #F08DB1
  StartColor #20A77A
  EndColor #4B5563
}
skinparam swimlane {
  BorderColor #CBC6BE
  TitleFontColor #2D2438
}
title RF19 — Interagir socialmente com esquemas e peças: reagir, comentar, salvar, compartilhar, remixar e retornar\nDiagrama de atividades — gerado do código em 2026-10-06 (scripts/diagramas/v5)

|Pessoa usuária|
start
:Abre /schemes/[id], /pieces/[id],\n/schemes/[id]/edit;
|Tela (Next.js)|
:Carrega os dados da tela\nGET /api/schemes/{id}\nGET /api/pieces/{id}\nGET /api/pieces/{id}/model3d\nGET /api/studio/backdrops;
|Pessoa usuária|
:Remixar conteúdo público para o meu\nacervo;
|Tela (Next.js)|
:POST /api/interactions/{type}/{id}/remixes;
|API (Spring Boot)|
:SocialController.remix\n→ SocialService.remix;
if (Peça não encontrado[a]?) then (sim)
  :404 NAO_ENCONTRADO\n«Peça não encontrado(a)»\n→ a tela mostra o aviso;
  stop
endif
if (indisponível?) then (sim)
  :409 INDISPONIVEL\n«O autor marcou este conteúdo como\nindisponível para remix.»\n→ a tela mostra o aviso;
  stop
endif
|Dados e serviços|
:Lê: schemes\nwardrobe_items\ndna_schemes;
:Usa: Guard.requireCanCreate\nSchemeService.requireView\nGuard.requireView\nSchemeService.remix\nCounterStorePort.increment\nNotificationService.notify;
:Evento: HypeSignal;
|Tela (Next.js)|
:Atualiza a tela com a resposta;
|Pessoa usuária|
if (Faz outra ação?) then (sim)
  switch (Qual?)
  case (Remixar um esquema público para o…)
    :POST /api/schemes/{id}/remix\n→ SchemeService.remix\nvalida: INDISPONIVEL, NAO_ENCONTRADO\nlê: schemes, scheme_items\nusa: Guard.requireCanCreate, Guard.requireView,\nWardrobeService.eligible;
  case (Excluir a peça)
    :DELETE /api/pieces/{id}\n→ WardrobeService.delete\nlê: wardrobe_items, scheme_items\nusa: Guard.requireCanCreate, Guard.requireOwner,\nProjectionService.removePiece …\nestado: availabilityStatus → ARCHIVED, disponivel →\nfalse, visibility → PRIVATE;
  case (Salvar esquema [manual, IA, autop…)
    :POST /api/schemes\n→ SchemeService.create\nvalida: FORMULARIO_INVALIDO, FOTO_INVALIDA,\nINDISPONIVEL, NAO_ENCONTRADO …\nlê: users, schemes, wardrobe_items …\nusa: Guard.requireCanCreate, Guard.requireView,\nBackgroundStudioService.applyToScheme …\ngrava: schemes, scheme_items;
  case (Editar esquema)
    :PUT /api/schemes/{id}\n→ SchemeService.update\nvalida: FORMULARIO_INVALIDO, FOTO_INVALIDA,\nPECA_DE_OUTRO_USUARIO, PECA_INDISPONIVEL …\nlê: schemes, scheme_items, wardrobe_items …\nusa: Guard.requireCanCreate, Guard.requireOwner,\nBackgroundStudioService.applyToScheme …\ngrava: scheme_items;
  case (Editar a peça)
    :PUT /api/pieces/{id}\n→ WardrobeService.update\nvalida: FORMULARIO_INVALIDO\nlê: wardrobe_items, brands, reactions\nusa: Guard.requireCanCreate, Guard.requireOwner,\nOwnMedia.accepts …\nestado: brandLogoUrl → null, brandLogoUrl → set;
  endswitch
  note right
  Outras ações deste RF:
  Cadastrar a peça a partir do…, Excluir o look
  (menu ⋯ do don…, Apagar comentário (autor ou d…,
  Solicitar modelo 3D da peça
  end note
  |Tela (Next.js)|
  :Atualiza a tela;
endif
|Pessoa usuária|
stop
@enduml
