@startuml RF19_Classes
title RF19 — Interagir socialmente com esquemas e peças: reagir, comentar, salvar, compartilhar, remixar e retornar\nDiagrama de classes — entidades JPA reais (fai-domain) e enums
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  HeaderBackgroundColor #E4DEF0
}
skinparam packageStyle rectangle
hide empty methods

package "fai-domain · model" {
class User {
  +username: String
  +displayName: String
  +profileType: ProfileType
}
class Reaction {
  +actor: User
  +targetType: TargetType
  +targetId: UUID
  +reactionType: ReactionType
}
class Comment {
  +author: User
  +targetType: TargetType
  +targetId: UUID
  +parentCommentId: UUID
  +content: String
  +active: boolean
}
class SavedItem {
  +user: User
  +targetType: TargetType
  +targetId: UUID
  +savedAt: Instant
  +favorite: boolean
}
class Share {
  +user: User
  +targetType: TargetType
  +targetId: UUID
  +channel: ShareChannel
  +caption: String
  +exportUrl: String
}
class Notification {
  +recipient: User
  +actor: User
  +type: NotificationType
  +category: NotificationCategory
  +resourceType: String
  +resourceId: UUID
  +delivered: boolean
  +read: boolean
}
class Scheme {
  +user: User
  +originalScheme: Scheme
  +origin: SchemeOrigin
  +visibility: Visibility
  +disponivel: boolean
  +likeCount: long
  +commentCount: long
  +shareCount: long
  +remixCount: long
  +saveCount: long
}
class WardrobeItem {
  +user: User
  +name: String
  +disponivel: boolean
  +likesCount: long
  +commentCount: long
  +sharesCount: long
  +remixesCount: long
}
class SchemeItem {
  +scheme: Scheme
  +wardrobeItem: WardrobeItem
  +slot: SchemeSlot
}
class HypeSignalDaily <<RF53>> {
  +entityType: HypeEntityType
  +entityId: UUID
  +signalType: HypeSignalType
  +signalDate: LocalDate
  +eventCount: int
  +weightedCount: BigDecimal
  +updatedAt: Instant
}
}
package "fai-domain · enums" {
enum ReactionType {
  LIKE
  TREND
  ELEGANTE
  CRIATIVO
}
enum ShareChannel {
  FEED
  EXTERNAL
}
enum TargetType {
  PIECE
  SCHEME
  DNA
}
enum NotificationType {
  NEW_LIKE
  NEW_REACTION
  NEW_COMMENT
  NEW_REMIX
  ..
}
enum HypeSignalType <<RF53>> {
  LIKE_CREATED
  COMMENT_CREATED
  SAVE_CREATED
  SHARE_CREATED
  FAVORITE_CREATED
  LOOK_REMIXED
  PIECE_REMIXED
  LOOK_VIEWED
  PIECE_VIEWED
  PIECE_USED
  PIECE_IN_LOOK
  LOOK_WORN
}
enum HypeEntityType {
  PIECE
  SCHEME
}
}
package "fai-application · service" {
class SocialService {
  {static} COMMENT_MAX = 500
  +react(user, type, id, reaction): Map
  +comments(viewer, type, id): List
  +comment(user, type, id, content, parentId): Map
  +deleteComment(user, commentId)
  +toggleSave(user, type, id): Map
  +favoriteSaved(user, type, id, favorite): Map
  +share(user, type, id, channel, caption): Map
  +remix(user, type, id): Map
  +returnToOrigin(user, pieceId, fromSchemeId): Map
  +counters(viewer, type, id): Map
  -hypeSignal(t, actorId, signal) <<RF53>>
}
}
package "fai-application · hype <<RF53>>" {
class "DomainEvents.HypeSignal" as HypeSignal <<record>> {
  +signal: HypeSignalType
  +entityType: HypeEntityType
  +entityId: UUID
  +actorId: UUID
  +ownerId: UUID
}
class HypeSignalRecorder {
  +onSignal(HypeSignal)
  ~record(HypeSignal)
}
class HypeIntegrityPolicy {
  {static} OWNER_ACTIONS = PIECE_USED, PIECE_IN_LOOK, LOOK_WORN
  {static} -DEDUPE_TTL = 26 h
  +weight(HypeSignal, day): double
  ~isNewAccount(actorId): boolean
}
interface HypeSignalDailyRepository {
  +increment(id, entityType, entityId, signalType, day, weight, now): int
}
}
Reaction "*" --> "1" User : actor
Comment "*" --> "1" User : author
SavedItem "*" --> "1" User
Share "*" --> "1" User
Notification "*" --> "1" User : recipient
Scheme "*" --> "1" User
Scheme "*" --> "0..1" Scheme : originalScheme (remix)
WardrobeItem "*" --> "1" User
SchemeItem "*" --> "1" Scheme
SchemeItem "*" --> "1" WardrobeItem
Reaction ..> ReactionType
Reaction ..> TargetType
Share ..> ShareChannel
Notification ..> NotificationType
SocialService ..> Reaction
SocialService ..> Comment
SocialService ..> SavedItem
SocialService ..> Share
SocialService ..> HypeSignal : publica (LIKE, COMMENT, SAVE,\nFAVORITE, SHARE, PIECE_REMIXED)
HypeSignal ..> HypeSignalType
HypeSignal ..> HypeEntityType
HypeSignalRecorder ..> HypeSignal : consome (AFTER_COMMIT)
HypeSignalRecorder ..> HypeIntegrityPolicy : weight
HypeSignalRecorder ..> HypeSignalDailyRepository : increment (peso > 0)
HypeSignalDailyRepository ..> HypeSignalDaily
HypeSignalDaily ..> HypeSignalType
note bottom of Reaction : uq_reactions_actor_target —\nsem curtida duplicada (CA02)
note bottom of SchemeItem : returnToOrigin (CA14) percorre\nscheme_items por wardrobe_item_id
note bottom of HypeSignalDaily : tabela hype_signal_daily\nnovo (RF53 · HypeScore v2)
note bottom of HypeSignalDailyRepository : @Modifying nativo: INSERT … ON DUPLICATE KEY UPDATE\nevent_count + 1, weighted_count + peso
note bottom of HypeIntegrityPolicy : 0 = visitante, próprio dono (fora OWNER_ACTIONS)\nou repetido no dia (hype:dedupe:* no RenderCachePort);\nconta nova (< 7 dias) = 0,5; demais = 1
note top of HypeSignal : também publicado por SchemeService\n(LOOK_REMIXED, LOOK_VIEWED) e\nWardrobeService (PIECE_VIEWED)
@enduml
