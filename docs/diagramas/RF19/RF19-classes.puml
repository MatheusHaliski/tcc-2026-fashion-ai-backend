package "fai-domain (enums)" {
  enum SchemeStatus {
    DRAFT
    PUBLISHED
    ARCHIVED
  }
  enum RenderStatus {
    PENDING
    RENDERING
    ENHANCING
    COMPOSITING
    CACHED
    COMPLETED
    FAILED
  }
  enum AccountStatus {
    PENDING_EMAIL_VERIFICATION
    ACTIVE
    PENDING_VALIDATION
    SUSPENDED
    DELETION_SCHEDULED
    DELETED
  }
  enum AvailabilityStatus {
    AVAILABLE
    UNAVAILABLE
    ARCHIVED
  }
  enum ModerationStatus {
    PENDING
    APPROVED
    REJECTED_POLICY
    REJECTED_NOT_CLOTHING
  }
  enum PhotoProcessingStatus {
    NEW
    MODERATING
    PROCESSING
    COMPLETED
    NEEDS_REUPLOAD
    FAILED
  }
}
package "fai-application" {
  class SchemeService <<service>> {
    +remix()
  }
}
SchemeService ..> Reaction : usa
SchemeService ..> SavedItem : usa
SchemeService ..> Scheme : usa
SchemeService ..> SchemeItem : usa
SchemeService ..> User : usa
SchemeService ..> WardrobeItem : usa
Comment "*" --> "1" User : author
Notification "*" --> "1" User : actor
Notification "*" --> "1" User : recipient
Reaction "*" --> "1" User : actor
SavedItem "*" --> "1" User : user
Scheme "*" --> "1" User : user
Scheme --> RenderStatus
Scheme --> SchemeStatus
SchemeItem "*" --> "1" Scheme : scheme
SchemeItem "*" --> "1" WardrobeItem : wardrobeItem
Share "*" --> "1" User : user
User --> AccountStatus
WardrobeItem "*" --> "1" User : user
WardrobeItem --> AvailabilityStatus
WardrobeItem --> ModerationStatus
WardrobeItem --> PhotoProcessingStatus
@enduml
