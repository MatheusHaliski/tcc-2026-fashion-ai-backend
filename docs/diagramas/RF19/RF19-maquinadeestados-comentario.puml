@startuml RF19_MaquinaDeEstados_Comentario
!pragma layout smetana
title RF19 — Interagir socialmente com esquemas e peças\nDiagrama de máquina de estados — Comment (active) e a notificação NEW_COMMENT ao autor do conteúdo
skinparam backgroundColor #FFFFFF
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  ArrowColor #52606D
}
state "Digitando\n(CommentsDialog)" as Digitando
state "Validando\n(SocialService.comment)" as Validando
state "Rejeitado\n(nada gravado)" as Rejeitado
state "Publicado (active = true)" as Publicado {
  state "Notificação NEW_COMMENT" as Notif {
    state "Entregue\n(delivered = true,\nprojeção Cassandra)" as Entregue
    state "Só contabilizada\n(delivered = false)" as Contada
    state "Não criada\n(comentário no próprio conteúdo)" as Nenhuma
    [*] --> Entregue : tipo habilitado
    [*] --> Contada : tipo desativado ou push master desligado
    [*] --> Nenhuma : ator = dono
  }
  state "Sinal COMMENT_CREATED\n(AFTER_COMMIT)" as Sinal {
    state "Agregado em hype_signal_daily" as Agregado
    state "Descartado (peso 0)" as Descartado
    [*] --> Agregado : outra pessoa, primeiro do dia
    [*] --> Descartado : dono, visitante ou repetido no dia
  }
}
state "Excluído\n(active = false)" as Excluido

[*] --> Digitando : abre os comentários (logado)
Digitando --> Validando : POST /api/interactions/{type}/{id}/comments\n{content, parentId}
Validando --> Rejeitado : sem permissão (login, e-mail, conta),\nalvo invisível/bloqueado → 401/403/404
Validando --> Rejeitado : vazio · mais de 500 · ofensivo\n→ 400 COMENTARIO_VAZIO · COMENTARIO_LONGO\n· CONTEUDO_BLOQUEADO
Rejeitado --> Digitando : corrige o texto
Validando --> Publicado : INSERT comments · commentCount + 1\n→ 201
Publicado --> Publicado : resposta (parentCommentId)\n= novo Comment
Publicado --> Publicado : DELETE por terceiro\n→ 403 (Guard.deny, auditado)
Publicado --> Excluido : DELETE /api/comments/{commentId}\n[autor do comentário ou dono do conteúdo]\n→ 204
Excluido --> [*] : commentCount − 1; some de\nfindBy…ActiveTrue (a linha fica)

note right of Excluido
  Excluir não desfaz o sinal de Hype nem a
  notificação já gravada; os pontos
  COMMENT_RECEIVED também ficam.
end note
@enduml
