@startuml RF19_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."
title RF19 — Interagir socialmente com esquemas e peças: reagir, comentar, salvar, compartilhar, remixar e retornar\nDiagrama de sequência — gerado do código em 2026-10-06 (scripts/diagramas/v5)

actor "Pessoa usuária" as U
boundary "Tela (Next.js)" as P
control "SocialController" as SocialController
participant "SocialService" as SocialService
participant "Guard" as Guard
database "MySQL" as DB_MySQL
participant "SchemeService" as SchemeService
participant "CounterStorePort\n(InMemoryCounterStore)" as CounterStorePort
participant "NotificationService" as NotificationService
queue "Eventos de domínio" as EV
== Reagir (curtir etc.) a esquema, peça ou comentário; repetir remove ==
U -> P : Reagir (curtir etc.) a esquema, peça ou comentári…
P -> SocialController : POST /api/interactions/{type}/{id}/reactions
SocialController -> SocialService : react()
activate SocialService
SocialService -> Guard : requireCanCreate()
SocialService -> DB_MySQL : SELECT schemes
SocialService -> SchemeService : requireView()
SocialService -> DB_MySQL : SELECT wardrobe_items
alt Peça não encontrado(a)
SocialService --> SocialController : 404 NAO_ENCONTRADO
SocialController --> P : 404 + mensagem
end
SocialService -> Guard : requireView()
SocialService -> DB_MySQL : SELECT dna_schemes
SocialService -> Guard : requireView()
SocialService -> DB_MySQL : SELECT reactions
SocialService -> DB_MySQL : DELETE reactions
SocialService -> CounterStorePort : increment()
SocialService -> SocialService : new Reaction()
SocialService -> DB_MySQL : SELECT users
SocialService -> SocialService : targetType = ?type
SocialService -> SocialService : reactionType = ?reaction
SocialService -> DB_MySQL : INSERT/UPDATE reactions
SocialService -> CounterStorePort : increment()
SocialService -> NotificationService : notify()
NotificationService -> DB_MySQL : SELECT users (×2)
NotificationService -> DB_MySQL : SELECT user_preferences
NotificationService -> DB_MySQL : INSERT/UPDATE notifications
NotificationService --> SocialService
SocialService ->> EV : InteractionReceived
SocialService ->> EV : HypeSignal
SocialService -> DB_MySQL : SELECT reactions
deactivate SocialService
SocialService --> SocialController : resultado
SocialController --> P : 201 JSON
P --> U : atualiza a tela
@enduml
