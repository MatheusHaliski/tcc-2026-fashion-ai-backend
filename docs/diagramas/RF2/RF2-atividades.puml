@startuml RF2_Atividades
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam activity {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  DiamondBackgroundColor #FFF5F8
  DiamondBorderColor #F08DB1
  StartColor #20A77A
  EndColor #4B5563
}
skinparam swimlane {
  BorderColor #CBC6BE
  TitleFontColor #2D2438
}
title RF2 — Autenticar usuário na plataforma com credenciais de acesso\nDiagrama de atividades — gerado do código em 2026-10-06 (scripts/diagramas/v5)

|Pessoa usuária|
start
:Abre /login, /closet, /reset-password;
|Tela (Next.js)|
:Monta a tela;
|Pessoa usuária|
:Autenticar por e-mail/username e\nsenha (2FA opcional);
|Tela (Next.js)|
:POST /api/auth/login;
|API (Spring Boot)|
:AuthController.login\n→ IdentityService.login;
if (erro?) then (sim)
  :500 ERRO\n→ a tela mostra o aviso;
  stop
endif
if (erro?) then (sim)
  :500 ERRO\n→ a tela mostra o aviso;
  stop
endif
if (erro?) then (sim)
  :500 ERRO\n→ a tela mostra o aviso;
  stop
endif
if (conta indisponível?) then (sim)
  :403 CONTA_INDISPONIVEL\n«Esta conta não está disponível.»\n→ a tela mostra o aviso;
  stop
endif
if (dois fatores necessario?) then (sim)
  :401 DOIS_FATORES_NECESSARIO\n«Enviamos um código de verificação\npara o seu e-mail.»\n→ a tela mostra o aviso;
  stop
endif
note right
  e mais 2 validações:
  NAO_AUTENTICADO
end note
|Dados e serviços|
:Lê: users\nverification_codes\nrefresh_tokens;
:Usa: RateLimitPort.tryAcquire\nPasswordHasherPort.matches\nRateLimitPort.release\nPasswordHasherPort.needsRehash\nPasswordHasherPort.hash\nRateLimitPort.reset (+3);
:Grava: refresh_tokens;
:Estado: consumedAt → set\nlastLoginAt → set\npersistent → ?persistent\nexpiresAt → set\nlastUsedAt → set;
|Tela (Next.js)|
:Atualiza a tela com a resposta;
|Pessoa usuária|
if (Faz outra ação?) then (sim)
  switch (Qual?)
  case (Renovar access token com rotação…)
    :POST /api/auth/refresh\n→ IdentityService.refresh\nvalida: NAO_AUTENTICADO\nlê: refresh_tokens\nusa: TokenIssuerPort.issueAccessToken,\nTokenIssuerPort.accessTokenTtl\ngrava: refresh_tokens;
  case (Definir nova senha com o token re…)
    :POST /api/auth/password-reset/confirm\n→ IdentityService.confirmPasswordReset\nvalida: FORMULARIO_INVALIDO, LINK_INVALIDO\nlê: verification_codes, refresh_tokens\nusa: PasswordHasherPort.hash, RateLimitPort.reset\nestado: consumedAt → set, revokedAt → set;
  case (Pedir redefinição de senha [respo…)
    :POST /api/auth/password-reset/request\n→ IdentityService.requestPasswordReset\nlê: users, user_preferences\nusa: RateLimitPort.tryAcquire,\nEmailSenderPort.send,\nNotificationService.notify\ngrava: verification_codes;
  case (Encerrar a sessão atual)
    :POST /api/auth/logout\n→ IdentityService.logout\nlê: refresh_tokens\nestado: revokedAt → set;
  case (Trocar senha [encerra as outras s…)
    :PUT /api/auth/password\n→ IdentityService.changePassword\nvalida: FORMULARIO_INVALIDO, SENHA_ATUAL_INCORRETA\nlê: users, verification_codes, refresh_tokens\nusa: PasswordHasherPort.hash\nestado: consumedAt → set, revokedAt → set;
  endswitch
  note right
  Outras ações deste RF:
  Confirmar e-mail com o código…, Reenviar código de
  confirmaçã…
  end note
  |Tela (Next.js)|
  :Atualiza a tela;
endif
|Pessoa usuária|
stop
@enduml
