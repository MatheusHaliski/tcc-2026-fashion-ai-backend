@startuml RF2_Classes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  StereotypeFontColor #6B6470
}
hide empty members
left to right direction
title RF2 — Autenticar usuário na plataforma com credenciais de acesso\nDiagrama de classes — gerado do código em 2026-10-14 (scripts/diagramas/v5)

package "components/photo-edit/piece-photo-editor.tsx" {
  class Session as "Session" <<interface>> {
    +originalUrl: string
    +width: number
    +height: number
    +category: string
    +currentRecipe: { target?: string; ops?: Op[] } | null
  }
  class Quality as "Quality" <<interface>> {
    +sharpness: number
    +exposure: number
    +occupancy: number
    +colorDeltaE: number
    +touchesEdge: boolean
    +cutConfidence: number
    +width: number
    +height: number
  }
  class Version as "Version" <<interface>> {
    +id: string
    +target: Target
    +url: string
    +current: boolean
    +createdAt: string
    +recipe: { target?: string; ops?: Op[] }
    +warnings: string[]
    +syntheticShadow: boolean
  }
  class Preview as "Preview" <<interface>> {
    +png: string
    +quality: Quality
    +warnings: string[]
  }
  enum Tool as "Tool" {
    adjust
    crop
    cutout
    present
    review
  }
  enum Pointer as "Pointer" {
    none
    brush
    eyedropper
    heal
  }
  class mod_piece_photo_editor_tsx as "piece-photo-editor.tsx" <<módulo>> {
    +PiecePhotoEditor()
  }
}
package "Backend (Java)" {
  class PasswordHasherPort <<interface>> {
    +hash()
    +matches()
    +needsRehash()
  }
  class RateLimitPort <<interface>> {
    +tryAcquire()
    +status()
    +reset()
    +release()
  }
  class TokenIssuerPort <<interface>> {
    +issueAccessToken()
    +accessTokenTtl()
  }
  class IdentityService <<service>> {
    -audit: Audit
    -frontendUrl: String
    -dummyHash: String
    -mailExecutor: Executor
    +setIssuerReview()
    +preRegistrationUpload()
    +pendingUpload()
    +purgeStalePendingUploads()
    +pendingReferenced()
    +register()
    +readQuietly()
    +claimPendingUpload()
  }
  class Argon2PasswordHasher  {
    -encoder: Argon2PasswordEncoder
    +hash()
    +matches()
    +needsRehash()
  }
  class JwtTokenIssuer  {
    -encoder: JwtEncoder
    -issuer: String
    -audience: String
    -ttl: Duration
    +issueAccessToken()
    +accessTokenTtl()
  }
  class SessionActiveFilter  {
    -errors: ErrorWriter
    +doFilterInternal()
  }
}
IdentityService --> PasswordHasherPort
IdentityService --> TokenIssuerPort
IdentityService --> RateLimitPort
SessionActiveFilter --> IdentityService
Preview --> Quality : quality
@enduml
