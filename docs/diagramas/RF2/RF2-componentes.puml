@startuml RF2_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF2 — Autenticar usuário na plataforma com credenciais de acesso\nDiagrama de componentes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "Frontend (Next.js)" {
  component "/forgot-password\n(site)/(auth)/forgot-password/page.tsx" as FE0
  component "/login\n(site)/(auth)/login/page.tsx" as FE1
  component "/closet\n(site)/(app)/closet/page.tsx" as FE2
  component "/reset-password\n(site)/(auth)/reset-password/page.tsx" as FE3
  component "/verify-email\n(site)/(auth)/verify-email/page.tsx" as FE4
  component "/settings\n(site)/(app)/settings/page.tsx" as FE5
  component "lib/api/client.ts" as APIC
}
package "fai-web (REST)" {
  component "AuthController\n/api/auth/login\n/api/auth/logout\n/api/auth/password-reset/confirm\n/api/auth/password-reset/request\n(+1 rotas)" as AuthController
}
package "fai-application (casos de uso)" {
  component "IdentityService" as IdentityService
  component "NotificationService" as NotificationService <<apoio>>
  component "PasswordHasherPort\n«Argon2PasswordHasher»" as PasswordHasherPort <<port>>
  component "TokenIssuerPort\n«JwtTokenIssuer»" as TokenIssuerPort <<port>>
  component "RateLimitPort\n«InMemoryRateLimit»" as RateLimitPort <<port>>
  component "EmailSenderPort\n«LoggingEmailSender / ResendEmailSender»" as EmailSenderPort <<port>>
  component "MediaStoragePort\n«LocalFileMediaStorage / S3MediaStorageAdapter»" as MediaStoragePort <<port>>
}
package "fai-domain (repositórios)" {
  component "UserRepository\nUserPreferencesRepository\nBrandProfileRepository\nCelebrityProfileRepository\nRefreshTokenRepository\nVerificationCodeRepository" as REPO_MySQL
}
database "MySQL\n• brand_profiles\n• celebrity_profiles\n• refresh_tokens\n• user_preferences\n• users\n• verification_codes" as DB_MySQL
cloud "Resend" as CL_Resend
cloud "S3" as CL_S3
APIC --> AuthController : HTTPS/JSON
AuthController --> IdentityService
EmailSenderPort --> CL_Resend
FE0 --> APIC
FE1 --> APIC
FE2 --> APIC
FE3 --> APIC
FE4 --> APIC
FE5 --> APIC
IdentityService --> EmailSenderPort
IdentityService --> MediaStoragePort
IdentityService --> PasswordHasherPort
IdentityService --> REPO_MySQL
IdentityService --> RateLimitPort
IdentityService --> TokenIssuerPort
IdentityService ..> NotificationService
MediaStoragePort --> CL_S3
REPO_MySQL --> DB_MySQL : JPA/Flyway
@enduml
