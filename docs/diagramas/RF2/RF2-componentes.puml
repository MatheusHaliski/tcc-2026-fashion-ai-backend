@startuml RF2_Componentes
title RF2 — Autenticar usuário na plataforma com credenciais de acesso\nDiagrama de componentes — gerado do código (controllers → serviços → repositórios/ports)
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
left to right direction

package "Frontend (Next.js)" {
  component "(auth)/login/page.tsx\n(auth)/forgot-password · reset-password" as FE0
  component "lib/api/client.ts\n(access em memória; renovação\nserializada por Web Locks)" as FE1
  component "lib/auth/session.tsx\n(useAuth · RequireAuth)" as FE2
  component "BFF /bff/auth/[action]\n(cookie HttpOnly fai_rt)" as FE3
}
package "fai-web · controllers / security" {
  [AuthController\n/api/auth/login · refresh · logout\npassword-reset/request · confirm] as AuthController
  [SecurityConfig\n(oauth2ResourceServer JWT, permitAll)] as Sec
  [SessionActiveFilter\n(sid ativo?)] as SF
  [JwtTokenIssuer\n(TokenIssuerPort, RS256, 15 min)] as Jwt
  [Argon2PasswordHasher\n(PasswordHasherPort)] as Hasher
  [CurrentUserResolver\nAuditAuthenticationEntryPoint] as Res
}
package "fai-application · services" {
  [IdentityService] as IdentityService
  [NotificationService] as NotificationService
  [RateLimitPort] as RatePort #FAFAFA
  [EmailSenderPort] as EmailPort #FAFAFA
  [AuditService] as AuditPort #FAFAFA
}
package "fai-domain · repositórios JPA" {
  [UserRepository\nRefreshTokenRepository\nVerificationCodeRepository\nUserPreferencesRepository\nNotificationRepository] as REPOS
}
package "fai-infrastructure · adapters" {
  [InMemoryRateLimit / RedisAdapters] as Rate
  [ResendEmailSender / LoggingEmailSender] as Resend
  [MysqlAuditService] as Audit
}
database "MySQL · fashionai_app\n• users\n• refresh_tokens\n• verification_codes\n• notifications\n• audit_log" as DB
cloud "Resend (e-mail transacional)" as C_mail
cloud "Redis (opcional)\ncontadores de bloqueio" as C_redis

FE0 --> FE3 : login · logout
FE0 --> AuthController : password-reset/*
FE1 --> FE3 : refresh
FE2 --> FE1 : sessão
FE3 --> AuthController : HTTPS/JSON
FE1 --> SF : Bearer em todo request
Sec --> SF : addFilterAfter(BearerTokenAuthenticationFilter)
Sec ..> Res
SF --> IdentityService : sessionActive(sid)
AuthController --> IdentityService : chama
IdentityService --> Hasher : matches / needsRehash
IdentityService --> Jwt : issueAccessToken
IdentityService --> NotificationService : NEW_LOGIN_DEVICE · PASSWORD_RESET
IdentityService ..> RatePort
IdentityService ..> EmailPort
IdentityService ..> AuditPort
IdentityService --> REPOS : grava/lê
RatePort <.. Rate
EmailPort <.. Resend
AuditPort <.. Audit
REPOS --> DB : JPA/Flyway
Audit --> DB : grava audit_log
Resend --> C_mail : envia
Rate --> C_redis : INCR/TTL
@enduml
