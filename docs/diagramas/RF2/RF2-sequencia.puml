@startuml RF2_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."
title RF2 — Autenticar usuário na plataforma com credenciais de acesso\nDiagrama de sequência — gerado do código em 2026-10-06 (scripts/diagramas/v5)

actor "Pessoa usuária" as U
boundary "Tela (Next.js)" as P
control "AuthController" as AuthController
participant "IdentityService" as IdentityService
database "MySQL" as DB_MySQL
participant "RateLimitPort\n(InMemoryRateLimit)" as RateLimitPort
participant "PasswordHasherPort\n(Argon2PasswordHasher)" as PasswordHasherPort
participant "Audit" as Audit
participant "NotificationService" as NotificationService
== Autenticar por e-mail/username e senha (2FA opcional) ==
U -> P : Autenticar por e-mail/username e senha (2FA opcio…
P -> AuthController : POST /api/auth/login
AuthController -> IdentityService : login()
activate IdentityService
IdentityService -> DB_MySQL : SELECT users (×2)
alt erro
IdentityService --> AuthController : 500 ERRO
AuthController --> P : 500 + mensagem
end
IdentityService -> RateLimitPort : tryAcquire()
IdentityService -> PasswordHasherPort : matches()
alt erro
IdentityService --> AuthController : 500 ERRO
AuthController --> P : 500 + mensagem
end
alt erro
IdentityService --> AuthController : 500 ERRO
AuthController --> P : 500 + mensagem
end
IdentityService -> RateLimitPort : release()
alt conta indisponível
IdentityService --> AuthController : 403 CONTA_INDISPONIVEL
AuthController --> P : 403 + mensagem
end
IdentityService -> PasswordHasherPort : needsRehash()
IdentityService -> PasswordHasherPort : hash()
alt dois fatores necessario
IdentityService --> AuthController : 401 DOIS_FATORES_NECESSARIO
AuthController --> P : 401 + mensagem
end
IdentityService -> DB_MySQL : SELECT verification_codes
alt não autenticado
IdentityService --> AuthController : 401 NAO_AUTENTICADO
AuthController --> P : 401 + mensagem
end
alt não autenticado
IdentityService --> AuthController : 401 NAO_AUTENTICADO
AuthController --> P : 401 + mensagem
end
IdentityService -> IdentityService : consumedAt = set
IdentityService -> RateLimitPort : reset()
IdentityService -> DB_MySQL : SELECT refresh_tokens
IdentityService -> IdentityService : lastLoginAt = set
IdentityService -> Audit : log()
IdentityService -> NotificationService : notify()
NotificationService -> DB_MySQL : SELECT users (×2)
NotificationService -> DB_MySQL : SELECT user_preferences
NotificationService -> DB_MySQL : INSERT/UPDATE notifications
NotificationService --> IdentityService
note over IdentityService : … e mais 7 passos no código
deactivate IdentityService
IdentityService --> AuthController : resultado
AuthController --> P : 201 JSON
P --> U : atualiza a tela
@enduml
