@startuml RF2_Sequencia
title RF2 — Autenticar usuário na plataforma com credenciais de acesso\nDiagrama de sequência — login com bloqueio por conta, limite por IP e segundo fator
skinparam backgroundColor #FFFFFF
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
}
autonumber
actor "Pessoa" as P
participant "login/page.tsx\n(useAuth · lib/api/client.ts)" as FE
participant "BFF\n/bff/auth/[action]" as BFF
participant "AuthRateLimitFilter\n+ ClientIpResolver" as RLF
participant "AuthController" as AC
participant "IdentityService" as IS
participant "RateLimitPort\n(memória / Redis)" as RL
participant "Argon2PasswordHasher" as H
participant "JwtTokenIssuer" as JWT
participant "EmailSenderPort\n(Resend)" as EM
participant "NotificationService" as NS
database "MySQL" as DB

P -> FE: e-mail ou @ + senha (+ lembrar-me)
FE -> BFF: POST /bff/auth/login {identifier, password, rememberMe, deviceName, twoFactorCode}
BFF -> BFF: mesma origem? corpo ≤ 64 KB? (senão 403 ORIGEM_INVALIDA / 413 CORPO_GRANDE)
BFF -> RLF: POST /api/auth/login\nX-Dev-Gate · X-Fai-Client-Ip/Ts/Sig (HMAC)
RLF -> RLF: IP do cliente (assinatura do BFF › X-Real-IP › TCP)
alt mais de 30 logins em 10 min do mesmo IP
  RLF --> BFF: 429 MUITAS_TENTATIVAS (Retry-After)
else sem vaga no teto de hashes em 2 s
  RLF --> BFF: 503 AUTENTICACAO_OCUPADA (Retry-After: 2)
else segue
  RLF -> AC: login
  AC -> IS: login(cmd, ip, userAgent)
  IS -> DB: findByEmailHash | findByUsernameIgnoreCase
  alt conta inexistente
    IS -> H: matches(senha, hash falso) — mesmo tempo
    IS -> DB: audit_log LOGIN_FALHO (usuario_inexistente)
    IS --> BFF: 401 NAO_AUTENTICADO
  else conta encontrada
    IS -> RL: tryAcquire(userId, "login-fail", 5, 15 min) — reserva antes do hash
    IS -> H: matches(password, passwordHash)
    alt balde cheio (bloqueio) ou senha errada
      IS -> DB: audit_log LOGIN_BLOQUEADO_TENTATIVAS | LOGIN_FALHO
      IS --> BFF: 401 NAO_AUTENTICADO (mesma resposta nos três casos)
    else senha certa
      IS -> RL: release(userId, "login-fail")
      alt status DELETED ou SUSPENDED
        IS --> BFF: 403 CONTA_INDISPONIVEL
      else twoFactorEnabled e sem código
        IS -> DB: INSERT verification_codes (TWO_FACTOR, 10 min)
        IS -> EM: send("Seu código de acesso")
        IS --> BFF: 401 DOIS_FATORES_NECESSARIO {twoFactorRequired: true}
        note right of FE: a tela espera 2FA_OBRIGATORIO /\nCODIGO_2FA — o campo do código\nnão aparece (divergência)
      else código 2FA errado ou vencido
        IS -> DB: attempts + 1 (5º erro expira o código)
        IS -> RL: tryAcquire(userId, "login-fail", 5, 15 min)
        IS --> BFF: 401 NAO_AUTENTICADO
      else credenciais (e código) válidos
        opt hash com parâmetros antigos
          IS -> H: hash(password) (needsRehash)
        end
        IS -> RL: reset(userId, "login-fail")
        IS -> DB: refresh_tokens ativos (User-Agent já visto?)
        IS -> DB: users.lastLoginAt · audit_log LOGIN_SUCESSO
        opt dispositivo novo
          IS -> NS: notify(NEW_LOGIN_DEVICE, ip)
        end
        IS -> DB: INSERT refresh_tokens (familyId novo, tokenHash SHA-256,\n30 dias | 1 dia, createdIp, userAgent, deviceName)
        IS -> JWT: issueAccessToken(user, familyId)
        JWT --> IS: JWT RS256 (15 min; iss, aud, sub, user_id, sid, username, role, profile_type)
        AC --> BFF: 200 Session {accessToken, refreshToken, refreshExpiresAt, user, status, emailVerified, warnings}
        BFF --> FE: 200 Session sem refreshToken\nSet-Cookie fai_rt (HttpOnly, Secure, SameSite=Strict, Path=/bff/auth) + fai_rt_h
        FE -> FE: tokenStore.set(access) em memória · BroadcastChannel "fai-auth"
        FE -> FE: /verify-email (e-mail não confirmado) ou safeNext(next, "/feed")
      end
    end
  end
end
@enduml
