@startuml RF20_Atividades
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam activity {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  DiamondBackgroundColor #FFF5F8
  DiamondBorderColor #F08DB1
  StartColor #20A77A
  EndColor #4B5563
}
skinparam swimlane {
  BorderColor #CBC6BE
  TitleFontColor #2D2438
}
title RF20 — Permitir que o usuário crie & publique um esquema de vestimenta como vinculado a uma marca de roupa\nDiagrama de atividades — gerado do código em 2026-10-06 (scripts/diagramas/v5)

|Pessoa usuária|
start
:Abre /schemes/new, /brands/[slug];
|Tela (Next.js)|
:Carrega os dados da tela\nGET /api/seal-bonds/review-queue\nGET /api/users/{ownerId}/seals\nGET /api/me/issuer-metrics;
|Pessoa usuária|
:Emissor aprova ou rejeita o vínculo;
|Tela (Next.js)|
:POST /api/seal-bonds/{bondId}/review;
|API (Spring Boot)|
:SealController.review\n→ SealService.review;
if (estado inválido?) then (sim)
  :409 ESTADO_INVALIDO\n«Este vínculo não está aguardando\nrevisão.»\n→ a tela mostra o aviso;
  stop
endif
if (motivo obrigatório?) then (sim)
  :400 MOTIVO_OBRIGATORIO\n«Informe o motivo da rejeição.»\n→ a tela mostra o aviso;
  stop
endif
|Dados e serviços|
:Lê: seal_bonds\nbrand_profiles;
:Usa: Guard.requireApprovedInstitutional\nGuard.requireOwner\nNotificationService.notify;
:Estado: revalidationPending → false\nstatus → APPROVED\nreviewedAt → set\nissuedAt → set\nexpiresAt → set;
:Evento: CouponRightsCheck;
|Tela (Next.js)|
:Atualiza a tela com a resposta;
|Pessoa usuária|
if (Faz outra ação?) then (sim)
  switch (Qual?)
  case (Marca/celebridade cria um selo)
    :POST /api/seals\n→ SealService.createSeal\nvalida: LIMITE_INVALIDO, PERIODO_INVALIDO\nlê: users, seal_bonds\nusa: Guard.requireApprovedInstitutional,\nOwnMedia.require,\nOwnMedia.requireOrUnchanged …\ngrava: seals;
  case (Editar selo [política, ícone, fun…)
    :PUT /api/seals/{sealId}\n→ SealService.updateSeal\nvalida: LIMITE_INVALIDO, PERIODO_INVALIDO\nlê: seals, seal_bonds\nusa: Guard.requireApprovedInstitutional,\nGuard.requireOwner, OwnMedia.require …\nestado: iconUrl → set;
  case (Revogar selo concedido)
    :POST /api/seal-bonds/{bondId}/revoke\n→ SealService.revoke\nlê: seal_bonds, brand_profiles\nusa: Guard.requireOwner,\nNotificationService.notify\nestado: status → REVOKED, reviewedAt → set;
  case (Selos possíveis para um look aind…)
    :POST /api/seal-suggestions/preview\n→ SealService.preview\nlê: wardrobe_items\nia: SEALBOND_MATCHER;
  endswitch
  |Tela (Next.js)|
  :Atualiza a tela;
endif
|Pessoa usuária|
stop
@enduml
