package "fai-domain (enums)" {
  enum ApprovalStatus {
    PENDENTE
    AJUSTES
    APROVADO
    RECUSADO
    SUSPENSO
  }
  enum PromotionStatus {
    AVAILABLE
    REDEEMED
    EXPIRED
    REVOKED
  }
  enum SchemeStatus {
    DRAFT
    PUBLISHED
    ARCHIVED
  }
  enum RenderStatus {
    PENDING
    RENDERING
    ENHANCING
    COMPOSITING
    CACHED
    COMPLETED
    FAILED
  }
  enum SealStatus {
    ACTIVE
    INACTIVE
  }
  enum SealBondStatus {
    SUGGESTED
    ACCEPTED
    EDITED
    REFUSED
    PENDING_REVIEW
    APPROVED
    REJECTED
    REVOKED
  }
}
