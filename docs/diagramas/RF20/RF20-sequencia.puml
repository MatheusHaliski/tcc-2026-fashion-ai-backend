@startuml RF20_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."
title RF20 — Permitir que o usuário crie & publique um esquema de vestimenta como vinculado a uma marca de roupa\nDiagrama de sequência — gerado do código em 2026-10-06 (scripts/diagramas/v5)

actor "Pessoa usuária" as U
boundary "Tela /brands/[slug]" as P
control "SealController" as SealController
participant "SealService" as SealService
participant "Guard" as Guard
database "MySQL" as DB_MySQL
participant "Audit" as Audit
participant "NotificationService" as NotificationService
queue "Eventos de domínio" as EV
== Emissor aprova ou rejeita o vínculo ==
U -> P : Emissor aprova ou rejeita o vínculo
P -> SealController : POST /api/seal-bonds/{bondId}/review
SealController -> SealService : review()
activate SealService
SealService -> Guard : requireApprovedInstitutional()
SealService -> DB_MySQL : SELECT seal_bonds
SealService -> Guard : requireOwner()
alt estado inválido
SealService --> SealController : 409 ESTADO_INVALIDO
SealController --> P : 409 + mensagem
end
SealService -> SealService : revalidationPending = false
SealService -> Audit : log()
SealService -> SealService : status = APPROVED
SealService -> SealService : reviewedAt = set
SealService -> SealService : issuedAt = set
SealService -> SealService : expiresAt = set
SealService -> DB_MySQL : SELECT seal_bonds
SealService -> NotificationService : notify()
NotificationService -> DB_MySQL : SELECT users (×2)
NotificationService -> DB_MySQL : SELECT user_preferences
NotificationService -> DB_MySQL : INSERT/UPDATE notifications
NotificationService --> SealService
SealService -> Audit : log()
SealService ->> EV : CouponRightsCheck
alt motivo obrigatório
SealService --> SealController : 400 MOTIVO_OBRIGATORIO
SealController --> P : 400 + mensagem
end
SealService -> SealService : reviewedAt = set
SealService -> SealService : revalidationPending = false
SealService -> NotificationService : notify()
SealService -> Audit : log()
SealService -> DB_MySQL : SELECT brand_profiles
deactivate SealService
SealService --> SealController : resultado
SealController --> P : 201 JSON
P --> U : atualiza a tela
@enduml
