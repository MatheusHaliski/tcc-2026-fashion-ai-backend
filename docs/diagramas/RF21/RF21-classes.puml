package "fai-domain (enums)" {
  enum ApprovalStatus {
    PENDENTE
    AJUSTES
    APROVADO
    RECUSADO
    SUSPENSO
  }
  enum PromotionStatus {
    AVAILABLE
    REDEEMED
    EXPIRED
    REVOKED
  }
  enum RedemptionStatus {
    ISSUED
    USED
    EXPIRED
  }
  enum SchemeStatus {
    DRAFT
    PUBLISHED
    ARCHIVED
  }
  enum RenderStatus {
    PENDING
    RENDERING
    ENHANCING
    COMPOSITING
    CACHED
    COMPLETED
    FAILED
  }
  enum SealStatus {
    ACTIVE
    INACTIVE
  }
}
package "fai-application" {
  class SealService <<service>> {
    +mySeals()
    +preview()
    +suggest()
    +linkManually()
    +refuseAll()
    +accept()
    +refuse()
  }
}
SealService ..> CelebrityProfile : usa
SealService ..> Promotion : usa
SealService ..> PromotionRedemption : usa
SealService ..> Scheme : usa
