@startuml RF21_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF21 — Permitir que o usuário crie & publique um esquema de vestimenta como vinculado a uma celebridade\nDiagrama de componentes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "Frontend (Next.js)" {
  component "/brands/[slug]\n(site)/(app)/brands/[slug]/page.tsx" as FE0
  component "/schemes/[id]/edit\n(site)/(app)/schemes/[id]/edit/page.tsx" as FE1
  component "/schemes/new\n(site)/(app)/schemes/new/page.tsx" as FE2
  component "lib/api/client.ts" as APIC
}
package "fai-web (REST)" {
  component "SchemeController\n/api/schemes\n/api/schemes/builder\n/api/schemes/preview\n/api/schemes/{…}\n(+1 rotas)" as SchemeController
  component "SealController\n/api/me/seals\n/api/promotions\n/api/promotions/{…}\n/api/schemes/{…}/seal-bonds\n(+8 rotas)" as SealController
}
package "fai-application (casos de uso)" {
  component "SchemeService" as SchemeService
  component "SealService" as SealService
  component "WardrobeService" as WardrobeService <<apoio>>
  component "BackgroundStudioService" as BackgroundStudioService <<apoio>>
  component "SchemeCardRenderer" as SchemeCardRenderer <<apoio>>
  component "ProjectionService" as ProjectionService <<apoio>>
  component "NotificationService" as NotificationService <<apoio>>
  component "MediaService" as MediaService <<apoio>>
  component "DailyLookService" as DailyLookService <<apoio>>
  component "HypeScoreConfig" as HypeScoreConfig <<apoio>>
  component "CounterStorePort\n«InMemoryCounterStore»" as CounterStorePort <<port>>
}
package "fai-domain (repositórios)" {
  component "SchemeRepository\nSchemeItemRepository\nWardrobeItemRepository\nUserRepository\nReactionRepository\nSavedItemRepository\nStyleDnaRepository\nHypeScoreCurrentRepository\nSealRepository\nSealBondRepository\n(+4)" as REPO_MySQL
}
database "MySQL\n• brand_profiles\n• celebrity_profiles\n• hype_scores\n• promotion_redemptions\n• promotions\n• reactions\n• saved_items\n• scheme_items\n• schemes\n• seal_bonds\n• seals\n• style_dna\n(+2)" as DB_MySQL
cloud "Motor de IA (RF24)\nprovedores externos + reserva local" as AI
component "Eventos de domínio\n(@TransactionalEventListener)" as EV
APIC --> SchemeController : HTTPS/JSON
APIC --> SealController : HTTPS/JSON
FE0 --> APIC
FE1 --> APIC
FE2 --> APIC
REPO_MySQL --> DB_MySQL : JPA/Flyway
SchemeController --> SchemeService
SchemeService --> AI
SchemeService --> CounterStorePort
SchemeService --> EV
SchemeService --> REPO_MySQL
SchemeService ..> BackgroundStudioService
SchemeService ..> DailyLookService
SchemeService ..> HypeScoreConfig
SchemeService ..> MediaService
SchemeService ..> NotificationService
SchemeService ..> ProjectionService
SchemeService ..> SchemeCardRenderer
SchemeService ..> SealService
SchemeService ..> WardrobeService
SealController --> SealService
SealService --> AI
SealService --> EV
SealService --> REPO_MySQL
SealService ..> NotificationService
@enduml
