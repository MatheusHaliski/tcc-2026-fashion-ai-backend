@startuml RF21_Componentes
title RF21 — Publicar look vinculado a uma celebridade verificada\nDiagrama de componentes — consentimento no Criar Look, revisão da celebridade, Selo Premium e promoções
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam interface {
  BackgroundColor #FFF5F8
  BorderColor #4A4852
}
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
left to right direction

package "Frontend (Next.js)" {
  component "components/scheme-builder.tsx\nSealSuggestions + caixa de consentimento\n(Salvar desabilitado sem ela)" as FE0
  component "components/expanded-card.tsx\n(look salvo: Vincular)" as FE1
  component "brands/[slug]/page.tsx (celebridade)\nRevisão de vínculos · Selos · Promoções" as FE2
  component "seal-medallion.tsx · scheme-card.tsx\n(premium = vítreo/holográfico)" as FE3
  component "(auth)/register/page.tsx\nsealConsentGranted no cadastro (RF1)" as FE4
}

package "fai-web · controllers" {
  [SealController\nPOST /api/seal-suggestions/preview\nGET /api/schemes/{id}/seal-suggestions\nPOST /api/schemes/{id}/seal-bonds\nPOST /api/seal-bonds/{id}/accept · review · revoke\nGET /api/seal-bonds/review-queue\nPOST /api/promotions · PUT /api/promotions/{id}\nPOST /api/promotions/{id}/redemptions] as C
  [SchemeController\nPOST /api/schemes] as SCC
  [AuthController · AdminController\ncadastro e verificação (RF1)] as AUTH
}

package "fai-application" {
  [SealService\ncandidates (STYLE_SIGNATURE) · route\n(consentimento + revisão obrigatória) ·\nissue (PRM-…) · createPromotion ·\npartnerConsented · redeem] as S
  [Similarity (ai.local)\nassinatura de estilo] as SIM
  [AiEngine (RF24)\nSEALBOND_MATCHER] as AI
  [IdentityService · IssuerReviewService\nCelebrityProfile PENDENTE → APROVADO\n(requiresSealReview = true, selos padrão)] as IR
  [InstitutionalService (RF22)\nupdateCelebrity: sealConsentGranted,\nassinatura de estilo] as IS
  [NotificationService · Audit] as N
  [CouponService (RF38)\nonCheck(CouponRightsCheck)] as CS
  [FlairService.sellerActive\n(emissor ativo e aprovado)] as FS
}

package "fai-domain · repository (JPA)" {
  [SealBondRepository · SealRepository\nCelebrityProfileRepository · BrandProfileRepository\nPromotionRepository · PromotionRedemptionRepository\nSchemeRepository · SchemeItemRepository · UserRepository] as REPOS
}

database "MySQL\n• celebrity_profiles (style_signature_json,\n  seal_consent_granted, requires_seal_review)\n• seal_bonds (image_rights_consent, era_label)\n• seals (premium, usage_limit)\n• promotions (partner_brand_user_id)\n• promotion_redemptions\n• notifications · audit_log" as DB

FE0 --> C : preview · seal-bonds\n{imageRightsConsent}
FE0 --> SCC
FE1 --> C : accept {imageRightsConsent: true}
FE2 --> C : review-queue · review · promoções
FE2 --> FE3
FE4 --> AUTH
C --> S
AUTH --> IR
S --> AI
AI ..> SIM : executa candidates()
S --> SIM
S --> N
S ..> CS : CouponRightsCheck (AFTER_COMMIT)
S --> FS
S --> REPOS
IR --> REPOS
IS --> REPOS
REPOS --> DB : JPA · Flyway

note bottom of S
  Diferenças do RF20: só celebridade APROVADA
  (CA18); sugestão pela assinatura de estilo (CA17);
  imageRightsConsent obrigatório (CA19); sempre
  PENDING_REVIEW; código PRM-… (CA20); teto pelo
  Seal.usageLimit (CA23). Partner brand: sem campo
  na tela de promoções hoje.
end note
@enduml
