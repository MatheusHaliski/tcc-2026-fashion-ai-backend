@startuml RF21_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."
title RF21 — Permitir que o usuário crie & publique um esquema de vestimenta como vinculado a uma celebridade\nDiagrama de sequência — gerado do código em 2026-10-06 (scripts/diagramas/v5)

actor "Pessoa usuária" as U
boundary "Tela /schemes/[id]/edit" as P
control "SealController" as SealController
participant "SealService" as SealService
participant "Guard" as Guard
database "MySQL" as DB_MySQL
== Vincular manualmente o esquema a uma marca/celebridade ==
U -> P : Vincular manualmente o esquema a uma marca/celebr…
P -> SealController : POST /api/schemes/{schemeId}/seal-bonds
SealController -> SealService : linkManually()
activate SealService
SealService -> Guard : requireCanCreate()
SealService -> DB_MySQL : SELECT schemes
SealService -> Guard : requireOwner()
SealService -> DB_MySQL : SELECT users
alt perfil inválido
SealService --> SealController : 400 PERFIL_INVALIDO
SealController --> P : 400 + mensagem
end
alt marca não validada
SealService --> SealController : 400 MARCA_NAO_VALIDADA
SealController --> P : 400 + mensagem
end
alt celebridade não verificada
SealService --> SealController : 400 CELEBRIDADE_NAO_VERIFICADA
SealController --> P : 400 + mensagem
end
SealService -> DB_MySQL : SELECT scheme_items
SealService -> DB_MySQL : SELECT seal_bonds
SealService -> SealService : new SealBond()
SealService -> SealService : origin = MANUAL
SealService -> SealService : status = EDITED
SealService -> SealService : imageRightsConsent = ?imageRightsConsent
SealService -> SealService : respondedAt = set
SealService -> DB_MySQL : SELECT seal_bonds
alt vinculo existente
SealService --> SealController : 409 VINCULO_EXISTENTE
SealController --> P : 409 + mensagem
end
SealService -> DB_MySQL : INSERT/UPDATE seal_bonds
SealService -> DB_MySQL : SELECT seal_bonds
alt vinculo existente
SealService --> SealController : 409 VINCULO_EXISTENTE
SealController --> P : 409 + mensagem
end
alt consentimento imagem
SealService --> SealController : 400 CONSENTIMENTO_IMAGEM
SealController --> P : 400 + mensagem
end
SealService -> DB_MySQL : SELECT seals
SealService -> DB_MySQL : SELECT scheme_items
note over SealService : … e mais 16 passos no código
deactivate SealService
SealService --> SealController : resultado
SealController --> P : 201 JSON
P --> U : atualiza a tela
@enduml
