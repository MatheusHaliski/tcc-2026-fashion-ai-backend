package "fai-domain (entidades JPA)" {
  class Follow <<follows>> {
    +id: UUID
    +follower: User
    +following: User
    +status: FollowStatus
    +respondedAt: Instant
  }
  class CelebrityProfile <<celebrity_profiles>> {
    +id: UUID
    +owner: User
    +stageName: String
    +slug: String
    +avatarUrl: String
    +coverUrl: String
    +bio: String
    +realName: String
    +areasJson: String
    +verifiableFollowersJson: String
    .. +20 campos ..
  }
  class DnaScheme <<dna_schemes>> {
    +id: UUID
    +user: User
    +title: String
    +identityPhrase: String
    +archetype: StyleArchetype
    +boldnessIndex: Integer
    +iconSchemeId: UUID
    +colorPaletteJson: String
    +narrativeType: NarrativeType
    +seasonalTheme: Season
    .. +25 campos ..
  }
  class Promotion <<promotions>> {
    +id: UUID
    +seal: Seal
    +sealBond: SealBond
    +type: PromotionType
    +code: String
    +description: String
    +discountPercent: Integer
    +partnerBrandUserId: UUID
    +campaignId: UUID
    +campaignLimit: Integer
    .. +13 campos ..
  }
  class SchemeGrouping <<scheme_groupings>> {
    +id: UUID
    +owner: User
    +type: GroupingType
    +label: String
    +description: String
    +coverUrl: String
    +atmospherePrompt: String
    +periodFrom: Integer
    +periodTo: Integer
    +accentColor: String
    .. +1 campos ..
  }
  class Seal <<seals>> {
    +id: UUID
    +owner: User
    +name: String
    +tier: SealTier
    +policyText: String
    +status: SealStatus
    +iconUrl: String
    +premium: boolean
    +backgroundConfigJson: String
    +availableFrom: Instant
    .. +4 campos ..
  }
  class SealBond <<seal_bonds>> {
    +id: UUID
    +scheme: Scheme
    +targetOwner: User
    +requestedBy: User
    +tier: SealTier
    +linkedPieceIdsJson: String
    +confidence: BigDecimal
    +justification: String
    +basis: SealBondBasis
    +status: SealBondStatus
    .. +13 campos ..
  }
  class User <<users>> {
    +id: UUID
    +username: String
    +displayName: String
    +email: String
    +emailHash: String
    +emailVerified: boolean
    +phone: String
    +birthDate: String
    +passwordHash: String
    +profileType: ProfileType
    .. +24 campos ..
  }
}
package "fai-domain (enums)" {
  enum FollowStatus {
    PENDENTE
    ACEITO
    BLOQUEADO
  }
  enum ApprovalStatus {
    PENDENTE
    AJUSTES
    APROVADO
    RECUSADO
    SUSPENSO
  }
  enum SchemeStatus {
    DRAFT
    PUBLISHED
    ARCHIVED
  }
  enum PromotionStatus {
    AVAILABLE
    REDEEMED
    EXPIRED
    REVOKED
  }
  enum SealStatus {
    ACTIVE
    INACTIVE
  }
  enum SealBondStatus {
    SUGGESTED
    ACCEPTED
    EDITED
    REFUSED
    PENDING_REVIEW
    APPROVED
    REJECTED
    REVOKED
  }
}
package "fai-application" {
  class InstitutionalService <<service>> {
    +profile()
    +tab()
    +store()
    +updateCelebrity()
  }
}
InstitutionalService ..> CelebrityProfile : usa
InstitutionalService ..> Follow : usa
InstitutionalService ..> SchemeGrouping : usa
InstitutionalService ..> Seal : usa
InstitutionalService ..> SealBond : usa
InstitutionalService ..> User : usa
CelebrityProfile "1" --> "1" User : owner
CelebrityProfile --> ApprovalStatus
DnaScheme "*" --> "1" User : user
DnaScheme --> SchemeStatus
Follow "*" --> "1" User : follower
Follow "*" --> "1" User : following
Follow --> FollowStatus
Promotion "*" --> "1" Seal : seal
Promotion "*" --> "1" SealBond : sealBond
Promotion --> PromotionStatus
SchemeGrouping "*" --> "1" User : owner
Seal "*" --> "1" User : owner
Seal --> SealStatus
SealBond "*" --> "1" Seal : seal
SealBond "*" --> "1" User : requestedBy
SealBond "*" --> "1" User : targetOwner
SealBond --> SealBondStatus
@enduml
