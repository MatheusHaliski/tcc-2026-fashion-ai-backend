@startuml RF22_Classes
title RF22 — Aba "Celebridades": feed e perfil das celebridades cadastradas\nDiagrama de classes — InstitutionalService (feed e perfil da celebridade), Hype CREATOR, política de exibição e entidades
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  HeaderBackgroundColor #E4DEF0
}
skinparam packageStyle rectangle
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
hide empty methods
hide empty fields

package "fai-web · controller" {
class ProfileController {
  +celebrities(viewer, term, order): Map
  +institutional(viewer, slugOrId): Map
  +tab(viewer, slugOrId, tab, filter, groupingId): Object
  +updateCelebrity(user, fields): Map
}
class HypeController {
  +groups(viewer, type = CREATOR, keys, window): Map
}
class ShowcaseController {
  +list(viewer, slug, kind = eras): Map
  +stage(viewer, slug, schemeId): Map
}
}

package "fai-application" {
class InstitutionalService {
  {static} ~FEED_ORDERS = AFINIDADE, RECENTES, EM_ALTA
  +celebrityFeed(viewer, term, order): Map
  +profile(viewer, slugOrId): Map
  +tab(viewer, slugOrId, tab, filter, groupingId): Object
  +updateCelebrity(user, fields): Map
  ~celebrityCard(CelebrityProfile): Map
  ~institutionalUser(slugOrId): User
  ~affinity(userStyles, ownerId): double
  ~feedHype(viewer, CREATOR, ownerIds): Map
  ~promoted(viewer, User, history, now): List<Promoted>
  ~filterLooks(list, filter, groupingId, personal): List<Promoted>
  ~pieceEntries(viewer, looks): List
}
class Promoted <<record>> {
  +scheme: Scheme
  +bonds: List<SealBond>
  +issuedAt, expiresAt: Instant
  +expired: boolean
  +revalidationPending: boolean
}
class HypeQueryService {
  +groups(viewer, RankGroup, keys, window): Map
  +currentOf(HypeEntityType, ids): Map
}
class ProfileInsights {
  ~resolve(BRAND_PROFILE, slug): Target
  ~build(Target kind CELEBRITY): List<Insight>
}
class SealService {
  +sealsOf(viewer, ownerId): List
  +promotionsOf(viewer, ownerId): List
  {static} +badge(SealBond): Map — premium
}
class IssuerReviewService {
  +decide(admin, userId, DecisionCommand): Map
  +resubmit(user, ResubmitCommand): Map
}
class ShowcaseService {
  +list · items · insights · stage — RF34
}
}

package "fai-domain · model" {
class CelebrityProfile <<celebrity_profiles>> {
  +owner: User
  +stageName: String
  +slug: String
  +avatarUrl, coverUrl: String
  +bio: String
  +areasJson: String
  +styleSignatureJson: String
  +verificationStatus: ApprovalStatus = PENDENTE
  +identityVerified: boolean
  +sealConsentGranted: boolean
  +requiresSealReview: boolean
  +reviewAttempts: int
}
class User <<users>> {
  +username: String
  +avatarUrl: String
  +profileType: ProfileType = CELEBRIDADE
  +status: AccountStatus
  +verified: boolean
}
class Follow <<follows>> {
  +follower, following: User
  +status: FollowStatus
}
class SealBond <<seal_bonds>> {
  +scheme: Scheme
  +targetOwner: User
  +status: SealBondStatus
  +tier: SealTier
  +issuedAt, expiresAt: Instant
}
class Seal <<seals>> {
  +owner: User
  +premium: boolean
  +status: SealStatus
}
class Scheme <<schemes>> {
  +user: User
  +status: SchemeStatus
  +groupingId: UUID
  +revalidationPending: boolean
}
class SchemeGrouping <<scheme_groupings>> {
  +owner: User
  +type: GroupingType — ERA · PHASE · TOUR
  +label: String
}
class StyleDna <<style_dna>> {
  +user: User
  +styleKeywords: String
}
}

package "fai-domain · enums" {
enum ApprovalStatus {
  PENDENTE
  AJUSTES
  APROVADO
  RECUSADO
  SUSPENSO
}
enum ProfileType {
  PESSOAL
  MARCA
  CELEBRIDADE
  ADMIN
}
}

ProfileController --> InstitutionalService
HypeController --> HypeQueryService
ShowcaseController --> ShowcaseService
InstitutionalService --> HypeQueryService : groups(CREATOR) · currentOf
InstitutionalService --> SealService
InstitutionalService ..> Promoted
ProfileInsights --> HypeQueryService
ShowcaseService --> InstitutionalService : institutionalUser
IssuerReviewService ..> CelebrityProfile : verificationStatus
CelebrityProfile "0..1" --> "1" User : owner
Follow "*" --> "1" User : following
SealBond "*" --> "1" User : targetOwner
SealBond "*" --> "1" Scheme
Seal "*" --> "1" User : owner
SchemeGrouping "*" --> "1" User : owner
Scheme "*" --> "1" User : user
StyleDna "0..1" --> "1" User
Promoted "*" --> "1" Scheme
Promoted "*" --> "1..*" SealBond
CelebrityProfile ..> ApprovalStatus
User ..> ProfileType

note bottom of CelebrityProfile
  Feed e perfil público só com APROVADO.
  Hype no card = agregado CREATOR do dono
  (chave = ownerId), não BRAND.
  Material do card: VITREO_HOLOGRAFICO.
end note
note right of Promoted
  Mesma política do RF14: só vínculos
  APPROVED com target_owner = celebridade.
end note
@enduml
