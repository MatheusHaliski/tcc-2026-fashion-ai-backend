left to right direction
title RF22 — Visualizar a aba 'Celebridades' — Feed de Perfil de Celebridades cadastradas dentro do sistema do FashionAI\nDiagrama de componentes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "Frontend (Next.js)" {
  component "/brands\n(site)/(app)/brands/page.tsx" as FE0
  component "/flair\n(site)/(app)/flair/page.tsx" as FE1
  component "/admin/users\n(site)/(app)/admin/users/page.tsx" as FE2
  component "/brands/[slug]\n(site)/(app)/brands/[slug]/page.tsx" as FE3
  component "/u/[username]\n(site)/(app)/u/[username]/page.tsx" as FE4
  component "lib/api/client.ts" as APIC
}
package "fai-web (REST)" {
  component "AdminController\n/api/admin/approvals\n/api/admin/approvals/{…}" as AdminController
  component "FlairController\n/api/flair/arena\n/api/flair/cards\n/api/flair/combinations\n/api/flair/combinations/{…}/redeem\n(+12 rotas)" as FlairController
  component "ProfileController\n/api/brands\n/api/celebrities\n/api/institutional/{…}\n/api/institutional/{…}/store\n(+4 rotas)" as ProfileController
  component "SealController\n/api/me/issuer-metrics\n/api/promotions\n/api/promotions/{…}\n/api/promotions/{…}/redemptions\n(+3 rotas)" as SealController
  component "ShowcaseController\n/api/groupings/{…}/cover\n/api/institutional/{…}/showcase/{…}\n/api/institutional/{…}/showcase/{…}/insights\n/api/institutional/{…}/showcase/{…}/items\n(+1 rotas)" as ShowcaseController
}
package "fai-application (casos de uso)" {
  component "IssuerReviewService" as IssuerReviewService
  component "FlairService" as FlairService
  component "ProfileService" as ProfileService
  component "InstitutionalService" as InstitutionalService
  component "SealService" as SealService
  component "ShowcaseService" as ShowcaseService
  component "SideEffectRunner" as SideEffectRunner <<apoio>>
  component "NotificationService" as NotificationService <<apoio>>
  component "IssuerVerificationPolicy" as IssuerVerificationPolicy <<apoio>>
  component "MediaService" as MediaService <<apoio>>
  component "SchemeService" as SchemeService <<apoio>>
  component "FaiPointsService" as FaiPointsService <<apoio>>
  component "HypeScoreConfig" as HypeScoreConfig <<apoio>>
  component "HypeQueryService" as HypeQueryService <<apoio>>
  component "EmailSenderPort\n«LoggingEmailSender / ResendEmailSender»" as EmailSenderPort <<port>>
  component "MediaStoragePort\n«LocalFileMediaStorage / S3MediaStorageAdapter»" as MediaStoragePort <<port>>
}
package "fai-domain (repositórios)" {
  component "UserRepository\nBrandProfileRepository\nCelebrityProfileRepository\nFlairProfileRepository\nFlairCoinEntryRepository\nFlairCombinationRepository\nFlairRedemptionRepository\nFlairTeamRepository\nFlairTeamMemberRepository\nFlairMatchRepository\n(+16)" as REPO_MySQL
}
database "MySQL\n• brand_profiles\n• celebrity_profiles\n• daily_looks\n• flair_coin_entries\n• flair_combinations\n• flair_match_entries\n• flair_matches\n• flair_profiles\n• flair_redemptions\n• flair_team_members\n• flair_teams\n• follows\n(+14)" as DB_MySQL
cloud "Motor de IA (RF24)\nprovedores externos + reserva local" as AI
component "Eventos de domínio\n(@TransactionalEventListener)" as EV
cloud "Resend" as CL_Resend
cloud "S3" as CL_S3
