@startuml RF22_Componentes
title RF22 — Visualizar a aba "Celebridades" — Feed de Perfil de Celebridades cadastradas dentro do sistema do FashionAI\nDiagrama de componentes — gerado do código (controllers → serviços → repositórios/ports)
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
left to right direction

package "Frontend (Next.js)" {
  component "brands/page.tsx\nTabs brands | celebrities → GET /api/{tab}" as FE0
  component "brands/[slug]/page.tsx\n(perfil institucional da celebridade)" as FE1
  component "components/showcase/showcase-tabs.tsx\n(ErasTab) · components/profile-header.tsx\ncomponents/flair/brand-flair-tab.tsx" as FE2
  component "admin/users/page.tsx\n(aba approvals — RF1.CA08)" as FE3
}
package "fai-web · controllers" {
  [ProfileController\nGET /api/celebrities\nGET /api/institutional/{slugOrId}\nGET /api/institutional/{slugOrId}/tabs/{tab}\nPATCH /api/me/celebrity-profile\nPOST /api/users/{id}/followers] as PC
  [SealController\nGET /api/users/{ownerId}/seals\nGET /api/users/{ownerId}/promotions] as SC
  [ShowcaseController\nGET /api/institutional/{slug}/showcase/{kind}\nGET …/showcase/{kind}/items · /insights\nGET /api/institutional/{slug}/stage] as SH
  [FlairController\nGET /api/institutional/{slug}/flair] as FC
  [AdminController\nGET/POST /api/admin/approvals/{userId}] as AC
}
package "fai-application · services" {
  [InstitutionalService\ncelebrityFeed · profile · tab\nupdateCelebrity] as I
  [SealService\nsealsOf · promotionsOf] as S
  [ShowcaseService (eras)] as SHS
  [FlairService] as FS
  [AdminService\ndecide() → verificationStatus] as AD
  [ProfileService (RF17 follow)] as PS
}
package "fai-infrastructure · adapters" {
  [Repositórios JPA (fai-domain · repository)\nCelebrityProfileRepository · UserRepository\nFollowRepository · SealBondRepository\nSealRepository · PromotionRepository\nSchemeGroupingRepository · DnaSchemeRepository] as REPOS
  [S3MediaStorageAdapter /\nLocalFileMediaStorage\n(avatar e capa)] as ST
}
database "MySQL · fashionai_app\n• celebrity_profiles\n• users\n• follows\n• seal_bonds · seals\n• promotions\n• scheme_groupings (ERA)\n• style_dnas" as DB

FE0 --> PC : GET /api/celebrities
FE1 --> PC : perfil e abas
FE1 --> SC : selos e promoções
FE1 --> FE2 : usa
FE2 --> SH : eras / stage
FE2 --> FC : combinações FLAIR
FE3 --> AC : aprova/rejeita celebridade
PC --> I : chama
PC --> PS : follow
SC --> S : chama
SH --> SHS : chama
FC --> FS : chama
AC --> AD : chama
I --> S : sealsOf (aba MEUS_SELOS)
I --> REPOS : lê
S --> REPOS : lê
SHS --> REPOS : lê scheme_groupings
AD --> REPOS : grava verification_status
I --> ST : URLs de avatar/capa
REPOS --> DB : JPA/Flyway
note bottom of FE0 : não há rota /celebrities própria —\na aba "Celebridades" vive em /brands
note bottom of I : ver RF14 (marcas — mesmo layout),\nRF21 (vínculos) e RF24.CA06 (afinidade)
@enduml
