@startuml RF22_Sequencia
title RF22 — Visualizar a aba "Celebridades" — Feed de Perfil de Celebridades cadastradas dentro do sistema do FashionAI\nDiagrama de sequência — endpoints reais
skinparam backgroundColor #FFFFFF
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
}
autonumber
actor "Pessoa" as U
participant "Frontend\n/brands (aba Celebridades)" as FE
participant "Frontend\n/brands/[slug]" as FE2
participant "ProfileController" as PC
participant "SealController" as SC
participant "ShowcaseController" as SH
participant "FlairController" as FC
participant "InstitutionalService" as I
participant "SealService" as S
database "MySQL" as DB
U -> FE: abre /brands e seleciona a aba "Celebridades"
FE -> PC: GET /api/celebrities?term=&order=
PC -> I: celebrityFeed(viewer, term, order)
I -> DB: SELECT celebrity_profiles WHERE verification_status = 'APROVADO'
opt visitante autenticado com DNA de estilo e order != RECENTES
  I -> DB: SELECT style_dnas (styleKeywords) · wardrobe_items do perfil
  I -> I: affinity(): Jaccard(estilos do DNA × estilos do acervo)
end
loop cada celebridade
  I -> DB: COUNT seal_bonds (APPROVED) · COUNT follows (ACEITO)
end
I --> FE: 200 {celebrities:[{slug, name, avatarUrl, bonds, followers,\nstyleSignature, material VITREO_HOLOGRAFICO, affinity?}], order, orders}
FE -> FE: renderiza cards (Avatar, áreas, seguidores, selos, afinidade)
U -> FE: toca em um perfil
FE -> FE2: navega para /brands/{slug}
FE2 -> PC: GET /api/institutional/{slug}
PC -> I: profile(viewer, slug)
I -> DB: SELECT celebrity_profiles WHERE slug
alt verification_status != APROVADO e visitante não é dona/admin
  I --> FE2: 404 Celebridade
else verificada
  I --> FE2: 200 {header: status "Verificada", autoApproval:false,\nautoApprovalLocked, coverLabel (ERA), kind, tabs}
end
par abas carregadas em paralelo
  FE2 -> SC: GET /api/users/{ownerId}/seals
  SC -> S: sealsOf(viewer, ownerId)
  S --> FE2: 200 [selos ACTIVE (premium)]
  FE2 -> SC: GET /api/users/{ownerId}/promotions
  SC -> S: promotionsOf(viewer, ownerId)
  S --> FE2: 200 [promoções + eligible]
end
U -> FE2: aba "Eras"
FE2 -> SH: GET /api/institutional/{slug}/showcase/eras
SH --> FE2: 200 eras (scheme_groupings type ERA)
FE2 -> SH: GET /api/institutional/{slug}/showcase/eras/items?groupingId=
SH --> FE2: 200 esquemas/peças da era
U -> FE2: aba "Esquemas em destaque"
FE2 -> PC: GET /api/institutional/{slug}/tabs/ESQUEMAS_DESTAQUE
PC -> I: tab(viewer, slug, "ESQUEMAS_DESTAQUE", filter, groupingId)
I --> FE2: 200 [{scheme, seals}]
U -> FE2: aba "Combinações FLAIR"
FE2 -> FC: GET /api/institutional/{slug}/flair
FC --> FE2: 200 combinações (RF14/RF22)
U -> FE2: seguir
FE2 -> PC: POST /api/users/{targetId}/followers
PC --> FE2: 200 (RF17)
@enduml
