@startuml RF22_Sequencia
title RF22 — Aba "Celebridades": feed e perfil das celebridades cadastradas\nDiagrama de sequência — feed /api/celebrities, perfil institucional, Hype da criadora e abas com a política de exibição
skinparam backgroundColor #FFFFFF
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
}
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
autonumber
actor "Pessoa" as U
participant "brands/page.tsx ·\nbrands/[slug]/page.tsx" as FE
participant "ProfileController" as PC
participant "HypeController ·\nInsightsController ·\nSealController" as HC
participant "InstitutionalService" as IS
participant "SealService" as SS
participant "HypeQueryService\n(+ HypeCache)" as HQ
database "MySQL" as DB

== Feed: aba "Celebridades" de /brands ==
U -> FE: troca para "Celebridades"
FE -> PC: GET /api/celebrities?term=&order=
PC -> IS: celebrityFeed(viewer, term, order)
IS -> DB: SELECT celebrity_profiles WHERE verification_status = 'APROVADO'\nORDER BY created_at DESC
opt logada
  IS -> DB: SELECT style_dna.style_keywords
end
IS -> HQ: groups(viewer, CREATOR, ids dos donos, 7)
HQ -> DB: hype_scores públicos (tabela por geração no HypeCache)
HQ --> IS: {items: {ownerId: {value, level, items, sufficient, rank}}}\n(bloqueio entre quem vê e a criadora = chave some)
loop cada celebridade
  IS -> DB: COUNT seal_bonds APPROVED · COUNT follows ACEITO
  opt AFINIDADE com DNA
    IS -> DB: wardrobe_items.style_tags (até 80)
  end
end
alt EM_ALTA
  IS -> IS: sort BY_GROUP_HYPE
else AFINIDADE com DNA
  IS -> IS: sort afinidade desc
end
IS --> FE: 200 {celebrities [{slug, name, avatarUrl, coverUrl, bonds, followers,\nstyleSignature, material VITREO_HOLOGRAFICO, affinity?, hype}], order, orders}

== Perfil /brands/[slug] ==
U -> FE: toca numa celebridade
FE -> PC: GET /api/institutional/{slug}
PC -> IS: profile(viewer, slug)
IS -> DB: SELECT celebrity_profiles WHERE slug
alt slug inexistente ou perfil PESSOAL
  IS --> FE: 404 Perfil institucional
else não APROVADA e quem vê não é a dona nem admin
  IS --> FE: 404 Celebridade (anônimo: NullPointerException → 500)
else
  IS -> DB: follows · wardrobe_items · schemes · seals ACTIVE ·\nscheme_groupings ERA · métricas RF19 (likes, reactions, saves)
  IS --> FE: 200 {header {status "Verificada", autoApproval false,\nautoApprovalLocked, coverLabel = 1ª ERA, metrics}, mode, tabs, groupings}
  par cabeçalho
    FE -> HC: GET /api/hype/groups?type=CREATOR&keys={ownerId}
    HC -> HQ: groups(viewer, CREATOR, [ownerId], 7)
    HC --> FE: 200 Hype da criadora (faixa, valor, base, posição)
  else
    FE -> HC: GET /api/insights?context=BRAND_PROFILE&key={slug}
    HC --> FE: 200 insights públicos (ProfileInsights, kind CELEBRITY)
  else
    FE -> HC: GET /api/users/{ownerId}/seals · /api/users/{ownerId}/promotions
    HC -> SS: sealsOf(viewer, ownerId) · promotionsOf(viewer, ownerId)
    HC --> FE: 200 selos Premium ativos · promoções (eligible pelo selo de quem vê)
  end
end

== Abas de looks e peças (mesma política do RF14) ==
U -> FE: "Esquemas em destaque" (ordem Hype)
FE -> PC: GET /api/institutional/{slug}/tabs/ESQUEMAS_DESTAQUE
PC -> IS: tab(viewer, slug, "ESQUEMAS_DESTAQUE", null, null)
IS -> DB: seal_bonds target_owner = celebridade AND status = APPROVED + schemes
IS -> IS: promoted(history = false): displayable, vigente, sem revalidação
IS -> HQ: currentOf(SCHEME, looks)
IS --> FE: 200 [{scheme, seals (premium), promotion {issuedAt, expiresAt,\nexpired, revalidationPending}}]
opt "Looks consagrados" (?filter=HYPE|GROWTH se mudar a ordem)
  FE -> PC: GET /api/institutional/{slug}/tabs/LOOKS_CONSAGRADOS[?filter=…]
  PC -> IS: tab(…): promoted(history = true) + filterLooks
  IS --> FE: 200 [entradas com expired / revalidationPending marcados]
end
opt aba só da dona pedida por outra pessoa
  IS --> FE: 403 (Guard.deny, auditado)
end
opt aba "Eras"
  FE -> FE: ErasTab → ShowcaseController (ver RF34)
end
@enduml
