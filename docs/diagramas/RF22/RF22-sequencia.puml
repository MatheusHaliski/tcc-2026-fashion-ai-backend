@startuml RF22_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."
title RF22 — Visualizar a aba 'Celebridades' — Feed de Perfil de Celebridades cadastradas dentro do sistema do FashionAI\nDiagrama de sequência — gerado do código em 2026-10-06 (scripts/diagramas/v5)

actor "Pessoa usuária" as U
boundary "Tela (Next.js)" as P
control "ProfileController" as ProfileController
participant "InstitutionalService" as InstitutionalService
database "MySQL" as DB_MySQL
participant "HypeQueryService" as HypeQueryService
participant "Guard" as Guard
== Celebridades (busca e ordenação) ==
U -> P : Celebridades (busca e ordenação)
P -> ProfileController : GET /api/celebrities
ProfileController -> InstitutionalService : celebrityFeed()
activate InstitutionalService
InstitutionalService -> DB_MySQL : SELECT celebrity_profiles
InstitutionalService -> DB_MySQL : SELECT style_dna
InstitutionalService -> HypeQueryService : groups()
HypeQueryService -> DB_MySQL : SELECT hype_scores
HypeQueryService -> DB_MySQL : SELECT hype_score_snapshots
HypeQueryService -> DB_MySQL : SELECT wardrobe_items
HypeQueryService -> DB_MySQL : SELECT schemes
HypeQueryService --> InstitutionalService
InstitutionalService -> DB_MySQL : SELECT seal_bonds
InstitutionalService -> DB_MySQL : SELECT follows
InstitutionalService -> DB_MySQL : SELECT wardrobe_items
deactivate InstitutionalService
InstitutionalService --> ProfileController : resultado
ProfileController --> P : 200 JSON
P --> U : atualiza a tela
== Celebridade edita seus dados institucionais ==
U -> P : Celebridade edita seus dados institucionais
P -> ProfileController : PATCH /api/me/celebrity-profile
ProfileController -> InstitutionalService : updateCelebrity()
activate InstitutionalService
InstitutionalService -> DB_MySQL : SELECT celebrity_profiles
InstitutionalService -> Guard : deny()
InstitutionalService -> InstitutionalService : coverUrl = set
InstitutionalService -> DB_MySQL : INSERT/UPDATE celebrity_profiles
InstitutionalService -> DB_MySQL : SELECT seal_bonds
InstitutionalService -> DB_MySQL : SELECT follows
deactivate InstitutionalService
InstitutionalService --> ProfileController : resultado
ProfileController --> P : 200 JSON
P --> U : atualiza a tela
@enduml
