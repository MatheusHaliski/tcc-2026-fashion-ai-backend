@startuml RF23_Componentes
title RF23 — Criar as telas de configuração do usuário (Conta, Privacidade, Aparência, Idioma, Seus dados) no padrão LGPD, com i18n\nDiagrama de componentes — gerado do código (controllers → serviços → repositórios/ports)
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
left to right direction

package "Frontend (Next.js)" {
  component "settings/page.tsx\n(abas Conta · Aparência · Privacidade · Seus dados · Sessões)" as FE0
  component "components/edit-profile.tsx\n(EditProfileForm)" as FE1
  component "lib/theme/theme.tsx\n(ThemeProvider · CHROME_BACKGROUNDS · CONTAINER_PRESETS)" as FE2
  component "lib/i18n (i18n.tsx · core.ts · state.ts · icu.ts)\nmessages/pt-BR.json · en.json · es.json" as FE3
  component "scripts/i18n (extract · scan · check · qa · JavaExtract)" as FE4
  component "components/app-shell.tsx\n(carrega preferências no login)" as FE5
}
package "fai-web · controllers" {
  [PreferencesController] as PC
  [MeController] as MC
  [BackgroundController] as BC
  [RequestLocaleFilter + I18nConfig\n(Accept-Language → Content-Language)] as LF
}
package "fai-application · services" {
  [PreferencesService] as PS
  [AccountService] as AS
  [AssetCatalogService] as AC
  [IdentityService\n(usernameSuggestions)] as IS
  [Msg (common)\ni18n/messages*.properties] as MSG
  [NotificationService] as NS
  [Audit] as AU
}
package "fai-infrastructure · adapters" {
  [UserPreferencesRepository\nUserRepository\nUserConsentRepository\nDataExportRequestRepository\nAssetPresetRepository] as REPOS
  [MediaStoragePort\n(local / S3 — restricted/)] as ST
}
database "MySQL · fashionai_app\n• user_preferences\n• users\n• user_consents\n• data_export_requests\n• audit_log\n• notifications" as DB

FE0 --> PC : GET/PUT /api/me/preferences\nPATCH /api/me/profile · PUT /api/me/username
FE1 --> PC : PATCH /api/me/profile\nPOST /api/me/avatar · /api/me/cover
FE0 --> MC : GET/PUT /api/me/consents/{purpose}\nPUT /api/me/privacy · POST/GET /api/me/exports
FE2 --> BC : GET /api/assets/chrome · /api/assets/manifest
FE5 --> PC : GET /api/me/preferences
FE3 --> LF : Accept-Language em toda chamada
FE4 ..> FE3 : gera/valida catálogos
PC --> PS : chama
MC --> AS : chama
BC --> AC : chama
PS --> AC : valida chromeBackgroundId / skin
PS --> IS : sugestões de @
PS --> AU : audita
AS --> NS : DATA_EXPORT_READY
AS --> AU : audita
AS --> ST : grava/lê exportação JSON
PS --> MSG : Msg.t (idioma da requisição)
AS --> MSG : Msg.resolveDeep (idioma preferido)
LF --> MSG : LocaleContextHolder
PS --> REPOS : lê/grava
AS --> REPOS : lê/grava
AC --> REPOS : lê presets
REPOS --> DB : JPA/Flyway
@enduml
