@startuml RF24_Classes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  StereotypeFontColor #6B6470
}
hide empty members
left to right direction
title RF24 — Usar a IA do sistema (motor transversal de inteligência artificial do Fashion AI)\nDiagrama de classes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "Backend (Java)" {
  class AiBudget <<service>> {
    -globalDaily: BigDecimal
    -userDaily: BigDecimal
    -clock: Clock
    +check()
    +globalDaily()
    +userDaily()
    +capped()
    +exceeds()
    +startOfUtcDay()
    +orZero()
  }
  class AiCatalog  {
    +envOr()
    +spec()
    +all()
    +put()
    +claude()
    +gemini()
    +local()
    +option()
  }
  class AiEngine <<service>> {
    -providers: Map<String,AiProviderPort>
    -budget: AiBudget
    -remoteEnabled: boolean
    -feature3d: boolean
    +text()
    +execute()
    +estimatedCost()
    +remoteAllowed()
    +localOutcome()
    +explanation()
    +classify()
    +consentState()
  }
  class AiOutcome  {
    -value: T
    -inferenceId: UUID
    -result: AiCallResult
    -fallbackUsed: boolean
    -provider: String
    -model: String
  }
  class AiProviderPort <<interface>> {
    +providerId()
    +available()
    +invoke()
  }
  class AiRequest  {
    -userId: UUID
    -capability: AiCapability
    -model: String
    -system: String
    -prompt: String
    -images: List<AiImage>
  }
  class AiResponse  {
    -provider: String
    -model: String
    -latencyMs: long
    -estimatedCostUsd: BigDecimal
    -text: String
    -inputTokens: long
  }
  class RateLimitPort <<interface>> {
    +tryAcquire()
    +status()
    +reset()
    +release()
  }
}
AiEngine --> RateLimitPort
AiEngine --> AiBudget
@enduml
