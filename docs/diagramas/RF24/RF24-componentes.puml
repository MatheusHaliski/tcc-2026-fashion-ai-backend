@startuml RF24_Componentes
title RF24 — Usar a IA do sistema\nDiagrama de componentes — telas → controllers → serviços hospedeiros → AiEngine → portas → provedores, Redis e MySQL
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
left to right direction

package "Frontend (Next.js)" {
  component "settings/page.tsx — aba Privacidade\n(um Switch por finalidade)" as FE0
  component "admin/system/page.tsx\n(provedores · catálogo · inferências recentes)" as FE1
  component "Telas dos RFs hospedeiros\n(pieces/new · schemes · mirror · copilot · autopilot ·\ndna · photos · room · explorer · brands · try-on…)\nmostram provedor ou \"motor local\" e o \"por quê?\"" as FE2
}
package "fai-web · controllers" {
  component "MeController\nGET /api/me/consents\nPUT /api/me/consents/{purpose}" as MC
  component "AdminController\nGET /api/admin/ai" as AC
  component "Controllers dos RFs hospedeiros\n(WardrobeController, SchemeController (+ Copilot),\nMirrorController, DnaController, AutopilotController,\nRoomController, PhotoController, DiscoveryController…)" as HC
}
package "fai-application · services" {
  component "AccountService\n(setConsent · consents)" as AS
  component "AdminService · DashboardService\n(aiOverview · providerAvailability)" as ADS
  component "Serviços hospedeiros — ai.text / ai.execute:\nWardrobeService · MultiPieceService · SchemeService ·\nMirrorService · DnaService · CopilotService ·\nAutopilotService · RoomService · HypeScoreService ·\nExplorerService · InsightService · BackgroundStudioService ·\nTryOnService · Model3dService · Avatar3dService ·\nBrandLogoService · BrandWebSearchService ·\nCatalogTextInterpreter · OfficialCatalogDiscovery" as HS
  component "Serviços com motor local primário — ai.local:\nSealService · LookbookService · InstitutionalService ·\nPhotoService · DnaService" as HSL
}
package "fai-application · ai (motor RF24)" {
  component "AiEngine\n(text · execute · local · remoteAllowed)" as AI
  component "AiCatalog\n(CapabilitySpec: primário · alternativo ·\nlocal · cota diária · timeout 30 s)" as CAT
  component "AiCapability\n(26 capacidades · hostRf · consentPurpose)" as CAP
  component "AiBudget\n(teto diário US$ global e por usuário)" as BUD
  component "CelebrityPromptValidator" as VAL
  component "ai.local\n(LocalAdvisors · LocalSchemeComposer ·\nLocalDnaSynthesizer · Similarity · ColorMath)" as LOC
}
package "Portas" {
  component "AiProviderPort <<port>>" as PP
  component "AuditService <<port>>\n(record: CHAMADA_IA)" as AUD
  component "RateLimitPort <<port>>" as RLP
  component "ImageProviderPorts <<port>>\n(TryOn · BackgroundRemoval · StudioShot ·\nUpscale · ImageGeneration · ImageEdit · Model3d)" as IPP
}
package "fai-infrastructure" {
  component "ai-providers\nGeminiProvider (gemini) · ClaudeProvider (claude)\n+ ProviderCircuit (1 retry · abre 60 s após 5 falhas)" as PROV
  component "ai-providers · image\nFashnTryOnAdapter · RembgAdapter · RemoveBgAdapter ·\nPhotoroomStudioAdapter · StabilityUpscaleAdapter ·\nReplicateImageGenerationAdapter · ReplicateImageEditAdapter ·\nGeminiImageEditAdapter · MeshyModel3dAdapter · StabilityFast3dAdapter" as IMG
  component "platform · InMemoryRateLimit\n(padrão)\ncache-redis · RedisAdapters.redisRateLimit\n(fashionai.redis.enabled=true)" as RL
  component "persistence-mysql\nAiInferenceLogRepository · UserConsentRepository\n+ MysqlAuditService (AuditService)" as REPOS
}
database "MySQL\n• ai_inference_log\n• user_consents\n• audit_log" as DB
database "Redis\n(baldes ai:CAPACIDADE)" as REDIS
cloud "Google Gemini API\n(generativelanguage.googleapis.com)" as GEM
cloud "Anthropic API (Claude)" as CLA
cloud "Imagem/3D: FASHN · remove.bg · Photoroom ·\nReplicate · Stability · Meshy · rembg próprio" as IMGC

FE0 --> MC
FE1 --> AC
FE2 --> HC
MC --> AS
AC --> ADS
HC --> HS
HC --> HSL
AS --> REPOS : grava consentimento
ADS --> AI : providerAvailability · remoteEnabled
ADS --> CAT : AiCatalog.all()
ADS --> REPOS : últimas inferências
HS --> AI : text(TextCall) / execute(RemoteSteps)
HSL --> AI : local(engine)
HS --> LOC : valor de fallback
AI --> CAT : spec(capability)
CAT --> CAP
AI --> VAL
AI --> BUD
AI --> RLP
AI --> PP
AI --> AUD
AI --> REPOS : consentimento · ai_inference_log
BUD --> REPOS : soma o custo do dia
HS ..> IPP : passos remotos de imagem/3D
PROV ..|> PP
IMG ..|> IPP
RL ..|> RLP
RL --> REDIS
REPOS ..|> AUD
REPOS --> DB : JPA/Flyway
PROV --> GEM : HTTPS
PROV --> CLA : HTTPS (SDK oficial)
IMG --> IMGC : HTTPS
@enduml
