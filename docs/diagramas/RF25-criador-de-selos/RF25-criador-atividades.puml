@startuml RF25_Criador_Atividades
title RF25 — Criar & editar selo de marca ou celebridade\nDiagrama de atividades — criador em 4 passos: modo (com/sem IA) → dados e política → arte (Circular · Folha · Padrão FashionAI) → revisar e salvar
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 18
skinparam ArrowColor #52606D
skinparam activity {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  DiamondBackgroundColor #FFF5F8
  DiamondBorderColor #F08DB1
  StartColor #20A77A
  EndColor #4B5563
  BarColor #4B4B4B
}
skinparam swimlane {
  BorderColor #CBC6BE
  TitleFontColor #2D2438
}
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
|Emissor (marca/celebridade)|
start
:Perfil → aba "Selos" → "Novo selo" (ou "Editar");
|Frontend (SealWizard)|
if (Editar selo existente?) then (sim)
  :Abre no passo 2 (modo = sem IA)\ncom nome, nível, política, validade, limite e desenho;
else (não)
  partition "Passo 1 · Modo" {
    |Emissor (marca/celebridade)|
    if (Com IA?) then (sim)
      |Frontend (SealWizard)|
      :POST /api/seals/draft {tier};
      |Backend (SealService)|
      if (Perfil MARCA/CELEBRIDADE aprovado e ativo?) then (não)
        #FFE3E3:403 → toast; volta ao passo 1;
        stop
      endif
      :SealDrafts.suggest(nome do perfil, celebridade?, nível,\naté 300 peças do emissor): cor mais frequente,\nmarca, categoria, até 2 ocasiões e 2 estilos;
      :Arte sugerida: marca → anel circular de cor mais próxima\n(SealDesigns.nearestCircular) + iniciais;\ncelebridade → folha "folha/mat-12" com o nome;
      note right: nada é salvo; audit "seal:draft"
      |Frontend (SealWizard)|
      :Preenche dados e arte; mostra\n"Sugerido pela IA" com os motivos;
    else (não)
      |Frontend (SealWizard)|
      :Começa do desenho padrão (paleta FAI);
    endif
  }
endif
partition "Passo 2 · Dados" {
  |Emissor (marca/celebridade)|
  :Nome (até 160), nível LOOK/PEÇA;
  :Política padronizada (SealPolicyEditor):\naté 6 regras quantificador (AT_LEAST n · ALL · NONE)\n× cor × marca × categoria × subcategoria × Hype mínimo;\naté 4 ocasiões e 4 estilos; ALL/ANY;
  :Critério de Hype da entidade (opcional):\nfaixa mínima, score mínimo e até 3 momentos;
  :Disponível a partir de / Expira em (vazio = imediato / sem fim)\ne limite de emissões (≥ 1, opcional);
}
partition "Passo 3 · Arte" {
  :Escolhe o tipo do selo;
  if (Tipo?) then (Circular)
    if (Origem?) then (Modelos)
      :Um dos 44 anéis com centro livre;
      :Núcleo (SealCoreEditor): Elemento (12 ícones +\nmaterial + cor + texto ≤ 3) | Imagem | Texto (≤ 24);
    else (Personalizado)
      :SealCreator: gerador (paleta, padrão entre borda\ne centro, materiais) ou envio de selo pronto;
      if (Enviou selo pronto?) then (sim)
        |Frontend (SealWizard)|
        :validateSealImage no cliente;
        :POST /api/seals/uploads (multipart);
        |Backend (SealService)|
        :SealDesignService.upload: 1:1 (± 3 %), 256–4096 px\n→ PNG 512 px em users/{id}/seals/upload-*.png;
        if (Válido?) then (não)
          #FFE3E3:400 SELO_PROPORCAO_INVALIDA ·\nSELO_PEQUENO · SELO_GRANDE;
        else (sim)
          :{url, circular, warning se os cantos não forem transparentes};
        endif
        |Emissor (marca/celebridade)|
      endif
    endif
  elseif (Folha)
    :Uma das 33 folhas picotadas;
    :Textos da folha: título (vazio = nome do selo), série,\nsubtítulo, rótulo, legenda, ano e emblema;
    :Emblema central: elemento da arte | imagem | texto;
  else (Padrão FashionAI)
    :Um dos 13 medalhões prontos;
  endif
  if (Núcleo/emblema com imagem enviada?) then (sim)
    |Frontend (SealWizard)|
    :Confere no cliente (≥ 64 px, proporção ≤ 4:1);
    :POST /api/seals/uploads?purpose=core;
    |Backend (SealService)|
    :SealDesignService.uploadCore → PNG ≤ 640 px\nem users/{id}/seals/core-*.png;
    if (Válido?) then (não)
      #FFE3E3:400 NUCLEO_PEQUENO · NUCLEO_PROPORCAO;
    endif
    |Emissor (marca/celebridade)|
  endif
  :Prévia ao vivo: 200 px, card do look (44 px)\ne card da peça (36 px);
}
partition "Passo 4 · Revisar e salvar" {
  |Frontend (SealWizard)|
  if (Nome com ≥ 2 caracteres?) then (não)
    :Botões "Avançar"/"Salvar selo" desabilitados;
    stop
  endif
  :Resumo: nome, nível, frase da política (describePolicy),\nvalidade, limite e tipo — "Editar" volta ao passo;
  :POST /api/seals | PUT /api/seals/{id};
  |Backend (SealService)|
  :Guard.requireApprovedInstitutional (senão 403);
  :nome 2–160 → SealPolicies.normalize/describe → policyText;\nSealDesigns.normalize → desenho válido do catálogo;\nOwnMedia: imagens só do próprio emissor;\nfolha sem título → título = nome do selo;
  if (Válido?) then (não)
    #FFE3E3:400 CAMPO_INVALIDO · POLITICA_INVALIDA ·\nSELO_DESIGN_INVALIDO {fields} · MIDIA_INVALIDA ·\nPERIODO_INVALIDO · LIMITE_INVALIDO;
    |Frontend (SealWizard)|
    :toast; continua no passo 4;
    stop
  endif
  |Backend (SealService)|
  :INSERT/UPDATE seals: background_config_json\nguarda {design, policy}; audit SELO_EDITADO;
}
|Emissor (marca/celebridade)|
:Selo aparece na aba "Selos" com o medalhão,\na frase da política, as emissões e o "Hype do selo";
note right
  "Desativar"/"Ativar" na aba = PUT /api/seals/{id}
  com status INACTIVE/ACTIVE.
  Selo ACTIVE, dentro da validade e abaixo do limite
  entra na detecção por política nos criadores de
  peça (RF4) e de look (RF5) — ver RF25_Deteccao_Politica_Sequencia.
  Os Selos de Hype (VIRAL, TRENDING, EMERGING, CLASSIC, RARE)
  não passam por este criador: são automáticos, vêm do
  HypeScore v2 e usam medalhões Padrão FashionAI fixos.
end note
stop
@enduml
