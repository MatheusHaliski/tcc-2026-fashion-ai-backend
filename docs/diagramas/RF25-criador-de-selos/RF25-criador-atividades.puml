|Pessoa usuária|
start
|Backend (Java)|
partition "SealDesigns.normalize()" {
  if (selo design inválido?) then (sim)
    :400 SELO_DESIGN_INVALIDO\n«Revise o desenho do selo.»;
    stop
  endif
}
|Backend (Java)|
partition "SealDrafts.suggest()" {
  :executa;
}
|API (Spring Boot)|
partition "OwnMedia.accepts()" {
  :MediaStoragePort.keyOf();
}
|Pessoa usuária|
:Vê o resultado;
stop
