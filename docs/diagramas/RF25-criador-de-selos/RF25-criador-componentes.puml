  component "seal-medallion.tsx" as m_components_seal_medallion_tsx <<apoio>>
}
package "lib" {
  component "dev-refs.ts" as m_lib_dev_refs_ts <<apoio>>
}
package "lib/api" {
  component "taxonomy.ts" as m_lib_api_taxonomy_ts <<apoio>>
}
package "lib/hype" {
  component "model.ts" as m_lib_hype_model_ts <<apoio>>
}
package "Backend (Spring Boot)" {
  component "SealController" as SealController
  component "WardrobeController" as WardrobeController
  component "SealDesigns" as SealDesigns <<apoio>>
  component "SealDrafts" as SealDrafts <<apoio>>
  component "OwnMedia" as OwnMedia
  component "SealDesignService" as SealDesignService
  component "SealPolicies" as SealPolicies <<apoio>>
  component "SealService" as SealService
}
database "MySQL" as DB_MySQL
