@startuml RF25_Criador_Componentes
title RF25 — Criar & editar selo de marca ou celebridade\nDiagrama de componentes — criador (4 passos), catálogo de modelos, detecção por política e Selos de Hype
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam component {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  ArrowColor #52606D
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #2D2438
}
skinparam interface {
  BackgroundColor #FFF5F8
  BorderColor #F08DB1
}


package "Frontend (Next.js)" {
  package "Perfil do emissor" {
    component "brands/[slug]/page.tsx\n(abas Selos · Revisão · Métricas)" as Page
    [SealWizard · SealArt · SealReview\n(seal-wizard.tsx)] as Wizard
    [SealPolicyEditor\n(regras, tags, Hype; describePolicy)] as PolEd
    [SealCoreEditor\n(Elemento · Imagem · Texto)] as CoreEd
    [SealCreator\n(gerador circular / upload)] as Gen
  }
  package "Criadores e cards" {
    [scheme-builder.tsx (RF5)\npiece-form.tsx (RF4)] as Criadores
    [scheme-card.tsx · piece-card.tsx\n(SealSlot)] as Cards
    [hype-seals.tsx\n(withHypeSeals · SealHypeStat ·\nHypeSealProgressList)] as HypeUi
    [hype-analytics-drawer.tsx] as Drawer
  }
  [SealMedallion\n(seal-medallion.tsx: render por kind)] as Med
  [lib/seals/templates.ts\n+ templates.json] as Cat
  [lib/hype/seals.ts\n(HYPE_SEAL_DESIGN → fai/03…)] as HypeLib
  [lib/hype/use-hype.ts\n(useHypeSummary)] as UseHype
  [lib/pieces/use-piece-seals.ts] as UsePS
}
package "Assets e geração (scripts/selos)" {
  [public/selos/{fai,circular,folha}\n13 · 44 · 33 modelos] as Assets
  [build_templates.py · build_folhas.mjs] as Build
}
package "fai-web" {
  [SealController\n/api/seals · /draft · /uploads · /design-catalog\n/api/seal-suggestions/* · /api/seal-bonds/*\n/api/pieces/seals] as Ctl
  [HypeController\n/api/hype/summaries · /pieces/{id} · /looks/{id}] as HCtl
}
package "fai-application" {
  [SealService] as Svc
  [SealDesignService] as Up
  [SealDrafts\n(IA local do "Com IA")] as Drafts
  [SealDesigns\n(+ seals/templates.json)] as Designs
  [SealPolicies] as Pol
  [OwnMedia] as Own
  [Guard · Audit · NotificationService] as Sec
  [AiEngine\n(local SEALBOND_MATCHER)] as Ai
  [HypeQueryService] as HQ
  [HypeSeals\n(Selos de Hype derivados)] as HS
  [HypeCache] as HC
  [CouponService\n(onCheck AFTER_COMMIT)] as Coupon
  interface "MediaStoragePort" as MSP <<port>>
  interface "RenderCachePort" as RCP <<port>>
}
package "fai-domain" {
  [Seal · SealBond · HypeScoreCurrent\nSealRepository · SealBondRepository\nHypeScoreCurrentRepository\nWardrobeItemRepository\nBrand/CelebrityProfileRepository] as Dom
}
package "fai-infrastructure" {
  database "MySQL\nseals · seal_bonds · wardrobe_items\nhype_scores · ai_inference_log · audit_log" as DB
  [S3MediaStorageAdapter /\nLocalFileMediaStorage\nusers/{id}/seals/*.png] as ST
  [RedisAdapters.redisRenderCache /\nInMemoryRenderCache] as Cache
}

Page --> Wizard
Wizard --> PolEd
Wizard --> CoreEd
Wizard --> Gen
Wizard --> Med
Page --> HypeUi : "Hype do selo"
Cards --> Med
Cards --> HypeUi
Cards --> UseHype
Cards --> UsePS
Criadores --> HypeUi : Hype da sugestão
Drawer --> HypeUi
HypeUi --> HypeLib
HypeUi --> Med
Med --> Cat
Cat ..> Assets
Build --> Assets
Build --> Cat
Build --> Designs : seals/templates.json

Wizard --> Ctl : POST /api/seals/draft\nPOST·PUT /api/seals
CoreEd --> Ctl : POST /api/seals/uploads?purpose=core
Gen --> Ctl : POST /api/seals/uploads
Page --> Ctl : GET /api/users/{ownerId}/seals\nPOST /api/seal-bonds/{id}/review
Criadores --> Ctl : POST /api/seal-suggestions/preview(-piece)\nPOST /api/schemes/{id}/seal-bonds
UsePS --> Ctl : GET /api/pieces/seals?ids=
UseHype --> HCtl : GET /api/hype/summaries
Drawer --> HCtl : GET /api/hype/{pieces|looks}/{id}

Ctl --> Svc
Ctl --> Up
HCtl --> HQ
Svc --> Drafts
Svc --> Designs
Svc --> Pol
Svc --> Own
Svc --> Sec
Svc --> Ai
Svc ..> HQ : currentOf (critério de Hype,\nordem e "Hype do selo")
Svc --> HC
Svc ..> Coupon : CouponRightsCheck
HQ --> HS : summary().seals ·\ndetail().sealProgress
Drafts --> Designs
Up --> Designs
Up --> MSP
Own --> MSP
HC --> RCP
Svc --> Dom
HQ --> Dom
Dom --> DB
Ai --> DB
MSP <|.. ST
RCP <|.. Cache
@enduml
