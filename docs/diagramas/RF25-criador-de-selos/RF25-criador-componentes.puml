@startuml RF25_Criador_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF25 — Criador de selo: componentes (frontend, backend, catálogo de modelos e armazenamento)\nDiagrama de componentes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "app/(site)" {
  component "page.tsx" as m_app__site__page_tsx
}
package "lib/seals" {
  component "templates.ts" as m_lib_seals_templates_ts
}
package "components/ui" {
  component "index.tsx" as m_components_ui_index_tsx
  component "icons.tsx" as m_components_ui_icons_tsx <<apoio>>
}
package "components" {
  component "seal-wizard.tsx" as m_components_seal_wizard_tsx
  component "seal-policy-editor.tsx" as m_components_seal_policy_editor_tsx
  component "seal-core-editor.tsx" as m_components_seal_core_editor_tsx
