@startuml RF25_Criador_Estados
!pragma layout smetana
title RF25 — Criar & editar selo de marca ou celebridade\nDiagrama de máquina de estados — assistente SealWizard (passo, tipo de arte e modo do núcleo)
skinparam backgroundColor #FFFFFF
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  ArrowColor #52606D
}
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
[*] --> Modo : "Novo selo" (step 0)
[*] --> Dados : "Editar" (form.id → step 1, modo MANUAL)
state "Modo (step 0)" as Modo
state "Sugerindo (IA)\ndrafting = true" as Sugerindo
state "Dados (step 1)" as Dados
state "Arte (step 2)" as Arte {
  [*] --> Circular
  state Circular {
    [*] --> Modelo
    Modelo --> Personalizado : origem
    Personalizado --> Modelo : origem
  }
  state Folha
  state "Padrão FashionAI" as FAI
  Circular --> Folha : tipo
  Folha --> FAI : tipo
  FAI --> Circular : tipo
  Folha --> Circular : tipo
  note right of Folha : ao voltar a um tipo,\no último modelo escolhido\nnele é restaurado
}
state "Revisar (step 3)" as Revisar
state "Salvando\nsaving = true" as Salvando
state Salvo
Modo --> Sugerindo : "Com IA" → POST /api/seals/draft
Sugerindo --> Dados : 200 sugestão + reasons
Sugerindo --> Modo : erro 403/5xx (toast, mode = null)
Modo --> Dados : "Sem IA" (mode = MANUAL)
Dados --> Arte : Avançar
Arte --> Dados : Voltar
Arte --> Revisar : Avançar [nome ≥ 2]
Revisar --> Dados : "Editar" (nome, nível, política,\nvalidade, limite)
Revisar --> Arte : "Editar" (tipo)
Revisar --> Salvando : "Salvar selo" [nome ≥ 2]
Salvando --> Salvo : 201 POST | 200 PUT\n(Dialog fecha, aba recarrega)
Salvando --> Revisar : 400 CAMPO_INVALIDO · POLITICA_INVALIDA ·\nSELO_DESIGN_INVALIDO · MIDIA_INVALIDA ·\nPERIODO_INVALIDO · LIMITE_INVALIDO (toast)
Salvo --> [*]

state "Núcleo (circular e emblema da folha) — SealCoreEditor" as Nucleo {
  [*] --> ELEMENT
  state ELEMENT : ícone + material + cor + texto ≤ 3
  state IMAGE {
    state "Sem imagem" as SemImg
    state "Enviando\nPOST /api/seals/uploads?purpose=core" as Enviando
    state "Com imagem\nimageUrl" as ComImg
    [*] --> SemImg
    SemImg --> Enviando : arquivo ok no cliente\n(≥ 64 px, ≤ 4:1)
    SemImg --> SemImg : arquivo recusado no cliente (toast)
    Enviando --> ComImg : 200 {url}
    Enviando --> SemImg : 400 NUCLEO_PEQUENO ·\nNUCLEO_PROPORCAO · 403 (toast)
    ComImg --> Enviando : "Trocar"
  }
  state TEXT : texto obrigatório (≤ 24),\naté 2 linhas
  ELEMENT --> IMAGE : segmento "Imagem"
  ELEMENT --> TEXT : segmento "Texto"
  IMAGE --> TEXT : segmento "Texto"
  TEXT --> IMAGE : segmento "Imagem"
  TEXT --> ELEMENT : segmento "Elemento"
  IMAGE --> ELEMENT : "Remover imagem" ou segmento
  note bottom of IMAGE : no salvamento, OwnMedia exige\nimagem do próprio emissor;\nzoom 1–3 e texto opcional
}
@enduml
