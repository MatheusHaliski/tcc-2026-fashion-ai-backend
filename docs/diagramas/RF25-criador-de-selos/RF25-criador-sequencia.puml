@startuml RF25_Criador_Sequencia
title RF25 — Criador de selo: sugestão "Com IA", upload do núcleo e salvamento\nDiagrama de sequência
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam sequence {
  ArrowColor #52606D
  LifeLineBorderColor #B695F5
  ParticipantBackgroundColor #F8F4FF
  ParticipantBorderColor #B695F5
  ActorBackgroundColor #F8F4FF
  GroupBackgroundColor #FFF5F8
}
actor "Emissor\n(marca/celebridade)" as E
participant "SealWizard\n(seal-wizard.tsx)" as W
participant "SealArt +\nSealCoreEditor" as A
participant "SealMedallion\n(prévia)" as M
participant "SealController" as C
participant "SealService" as S
participant "SealDrafts" as D
participant "SealDesignService" as U
participant "SealDesigns" as N
participant "OwnMedia" as O
database "MySQL\nseals" as DB
database "Storage\nusers/{id}/seals" as ST

E -> W : "Novo selo"
group Passo 1 — Com IA
  E -> W : escolhe "Com IA"
  W -> C : POST /api/seals/draft {tier}
  C -> S : draft(user, tier)
  S -> S : requireIssuer (perfil aprovado)
  S -> DB : perfil emissor + peças do emissor
  S -> D : suggest(nome, celebridade?, tier, peças)
  D -> N : nearestCircular(cor dominante) / labelFrom(nome)
  D -> N : normalize(design sugerido)
  D --> S : {name, tier, policy, design, reasons}
  S --> W : 200 sugestão (nada salvo)
  W -> W : preenche dados e arte; mostra o porquê
end
group Passo 3 — Arte
  E -> A : tipo (Circular | Folha | Padrão FashionAI) e modelo
  A -> M : design {kind, mode, template, texts, core}
  M --> E : prévia 200/44/36 px
  opt núcleo com imagem
    E -> A : escolhe arquivo
    A -> A : valida no cliente (≥ 64 px, ≤ 4:1)
    A -> C : POST /api/seals/uploads?purpose=core (multipart)
    C -> U : uploadCore(user, bytes)
    U -> U : perfil MARCA/CELEBRIDADE; decodifica; reduz a ≤ 640 px
    U -> ST : put(users/{id}/seals/core-{uuid}.png)
    U --> A : {url, width, height}
    A -> M : core {mode: IMAGE, imageUrl, zoom, text?}
  end
end
group Passo 4 — Revisar e salvar
  E -> W : "Salvar selo"
  W -> C : POST /api/seals {name, tier, policy, design, validade, limite}
  C -> S : createSeal(user, form)
  S -> N : normalize(design)
  alt desenho inválido
    N --> S : ApiException 400 SELO_DESIGN_INVALIDO {fields}
    S --> W : 400 (campos apontados)
  else válido
    S -> O : require(owner, core.imageUrl) — só arquivo do próprio emissor
    S -> S : SealPolicies.normalize/describe → policyText
    S -> DB : INSERT seals (background_config_json = {design, policy})
    S --> W : 201 sealView
    W --> E : selo na aba "Selos"
  end
end
@enduml
