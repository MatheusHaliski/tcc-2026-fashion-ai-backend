@startuml RF25_MaquinaDeEstados_Promocao
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  StartColor #20A77A
  EndColor #4B5563
}
title RF25 — ciclo de vida de Promotion.status\nDiagrama de máquina de estados — gerado do código em 2026-10-14 (scripts/diagramas/v5)\nenum PromotionStatus · tabela promotions

state "Promotion.status" as Ciclo_Promotion {
  state Ciclo_Promotion_AVAILABLE as "AVAILABLE"
  state Ciclo_Promotion_REDEEMED as "REDEEMED"
  state Ciclo_Promotion_EXPIRED as "EXPIRED"
  state Ciclo_Promotion_REVOKED as "REVOKED"
}
[*] --> Ciclo_Promotion_AVAILABLE : criação
Ciclo_Promotion --> Ciclo_Promotion_REDEEMED : redeem()\nPOST /api/promotions/{id}/redemptions
note bottom of Ciclo_Promotion
  Sem mudança explícita no código para: EXPIRED, REVOKED
  (valor vindo de importação, regra calculada ou dado legado)
end note
note right of Ciclo_Promotion
  Setas que saem da borda: a mudança vale
  a partir de qualquer estado (o código não
  testa o estado anterior).
end note
@enduml
