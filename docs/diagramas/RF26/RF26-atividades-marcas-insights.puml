@startuml RF26_Atividades_Marcas_Insights
title RF26 — Busca global de esquemas e peças (aba "Explorador Global")\nDiagrama de atividades — "Buscar marcas & lojas" (Hype v2, minLevel) e "Insights globais" (três blocos + leitura da IA)
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 18
skinparam ArrowColor #52606D
skinparam activity {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  DiamondBackgroundColor #FFF5F8
  DiamondBorderColor #F08DB1
  StartColor #20A77A
  EndColor #4B5563
  BarColor #4B4B4B
}
skinparam swimlane {
  BorderColor #CBC6BE
  TitleFontColor #2D2438
}
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}

|Pessoa|
start
if (Qual aba?) then (Buscar marcas & lojas)
  :Nome, país, categoria, cor, estação,\nnível mínimo de Hype (minLevel) e ordem\n(Mais Hype · Mais looks com selo);
  |Frontend|
  :GET /api/explorer/brands?term&country&category\n&color&season&minLevel&sort;
  |API|
  :DiscoveryController.brands → ExplorerService.brandsAndStores;
  if (minLevel fora da escala?) then (sim)
    #FFE3E3:400 NIVEL_INVALIDO (SearchService.parseLevel);
    |Frontend|
    :ErrorState;
    stop
  endif
  |Banco/IA|
  :BrandProfile APROVADO + brandFacets (cores, estações)\n+ brandUsage (peças públicas) + seal_bonds APPROVED;
  :hype_scores públicos: peças por marca e\nlooks vinculados por selo vigente;
  |API|
  :filtra nome, país, categoria, cor e estação;
  :hype = brandHype(): ≥ 3 looks vinculados com Hype público →\nmédia deles (BONDED_LOOKS); senão ≥ 3 peças públicas →\nmédia das 5 mais relevantes (BRAND_GROUP); senão sem valor;
  :passesHype(minLevel): marca sem valor nunca passa;
  if (CatalogService ativo e sem filtro de cor/estação?) then (sim)
    :acrescenta marcas só do catálogo global (RF47),\ncom Hype pelas peças públicas da marca;
  endif
  :ordena: HYPE (sem valor por último) ou SCHEMES;\ndevolve facets, levels, minItems (3);
  |Frontend|
  if (Nenhuma marca?) then (sim)
    :EmptyState "Nenhuma marca com esses filtros";
  else (não)
    :Cards: logo, país · categoria, peças/looks,\nlinha de Hype (valor + faixa ou "—"),\npaleta, estações; "Ver perfil" (RF14),\n"Buscar peças" (catálogo) ou "Loja";
  endif
else (Insights globais)
  |Frontend|
  :InsightStrip (contexto EXPLORER_GLOBAL) +\nGET /api/explorer/insights;
  |API|
  :DiscoveryController.insights → ExplorerService.insights;
  |Banco/IA|
  :hypeRankings(): população pública de hype_scores\n(peças; estação pelos looks); grupo com < 3 itens fica fora;
  :volume: brandUsage (peças públicas), colorRanking,\ncountries (looks públicos por país);
  |API|
  :Bloco Hype: byCategory, byColor, byBrand\n(média das 5 mais relevantes), bySeason;
  :Bloco Crescimento: growthByCategory\n(dimensão TREND, 50 = estável);
  :Bloco Volume: topBrands, topColors, topCountries;
  :texto local = LocalAdvisors.insightText(rankings);
  if (Pessoa autenticada?) then (sim)
    |Banco/IA|
    :AiEngine.text(INSIGHT_GENERATOR, até 250 tokens)\n— motor de IA do RF24;
    |API|
    if (IA respondeu?) then (sim)
      :aiInsight = texto da IA (até 400 caracteres);
    else (não)
      :aiInsight = texto local, fallbackUsed = true;
    endif
  else (não)
    :aiInsight = texto local\n("faça login para a leitura da IA");
  endif
  :200 {rankings, hype, aiInsight, explanation, fallbackUsed, note};
  |Frontend|
  :Card "Leitura de tendência" (IA ou motor local)\n+ seções Hype · Crescimento · Volume;\ngrupo sem base mostra "—", nunca 0;
endif
|Pessoa|
:Lê tendências agregadas, sem dados pessoais;
stop
@enduml
