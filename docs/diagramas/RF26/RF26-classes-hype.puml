@startuml RF26_Classes_Hype
title RF26 — Busca global de esquemas e peças (aba "Explorador Global")\nDiagrama de classes — globo com camadas de Hype v2, "Em alta" e "Ranking de HypeScore"
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  HeaderBackgroundColor #E4DEF0
}
skinparam packageStyle rectangle
hide empty methods
set separator none

package "frontend (lib/hype/globe.ts · components/hype)" {
  class GlobeFilters <<interface TS>> {
    layers : GlobeLayer[]  «numbers · columns · figures · cards · heat»
    metric : GlobeMetric  «avg · max · volume · growth»
    type : PIECE | SCHEME
    window : "1" | "7" | "30"
    category : string
    minLevel : HypeLevel | ""
  }
  class "hype-globe.tsx" as HypeGlobeUi <<React>> {
    useGlobeFilters()  «estado na URL»
    HypeGlobeFilterBar · HypeGlobeLegend
    HypeGlobeTable · HypeGlobeCountryPanel
  }
  class "globe.tsx" as GlobeUi <<React, d3-geo>> {
    Globe(points, selected, onSelect, hype)
  }
  class HypeTrendingPanel <<React>>
  class HypeRankingPanel <<React>>
}

package "fai-web" {
  class HypeController <<RestController>> {
    +globe(viewer, type, window, category, subcategory, minLevel)  «GET /api/hype/globe»
    +trending(viewer, type, window, category, style, occasion, limit)  «GET /api/hype/trending»
    +ranking(viewer, type, window, region, country, category, subcategory, page, size)  «GET /api/hype/ranking»
    +rankingFacets(type, window, region, category)  «GET /api/hype/ranking/facets»
    {static} ~type(raw): HypeEntityType  «400 TIPO_INVALIDO»
  }
}

package "fai-application · hype" {
  class HypeQueryService <<service>> {
    +GLOBE_MIN_ITEMS = 3 · ~GLOBE_TOP_CANDIDATES = 8
    +RANKING_MAX_SIZE = 48 · ~NO_REGION = "OUTRAS"
    ~MIN_GROUP_ITEMS = 3
    +globe(…): Map
    ~globeAggregate(type, win, cat, sub, min): Map
    ~globeCountry(co, list, hype, metric, colors): Map
    {static} ~globeLevel(raw): HypeLevel  «400 NIVEL_INVALIDO»
    +trending(…): Map
    ~rank(type, win, category, style, occasion, lim): Map
    +trendingGroups(viewer, RankGroup, …): Map
    +ranking(…): Map
    ~rankRegional(type, win, region, country, cat, sub): Map
    +rankingFacets(…): Map
    ~publicPool(type): List<HypeScoreCurrent>
    ~monthAverage(type, ids): Map<UUID, Double>
    +currentOf(type, ids): Map<UUID, HypeScoreCurrent>
    +detail(viewer, type, id): Map
  }
  enum "HypeQueryService.RankGroup" as RankGroup {
    BRAND
    CREATOR
    {static} parse(raw)
  }
  class HypeCache <<service>> {
    ~TTL = 10 min
    +get(key, loader): Map  «chave com a geração»
    +generation() · +bump()  «job»
  }
  interface RenderCachePort <<port>>
  class HypeScoreConfig <<component>> {
    +algorithmVersion(): String
    +level(score): HypeLevel
    +levelThresholds(): int[]
  }
  class WorldRegions <<final>> {
    {static} of(country): String
    {static} label(region): String
    {static} codes(): List<String>
  }
}

package "fai-domain" {
  class HypeScoreCurrent <<entity hype_scores>> {
    entityType : HypeEntityType
    entityId, ownerId : UUID
    algorithmVersion : String
    status : HypeStatus
    score : BigDecimal
    level : HypeLevel
    momentum : HypeMomentum
    dimensions : HypeDimensions
    publicEligible : boolean
    category, styles, occasions : String
    country, region : String  «do dono (V39)»
    categories, subcategories : String  «look: das peças»
    calculatedAt : Instant
  }
  class HypeScoreSnapshot <<entity hype_score_snapshots>> {
    entityType : HypeEntityType
    entityId : UUID
    snapshotDate : LocalDate
    score : BigDecimal
    level : HypeLevel
    publicEligible : boolean
  }
  class HypeDimensions <<embeddable>> {
    popularity · engagement · trend · trendVelocity
    originality · rarity · longevity · novelty · influence
  }
  interface HypeScoreCurrentRepository <<repository>> {
    findByEntityTypeAndAlgorithmVersion\nAndPublicEligibleTrueAndStatus(type, versão, status)
    findByEntityTypeAndEntityIdInAndAlgorithmVersion(type, ids, versão)
  }
  interface HypeScoreSnapshotRepository <<repository>> {
    findByEntityTypeAndAlgorithmVersion\nAndSnapshotDateBetween(type, versão, de, até)
  }
  enum HypeEntityType {
    PIECE
    SCHEME
  }
  enum HypeStatus {
    AVAILABLE
    INSUFFICIENT_DATA
  }
  enum HypeMomentum {
    EMERGING
    RISING
    STABLE
    COOLING
    CLASSIC
  }
}

HypeGlobeUi ..> GlobeFilters
HypeGlobeUi ..> HypeController : GET /api/hype/globe
GlobeUi ..> HypeGlobeUi : camadas e métrica
HypeTrendingPanel ..> HypeController : GET /api/hype/trending
HypeRankingPanel ..> HypeController : GET /api/hype/ranking(/facets)
HypeController --> HypeQueryService
HypeQueryService ..> RankGroup
HypeQueryService --> HypeCache
HypeCache --> RenderCachePort
HypeQueryService --> HypeScoreConfig
HypeQueryService ..> WorldRegions
HypeQueryService --> HypeScoreCurrentRepository
HypeQueryService --> HypeScoreSnapshotRepository : janela 30
HypeScoreCurrentRepository ..> HypeScoreCurrent
HypeScoreSnapshotRepository ..> HypeScoreSnapshot
HypeScoreCurrent *-- HypeDimensions
HypeScoreSnapshot *-- HypeDimensions
HypeScoreCurrent ..> HypeEntityType
HypeScoreCurrent ..> HypeStatus
HypeScoreCurrent ..> HypeMomentum
HypeScoreSnapshot ..> HypeScoreCurrent : mesma entidade, por dia
note bottom of HypeScoreCurrent : gravado só pelo HypeSnapshotService (cron a cada 6 h)\ne pelo HypeLiveRecalc; os GET nunca recalculam
note right of HypeQueryService : métrica da janela: 1 = trend (desempate score) ·\n7 = score atual · 30 = média dos snapshots do mês;\nsó população pública (publicEligible + AVAILABLE + score)
@enduml
