@startuml RF26_Classes
title RF26 — Busca global de esquemas e peças (aba "Explorador Global")\nDiagrama de classes — Painel global (volume), Buscar marcas & lojas e Insights globais
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  HeaderBackgroundColor #E4DEF0
}
skinparam packageStyle rectangle
hide empty methods
set separator none

package "fai-web" {
  class DiscoveryController <<RestController>> {
    +global(viewer, country, season, color)  «GET /api/explorer/global»
    +brands(viewer, term, country, category, sort, color, season, minLevel)  «GET /api/explorer/brands»
    +insights(viewer)  «GET /api/explorer/insights»
  }
}

package "fai-application" {
  class ExplorerService <<service>> {
    +MIN_DATA = 3  «país aceso no painel»
    +MIN_BRAND_ITEMS = 3  «base mínima de Hype»
    ~BRAND_TOP_ITEMS = 5 · RANKING_ROWS = 5
    +globalPanel(viewer, country, season, color): Map
    +brandsAndStores(viewer, term, country, category, sort, color, season, minLevel): Map
    +insights(viewer): Map
    ~publicPieces(): List<PublicPiece>
    ~brandHype(bondedLooks, brandPieces, cfg): Map  «BONDED_LOOKS · BRAND_GROUP»
    -passesHype(card, minLevel): boolean
    ~hypeRankings(): Map
    ~seasonAverages(): List<Agg>
  }
  class "ExplorerService.PublicPiece" as PublicPiece <<record>> {
    hype : HypeScoreCurrent
    piece : WardrobeItem
  }
  class "ExplorerService.Agg" as Agg <<record>> {
    key : String
    value : double
    items : int
  }
  interface AnalyticsQueryPort <<port>> {
    brandUsage(limit)  «vw_brand_usage»
    countries()  «vw_country_insights»
    countryColors()
    looksBySeason(country)
    colorRanking(country, limit)
    schemesByCountry(GlobalFilter)
    piecesByCountry(GlobalFilter)
    brandFacets()
  }
  class "AnalyticsQueryPort.GlobalFilter" as GlobalFilter <<record>> {
    season : String
    color : String
  }
  class SearchService <<service>> {
    {static} ~parseLevel(raw): HypeLevel  «400 NIVEL_INVALIDO»
    {static} ~hypeRows(repo, cfg, type, ids)
    {static} ~publicScore(c): Double
    {static} ~trendFor(c, self): Double
    {static} ~publicRow(c): HypeScoreCurrent
  }
  class AiEngine <<service>> {
    +text(TextCall): AiOutcome<String>  «INSIGHT_GENERATOR»
  }
  class LocalAdvisors <<final>> {
    {static} +insightText(rankings): String
  }
  class CatalogService <<service, RF47>> {
    +catalogBrands(): List<Map>
  }
  class HypeScoreConfig <<component>> {
    +algorithmVersion(): String
    +level(score): HypeLevel
  }
  class Taxonomy <<final>> {
    {static} COLORS
    {static} hex(color): String
  }
}

package "fai-infrastructure" {
  class MysqlAnalyticsAdapter <<adapter>>
}

package "fai-domain" {
  class User <<entity users>> {
    country : String  «região do dono (CA04)»
    profileType : ProfileType
  }
  class BrandProfile <<entity brand_profiles>> {
    owner : User
    brandName, slug, logoUrl, storeUrl : String
    fashionCategory : String
    country : String
    approvalStatus : ApprovalStatus
  }
  class WardrobeItem <<entity wardrobe_items>> {
    user : User
    category, subcategory, color : String
    brandName : String
    visibility : Visibility
  }
  class Scheme <<entity schemes>> {
    user : User
    season : Season
    visibility : Visibility
  }
  class SealBond <<entity seal_bonds>> {
    scheme : Scheme
    targetOwner : User
    status : SealBondStatus
    expiresAt : Instant
  }
  class HypeScoreCurrent <<entity hype_scores>> {
    entityType : HypeEntityType
    entityId : UUID
    status : HypeStatus
    score : BigDecimal
    level : HypeLevel
    dimensions : HypeDimensions  «trend = crescimento»
    publicEligible : boolean
    category : String
  }
  interface BrandProfileRepository <<repository>> {
    findByApprovalStatusOrderByCreatedAtDesc(status)
  }
  interface SealBondRepository <<repository>> {
    findByTargetOwnerIdAndStatusOrderByCreatedAtDesc(owner, status)
  }
  interface HypeScoreCurrentRepository <<repository>> {
    findByEntityTypeAndAlgorithmVersion\nAndPublicEligibleTrueAndStatus(type, versão, status)
  }
  enum HypeLevel {
    LOW_SIGNAL
    NICHE
    RELEVANT
    HOT
    TRENDING
    VIRAL
  }
}

DiscoveryController --> ExplorerService
ExplorerService --> AnalyticsQueryPort
ExplorerService --> BrandProfileRepository
ExplorerService --> SealBondRepository
ExplorerService --> HypeScoreCurrentRepository
ExplorerService --> AiEngine
ExplorerService ..> LocalAdvisors
ExplorerService ..> SearchService
ExplorerService ..> HypeScoreConfig
ExplorerService ..> Taxonomy
ExplorerService ..> "0..1" CatalogService : setter opcional
ExplorerService ..> PublicPiece
ExplorerService ..> Agg
AnalyticsQueryPort ..> GlobalFilter
AnalyticsQueryPort <|.. MysqlAnalyticsAdapter
BrandProfile "1" --> "1" User : owner
WardrobeItem "*" --> "1" User : user
Scheme "*" --> "1" User : user
SealBond "*" --> "1" Scheme
SealBond "*" --> "1" User : targetOwner
PublicPiece --> HypeScoreCurrent
PublicPiece --> WardrobeItem
HypeScoreCurrent ..> HypeLevel
HypeScoreCurrentRepository ..> HypeScoreCurrent
BrandProfileRepository ..> BrandProfile
SealBondRepository ..> SealBond
note bottom of MysqlAnalyticsAdapter : agrega schemes · wardrobe_items JOIN users\n(só PUBLIC, por users.country) e lê as views\nvw_brand_usage e vw_country_insights
note right of ExplorerService : P3-16: sem hypeBand, sem hypeMin e\nsem médias de hype_score v1; Hype só v2\npúblico (publicEligible + AVAILABLE)
@enduml
