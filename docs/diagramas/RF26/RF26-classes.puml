@startuml RF26_Classes
title RF26 — Explorador Global: painel por país, marcas & lojas e insights\nDiagrama de classes — entidades JPA reais (fai-domain) e enums
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  HeaderBackgroundColor #E4DEF0
}
skinparam packageStyle rectangle
hide empty methods

package "fai-domain · model" {
class User {
  +username: String
  +displayName: String
  +email: String
  +emailHash: String
  +emailVerified: boolean
  +phone: String
  +birthDate: String
  +passwordHash: String
  +profileType: ProfileType
  +role: String
  .. +20 campos ..
}
class BrandProfile {
  +owner: User
  +brandName: String
  +slug: String
  +logoUrl: String
  +coverUrl: String
  +bio: String
  +storeUrl: String
  +cnpj: String
  +razaoSocial: String
  +nomeFantasia: String
  +fashionCategory: String
  +commercialContact: String
  +officialHashtag: String
  +activityProofUrl: String
  .. +11 campos ..
}
class WardrobeItem {
  +user: User
  +brandProfile: BrandProfile
  +brand: Brand
  +name: String
  +category: String
  +subcategory: String
  +sex: String
  +brandName: String
  +color: String
  +material: String
  +sizeLabel: String
  +market: String
  +styleTags: String
  +occasionTags: String
  .. +54 campos ..
}
class Scheme {
  +user: User
  +originalScheme: Scheme
  +title: String
  +description: String
  +creationMode: CreationMode
  +origin: SchemeOrigin
  +style: String
  +occasion: String
  +season: Season
  +mood: Mood
  +visibility: Visibility
  +status: SchemeStatus
  +displayMode: DisplayMode
  +disponivel: boolean
  .. +41 campos ..
}
class SealBond {
  +scheme: Scheme
  +targetOwner: User
  +requestedBy: User
  +tier: SealTier
  +linkedPieceIdsJson: String
  +confidence: BigDecimal
  +justification: String
  +basis: SealBondBasis
  +status: SealBondStatus
  +requiresReview: boolean
  +seal: Seal
  +imageRightsConsent: Boolean
  +aiInferenceId: UUID
  +respondedAt: Instant
  .. +8 campos ..
}
class HypeScoreMetric {
  +dailyLook: DailyLook
  +scheme: Scheme
  +user: User
  +scoreDate: LocalDate
  +likesCount: long
  +commentsCount: long
  +sharesCount: long
  +remixesCount: long
  +engagementRaw: BigDecimal
  +engagementNorm: BigDecimal
  +trendRaw: BigDecimal
  +trendNorm: BigDecimal
  +hypeScore: BigDecimal
  +globalHypeScore: BigDecimal
  .. +9 campos ..
}
class HypeScoreCurrent <<RF53>> {
  +entityType: HypeEntityType
  +entityId: UUID
  +ownerId: UUID
  +algorithmVersion: String
  +status: HypeStatus
  +score: BigDecimal
  +dimensions: HypeDimensions
  +publicEligible: boolean
  +category: String
  +styles: String
  +occasions: String
  .. +11 campos ..
}
class HypeScoreSnapshot <<RF53>> {
  +entityType: HypeEntityType
  +entityId: UUID
  +algorithmVersion: String
  +snapshotDate: LocalDate
  +status: HypeStatus
  +score: BigDecimal
  +publicEligible: boolean
  .. +5 campos ..
}
class HypeDimensions <<embeddable>> {
  +popularity · engagement
  +trend · trendVelocity
  +novelty · longevity · rarity
  +originality · influence
}
}
package "fai-domain · enums" {
enum ProfileType {
  PESSOAL
  MARCA
  CELEBRIDADE
}
enum HypeEntityType {
  PIECE
  SCHEME
}
enum HypeStatus <<RF53>> {
  AVAILABLE
  INSUFFICIENT_DATA
}
}
BrandProfile "1" --> "1" User : owner
HypeScoreMetric "*" --> "1" Scheme : scheme
HypeScoreMetric "*" --> "1" User : user
Scheme "*" --> "1" User : user
SealBond "*" --> "1" Scheme : scheme
SealBond "*" --> "1" User : requestedBy
SealBond "*" --> "1" User : targetOwner
User --> ProfileType
WardrobeItem "*" --> "1" BrandProfile : brandProfile
WardrobeItem "*" --> "1" User : user
HypeScoreCurrent *-- HypeDimensions : dimensions
HypeScoreSnapshot *-- HypeDimensions : dimensions
HypeScoreCurrent ..> HypeEntityType
HypeScoreCurrent ..> HypeStatus
HypeScoreCurrent ..> WardrobeItem : entityId (PIECE)
HypeScoreCurrent ..> Scheme : entityId (SCHEME)
HypeScoreSnapshot ..> HypeScoreCurrent : mesma entidade, por dia
note top of User : tabela users
note top of BrandProfile : tabela brand_profiles
note top of WardrobeItem : tabela wardrobe_items
note top of Scheme : tabela schemes
note top of SealBond : tabela seal_bonds
note top of HypeScoreCurrent : tabela hype_scores — novo (RF53 · HypeScore v2)\n"Em alta" lê só publicEligible = true e status = AVAILABLE\n(janela 1 = dimensions.trend · 7 = score)
note bottom of HypeScoreSnapshot : tabela hype_score_snapshots\njanela 30 = média dos snapshots do mês
@enduml
