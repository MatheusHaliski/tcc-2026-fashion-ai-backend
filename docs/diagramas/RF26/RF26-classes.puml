package "fai-domain (enums)" {
  enum ApprovalStatus {
    PENDENTE
    AJUSTES
    APROVADO
    RECUSADO
    SUSPENSO
  }
  enum HypeStatus {
    AVAILABLE
    INSUFFICIENT_DATA
  }
  enum SchemeStatus {
    DRAFT
    PUBLISHED
    ARCHIVED
  }
  enum RenderStatus {
    PENDING
    RENDERING
    ENHANCING
    COMPOSITING
    CACHED
    COMPLETED
    FAILED
  }
  enum SealStatus {
    ACTIVE
    INACTIVE
  }
  enum SealBondStatus {
    SUGGESTED
    ACCEPTED
    EDITED
    REFUSED
    PENDING_REVIEW
    APPROVED
    REJECTED
    REVOKED
  }
}
package "fai-application" {
  class ExplorerService <<service>> {
    +globalPanel()
    +brandsAndStores()
    +insights()
  }
}
ExplorerService ..> BrandProfile : usa
ExplorerService ..> HypeScoreCurrent : usa
ExplorerService ..> Scheme : usa
ExplorerService ..> SealBond : usa
ExplorerService ..> WardrobeItem : usa
Brand "*" --> "1" BrandProfile : brandProfile
BrandProfile "1" --> "1" User : owner
BrandProfile --> ApprovalStatus
DailyLook "*" --> "1" Scheme : scheme
DailyLook "*" --> "1" User : user
HypeScoreCurrent --> HypeStatus
HypeScoreCurrent ..> User : ownerId
HypeScoreMetric "*" --> "1" DailyLook : dailyLook
HypeScoreMetric "*" --> "1" Scheme : scheme
HypeScoreMetric "*" --> "1" User : user
HypeScoreSnapshot --> HypeStatus
Scheme "*" --> "1" User : user
Scheme --> RenderStatus
Scheme --> SchemeStatus
Seal "*" --> "1" User : owner
Seal --> SealStatus
SealBond "*" --> "1" Scheme : scheme
SealBond "*" --> "1" Seal : seal
SealBond "*" --> "1" User : requestedBy
SealBond "*" --> "1" User : targetOwner
SealBond --> SealBondStatus
WardrobeItem "*" --> "1" Brand : brand
WardrobeItem "*" --> "1" BrandProfile : brandProfile
WardrobeItem "*" --> "1" User : user
@enduml
