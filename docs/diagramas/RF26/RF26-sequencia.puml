@startuml RF26_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."
title RF26 — Realizar busca global de esquemas de vestimenta & peças por estação, região, clima e gênero, através da aba 'Explorador Global'\nDiagrama de sequência — gerado do código em 2026-10-06 (scripts/diagramas/v5)

actor "Pessoa usuária" as U
boundary "Tela /explorer" as P
control "DiscoveryController" as DiscoveryController
participant "ExplorerService" as ExplorerService
== Painel global por país (cores, hype, marcas) ==
U -> P : Painel global por país (cores, hype, marcas)
P -> DiscoveryController : GET /api/explorer/global
DiscoveryController -> ExplorerService : globalPanel()
activate ExplorerService
deactivate ExplorerService
ExplorerService --> DiscoveryController : resultado
DiscoveryController --> P : 200 JSON
P --> U : atualiza a tela
== Marcas e lojas por país/categoria (hype v2 agregado; minLevel = faixa… ==
U -> P : Marcas e lojas por país/categoria (hype v2 agrega…
P -> DiscoveryController : GET /api/explorer/brands
DiscoveryController -> ExplorerService : brandsAndStores()
activate ExplorerService
deactivate ExplorerService
ExplorerService --> DiscoveryController : resultado
DiscoveryController --> P : 200 JSON
P --> U : atualiza a tela
@enduml
