@startuml RF26_Sequencia
title RF26 — Busca global de esquemas e peças (aba "Explorador Global")\nDiagrama de sequência — Painel global: volume por país (/api/explorer/global) e globo de Hype v2 (/api/hype/globe)
skinparam backgroundColor #FFFFFF
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
}
autonumber
actor "Pessoa" as U
participant "explorer/page.tsx\n(aba map · useGlobeFilters ·\nGlobe · HypeGlobe*)" as FE
participant "DiscoveryController" as DC
participant "ExplorerService" as ES
participant "AnalyticsQueryPort\n(MysqlAnalyticsAdapter)" as A
participant "HypeController" as HC
participant "HypeQueryService" as HQ
participant "HypeCache\n(RenderCachePort)" as CA
participant "HypeScoreCurrentRepository ·\nHypeScoreSnapshotRepository" as HR
database "MySQL" as DB

U -> FE : aba "Painel global" (?tab=map&layers&metric&type&window&category&minLevel)
par volume por país
  FE -> DC : GET /api/explorer/global?season&color
  DC -> ES : globalPanel(viewer, null, season, color)
  alt estação ou cor inválidas
    ES --> FE : 400 ESTACAO_INVALIDA | COR_INVALIDA
  else ok
    ES -> A : countryColors()
    ES -> A : schemesByCountry(GlobalFilter) · piecesByCountry(GlobalFilter)
    A -> DB : schemes / wardrobe_items PUBLIC JOIN users (country do dono)
    ES -> A : colorRanking(null, 12)
    ES -> ES : total, sufficient = total ≥ MIN_DATA (3), cor dominante
    ES --> FE : 200 {countries[], minData, facets, legend}
  end
else Hype v2 por país
  FE -> HC : GET /api/hype/globe?type&window&category&minLevel
  HC -> HQ : globe(viewer, type, window, category, subcategory, minLevel)
  alt type ou minLevel inválidos
    HQ --> FE : 400 TIPO_INVALIDO | NIVEL_INVALIDO
  else ok
    HQ -> CA : get("globe:{type}:{win}:{cat}:{sub}:{min}", globeAggregate)
    opt fora do cache (nova geração do job ou TTL 10 min)
      HQ -> HR : findByEntityTypeAndAlgorithmVersion\nAndPublicEligibleTrueAndStatus(type, versão, AVAILABLE)
      HR -> DB : hype_scores
      opt janela = 30
        HQ -> HR : snapshots dos últimos 30 dias (monthAverage)
        HR -> DB : hype_score_snapshots
      end
      HQ -> HQ : globeCountry por país: count, creators, avgHype/maxHype + faixa,\ntrend, rising, levels, cor/categoria dominantes, candidatos (8),\nsufficient = count ≥ 3; world e regions (WorldRegions)
    end
    HQ -> HR : currentOf(type, candidatos) — ainda públicos?
    HQ -> HQ : globeCards(viewer): 1º candidato visível vira "top"
    HQ --> FE : 200 {type, window, world, countries[], regions[], minItems}
  end
end
FE -> FE : pontos = volume + avgHype v2 do país;\ncamadas numbers · columns · figures · cards · heat
FE --> U : globo (ou tabela) + legenda + lista de países

opt toca um país
  U -> FE : pickCountry("BR")
  FE -> FE : grava ?country na URL
  FE -> DC : GET /api/explorer/global?country=BR&season&color
  DC -> ES : globalPanel(viewer, "BR", season, color)
  ES -> A : looksBySeason("BR") · colorRanking("BR", 5)
  ES --> FE : 200 {…, selected: {country, looksBySeason, topColors}}
  FE --> U : HypeGlobeCountryPanel (Hype do país no recorte)\n+ looks por estação (volume) + 5 cores
  opt abre o destaque do país
    U -> FE : card "top"
    FE -> HC : GET /api/hype/pieces/{id} | /api/hype/looks/{id}
    HC -> HQ : detail(viewer, type, id)
    HQ --> FE : análise completa (HypeAnalyticsDrawer)
  end
end
@enduml
