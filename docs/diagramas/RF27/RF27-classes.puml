@startuml RF27_Classes
title RF27 — Meu Quarto (guarda-roupa num quarto 3D interativo)\nDiagrama de classes — RoomService, endereço da peça e tabelas do quarto
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  HeaderBackgroundColor #E4DEF0
}
skinparam packageStyle rectangle
hide empty methods

package "fai-web · controller" {
class RoomController {
  +room(user): Map
  +listView(user): List<Map>
  +open(user, moduleId): Map
  +move(user, pieceId, AddressRequest): Map
  +renameDrawer(user, drawer, LabelRequest): Map
  +organizePreview(user, useAi): Map
  +applyOrganization(user, OrganizeRequest): Map
  +undoOrganization(user): Map
  +pieceTag(user, pieceId): Map
  +giveKey(user, KeyRequest) / tour(viewer, ownerId)
  +light(…) · monogram(…) · seasonStorage(…) · island(…) · diary(…) · showInRoom(…)
}
}

package "fai-application · service / room" {
class RoomService {
  +{static} FORGOTTEN_DAYS = 60
  +{static} HANGERS_PER_DOOR = 12
  +{static} DRAWER_CAPACITY = 6
  +{static} SHOE_RACK_CAPACITY = 24
  +{static} DEFAULT_DRAWER_LABELS: List<String>
  +room(user): Map
  +layout(userId): RoomLayout
  +entries(userId, pieces): List<RoomStorageEntry>
  +autoAssign(userId, pieceId): RoomAddress
  +locate(userId, pieceId): Optional<Location>
  +locateAll(userId): Map<UUID, Location>
  +outOfSeason(userId): Set<UUID>
  +move(user, pieceId, rawAddress): Map
  +organizePreview(user, useAi): Map
  +applyOrganization(user, labels, moves): Map
  +undoOrganization(user): Map
  +diaryEntry(user, pieceId, date, occasion, note): Map
  +onPieceCreated(PieceCreated) <<AFTER_COMMIT>>
  +onPieceDeleted(PieceDeleted)
  ~statesOf(w, a, today, lastDiary, dailyLookPieces, icon): Set<String>
  +{static} forgotten(w, last, today): boolean
}
class "RoomService.Location" as Location <<record>> {
  +address: RoomAddress
  +label: String
  +moduleId: String
}
interface "RoomService.DecorationsProvider" as Decorations <<port>> {
  +decorations(userId): List<Map>
}
class RoomAddress <<record>> {
  +zone: String
  +index: int
  +sub: int
  +{static} parse(raw): Optional<RoomAddress>
  +moduleId(): String
  +label(drawerLabels): String
}
note bottom of RoomAddress
  zonas: door:n/hanger:k · drawer:n · top:n · base:n
  shoe:n · bags:n · jewelry:n · chair:n · season:n
end note
interface "FaiPointsService.RoomLayoutAccess" as Access <<port>> {
  +setLevel(userId, level)
  +compatibleModules(userId, item): List<String>
  +applyFinish(userId, moduleId, item)
  +layout(userId): RoomLayout
}
enum "FaiPointsService.Level" as Level {
  ESTREIA
  STUDIO
  LOFT
  CLOSET
  ATELIER
  PENTHOUSE
  MAISON
}
class ChallengeService
}

package "fai-domain · model" {
class RoomLayout <<table room_layouts>> {
  +user: User
  +level: String = "ESTREIA"
  +modulesJson: String
  +drawerLabelsJson: String
  +previousMapJson: String
}
class RoomStorageEntry <<table room_storage_map>> {
  +userId: UUID
  +wardrobeItemId: UUID {unique}
  +address: String
  +assignedBy: String = AUTO | USER | AI
}
class RoomInventoryItem <<table room_inventory>> {
  +id: UUID
  +userId: UUID
  +sku: String
  +serial: Integer
  +source: String
  +appliedModule: String
  +acquiredAt: Instant
}
class WardrobeItem <<table wardrobe_items>> {
  +name: String
  +category / subcategory: String
  +disponivel: boolean
  +availabilityStatus: AvailabilityStatus
  +favorite: boolean
  +forSale: boolean
  +wearCount: int
  +lastWornDate: LocalDate
  +pieceOrigin: String
  .. demais campos ..
}
class PieceUsageDiaryEntry <<table piece_usage_diary>> {
  +wardrobeItemId: UUID
  +userId: UUID
  +usedOn: LocalDate
  +occasion: String
  +source: String
}
class DailyLook <<table daily_looks>> {
  +lookDate: LocalDate
  +source: DailyLookSource
}
class StyleDna <<table style_dna>> {
  +iconPieceName: String
}
class User <<table users>>
}

package "fai-domain · repository" {
interface RoomLayoutRepository {
  +findByUserId(userId): Optional<RoomLayout>
}
interface RoomStorageEntryRepository {
  +findByUserId(userId): List<RoomStorageEntry>
  +findByWardrobeItemId(id): Optional<RoomStorageEntry>
  +deleteByWardrobeItemId(id)
}
}

RoomController --> RoomService
RoomService ..|> Access
ChallengeService ..|> Decorations
RoomService --> "0..*" Decorations : decorações de desafios
RoomService ..> RoomAddress
RoomService ..> Location
Location --> RoomAddress
RoomService --> RoomLayoutRepository
RoomService --> RoomStorageEntryRepository
RoomService ..> Level : levelOf(lifetime)
RoomLayoutRepository ..> RoomLayout
RoomStorageEntryRepository ..> RoomStorageEntry
RoomLayout "0..1" --> "1" User : user (unique)
RoomStorageEntry "0..1" ..> "1" WardrobeItem : wardrobeItemId
RoomStorageEntry ..> RoomAddress : address (texto)
RoomInventoryItem "*" ..> "1" User : userId
WardrobeItem "*" --> "1" User
PieceUsageDiaryEntry "*" ..> "1" WardrobeItem
DailyLook "*" --> "1" User
StyleDna "0..1" --> "1" User
@enduml
