package "fai-domain (enums)" {
  enum ApprovalStatus {
    PENDENTE
    AJUSTES
    APROVADO
    RECUSADO
    SUSPENSO
  }
  enum SchemeStatus {
    DRAFT
    PUBLISHED
    ARCHIVED
  }
  enum RenderStatus {
    PENDING
    RENDERING
    ENHANCING
    COMPOSITING
    CACHED
    COMPLETED
    FAILED
  }
  enum AccountStatus {
    PENDING_EMAIL_VERIFICATION
    ACTIVE
    PENDING_VALIDATION
    SUSPENDED
    DELETION_SCHEDULED
    DELETED
  }
  enum AvailabilityStatus {
    AVAILABLE
    UNAVAILABLE
    ARCHIVED
  }
  enum ModerationStatus {
    PENDING
    APPROVED
    REJECTED_POLICY
    REJECTED_NOT_CLOTHING
  }
}
package "fai-application" {
  class RoomService <<service>> {
    +room()
    +tour()
    +giveKey()
    +listView()
    +open()
    +move()
    +renameDrawer()
    +showInRoom()
    +seasonStorage()
    +organizePreview()
  }
}
RoomService ..> DailyLook : usa
RoomService ..> RoomCatalogItem : usa
RoomService ..> RoomInventoryItem : usa
RoomService ..> RoomLayout : usa
RoomService ..> RoomStorageEntry : usa
RoomService ..> Scheme : usa
Brand "*" --> "1" BrandProfile : brandProfile
BrandProfile "1" --> "1" User : owner
BrandProfile --> ApprovalStatus
DailyLook "*" --> "1" Scheme : scheme
DailyLook "*" --> "1" User : user
RoomInventoryItem ..> User : userId
RoomLayout "*" --> "1" User : user
RoomStorageEntry ..> User : userId
RoomStorageEntry ..> WardrobeItem : wardrobeItemId
Scheme "*" --> "1" User : user
Scheme --> RenderStatus
Scheme --> SchemeStatus
User --> AccountStatus
UserPreferences "1" --> "1" User : user
WardrobeItem "*" --> "1" Brand : brand
WardrobeItem "*" --> "1" BrandProfile : brandProfile
WardrobeItem "*" --> "1" User : user
WardrobeItem --> AvailabilityStatus
WardrobeItem --> ModerationStatus
