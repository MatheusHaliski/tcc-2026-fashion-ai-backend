@startuml RF27_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF27 — Visualizar e organizar o guarda-roupa num quarto 3D interativo ('Meu Quarto')\nDiagrama de componentes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "Frontend (Next.js)" {
  component "/room\n(site)/(app)/room/page.tsx" as FE0
  component "lib/api/client.ts" as APIC
}
package "fai-web (REST)" {
  component "RoomController\n/api/me/room\n/api/me/room/drawers/{…}\n/api/me/room/island\n/api/me/room/keys\n(+11 rotas)" as RoomController
}
package "fai-application (casos de uso)" {
  component "RoomService" as RoomService
  component "SideEffectRunner" as SideEffectRunner <<apoio>>
}
package "fai-domain (repositórios)" {
  component "RoomLayoutRepository\nRoomStorageEntryRepository\nWardrobeItemRepository\nSchemeRepository\nSchemeItemRepository\nDailyLookRepository\nStyleDnaRepository\nPieceUsageDiaryEntryRepository\nUserAchievementRepository\nUserPreferencesRepository\n(+4)" as REPO_MySQL
}
database "MySQL\n• daily_looks\n• fai_points_ledger\n• piece_usage_diary\n• room_catalog\n• room_inventory\n• room_layouts\n• room_storage_map\n• scheme_items\n• schemes\n• style_dna\n• user_achievements\n• user_preferences\n(+2)" as DB_MySQL
cloud "Motor de IA (RF24)\nprovedores externos + reserva local" as AI
component "Eventos de domínio\n(@TransactionalEventListener)" as EV
APIC --> RoomController : HTTPS/JSON
FE0 --> APIC
REPO_MySQL --> DB_MySQL : JPA/Flyway
RoomController --> RoomService
RoomService --> AI
RoomService --> EV
RoomService --> REPO_MySQL
RoomService ..> SideEffectRunner
@enduml
