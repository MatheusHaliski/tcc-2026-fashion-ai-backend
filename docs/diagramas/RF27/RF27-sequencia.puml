@startuml RF27_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."
title RF27 — Visualizar e organizar o guarda-roupa num quarto 3D interativo ('Meu Quarto')\nDiagrama de sequência — gerado do código em 2026-10-06 (scripts/diagramas/v5)

actor "Pessoa usuária" as U
boundary "Tela /room" as P
control "RoomController" as RoomController
participant "RoomService" as RoomService
database "MySQL" as DB_MySQL
participant "Guard" as Guard
queue "Eventos de domínio" as EV
== Mover peça para um endereço (door:1/hanger:3, drawer:2, shoe:4…) ==
U -> P : Mover peça para um endereço (door:1/hanger:3, dra…
P -> RoomController : PUT /api/pieces/{pieceId}/room-address
RoomController -> RoomService : move()
activate RoomService
RoomService -> DB_MySQL : SELECT wardrobe_items
RoomService -> Guard : requireOwner()
RoomService -> DB_MySQL : SELECT room_layouts
RoomService -> RoomService : new RoomLayout()
RoomService -> DB_MySQL : SELECT users
RoomService -> DB_MySQL : SELECT fai_points_ledger
RoomService -> DB_MySQL : INSERT/UPDATE room_layouts
RoomService -> DB_MySQL : SELECT room_storage_map
alt gaveta cheia
RoomService --> RoomController : 409 GAVETA_CHEIA
RoomController --> P : 409 + mensagem
end
alt posicao inválida
RoomService --> RoomController : 400 POSICAO_INVALIDA
RoomController --> P : 400 + mensagem
end
RoomService -> DB_MySQL : SELECT room_storage_map
alt posicao ocupada
RoomService --> RoomController : 409 POSICAO_OCUPADA
RoomController --> P : 409 + mensagem
end
RoomService -> DB_MySQL : SELECT room_storage_map
RoomService -> RoomService : new RoomStorageEntry()
RoomService -> DB_MySQL : INSERT/UPDATE room_storage_map
deactivate RoomService
RoomService --> RoomController : resultado
RoomController --> P : 200 JSON
P --> U : atualiza a tela
== Aplicar organização (rótulos e movimentos) ==
U -> P : Aplicar organização (rótulos e movimentos)
P -> RoomController : POST /api/me/room/organization
RoomController -> RoomService : applyOrganization()
activate RoomService
RoomService -> DB_MySQL : SELECT room_layouts
RoomService -> RoomService : new RoomLayout()
RoomService -> DB_MySQL : SELECT users
RoomService -> DB_MySQL : SELECT fai_points_ledger
RoomService -> DB_MySQL : INSERT/UPDATE room_layouts
RoomService -> DB_MySQL : SELECT room_storage_map
RoomService -> DB_MySQL : INSERT/UPDATE room_layouts
RoomService -> DB_MySQL : INSERT/UPDATE room_storage_map
RoomService ->> EV : RoomOrganized
deactivate RoomService
RoomService --> RoomController : resultado
RoomController --> P : 201 JSON
P --> U : atualiza a tela
@enduml
