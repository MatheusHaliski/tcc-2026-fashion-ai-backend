@startuml RF28_Espelho_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF28 — Vista-me: componentes\nDiagrama de componentes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "app/(site)" {
  component "page.tsx" as m_app__site__page_tsx
}
package "components/mirror" {
  component "mirror-stage.tsx" as m_components_mirror_mirror_stage_tsx
}
package "components/three" {
  component "avatar-viewer.tsx" as m_components_three_avatar_viewer_tsx
  component "human-avatar.tsx" as m_components_three_human_avatar_tsx
  component "human-outfit.tsx" as m_components_three_human_outfit_tsx
  component "common.tsx" as m_components_three_common_tsx <<apoio>>
}
package "lib/avatar3d/human" {
  component "three-human.ts" as m_lib_avatar3d_human_three_human_ts
}
package "components/ui" {
  component "index.tsx" as m_components_ui_index_tsx <<apoio>>
}
package "lib/auth" {
  component "session.tsx" as m_lib_auth_session_tsx <<apoio>>
}
package "lib/avatar3d" {
  component "body-spec.ts" as m_lib_avatar3d_body_spec_ts <<apoio>>
  component "model.ts" as m_lib_avatar3d_model_ts <<apoio>>
}
package "lib" {
  component "chunk-recovery.ts" as m_lib_chunk_recovery_ts <<apoio>>
}
package "Backend (Spring Boot)" {
  component "Avatar3dController" as Avatar3dController
  component "MirrorController" as MirrorController
  component "MirrorService" as MirrorService
  component "RoomService" as RoomService
  component "WardrobeService" as WardrobeService
}
database "MySQL" as DB_MySQL
MirrorController --> MirrorService
MirrorService --> DB_MySQL : mirror_states, scheme_items, schemes, style_dna, wardrobe_items
MirrorService --> RoomService
MirrorService --> WardrobeService
RoomService --> DB_MySQL : daily_looks, fai_points_ledger,\npiece_usage_diary, room_catalog,\nroom_inventory, room_layouts
WardrobeService --> DB_MySQL : brands, moderation_queue, photos,\npipeline_jobs, processing_jobs_log,\nquality_scores
m_components_mirror_mirror_stage_tsx --> Avatar3dController : HTTPS
m_components_mirror_mirror_stage_tsx --> m_components_three_common_tsx
m_components_mirror_mirror_stage_tsx --> m_components_ui_index_tsx
m_components_mirror_mirror_stage_tsx --> m_lib_auth_session_tsx
m_components_mirror_mirror_stage_tsx --> m_lib_avatar3d_body_spec_ts
m_components_mirror_mirror_stage_tsx --> m_lib_avatar3d_model_ts
m_components_mirror_mirror_stage_tsx --> m_lib_chunk_recovery_ts
m_components_three_avatar_viewer_tsx --> m_components_three_common_tsx
m_components_three_avatar_viewer_tsx --> m_components_three_human_avatar_tsx
m_components_three_avatar_viewer_tsx --> m_lib_avatar3d_body_spec_ts
m_components_three_common_tsx --> m_lib_avatar3d_model_ts
m_components_three_human_avatar_tsx --> m_components_three_common_tsx
m_components_three_human_avatar_tsx --> m_components_three_human_outfit_tsx
m_components_three_human_avatar_tsx --> m_lib_avatar3d_human_three_human_ts
m_components_three_human_avatar_tsx --> m_lib_avatar3d_model_ts
m_components_three_human_outfit_tsx --> m_components_three_common_tsx
m_components_three_human_outfit_tsx --> m_components_three_human_avatar_tsx
m_lib_avatar3d_model_ts --> m_lib_avatar3d_body_spec_ts
