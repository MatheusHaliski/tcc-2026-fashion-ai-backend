@startuml RF28_Espelho_Sequencia
title RF28 — Vista-me: estado do espelho, avatar 3D e "Vista-me" por prompt\nDiagrama de sequência
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam sequence {
  ArrowColor #52606D
  LifeLineBorderColor #B695F5
  ParticipantBackgroundColor #F8F4FF
  ParticipantBorderColor #B695F5
  ActorBackgroundColor #F8F4FF
  GroupBackgroundColor #FFF5F8
}
actor "Pessoa usuária" as P
participant "mirror/page.tsx" as Pg
participant "MirrorStage" as St
participant "AvatarViewer\n(Three.js)" as V
participant "HumanOutfit" as O
participant "MirrorController" as C
participant "MirrorService" as S
participant "Avatar3dController" as AC
database "MySQL\nmirror_states ·\nwardrobe_items ·\nuser_avatar3d" as DB

P -> Pg : abre /mirror
Pg -> C : GET /api/me/mirror
C -> S : state(user)
S -> DB : MirrorState + peças
S --> Pg : {slots, complete, missing, light}
Pg -> St : <MirrorStage slots kelvin>
St -> AC : GET /api/me/avatar3d
AC --> St : {exists, model, adjust, textureUrl}
St -> V : avatar, sexo, corpo, pieces=mirrorPieces(slots), framing=full
V -> O : veste as peças (padrão FAI no que faltar)
O --> V : malhas presas ao esqueleto
V --> P : reflexo em pose natural
P -> Pg : "Vista-me: jantar de sexta"
Pg -> C : POST /api/me/mirror/vista-me {prompt, keepMirror}
C -> S : vistaMe(user, prompt, anchors, focus, keep)
S -> S : interpreta (ocasião, humor, âncoras, restrições, estação)
S -> DB : escolhe peças elegíveis por slot e salva o estado
S --> Pg : novo estado
Pg -> St : novos slots
St -> V : pieces atualizadas
V --> P : reflexo com o look novo
@enduml
