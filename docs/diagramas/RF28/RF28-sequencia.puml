@startuml RF28_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."
title RF28 — Montar looks no Smart Mirror e pedir sugestões ao 'Vista-me' (só com peças do próprio guarda-roupa)\nDiagrama de sequência — gerado do código em 2026-10-14 (scripts/diagramas/v5)

actor "Pessoa usuária" as U
boundary "Tela /room" as P
control "MirrorController" as MirrorController
participant "MirrorService" as MirrorService
participant "WardrobeService" as WardrobeService
database "MySQL" as DB_MySQL
participant "RoomService" as RoomService
queue "Eventos de domínio" as EV
participant "LookScorer" as LookScorer
== Vestir uma peça no espelho ==
U -> P : Vestir uma peça no espelho
P -> MirrorController : POST /api/me/mirror/pieces
MirrorController -> MirrorService : place()
activate MirrorService
alt peça obrigatória
MirrorService --> MirrorController : 400 PECA_OBRIGATORIA
MirrorController --> P : 400 + mensagem
end
MirrorService -> WardrobeService : owned()
WardrobeService -> DB_MySQL : SELECT wardrobe_items
WardrobeService --> MirrorService
MirrorService -> DB_MySQL : SELECT mirror_states
MirrorService -> MirrorService : new MirrorState()
MirrorService -> DB_MySQL : INSERT/UPDATE mirror_states
MirrorService -> RoomService : locateAll()
RoomService -> DB_MySQL : SELECT room_layouts
RoomService -> DB_MySQL : SELECT users
RoomService -> DB_MySQL : SELECT fai_points_ledger
RoomService -> DB_MySQL : INSERT/UPDATE room_layouts
RoomService --> MirrorService
MirrorService -> DB_MySQL : SELECT wardrobe_items (×4)
MirrorService -> DB_MySQL : INSERT/UPDATE mirror_states
MirrorService ->> EV : MirrorAction
MirrorService -> DB_MySQL : SELECT wardrobe_items
MirrorService -> DB_MySQL : INSERT/UPDATE mirror_states
MirrorService -> RoomService : locateAll()
MirrorService -> DB_MySQL : SELECT style_dna
MirrorService -> LookScorer : scoreLooks()
LookScorer -> DB_MySQL : SELECT style_dna
LookScorer -> DB_MySQL : SELECT schemes
LookScorer -> DB_MySQL : SELECT scheme_items
LookScorer --> MirrorService
deactivate MirrorService
MirrorService --> MirrorController : resultado
MirrorController --> P : 201 JSON
P --> U : atualiza a tela
@enduml
