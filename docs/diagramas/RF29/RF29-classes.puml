package "fai-domain (enums)" {
  enum ApprovalStatus {
    PENDENTE
    AJUSTES
    APROVADO
    RECUSADO
    SUSPENSO
  }
  enum AccountStatus {
    PENDING_EMAIL_VERIFICATION
    ACTIVE
    PENDING_VALIDATION
    SUSPENDED
    DELETION_SCHEDULED
    DELETED
  }
  enum AvailabilityStatus {
    AVAILABLE
    UNAVAILABLE
    ARCHIVED
  }
  enum ModerationStatus {
    PENDING
    APPROVED
    REJECTED_POLICY
    REJECTED_NOT_CLOTHING
  }
  enum PhotoProcessingStatus {
    NEW
    MODERATING
    PROCESSING
    COMPLETED
    NEEDS_REUPLOAD
    FAILED
  }
  enum Model3dStatus {
    QUEUED
    PROCESSING
    COMPLETED
    FAILED
  }
}
package "fai-application" {
  class InventoryScoreService <<service>> {
    +highlightsTab()
    +explain()
    +improvementHints()
    +describe()
    +album()
    +retrospective()
    +optIn()
    +rankings()
  }
}
InventoryScoreService ..> InventoryScoreSnapshot : usa
InventoryScoreService ..> PieceUsageDiaryEntry : usa
