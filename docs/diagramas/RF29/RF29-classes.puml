@startuml RF29_Classes
title RF29 — FAI Inventory Score, destaques, evolução, conquistas e rankings ("Destaques")\nDiagrama de classes — InventoryScoreService, AchievementService e tabelas de nota e ranking
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  HeaderBackgroundColor #E4DEF0
}
skinparam packageStyle rectangle
hide empty methods

package "fai-web · controller" {
class HighlightsController {
  +highlights(user): Map
  +explain(user, code): Dimension
  +hints(user): Map
  +method(): Map
  +album(user) / retrospective(user, year): Map
  +optIn(user, OptInRequest): Map
  +rankings(user): Map
  +achievements(user): List<Map>
}
}

package "fai-application · service" {
class InventoryScoreService {
  +{static} WINDOW_DAYS = 90
  +{static} MIN_PIECES = 10
  +{static} SATURATION = 20
  +{static} CITY_K_ANONYMITY = 50
  ~{static} CACHE_TTL = 1 h
  ~{static} WEIGHTS: C .20 · U .20 · V .15 · R .13 · D .12 · O .10 · I .10
  +{static} BANDS: List<Band>
  +compute(userId, useCache): Result
  +highlightsTab(user): Map
  +explain(user, code): Dimension
  +improvementHints(userId): Map
  +album(user) / retrospective(user, year): Map
  +optIn(user, optedIn, shareCity, city): Map
  +rankings(user): Map
  +recomputeRankings(): int <<@Scheduled 0 15 */4 * * *>>
  +dailySnapshots(): int <<@Scheduled 0 30 3 * * *>>
  +invalidate(evento) <<@EventListener>>
  +{static} completeness(w): int
  +{static} catalogReady(w): boolean
}
class "InventoryScoreService.Result" as Result <<record>> {
  +userId: UUID
  +eligible: boolean
  +pieces: int
  +k: double
  +score: Integer
  +band: String
  +dims: Map<String, Integer>
  +metrics: Map<String, Object>
  +dimensions: List<Dimension>
  +computedAt: Instant
}
class "InventoryScoreService.Dimension" as Dimension <<record>> {
  +code: String
  +name: String
  +value: Integer
  +weight: double
  +rule: String
  +pullingDown: List<Map>
}
class "InventoryScoreService.Band" as Band <<record>> {
  +min: int
  +max: int
  +label: String
}
note bottom of Band
  0–299 Em Montagem · 300–499 Organizado · 500–649 Versátil
  650–799 Bem Curado · 800–899 Closet Inteligente
  900–959 Signature Closet · 960–1000 Maison Closet
end note
class AchievementService {
  +{static} CATALOG: List<Def>
  +grant(userId, code): boolean
  +list(user): List<Map>
  +onMirror(MirrorAction) <<AFTER_COMMIT>>
  +onSchemeSaved(SchemeSaved) <<AFTER_COMMIT>>
  +onDailyLook(DailyLookRegistered) <<AFTER_COMMIT>>
}
class "AchievementService.Def" as Def <<record>> {
  +code: String
  +name: String
  +emoji: String
  +condition: String
  +points: int
  +secret: boolean
}
class FaiPointsService {
  +award(userId, actionCode, refType, refId, pointsOverride): Award
}
class RoomService
}

package "fai-domain · model" {
class InventoryScoreSnapshot <<table inventory_score_snapshots>> {
  +id: UUID
  +userId: UUID
  +periodType: String = DAY | MONTH
  +periodDate: LocalDate
  +score: Integer
  +dimensionsJson: String
  +metricsJson: String
  +eligible: boolean
  +computedAt: Instant
}
class RankingOptIn <<table ranking_opt_ins>> {
  +userId: UUID <<id>>
  +optedIn: boolean
  +shareCity: boolean
  +city: String
  +updatedAt: Instant
}
class RankingPosition <<table ranking_positions>> {
  +id: UUID
  +segment: String
  +userId: UUID
  +position: int
  +total: int
  +topPercent: BigDecimal
  +value: BigDecimal
  +computedAt: Instant
}
class UserAchievement <<table user_achievements>> {
  +id: UUID
  +userId: UUID
  +achievementCode: String
  +secret: boolean
  +grantedAt: Instant
}
class WardrobeAvailabilityChange <<table wardrobe_availability_log>> {
  +wardrobeItemId: UUID
  +userId: UUID
  +available: boolean
  +changedAt: Instant
}
class PieceUsageDiaryEntry <<table piece_usage_diary>> {
  +wardrobeItemId: UUID
  +usedOn: LocalDate
  +source: String
  +schemeId: UUID
}
class StyleDna <<table style_dna>> {
  +archetype: StyleArchetype
  +iconPieceName: String
}
class ChallengeTemplate <<table challenge_templates>> {
  +code: String
  +scoreDimensionsJson: String
}
}

package "fai-domain · repository" {
interface InventoryScoreSnapshotRepository {
  +findByUserIdAndPeriodTypeAndPeriodDate(...): Optional
  +findTop60ByUserIdAndPeriodTypeOrderByPeriodDateDesc(...): List
}
interface RankingOptInRepository {
  +findByOptedInTrue(): List<RankingOptIn>
}
interface RankingPositionRepository {
  +findByUserId(userId): List
  +deleteBySegment(segment)
  +findTop20BySegmentOrderByPositionDesc(segment): List
}
interface UserAchievementRepository {
  +existsByUserIdAndAchievementCode(userId, code): boolean
}
}

HighlightsController --> InventoryScoreService
HighlightsController --> AchievementService
InventoryScoreService ..> Result
Result *-- "7" Dimension : I com value = null sem DNA
InventoryScoreService ..> Band
InventoryScoreService --> AchievementService : checkAchievements
InventoryScoreService --> RoomService : FORGOTTEN_DAYS, lastUse
AchievementService ..> Def
AchievementService --> FaiPointsService : award(ACHIEVEMENT)
InventoryScoreService --> InventoryScoreSnapshotRepository
InventoryScoreService --> RankingOptInRepository
InventoryScoreService --> RankingPositionRepository
AchievementService --> UserAchievementRepository
InventoryScoreSnapshotRepository ..> InventoryScoreSnapshot
RankingOptInRepository ..> RankingOptIn
RankingPositionRepository ..> RankingPosition
UserAchievementRepository ..> UserAchievement
InventoryScoreService ..> WardrobeAvailabilityChange : Utilização (exposição)
InventoryScoreService ..> PieceUsageDiaryEntry : uso na janela
InventoryScoreService ..> StyleDna : Identidade
InventoryScoreService ..> ChallengeTemplate : desafios sugeridos
RankingOptIn "1" ..> "0..*" RankingPosition : userId
@enduml
