@startuml RF29_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF29 — FAI Inventory Score, destaques, evolução, conquistas e rankings do guarda-roupa\nDiagrama de componentes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "Frontend (Next.js)" {
  component "/highlights\n(site)/(app)/highlights/page.tsx" as FE0
  component "lib/api/client.ts" as APIC
}
package "fai-web (REST)" {
  component "HighlightsController\n/api/inventory-score/method\n/api/me/album\n/api/me/highlights\n/api/me/inventory-score/dimensions/{…}\n(+4 rotas)" as HighlightsController
}
package "fai-application (casos de uso)" {
  component "InventoryScoreService" as InventoryScoreService
  component "RoomService" as RoomService <<apoio>>
  component "AchievementService" as AchievementService <<apoio>>
  component "SideEffectRunner" as SideEffectRunner <<apoio>>
}
package "fai-domain (repositórios)" {
  component "WardrobeItemRepository\nSchemeRepository\nSchemeItemRepository\nPieceUsageDiaryEntryRepository\nWardrobeAvailabilityChangeRepository\nStyleDnaRepository\nInventoryScoreSnapshotRepository\nRankingOptInRepository\nRankingPositionRepository\nChallengeTemplateRepository\n(+1)" as REPO_MySQL
}
database "MySQL\n• challenge_templates\n• inventory_score_snapshots\n• piece_usage_diary\n• ranking_opt_ins\n• ranking_positions\n• scheme_items\n• schemes\n• style_dna\n• users\n• wardrobe_availability_log\n• wardrobe_items" as DB_MySQL
APIC --> HighlightsController : HTTPS/JSON
FE0 --> APIC
HighlightsController --> InventoryScoreService
InventoryScoreService --> REPO_MySQL
InventoryScoreService ..> AchievementService
InventoryScoreService ..> RoomService
InventoryScoreService ..> SideEffectRunner
REPO_MySQL --> DB_MySQL : JPA/Flyway
@enduml
