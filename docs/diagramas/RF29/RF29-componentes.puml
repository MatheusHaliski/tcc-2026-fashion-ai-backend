@startuml RF29_Componentes
title RF29 — FAI Inventory Score, destaques, evolução, conquistas e rankings do guarda-roupa\nDiagrama de componentes — gerado do código (controllers → serviços → repositórios/ports)
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
left to right direction

package "Frontend (Next.js · React Three Fiber)" {
  component "highlights — Destaques (Inventory Score)" as FE0
  component "highlights — Álbum e retrospectiva" as FE1
  component "highlights — Rankings" as FE2
}
package "fai-web (REST)" {
  [HighlightsController] as HighlightsController
}
package "fai-application (casos de uso)" {
  [InventoryScoreService] as InventoryScoreService
  [FaiPointsService] as FaiPointsService
  [AchievementService] as AchievementService
  [RoomService] as RoomService #FAFAFA
  [WardrobeCreatorService] as WardrobeCreatorService #FAFAFA
}
package "fai-domain (repositórios JPA)" {
  [ChallengeTemplateRepository\nFaiPointsLedgerEntryRepository\nFaiPointsRuleRepository\nInventoryScoreSnapshotRepository\nPieceUsageDiaryEntryRepository\nRankingOptInRepository\nRankingPositionRepository\nRoomCatalogItemRepository\nRoomInventoryItemRepository\nSchemeItemRepository\nSchemeRepository\nStyleDnaRepository\nUserAchievementRepository\nUserRepository\nWardrobeAvailabilityChangeRepository\nWardrobeItemRepository] as REPOS
}
database "MySQL · fashionai_app\n• challenge_templates\n• fai_points_ledger\n• fai_points_rules\n• inventory_score_snapshots\n• piece_usage_diary\n• ranking_opt_ins\n• ranking_positions\n• room_catalog\n• room_inventory\n• scheme_items\n• schemes\n• style_dna\n• user_achievements\n• users\n• wardrobe_availability_log\n• wardrobe_items" as DB
[Eventos de domínio\n(@TransactionalEventListener AFTER_COMMIT)] as P_events
[NotificationService\n(RNF10)] as P_notif
[SideEffectRunner\n(efeitos colaterais isolados)] as P_side

FE0 --> HighlightsController : HTTPS/JSON
FE1 --> HighlightsController : HTTPS/JSON
FE2 --> HighlightsController : HTTPS/JSON
HighlightsController --> InventoryScoreService
HighlightsController --> FaiPointsService
HighlightsController --> AchievementService
InventoryScoreService ..> RoomService
InventoryScoreService ..> AchievementService
InventoryScoreService --> REPOS
FaiPointsService ..> WardrobeCreatorService
FaiPointsService --> REPOS
FaiPointsService --> P_notif
AchievementService ..> FaiPointsService
AchievementService --> REPOS
AchievementService --> P_notif
AchievementService --> P_events
AchievementService --> P_side
REPOS --> DB : JPA/Flyway
@enduml
