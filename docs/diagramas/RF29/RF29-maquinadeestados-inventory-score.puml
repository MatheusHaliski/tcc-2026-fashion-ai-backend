@startuml RF29_MaquinaDeEstados_InventoryScore
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  StartColor #20A77A
  EndColor #4B5563
}
title RF29 — InventoryScoreService: elegibilidade e faixas de score\nDiagrama de máquina de estados — gerado do código em 2026-10-06 (scripts/diagramas/v5)\nInventoryScoreService.BANDS · 7 faixas · calculado em computeNow()

state "Inelegível\neligible = false (n < 10)" as INELEGIVEL
state "Elegível — eligible = true (n ≥ MIN_PIECES = 10)" as ELEGIVEL {
  state "Em Montagem\nscore 0–299" as F0
  state "Organizado\nscore 300–499" as F1
  state "Versátil\nscore 500–649" as F2
  state "Bem Curado\nscore 650–799" as F3
  state "Closet Inteligente\nscore 800–899" as F4
  state "Signature Closet\nscore 900–959" as F5
  state "Maison Closet\nscore 960–1000" as F6
  [*] --> F0
  F0 --> F1 : score ≥ 300
  F1 --> F2 : score ≥ 500
  F2 --> F3 : score ≥ 650
  F3 --> F4 : score ≥ 800
  F4 --> F5 : score ≥ 900
  F5 --> F6 : score ≥ 960
}
[*] --> INELEGIVEL
INELEGIVEL --> ELEGIVEL : computeNow()\nn ≥ 10
ELEGIVEL --> INELEGIVEL : computeNow()\nn < 10
note right of ELEGIVEL
  A cada cálculo a faixa é a que contém o score
  (sobe ou desce com o recálculo);
  as setas mostram a ordem crescente.
end note
state "RankingOptIn.optedIn" as B_RankingOptIn_optedIn {
  state "optedIn = true" as B_RankingOptIn_optedIn_T
  state "optedIn = false" as B_RankingOptIn_optedIn_F
  [*] --> B_RankingOptIn_optedIn_F : criação\n(valor inicial false)
  B_RankingOptIn_optedIn_T --> B_RankingOptIn_optedIn_F : optIn()\nPUT /api/me/rankings/opt-in\n(optedIn)
  B_RankingOptIn_optedIn_F --> B_RankingOptIn_optedIn_T : optIn()\nPUT /api/me/rankings/opt-in\n(optedIn)
}
note bottom of B_RankingOptIn_optedIn
  Consultas que filtram por optedIn:
  findByOptedInTrue
end note
@enduml
