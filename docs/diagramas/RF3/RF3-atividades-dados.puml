@startuml RF3_Atividades_Dados
title RF3 — Gerenciar a conta (dados pessoais, sessão, segurança, LGPD e notificações)\nDiagrama de atividades — Seus dados: exportação em JSON e exclusão da conta com carência de 30 dias
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 18
skinparam ArrowColor #52606D
skinparam activity {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  DiamondBackgroundColor #FFF5F8
  DiamondBorderColor #F08DB1
  StartColor #20A77A
  EndColor #4B5563
  BarColor #4B4B4B
}
skinparam swimlane {
  BorderColor #CBC6BE
  TitleFontColor #2D2438
}
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
start
:Abre /settings, aba Seus dados;
  if (Exportar ou excluir?) then (exportar)
    :<b>Frontend</b> · POST /api/me/exports;
    :<b>API</b> · data_export_requests PROCESSING; monta o JSON no idioma preferido\n(perfil, preferências com hypeCreatorOptOut, consentimentos, peças, looks,\ncomentários, salvos, seguindo, fotos, notificações, DNA, inferências de IA, Hype);
    :<b>API</b> · Grava em restricted/users/{id}/exports/{exportId}.json;\nREADY, expiresAt = +7 dias; notificação DATA_EXPORT_READY;\naudita EXPORTACAO_CONTA → 202 {id, status, readyAt, expiresAt, bytes};
    :<b>Frontend</b> · GET /api/me/exports (status EXPIRED quando expiresAt passou);
    :<b>Frontend</b> · Baixar → GET /api/me/exports/{exportId}/file;
    if (Exportação de outra pessoa?) then (sim)
      #FFE3E3:<b>API</b> · 403;
      stop
    elseif (Vencida ou sem arquivo?) then (sim)
      #FFE3E3:<b>API</b> · 410 EXPORTACAO_EXPIRADA;
      stop
    else (não)
      :<b>API</b> · 200 application/octet-stream\n(arquivo "fashionai-dados-{id}.zip" com conteúdo JSON);
    endif
  else (excluir a conta)
    :<b>Frontend</b> · Diálogo pede a senha → POST /api/me/deletion {password}\n(10 pedidos/h por IP);
    if (Senha confere (mesmo bloqueio do login)?) then (não)
      #FFE3E3:<b>API</b> · 401 REAUTENTICACAO_FALHOU · 429 MUITAS_TENTATIVAS;
      stop
    endif
    :<b>API</b> · status DELETION_SCHEDULED; deletionScheduledFor = +30 dias;\ne-mail de aviso; audita EXCLUSAO_CONTA → 200 {status, deletionScheduledFor};
    if (Desiste dentro dos 30 dias?) then (sim)
      :<b>Frontend</b> · DELETE /api/me/deletion;
      :<b>API</b> · Volta para PENDING_EMAIL_VERIFICATION, PENDING_VALIDATION\nou ACTIVE; audita EXCLUSAO_CANCELADA;
    else (não)
      #EEEEEE:<b>API</b> · purgeScheduledDeletions anonimiza a conta\n<<planejado>>: sem @Scheduled nem chamada no código;
    endif
  endif
:<b>Frontend</b> · Atualiza a seção e mostra o aviso;
stop
legend right
Em negrito, quem executa cada passo:
Pessoa · Frontend (settings/page.tsx)
· API (MeController · AccountService)
endlegend
@enduml
