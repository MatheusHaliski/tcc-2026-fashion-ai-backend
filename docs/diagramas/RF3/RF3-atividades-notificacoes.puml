@startuml RF3_Atividades_Notificacoes
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam activity {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  DiamondBackgroundColor #FFF5F8
  DiamondBorderColor #F08DB1
  StartColor #20A77A
  EndColor #4B5563
}
skinparam swimlane {
  BorderColor #CBC6BE
  TitleFontColor #2D2438
}
title RF3 — Gerenciar a conta (dados pessoais, sessão, segurança, LGPD e notificações)\nDiagrama de atividades — gerado do código em 2026-10-14 (scripts/diagramas/v5)

|Pessoa usuária|
start
:Abre /notifications, /login,\n/reset-password;
|Tela (Next.js)|
:Carrega os dados da tela\nGET /api/notifications/preferences\nGET /api/notifications/unread-count\nGET /api/notifications;
|Pessoa usuária|
:Marcar como lidas;
|Tela (Next.js)|
:POST /api/notifications/read;
|API (Spring Boot)|
:NotificationController.markRead\n→ NotificationService.markRead;
if (Notificação de outro usuário.?) then (sim)
  :403 ACESSO_NEGADO\n«Notificação de outro usuário.»\n→ a tela mostra o aviso;
  stop
endif
|Dados e serviços|
:Lê: notifications;
:Estado: read → true\nreadAt → set;
|Tela (Next.js)|
:Atualiza a tela com a resposta;
|Pessoa usuária|
if (Faz outra ação?) then (sim)
  switch (Qual?)
  case (Marcar todas como lidas)
    :POST /api/notifications/read-all\n→ NotificationService.markAllRead\nlê: notifications\nestado: read → true, readAt → set;
  case (Ligar/desligar tipos de notificaç…)
    :PUT /api/notifications/preferences\n→ NotificationService.updatePreferences\nvalida: TIPO_OBRIGATORIO\nlê: user_preferences\nestado: notificationPushMaster → ?master;
  endswitch
  |Tela (Next.js)|
  :Atualiza a tela;
endif
|Pessoa usuária|
stop
@enduml
