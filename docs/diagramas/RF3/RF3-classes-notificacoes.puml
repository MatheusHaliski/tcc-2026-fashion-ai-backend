@startuml RF3_Classes_Notificacoes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  StereotypeFontColor #6B6470
}
hide empty members
left to right direction
title RF3 — Gerenciar a conta (dados pessoais, sessão, segurança, LGPD e notificações)\nDiagrama de classes — gerado do código em 2026-10-14 (scripts/diagramas/v5)

package "fai-domain (entidades JPA)" {
  class Notification <<notifications>> {
    +id: UUID
    +recipient: User
    +actor: User
    +type: NotificationType
    +category: NotificationCategory
    +resourceType: String
    +resourceId: UUID
    +title: String
    +body: String
    +payloadJson: String
    .. +3 campos ..
  }
  class User <<users>> {
    +id: UUID
    +username: String
    +displayName: String
    +email: String
    +emailHash: String
    +emailVerified: boolean
    +phone: String
    +birthDate: String
    +passwordHash: String
    +profileType: ProfileType
    .. +25 campos ..
  }
  class UserPreferences <<user_preferences>> {
    +id: UUID
    +user: User
    +theme: ThemeMode
    +language: UiLanguage
    +density: UiDensity
    +fontScale: int
    +highContrast: boolean
    +reduceMotion: boolean
    +chromeBackgroundId: String
    +sizeSystem: SizeSystem
    .. +18 campos ..
  }
}
package "fai-domain (enums)" {
  enum AccountStatus {
    PENDING_EMAIL_VERIFICATION
    ACTIVE
    PENDING_VALIDATION
    SUSPENDED
    DELETION_SCHEDULED
    DELETED
  }
  enum NotificationType {
    PASSWORD_RESET
    TWO_FACTOR_CODE
    NEW_LOGIN_DEVICE
    EMAIL_CONFIRMATION
    DATA_EXPORT_READY
    FOLLOW_REQUEST
    FOLLOW_ACCEPTED
    NEW_FOLLOWER
    NEW_COMMENT
    NEW_LIKE
    ..
  }
  enum NotificationCategory {
    SECURITY
    SOCIAL
    ACHIEVEMENT
    SYSTEM
    POINTS
  }
}
package "fai-application" {
  class AdminService <<service>> {
    +runJob()
  }
}
AdminService ..> User : usa
Notification "*" --> "1" User : actor
Notification "*" --> "1" User : recipient
Notification --> NotificationCategory
Notification --> NotificationType
User --> AccountStatus
UserPreferences "1" --> "1" User : user
@enduml
