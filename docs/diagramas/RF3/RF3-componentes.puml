@startuml RF3_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF3 — Gerenciar a conta: dados pessoais, sessão, segurança, privacidade (LGPD) e notificações\nDiagrama de componentes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "Frontend (Next.js)" {
  component "/notifications\n(site)/(app)/notifications/page.tsx" as FE0
  component "/settings\n(site)/(app)/settings/page.tsx" as FE1
  component "/u/[username]\n(site)/(app)/u/[username]/page.tsx" as FE2
  component "lib/api/client.ts" as APIC
}
package "fai-web (REST)" {
  component "AccountController\n/api/rf3/users/{…}/privacy-probe" as AccountController
  component "AuthController\n/api/auth/logout\n/api/auth/password\n/api/auth/sessions\n/api/auth/sessions/{…}" as AuthController
  component "MeController\n/api/me\n/api/me/consents\n/api/me/deletion\n/api/me/email-change/confirm\n(+4 rotas)" as MeController
  component "NotificationController\n/api/notifications\n/api/notifications/preferences" as NotificationController
  component "PreferencesController\n/api/me/avatar\n/api/me/avatar/rotate\n/api/me/cover\n/api/me/preferences\n(+3 rotas)" as PreferencesController
}
package "fai-application (casos de uso)" {
  component "IdentityService" as IdentityService
  component "AccountService" as AccountService
  component "NotificationService" as NotificationService
  component "PreferencesService" as PreferencesService
  component "Avatar3dService" as Avatar3dService <<apoio>>
  component "LensService" as LensService <<apoio>>
  component "HypeScoreConfig" as HypeScoreConfig <<apoio>>
  component "AssetCatalogService" as AssetCatalogService <<apoio>>
  component "MediaService" as MediaService <<apoio>>
  component "PasswordHasherPort\n«Argon2PasswordHasher»" as PasswordHasherPort <<port>>
  component "TokenIssuerPort\n«JwtTokenIssuer»" as TokenIssuerPort <<port>>
  component "RateLimitPort\n«InMemoryRateLimit»" as RateLimitPort <<port>>
  component "EmailSenderPort\n«LoggingEmailSender / ResendEmailSender»" as EmailSenderPort <<port>>
  component "MediaStoragePort\n«LocalFileMediaStorage / S3MediaStorageAdapter»" as MediaStoragePort <<port>>
  component "NotificationProjectionPort\n«CassandraProjectionAdapter»" as NotificationProjectionPort <<port>>
}
package "fai-domain (repositórios)" {
  component "UserRepository\nUserPreferencesRepository\nBrandProfileRepository\nCelebrityProfileRepository\nRefreshTokenRepository\nVerificationCodeRepository\nUserConsentRepository\nDataExportRequestRepository\nWardrobeItemRepository\nSchemeRepository\n(+13)" as REPO_MySQL
}
database "MySQL\n• ai_inference_log\n• brand_profiles\n• celebrity_profiles\n• comments\n• data_export_requests\n• dna_schemes\n• follows\n• hype_milestones\n• hype_score_snapshots\n• hype_scores\n• notifications\n• photos\n(+11)" as DB_MySQL
cloud "Resend" as CL_Resend
cloud "S3" as CL_S3
cloud "Cassandra" as CL_Cassandra
APIC --> AccountController : HTTPS/JSON
APIC --> AuthController : HTTPS/JSON
APIC --> MeController : HTTPS/JSON
APIC --> NotificationController : HTTPS/JSON
APIC --> PreferencesController : HTTPS/JSON
AccountService --> EmailSenderPort
AccountService --> MediaStoragePort
AccountService --> REPO_MySQL
AccountService ..> Avatar3dService
AccountService ..> HypeScoreConfig
AccountService ..> IdentityService
AccountService ..> LensService
AccountService ..> NotificationService
AuthController --> IdentityService
EmailSenderPort --> CL_Resend
FE0 --> APIC
FE1 --> APIC
FE2 --> APIC
IdentityService --> EmailSenderPort
IdentityService --> MediaStoragePort
IdentityService --> PasswordHasherPort
IdentityService --> REPO_MySQL
IdentityService --> RateLimitPort
IdentityService --> TokenIssuerPort
IdentityService ..> NotificationService
MeController --> AccountService
MediaStoragePort --> CL_S3
NotificationController --> NotificationService
NotificationProjectionPort --> CL_Cassandra
NotificationService --> NotificationProjectionPort
NotificationService --> REPO_MySQL
PreferencesController --> PreferencesService
PreferencesService --> REPO_MySQL
PreferencesService ..> AssetCatalogService
PreferencesService ..> IdentityService
PreferencesService ..> MediaService
REPO_MySQL --> DB_MySQL : JPA/Flyway
@enduml
