@startuml RF3_Componentes
title RF3 — Gerenciar a conta (dados pessoais, sessão, segurança, LGPD e notificações)\nDiagrama de componentes — telas → controllers → serviços → portas → MySQL, Redis, Cassandra, S3 e Resend
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #4A4852
}
left to right direction

package "Frontend (Next.js)" {
  component "settings/page.tsx\nabas Conta · Aparência · Privacidade\nSeus dados · Sessões" as FE_SET
  component "components/edit-profile.tsx\n(EditProfileForm)" as FE_EDIT
  component "notifications/page.tsx\n(caixa · preferências por tipo)" as FE_NOT
  component "forgot-password · reset-password\n(páginas públicas)" as FE_PWD
  component "app-shell.tsx\n(sino: unread-count)" as FE_SHELL
  component "lib/api/client.ts (api)\nlib/hooks/use-api.ts (useApi)\nlib/auth/session.tsx (useAuth)" as FE_LIB
}

package "fai-web" {
  component "AuthRateLimitFilter\n(limite por IP nas rotas sensíveis)" as RLF
  component "MeController\n/api/me · /sensitive · /email-change/confirm\n/privacy · /consents/{purpose}\n/exports · /exports/{id}/file · /deletion" as MeC
  component "AuthController\n/api/auth/password · /sessions(/{id})\n/password-reset/request · /confirm · /logout" as AuC
  component "NotificationController\n/api/notifications · /unread-count\n/read · /read-all · /preferences" as NoC
  component "AccountController\n/api/rf3/users/{userId}/privacy-probe" as AcC
  component "FashionAuthorization\ncanAccessUser (403 auditado)" as Authz
}

package "fai-application" {
  component "AccountService\ndados sensíveis · privacidade · consentimentos\nexportação JSON · exclusão (30 dias)" as AS
  component "IdentityService\nreauthenticate · changePassword\nsessions · revokeSession · password reset" as IS
  component "NotificationService\nnotify · inbox · markRead\npreferences · purgeExpired" as NS
  component "Audit → AuditService" as AUD
  interface "MediaStoragePort" as P_MEDIA <<port>>
  interface "EmailSenderPort" as P_MAIL <<port>>
  interface "RateLimitPort" as P_RL <<port>>
  interface "NotificationProjectionPort" as P_PROJ <<port>>
}

package "fai-domain · repositórios" {
  component "UserRepository · UserConsentRepository\nDataExportRequestRepository · VerificationCodeRepository\nRefreshTokenRepository · NotificationRepository\nUserPreferencesRepository" as REPOS
}

package "fai-infrastructure" {
  component "MysqlAuditService" as A_AUD
  component "S3MediaStorageAdapter\n| LocalFileMediaStorage" as A_S3
  component "ResendEmailSender\n| LoggingEmailSender" as A_MAIL
  component "RedisAdapters.redisRateLimit\n| InMemoryRateLimit" as A_RL
  component "CassandraProjectionAdapter\n| NoopProjections" as A_CASS
}

database "MySQL (Flyway)\nusers · user_consents · data_export_requests\nverification_codes · refresh_tokens\nnotifications · user_preferences · audit_log" as DB
database "Redis\ncontadores de tentativa" as REDIS
database "Cassandra\ninbox projetada (TTL 90 dias)" as CASS
cloud "S3 / R2\nrestricted/users/{id}/exports" as S3
cloud "Resend\ne-mail transacional" as RESEND

FE_SET --> FE_EDIT
FE_SET --> FE_LIB
FE_EDIT --> FE_LIB
FE_NOT --> FE_LIB
FE_PWD --> FE_LIB
FE_SHELL --> FE_LIB

FE_LIB --> RLF : HTTPS + JWT
RLF --> MeC
RLF --> AuC
FE_LIB --> NoC
FE_LIB --> AcC
AcC ..> Authz : @PreAuthorize

MeC --> AS
AuC --> IS
NoC --> NS
AS --> IS : reauthenticate · invalidateCodes\nrequireCodeAttemptQuota
AS --> NS : DATA_EXPORT_READY
AS --> AUD : ALTERACAO_DADO_PESSOAL_SENSIVEL\nCONSENTIMENTO_* · EXPORTACAO_CONTA\nEXCLUSAO_CONTA
IS --> AUD
AS --> P_MEDIA
AS --> P_MAIL
IS --> P_MAIL
IS --> P_RL
NS --> P_PROJ

AS --> REPOS
IS --> REPOS
NS --> REPOS

A_S3 ..|> P_MEDIA
A_MAIL ..|> P_MAIL
A_RL ..|> P_RL
A_CASS ..|> P_PROJ
AUD --> A_AUD

REPOS --> DB : JPA
A_AUD --> DB : audit_log
A_RL --> REDIS
A_CASS --> CASS
A_S3 --> S3
A_MAIL --> RESEND

note bottom of AS
  purgeExpiredExports: @Scheduled 0 50 * * * * (America/Sao_Paulo).
  purgeScheduledDeletions e NotificationService.purgeExpired
  existem no código, mas nenhum @Scheduled os chama hoje.
end note
@enduml
