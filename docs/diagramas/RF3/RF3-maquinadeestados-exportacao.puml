@startuml RF3_MaquinaDeEstados_Exportacao
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  StartColor #20A77A
  EndColor #4B5563
}
title RF3 — ciclo de vida de DataExportRequest.status\nDiagrama de máquina de estados — gerado do código em 2026-10-06 (scripts/diagramas/v5)\nenum ExportStatus · tabela data_export_requests

state "DataExportRequest.status" as Ciclo_DataExportRequest {
  state Ciclo_DataExportRequest_REQUESTED as "REQUESTED"
  state Ciclo_DataExportRequest_PROCESSING as "PROCESSING"
  state Ciclo_DataExportRequest_READY as "READY"
  state Ciclo_DataExportRequest_EXPIRED as "EXPIRED"
}
[*] --> Ciclo_DataExportRequest_REQUESTED : criação
Ciclo_DataExportRequest --> Ciclo_DataExportRequest_EXPIRED : purgeExpiredExports()
Ciclo_DataExportRequest --> Ciclo_DataExportRequest_PROCESSING : requestExport()\nPOST /api/me/exports
Ciclo_DataExportRequest --> Ciclo_DataExportRequest_READY : requestExport()\nPOST /api/me/exports
note right of Ciclo_DataExportRequest
  Setas que saem da borda: a mudança vale
  a partir de qualquer estado (o código não
  testa o estado anterior).
end note
@enduml
