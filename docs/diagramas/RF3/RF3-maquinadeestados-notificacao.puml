@startuml RF3_MaquinaDeEstados_Notificacao
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  StartColor #20A77A
  EndColor #4B5563
}
title RF3 — ciclo de vida de Notification.category\nDiagrama de máquina de estados — gerado do código em 2026-10-14 (scripts/diagramas/v5)\nenum NotificationCategory · tabela notifications

state "Notification.category" as Ciclo_Notification {
  state Ciclo_Notification_SECURITY as "SECURITY"
  state Ciclo_Notification_SOCIAL as "SOCIAL"
  state Ciclo_Notification_ACHIEVEMENT as "ACHIEVEMENT"
  state Ciclo_Notification_SYSTEM as "SYSTEM"
  state Ciclo_Notification_POINTS as "POINTS"
}
note bottom of Ciclo_Notification
  Recebe o valor escolhido em: ask(cat), diagnosis(cat), upsert(category)
end note
@enduml
