@startuml RF3_Sequencia_LGPD
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."
title RF3 — Gerenciar a conta (dados pessoais, sessão, segurança, LGPD e notificações)\nDiagrama de sequência — gerado do código em 2026-10-14 (scripts/diagramas/v5)

actor "Pessoa usuária" as U
boundary "Tela /settings" as P
control "MeController" as MeController
participant "AccountService" as AccountService
participant "IdentityService" as IdentityService
database "MySQL" as DB_MySQL
participant "EmailSenderPort\n(LoggingEmailSender, ResendEmailSender)" as EmailSenderPort
participant "Audit" as Audit
participant "HypeScoreConfig" as HypeScoreConfig
participant "MediaStoragePort\n(LocalFileMediaStorage, S3MediaStorageAdapter)" as MediaStoragePort
participant "NotificationService" as NotificationService
== Alterar senha, e-mail, telefone, nascimento ou 2FA (pede reautenticaç… ==
U -> P : Alterar senha, e-mail, telefone, nascimento ou 2F…
P -> MeController : PATCH /api/me/sensitive
MeController -> AccountService : updateSensitive()
activate AccountService
AccountService -> IdentityService : reauthenticate()
IdentityService -> DB_MySQL : SELECT users
IdentityService --> AccountService
AccountService -> DB_MySQL : SELECT users
alt e-mail inválido
AccountService --> MeController : 400 EMAIL_INVALIDO
MeController --> P : 400 + mensagem
end
alt e-mail em uso
AccountService --> MeController : 409 EMAIL_EM_USO
MeController --> P : 409 + mensagem
end
AccountService -> IdentityService : invalidateCodes()
IdentityService -> DB_MySQL : SELECT verification_codes
IdentityService --> AccountService
AccountService -> AccountService : new VerificationCode()
AccountService -> AccountService : purpose = EMAIL_CHANGE
AccountService -> AccountService : expiresAt = set
AccountService -> AccountService : lastSentAt = set
AccountService -> DB_MySQL : INSERT/UPDATE verification_codes
AccountService -> DB_MySQL : SELECT user_preferences
AccountService -> EmailSenderPort : send() (×2)
AccountService -> Audit : log()
deactivate AccountService
AccountService --> MeController : resultado
MeController --> P : 200 JSON
P --> U : atualiza a tela
== Solicitar exportação dos meus dados ==
U -> P : Solicitar exportação dos meus dados
P -> MeController : POST /api/me/exports
MeController -> AccountService : requestExport()
activate AccountService
AccountService -> DB_MySQL : SELECT users
AccountService -> AccountService : new DataExportRequest()
AccountService -> AccountService : status = PROCESSING
AccountService -> DB_MySQL : INSERT/UPDATE data_export_requests
AccountService -> DB_MySQL : SELECT user_preferences
AccountService -> DB_MySQL : SELECT user_consents
AccountService -> DB_MySQL : SELECT wardrobe_items
AccountService -> DB_MySQL : SELECT schemes
AccountService -> DB_MySQL : SELECT scheme_items
AccountService -> DB_MySQL : SELECT comments
AccountService -> DB_MySQL : SELECT saved_items
AccountService -> DB_MySQL : SELECT follows
AccountService -> DB_MySQL : SELECT photos
AccountService -> DB_MySQL : SELECT notifications
AccountService -> DB_MySQL : SELECT style_dna
AccountService -> DB_MySQL : SELECT dna_schemes
AccountService -> DB_MySQL : SELECT ai_inference_log
AccountService -> HypeScoreConfig : algorithmVersion()
AccountService -> DB_MySQL : SELECT hype_scores
AccountService -> DB_MySQL : SELECT hype_score_snapshots
AccountService -> DB_MySQL : SELECT hype_milestones
AccountService -> DB_MySQL : SELECT user_preferences
AccountService -> MediaStoragePort : put()
AccountService -> AccountService : fileKey = set
AccountService -> AccountService : status = READY
AccountService -> AccountService : readyAt = set
AccountService -> AccountService : expiresAt = set
AccountService -> NotificationService : notify()
NotificationService -> DB_MySQL : SELECT users (×2)
NotificationService -> DB_MySQL : SELECT user_preferences
NotificationService -> DB_MySQL : INSERT/UPDATE notifications
NotificationService --> AccountService
note over AccountService : … e mais 1 passos no código
deactivate AccountService
AccountService --> MeController : resultado
MeController --> P : 201 JSON
P --> U : atualiza a tela
@enduml
