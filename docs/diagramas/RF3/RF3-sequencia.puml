@startuml RF3_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."
title RF3 — Gerenciar a conta: dados pessoais, sessão, segurança, privacidade (LGPD) e notificações\nDiagrama de sequência — gerado do código em 2026-10-06 (scripts/diagramas/v5)

actor "Pessoa usuária" as U
boundary "Tela /settings" as P
control "MeController" as MeController
participant "AccountService" as AccountService
participant "IdentityService" as IdentityService
database "MySQL" as DB_MySQL
participant "EmailSenderPort\n(LoggingEmailSender, ResendEmailSender)" as EmailSenderPort
participant "Audit" as Audit
control "AuthController" as AuthController
== Alterar senha, e-mail, telefone, nascimento ou 2FA (pede reautenticaç… ==
U -> P : Alterar senha, e-mail, telefone, nascimento ou 2F…
P -> MeController : PATCH /api/me/sensitive
MeController -> AccountService : updateSensitive()
activate AccountService
AccountService -> IdentityService : reauthenticate()
IdentityService -> DB_MySQL : SELECT users
IdentityService --> AccountService
AccountService -> DB_MySQL : SELECT users
alt e-mail inválido
AccountService --> MeController : 400 EMAIL_INVALIDO
MeController --> P : 400 + mensagem
end
alt e-mail em uso
AccountService --> MeController : 409 EMAIL_EM_USO
MeController --> P : 409 + mensagem
end
AccountService -> IdentityService : invalidateCodes()
IdentityService -> DB_MySQL : SELECT verification_codes
IdentityService --> AccountService
AccountService -> AccountService : new VerificationCode()
AccountService -> AccountService : purpose = EMAIL_CHANGE
AccountService -> AccountService : expiresAt = set
AccountService -> AccountService : lastSentAt = set
AccountService -> DB_MySQL : INSERT/UPDATE verification_codes
AccountService -> DB_MySQL : SELECT user_preferences
AccountService -> EmailSenderPort : send() (×2)
AccountService -> Audit : log()
deactivate AccountService
AccountService --> MeController : resultado
MeController --> P : 200 JSON
P --> U : atualiza a tela
== Encerrar uma sessão específica ==
U -> P : Encerrar uma sessão específica
P -> AuthController : DELETE /api/auth/sessions/{sessionId}
AuthController -> IdentityService : revokeSession()
activate IdentityService
IdentityService -> DB_MySQL : SELECT refresh_tokens
alt Sessão não encontrado(a)
IdentityService --> AuthController : 404 NAO_ENCONTRADO
AuthController --> P : 404 + mensagem
end
IdentityService -> DB_MySQL : SELECT refresh_tokens
IdentityService -> IdentityService : revokedAt = set
IdentityService -> Audit : log()
deactivate IdentityService
IdentityService --> AuthController : resultado
AuthController --> P : 200 JSON
P --> U : atualiza a tela
@enduml
