@startuml RF30_MaquinaDeEstados_Nivel
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  ArrowColor #52606D
}
title RF30 — Nível do Meu Quarto (FaiPointsService.Level, room_layouts.level) pelos FAI Points vitalícios
[*] --> ESTREIA : conta criada (lifetime = 0)
state "ESTREIA (0)\nFAI Origem, Smart Mirror, Vista-me" as ESTREIA
state "STUDIO (300)\niluminação guiada, 1ºs acabamentos" as STUDIO
state "LOFT (900)\n+2 módulos, mais categorias" as LOFT
state "CLOSET (2000)\nsapateira, vitrine de bolsas" as CLOSET
state "ATELIER (4000)\nilha central / bancada de looks" as ATELIER
state "PENTHOUSE (7500)\ntroca de estação (maleiro)" as PENTHOUSE
state "MAISON (12000)\ncloset de assinatura, itens exclusivos" as MAISON
ESTREIA --> STUDIO : lifetime >= 300
STUDIO --> LOFT : lifetime >= 900
LOFT --> CLOSET : lifetime >= 2000
CLOSET --> ATELIER : lifetime >= 4000
ATELIER --> PENTHOUSE : lifetime >= 7500
PENTHOUSE --> MAISON : lifetime >= 12000
ESTREIA --> ESTREIA : award(actionCode) → fai_points_ledger\n(idempotencyKey, limite diário/semanal)
note right of ESTREIA : cada Award credita delta no ledger append-only;\nlevelUp notifica "nível liberado" e grava room_layouts.level
note bottom of MAISON : nível nunca regride: compras na loja\n(POST /api/points/shop/{sku}/purchase) debitam o saldo\nmas não o vitalício (countsLifetime = false)
note left of CLOSET : nenhum nível bloqueia função básica;\nitens da loja podem exigir requiredLevel\n(409 NIVEL_INSUFICIENTE)
@enduml
