@startuml RF31_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF31 — Filtrar e marcar o estado dos itens do acervo (favorita, disponível, indisponível, à venda)\nDiagrama de componentes — gerado do código em 2026-10-14 (scripts/diagramas/v5)

package "Frontend (Next.js)" {
  component "/dna-schemes/[id]/edit\n(site)/(app)/dna-schemes/[id]/edit/page.tsx" as FE0
  component "/dna-schemes/new\n(site)/(app)/dna-schemes/new/page.tsx" as FE1
  component "/dna\n(site)/(app)/dna/page.tsx" as FE2
  component "/pieces/[id]\n(site)/(app)/pieces/[id]/page.tsx" as FE3
  component "/pieces/new\n(site)/(app)/pieces/new/page.tsx" as FE4
  component "/schemes/[id]/edit\n(site)/(app)/schemes/[id]/edit/page.tsx" as FE5
  component "lib/api/client.ts" as APIC
}
package "fai-web (REST)" {
  component "WardrobeController\n/api/me/closet\n/api/pieces/{…}\n/api/pieces/{…}/copy\n/api/pieces/{…}/deletion-impact\n(+3 rotas)" as WardrobeController
}
package "fai-application (casos de uso)" {
  component "WardrobeService" as WardrobeService
  component "FlatLayPipeline" as FlatLayPipeline <<apoio>>
  component "MediaService" as MediaService <<apoio>>
  component "AssetCatalogService" as AssetCatalogService <<apoio>>
  component "ProjectionService" as ProjectionService <<apoio>>
  component "NotificationService" as NotificationService <<apoio>>
  component "Model3dService" as Model3dService <<apoio>>
  component "BrandLogoService" as BrandLogoService <<apoio>>
  component "PieceReferenceCatalog" as PieceReferenceCatalog <<apoio>>
  component "JobQueuePort\n«InMemoryJobQueue»" as JobQueuePort <<port>>
}
package "fai-domain (repositórios)" {
  component "WardrobeItemRepository\nUserRepository\nBrandRepository\nPipelineJobRepository\nProcessingJobLogRepository\nQualityScoreRepository\nModerationQueueRepository\nSchemeItemRepository\nSchemeRepository\nReactionRepository\n(+2)" as REPO_MySQL
}
database "MySQL\n• brands\n• moderation_queue\n• photos\n• pipeline_jobs\n• processing_jobs_log\n• quality_scores\n• reactions\n• saved_items\n• scheme_items\n• schemes\n• users\n• wardrobe_items" as DB_MySQL
cloud "Motor de IA (RF24)\nprovedores externos + reserva local" as AI
component "Eventos de domínio\n(@TransactionalEventListener)" as EV
APIC --> WardrobeController : HTTPS/JSON
FE0 --> APIC
FE1 --> APIC
FE2 --> APIC
FE3 --> APIC
FE4 --> APIC
FE5 --> APIC
REPO_MySQL --> DB_MySQL : JPA/Flyway
WardrobeController --> WardrobeService
WardrobeService --> AI
WardrobeService --> EV
WardrobeService --> JobQueuePort
WardrobeService --> REPO_MySQL
WardrobeService ..> AssetCatalogService
WardrobeService ..> BrandLogoService
WardrobeService ..> FlatLayPipeline
WardrobeService ..> MediaService
WardrobeService ..> Model3dService
WardrobeService ..> NotificationService
WardrobeService ..> PieceReferenceCatalog
WardrobeService ..> ProjectionService
@enduml
