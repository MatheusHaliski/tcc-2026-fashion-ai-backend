@startuml RF31_Sequencia
title RF31 — Filtrar e marcar o estado dos itens do acervo: favoritar, disponível, indisponível e todos\nDiagrama de sequência — filtrar e ordenar o guarda-roupa (estado, faixa de Hype v2 e "Com selo")
skinparam backgroundColor #FFFFFF
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
}
autonumber
actor "Pessoa" as U
participant "closet/page.tsx\n(FilterBar · hype-filters.ts)" as FE
participant "WardrobeController" as C
participant "WardrobeService" as S
participant "HypeScoreConfig" as CFG
participant "HypeSeals" as HS
participant "SealService\n(approvedPieceBonds)" as SS
participant "SealController" as SC
database "MySQL" as DB

U -> FE: estado "Indisponíveis", faixa "Em alta ou mais",\n"Com selo: Hype", ordenar "Maior Hype"
FE -> FE: router.replace(/closet?category=…&seal=hype)
FE -> C: GET /api/me/closet?state=indisponivel&hypeLevel=HOT\n&seal=hype&sort=hype_desc&page=0&size=24
C -> S: closet(user, user.id(), ClosetFilter(…, hypeLevel, seal))
S -> DB: SELECT wardrobe_items WHERE user_id ORDER BY created_at DESC
S -> S: tira ARCHIVED; filtra categoria, cor (ou família),\nestação, ocasião, estilo, stateMatches(w, "indisponivel"), q
S -> S: SORT_ALIASES (mais_usadas → worn, nome → name…)\nsealFilter("hype") → "hype"
opt sort ∈ HYPE_SORTS ou hypeLevel ou seal ∈ {hype, any}
  S -> CFG: algorithmVersion()
  S -> DB: hype_scores (PIECE, ids, versão)\nfindByEntityTypeAndEntityIdInAndAlgorithmVersion
  note right of S: dona: Hype pessoal de todas as peças;\noutra pessoa: só publicEligible
end
opt hypeLevel informado
  S -> CFG: levelThresholds() → HOT = 60
  S -> S: remove sem Hype ou score < 60 − 0,5
end
alt seal = hype
  S -> HS: of(hypeScore) — VIRAL, TRENDING, EMERGING, CLASSIC, RARE
  S -> S: remove peças sem selo de Hype
else seal = brand ou any
  S -> SS: approvedPieceBonds(ids, schemeItems, sealBonds, canViewScheme)
  SS -> DB: scheme_items + seal_bonds (APROVADO, tier PEÇA)
  S -> S: brand: remove sem vínculo · any: remove sem nenhum dos dois
end
S -> S: ordena (hype_desc: score, sem Hype por último)\npagina (size ≤ 60)
S --> C: Page<PieceView> {items, page, size, total, hasMore}
C --> FE: 200
FE -> SC: GET /api/pieces/seals?ids=… (usePieceSeals, até 60)
SC --> FE: selos de marca/celebridade por peça
FE --> U: grade de PieceCard (SealSlot · Indisponível · Para doar · ★)
alt nenhuma peça
  FE --> U: EmptyState "Adicionar peça"
end
@enduml
