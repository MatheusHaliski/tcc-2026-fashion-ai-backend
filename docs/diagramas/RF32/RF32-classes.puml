@startuml RF32_Classes
title RF32 — Participar de desafios de moda solo, em equipe, em duelo ou da comunidade, através da sub-aba "Desafios"\nDiagrama de classes — ChallengeService, entidades challenge_* e integrações (quarto, espelho, pontos)
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  HeaderBackgroundColor #E4DEF0
}
skinparam packageStyle rectangle
hide empty methods
hide empty fields

package "fai-web" {
  class ChallengeController {
    catalog · mine · start · launch · accept · decline
    startNow · leave · cancel · detail · submitEntry
    voteFeed · vote · note · react · realMirror
    mirrorPhoto · confirmRealMirror · resultCard · propose
  }
  class AdminController {
    +promoteChallenge(user, code)\n  «POST /api/admin/challenges/{code}/promotion»
  }
}

package "fai-application" {
  class ChallengeService <<@Service>> {
    +MAX_ACTIVE = 3
    +ACCEPT_WINDOW = 48 h
    +NOTE_MAX = 80
    +MODES = SOLO, EQUIPE, DUELO, COMUNIDADE
    +REACTIONS · PRESET_NOTES
    ~VOTED = RUNWAY_BATTLE, GRWM
    ~SINGLE_SHOT = RUNWAY_BATTLE, GRWM, DAILY_CHALLENGE
    ~RULE_BLOCK_TYPES
    --
    +catalog(user) · +mine(user)
    +start(user, StartRequest)
    +launchDraft(user, id, invitees, teams)
    +accept / decline / startNow / leave / cancel
    +submitEntry(user, id, schemeId)
    +voteFeed(user) · +vote(user, id, entrySchemeId)
    +note(user, id, preset, free) · +react(user, id, emoji)
    +realMirror · +confirmRealMirror · +mirrorPhoto
    +conclude(instance, template)
    +tick()  «@Scheduled 0 */15 * * * *»
    +onSchemeSaved / onDailyLook / onMirror / onPieceCreated\n  «AFTER_COMMIT»
    +resultCard(user, id) · +propose(user, ProposalRequest)
    +promote(admin, code)
    +decorations(userId) · +restriction(userId)
    +activeSummary(userId)
  }
  class "ChallengeService.StartRequest" as StartRequest <<record>> {
    code: String
    mode: String
    params: Map
    invitees: List<UUID>
    teams: Map<String, String>
    draft: Boolean
    photoConsent: Boolean
  }
  class "ChallengeService.Progress" as Progress <<record>> {
    value, target: int
    fraction: double
    best: int
    label: String
    pending: int
  }
  interface "RoomService.DecorationsProvider" as DecProv <<port>> {
    +decorations(userId)
  }
  interface "MirrorService.PieceRestrictionProvider" as RestrProv <<port>> {
    +restriction(userId): Optional<Restriction>
  }
  class FaiPointsService <<@Service>> {
    +award(userId, CHALLENGE_COMPLETED, …, pts)
    +game(userId, "CHALLENGE", id, null)
  }
  class NotificationService <<@Service>> {
    CHALLENGE_INVITE · CHALLENGE_RESULT
  }
  class RoomService <<@Service>> {
    +hasKey(owner, guest): boolean
    +lastDiaryDates(…)
  }
  class CopilotService <<@Service>>
}

package "fai-domain" {
  class ChallengeTemplate <<@Entity>> {
    code: String «PK»
    name / ruleText: String
    ruleBlocksJson / modesAllowedJson: String
    durationDays: Integer
    scoreDimensionsJson: String
    rewardPoints: int
    effort: String
    minParticipants / maxParticipants: int
    origin: String «OFFICIAL | COMMUNITY»
    authorUserId: UUID
    roomDecoration: String
    active: boolean
  }
  class ChallengeInstance <<@Entity>> {
    id: UUID
    templateCode: String
    mode: String
    state: String
    paramsJson: String
    startsAt / endsAt / acceptDeadline: Instant
    createdBy: UUID
    resultJson: String
    version: long
  }
  class ChallengeParticipant <<@Entity>> {
    id: UUID
    instanceId / userId: UUID
    team: String «A | B»
    status: String
    joinedAt / leftAt: Instant
    personalGoalJson: String
    progressFraction: BigDecimal
    bestRecord: int
  }
  class ChallengeEvent <<@Entity>> {
    id: UUID
    instanceId / userId: UUID
    evidenceType: String
    refId: UUID
    createdAt: Instant
  }
  class ChallengeNote <<@Entity>> {
    instanceId / userId: UUID
    kind: String «PRESET | FREE | REACTION»
    content: String
  }
  class ChallengeVote <<@Entity>> {
    instanceId: UUID
    voterUserId: UUID
    entrySchemeId: UUID
  }
  class Scheme <<@Entity>>
  class User <<@Entity>>
}

ChallengeController --> ChallengeService
AdminController ..> ChallengeService : AdminService.promoteChallenge → promote
ChallengeService ..|> DecProv
ChallengeService ..|> RestrProv
ChallengeService --> FaiPointsService
ChallengeService --> NotificationService
ChallengeService --> RoomService
CopilotService ..> ChallengeService : activeSummary
ChallengeService ..> StartRequest
ChallengeService ..> Progress
ChallengeService ..> ChallengeInstance : Challenge*Repository (6)

ChallengeTemplate "1" -- "0..*" ChallengeInstance : templateCode
ChallengeInstance "1" *-- "1..*" ChallengeParticipant : instanceId
ChallengeInstance "1" *-- "0..*" ChallengeEvent
ChallengeInstance "1" *-- "0..*" ChallengeNote
ChallengeInstance "1" *-- "0..*" ChallengeVote
ChallengeVote "0..*" --> "1" Scheme : entrySchemeId
ChallengeParticipant "0..*" --> "1" User : userId
ChallengeInstance "0..*" --> "1" User : createdBy

note bottom of ChallengeInstance
  tabela challenge_instances · state:
  RASCUNHO · AGUARDANDO · ATIVO · CONCLUIDO · EXPIRADO
end note
note bottom of ChallengeParticipant
  tabela challenge_participants · status: CONVIDADO ·
  ATIVO · RECUSOU · SAIU · CONCLUIU · CANCELADO
end note
note bottom of ChallengeVote : tabela challenge_votes\n(unique uq_ch_vote_voter, V27: 1 voto por batalha)
note right of ChallengeTemplate
  tabela challenge_templates (seed V5): TEN_X_TEN,
  CAPSULE_SEASON, SECOND_CHANCE, NO_REPEAT,
  WEAR_WHAT_YOU_HAVE, CHANEL_WEEK, MY_SEASON,
  RUNWAY_BATTLE, DAILY_CHALLENGE, GRWM, REAL_MIRROR
  + propostas da comunidade (origin COMMUNITY)
end note
@enduml
