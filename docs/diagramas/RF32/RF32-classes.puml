package "fai-domain (entidades JPA)" {
  class ChallengeEvent <<challenge_events>> {
    +id: UUID
    +instanceId: UUID
    +userId: UUID
    +evidenceType: String
    +refId: UUID
    +newEntity: boolean
  }
  class ChallengeInstance <<challenge_instances>> {
    +id: UUID
    +templateCode: String
    +mode: String
    +state: String
    +paramsJson: String
    +startsAt: Instant
    +endsAt: Instant
    +acceptDeadline: Instant
    +resultJson: String
    +newEntity: boolean
  }
  class ChallengeNote <<challenge_notes>> {
    +id: UUID
    +instanceId: UUID
    +userId: UUID
    +kind: String
    +content: String
    +newEntity: boolean
  }
  class ChallengeParticipant <<challenge_participants>> {
    +id: UUID
    +instanceId: UUID
    +userId: UUID
    +team: String
    +status: String
    +joinedAt: Instant
    +leftAt: Instant
    +personalGoalJson: String
    +progressFraction: BigDecimal
    +bestRecord: int
    .. +1 campos ..
  }
  class ChallengeTemplate <<challenge_templates>> {
    +code: String
    +name: String
    +ruleText: String
    +ruleBlocksJson: String
    +modesAllowedJson: String
    +durationDays: Integer
    +scoreDimensionsJson: String
    +rewardPoints: int
    +effort: String
    +minParticipants: int
    .. +5 campos ..
  }
  class ChallengeVote <<challenge_votes>> {
    +id: UUID
    +instanceId: UUID
    +voterUserId: UUID
    +entrySchemeId: UUID
    +newEntity: boolean
  }
  class Scheme <<schemes>> {
    +id: UUID
    +user: User
    +originalScheme: Scheme
    +title: String
    +description: String
    +creationMode: CreationMode
    +origin: SchemeOrigin
    +style: String
    +occasion: String
    +season: Season
    .. +46 campos ..
  }
  class User <<users>> {
    +id: UUID
    +username: String
    +displayName: String
    +email: String
    +emailHash: String
    +emailVerified: boolean
    +phone: String
    +birthDate: String
    +passwordHash: String
    +profileType: ProfileType
    .. +24 campos ..
  }
}
package "fai-domain (enums)" {
  enum SchemeStatus {
    DRAFT
    PUBLISHED
    ARCHIVED
  }
  enum RenderStatus {
    PENDING
    RENDERING
    ENHANCING
    COMPOSITING
    CACHED
    COMPLETED
    FAILED
  }
  enum AccountStatus {
    PENDING_EMAIL_VERIFICATION
    ACTIVE
    PENDING_VALIDATION
    SUSPENDED
    DELETION_SCHEDULED
    DELETED
  }
  enum CreationMode {
    MANUAL
    AI_ASSISTED
  }
  enum SchemeOrigin {
    CRIAR_LOOK
    PROVADOR
    REMIX
    COPILOT
    DNA_DUPLICATE
    SMART_MIRROR
    VISTA_ME
    AUTOPILOTO
  }
  enum Season {
    SPRING
    SUMMER
    AUTUMN
    WINTER
  }
}
package "fai-application" {
  class ChallengeService <<service>> {
    +catalog()
    +mine()
    +start()
    +launchDraft()
    +accept()
    +decline()
    +startNow()
    +leave()
    +cancel()
    +detail()
  }
}
ChallengeService ..> ChallengeEvent : usa
ChallengeService ..> ChallengeInstance : usa
ChallengeService ..> ChallengeNote : usa
ChallengeService ..> ChallengeParticipant : usa
ChallengeService ..> ChallengeTemplate : usa
ChallengeService ..> ChallengeVote : usa
ChallengeEvent ..> User : userId
ChallengeNote ..> User : userId
ChallengeParticipant ..> User : userId
Scheme "*" --> "1" User : user
Scheme --> CreationMode
Scheme --> RenderStatus
Scheme --> SchemeOrigin
Scheme --> SchemeStatus
Scheme --> Season
User --> AccountStatus
@enduml
