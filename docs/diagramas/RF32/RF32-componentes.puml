@startuml RF32_Componentes
title RF32 — Participar de desafios de moda solo, em equipe, em duelo ou da comunidade, através da sub-aba "Desafios"\nDiagrama de componentes — telas de Desafios → ChallengeController → ChallengeService → tabelas challenge_*, quarto, espelho e pontos
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
left to right direction

package "Frontend (Next.js 16)" {
  component "challenges/page.tsx\n(abas Catálogo · Meus desafios ·\nVotação · Propor; diálogo Começar)" as FE0
  component "challenges/[id]/page.tsx\n(progresso, entradas, mural,\nsair, cancelar, card de resultado)" as FE1
  component "room/page.tsx · mirror/page.tsx\n(decorações e restrição do desafio)" as FE2
}
package "fai-web" {
  [ChallengeController\n/api/challenges/** · /api/me/challenges] as CC
  [AdminController\nPOST /api/admin/challenges/{code}/promotion] as AC
  [RoomController · MirrorController] as RMC
}
package "fai-application" {
  [ChallengeService] as CS
  [AdminService] as AS
  [RoomService.DecorationsProvider] <<port>> as P_DEC
  [MirrorService.PieceRestrictionProvider] <<port>> as P_RES
  [RoomService] as RS
  [MirrorService] as MS
  [CopilotService\n(activeSummary)] as CPS
  [FaiPointsService\n(award · game)] as FPS
  [NotificationService] as NS
  [MediaService\n(fotos restritas do Espelho de Verdade)] as MED
  [Guard · Audit] as GA
  [SideEffectRunner] as SER
  [Eventos de domínio AFTER_COMMIT\nSchemeSaved · DailyLookRegistered ·\nMirrorAction · PieceCreated] as EV
  [Scheduler\n@Scheduled tick() a cada 15 min] as JOB
}
package "fai-domain (Spring Data JPA)" {
  [ChallengeTemplateRepository · ChallengeInstanceRepository\nChallengeParticipantRepository · ChallengeEventRepository\nChallengeNoteRepository · ChallengeVoteRepository] as R_CH
  [WardrobeItemRepository · SchemeRepository · SchemeItemRepository\nDailyLookRepository · PieceUsageDiaryEntryRepository\nFollowRepository · UserRepository · StyleDnaRepository] as R_OUT
}
database "MySQL · fashionai_app\n• challenge_templates · challenge_instances\n• challenge_participants · challenge_events\n• challenge_notes · challenge_votes\n• schemes · wardrobe_items · follows · daily_looks…" as DB
database "Storage de mídia\n(MediaStoragePort: local / S3)\nrestricted/challenges/…" as ST

FE0 --> CC : HTTPS/JSON
FE1 --> CC : HTTPS/JSON
FE2 --> RMC : GET /api/me/room · /api/me/mirror
RMC --> RS
RMC --> MS
CC --> CS
AC --> AS
AS --> CS : promote
CS ..|> P_DEC
CS ..|> P_RES
RS --> P_DEC
MS --> P_RES
CPS --> CS
EV ..> CS : progresso
CS --> SER
JOB --> CS
CS --> FPS : CHALLENGE_COMPLETED · GAME_PLAYED
CS --> NS : CHALLENGE_INVITE · CHALLENGE_RESULT
CS --> RS : hasKey · lastDiaryDates
CS --> MED
CS --> GA
CS --> R_CH
CS --> R_OUT
MED --> ST
R_CH --> DB : JPA/Flyway (V5, V27)
R_OUT --> DB
@enduml
