@startuml RF32_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."
title RF32 — Participar de desafios de moda solo, em equipe, em duelo ou da comunidade ('Desafios')\nDiagrama de sequência — gerado do código em 2026-10-06 (scripts/diagramas/v5)

actor "Pessoa usuária" as U
boundary "Tela /challenges" as P
control "ChallengeController" as ChallengeController
participant "ChallengeService" as ChallengeService
participant "Guard" as Guard
database "MySQL" as DB_MySQL
participant "RoomService" as RoomService
== Iniciar desafio (solo, duelo, grupo, equipes) ==
U -> P : Iniciar desafio (solo, duelo, grupo, equipes)
P -> ChallengeController : POST /api/challenges
ChallengeController -> ChallengeService : start()
activate ChallengeService
ChallengeService -> Guard : requireCanCreate()
ChallengeService -> DB_MySQL : SELECT challenge_templates
alt modo indisponível
ChallengeService --> ChallengeController : 400 MODO_INDISPONIVEL
ChallengeController --> P : 400 + mensagem
end
ChallengeService -> DB_MySQL : SELECT challenge_instances
ChallengeService -> ChallengeService : new ChallengeInstance()
ChallengeService -> ChallengeService : state = ATIVO
ChallengeService -> ChallengeService : startsAt = set
ChallengeService -> ChallengeService : endsAt = set
ChallengeService -> DB_MySQL : INSERT/UPDATE challenge_instances
ChallengeService -> DB_MySQL : SELECT challenge_participants
alt limite desafios
ChallengeService --> ChallengeController : 409 LIMITE_DESAFIOS
ChallengeController --> P : 409 + mensagem
end
ChallengeService -> ChallengeService : new ChallengeParticipant()
ChallengeService -> ChallengeService : joinedAt = set
ChallengeService -> ChallengeService : status = ATIVO
ChallengeService -> ChallengeService : joinedAt = set
ChallengeService -> ChallengeService : leftAt = null
ChallengeService -> RoomService : lastDiaryDates()
RoomService -> DB_MySQL : SELECT piece_usage_diary
RoomService --> ChallengeService
ChallengeService -> DB_MySQL : SELECT wardrobe_items
ChallengeService -> DB_MySQL : INSERT/UPDATE challenge_participants
ChallengeService -> DB_MySQL : SELECT challenge_instances
ChallengeService -> DB_MySQL : SELECT challenge_templates
ChallengeService -> DB_MySQL : SELECT challenge_participants
alt erro
ChallengeService --> ChallengeController : 500 ERRO
ChallengeController --> P : 500 + mensagem
end
ChallengeService -> DB_MySQL : SELECT challenge_events
note over ChallengeService : … e mais 73 passos no código
deactivate ChallengeService
ChallengeService --> ChallengeController : resultado
ChallengeController --> P : 201 JSON
P --> U : atualiza a tela
@enduml
