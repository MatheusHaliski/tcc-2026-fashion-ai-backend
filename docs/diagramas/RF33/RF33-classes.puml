title RF33 — Passarela 3D: Look do Dia desfilando em manequins, Top 100 Global/Regional/País e filtros\nDiagrama de classes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "fai-domain (entidades JPA)" {
  class Follow <<follows>> {
    +id: UUID
    +follower: User
    +following: User
    +status: FollowStatus
    +respondedAt: Instant
  }
  class Brand <<brands>> {
    +id: UUID
    +name: String
    +slug: String
    +logoUrl: String
    +website: String
    +source: BrandSource
    +catalogOrigin: CatalogOrigin
    +fixtureKey: String
    +sourceConfidence: BigDecimal
    +verifiedAt: Instant
    .. +2 campos ..
  }
  class BrandProfile <<brand_profiles>> {
    +id: UUID
    +owner: User
    +brandName: String
    +slug: String
    +logoUrl: String
    +coverUrl: String
    +bio: String
    +storeUrl: String
    +cnpj: String
    +razaoSocial: String
    .. +21 campos ..
  }
  class DailyLook <<daily_looks>> {
    +id: UUID
    +user: User
    +scheme: Scheme
    +materializedFrom: DailyLook
    +lookDate: LocalDate
    +source: DailyLookSource
    +feedback: DailyLookFeedback
    +feedbackAt: Instant
    +weekPlanDayId: UUID
  }
  class Scheme <<schemes>> {
    +id: UUID
    +user: User
    +originalScheme: Scheme
    +title: String
    +description: String
    +creationMode: CreationMode
    +origin: SchemeOrigin
    +style: String
    +occasion: String
    +season: Season
    .. +46 campos ..
  }
  class SchemeItem <<scheme_items>> {
    +id: UUID
    +scheme: Scheme
    +wardrobeItem: WardrobeItem
    +slot: SchemeSlot
    +tryOnLayer: TryOnLayer
    +sortOrder: int
    +zIndex: int
    +positionX: BigDecimal
    +positionY: BigDecimal
    +scale: BigDecimal
    .. +4 campos ..
  }
  class User <<users>> {
    +id: UUID
    +username: String
    +displayName: String
    +email: String
    +emailHash: String
    +emailVerified: boolean
    +phone: String
    +birthDate: String
    +passwordHash: String
    +profileType: ProfileType
    .. +24 campos ..
  }
  class UserPreferences <<user_preferences>> {
    +id: UUID
    +user: User
    +theme: ThemeMode
    +language: UiLanguage
    +density: UiDensity
    +fontScale: int
    +highContrast: boolean
    +reduceMotion: boolean
    +chromeBackgroundId: String
    +sizeSystem: SizeSystem
    .. +16 campos ..
  }
  class WardrobeItem <<wardrobe_items>> {
    +id: UUID
    +user: User
    +brandProfile: BrandProfile
    +brand: Brand
    +name: String
    +category: String
    +subcategory: String
    +sex: String
    +brandName: String
    +brandLogoUrl: String
    .. +70 campos ..
  }
}
package "fai-domain (enums)" {
  enum FollowStatus {
    PENDENTE
    ACEITO
    BLOQUEADO
  }
  enum ApprovalStatus {
    PENDENTE
    AJUSTES
    APROVADO
    RECUSADO
    SUSPENSO
  }
  enum SchemeStatus {
    DRAFT
    PUBLISHED
    ARCHIVED
  }
  enum RenderStatus {
    PENDING
    RENDERING
    ENHANCING
    COMPOSITING
    CACHED
    COMPLETED
    FAILED
  }
  enum AccountStatus {
    PENDING_EMAIL_VERIFICATION
    ACTIVE
    PENDING_VALIDATION
    SUSPENDED
    DELETION_SCHEDULED
    DELETED
  }
  enum AvailabilityStatus {
    AVAILABLE
    UNAVAILABLE
    ARCHIVED
  }
}
package "fai-application" {
  class DailyLookService <<service>> {
    +history()
  }
}
DailyLookService ..> DailyLook : usa
DailyLookService ..> SchemeItem : usa
DailyLookService ..> User : usa
Brand "*" --> "1" BrandProfile : brandProfile
BrandProfile "1" --> "1" User : owner
BrandProfile --> ApprovalStatus
DailyLook "*" --> "1" Scheme : scheme
DailyLook "*" --> "1" User : user
Follow "*" --> "1" User : follower
Follow "*" --> "1" User : following
Follow --> FollowStatus
Scheme "*" --> "1" User : user
Scheme --> RenderStatus
Scheme --> SchemeStatus
SchemeItem "*" --> "1" Scheme : scheme
SchemeItem "*" --> "1" WardrobeItem : wardrobeItem
User --> AccountStatus
UserPreferences "1" --> "1" User : user
WardrobeItem "*" --> "1" Brand : brand
WardrobeItem "*" --> "1" BrandProfile : brandProfile
WardrobeItem "*" --> "1" User : user
WardrobeItem --> AvailabilityStatus
@enduml
