@startuml RF33_Classes
title RF33 — Passarela 3D: Look do Dia desfilando em manequins, Top 100 Global/Regional/País e filtros\nDiagrama de classes — entidades JPA reais (fai-domain) e enums
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  HeaderBackgroundColor #E4DEF0
}
skinparam packageStyle rectangle
hide empty methods

package "fai-domain · model" {
class User {
  +username: String
  +displayName: String
  +email: String
  +emailHash: String
  +emailVerified: boolean
  +phone: String
  +birthDate: String
  +passwordHash: String
  +profileType: ProfileType
  +role: String
  .. +20 campos ..
}
class DailyLook {
  +user: User
  +scheme: Scheme
  +materializedFrom: DailyLook
  +lookDate: LocalDate
  +source: DailyLookSource
  +feedback: DailyLookFeedback
  +feedbackAt: Instant
  +weekPlanDayId: UUID
}
class Scheme {
  +user: User
  +originalScheme: Scheme
  +title: String
  +description: String
  +creationMode: CreationMode
  +origin: SchemeOrigin
  +style: String
  +occasion: String
  +season: Season
  +mood: Mood
  +visibility: Visibility
  +status: SchemeStatus
  +displayMode: DisplayMode
  +disponivel: boolean
  .. +41 campos ..
}
class SchemeItem {
  +scheme: Scheme
  +wardrobeItem: WardrobeItem
  +slot: SchemeSlot
  +tryOnLayer: TryOnLayer
  +sortOrder: int
  +zIndex: int
  +positionX: BigDecimal
  +positionY: BigDecimal
  +scale: BigDecimal
  +rotation: BigDecimal
  +opacity: BigDecimal
  +filtersJson: String
  +snapshotJson: String
}
class WardrobeItem {
  +user: User
  +brandProfile: BrandProfile
  +brand: Brand
  +name: String
  +category: String
  +subcategory: String
  +sex: String
  +brandName: String
  +color: String
  +material: String
  +sizeLabel: String
  +market: String
  +styleTags: String
  +occasionTags: String
  .. +54 campos ..
}
class Follow {
  +follower: User
  +following: User
  +status: FollowStatus
  +respondedAt: Instant
}
class UserPreferences {
  +user: User
  +theme: ThemeMode
  +language: UiLanguage
  +density: UiDensity
  +fontScale: int
  +highContrast: boolean
  +reduceMotion: boolean
  +chromeBackgroundId: String
  +sizeSystem: SizeSystem
  +unitSystem: UnitSystem
  +mannequinSex: MannequinSex
  +mannequinSkinTone: String
  +mannequinBuild: BodyBuild
  +contentContainerColor: String
  .. +10 campos ..
}
}
package "fai-domain · enums" {
enum MannequinSex {
  MASCULINO
  FEMININO
}
}
DailyLook "*" --> "1" Scheme : scheme
DailyLook "*" --> "1" User : user
Follow "*" --> "1" User : follower
Follow "*" --> "1" User : following
Scheme "*" --> "1" User : user
SchemeItem "*" --> "1" Scheme : scheme
SchemeItem "*" --> "1" WardrobeItem : wardrobeItem
UserPreferences "1" --> "1" User : user
UserPreferences --> MannequinSex
WardrobeItem "*" --> "1" User : user
note top of User : tabela users
note top of DailyLook : tabela daily_looks
note top of Scheme : tabela schemes
note top of SchemeItem : tabela scheme_items
note top of WardrobeItem : tabela wardrobe_items
note top of Follow : tabela follows
note top of UserPreferences : tabela user_preferences
@enduml
