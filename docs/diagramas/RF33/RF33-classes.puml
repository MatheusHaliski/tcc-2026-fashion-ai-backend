@startuml RF33_Classes
title RF33 — Passarela 3D: o Look do Dia de cada usuário desfilando num manequim\nDiagrama de classes — serviço da Passarela, Look do Dia, manequim e HypeScore v2
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  HeaderBackgroundColor #E4DEF0
}
skinparam packageStyle rectangle
hide empty methods

package "fai-web" {
class ShowcaseController {
  +runway(viewer, limit, offset, ranking, region,\n  country, colors, occasions, styles, sex): Map
}
}
package "fai-application" {
class ShowcaseService {
  +RUNWAY_RANKINGS: List<String> {TOP100_GLOBAL,\n  TOP100_REGIONAL, TOP100_PAIS, SEGUINDO, EM_ALTA, RECENTES}
  ~RUNWAY_TOP = 100
  ~RUNWAY_MAX = 24
  +runway(viewer, RunwayFilter): Map
  ~entry(DailyLook): RunwayEntry
  ~{static} runwayOrder(ranking, hype): Comparator
  ~look(Scheme, viewer, HypeScoreCurrent): Map
  ~mannequin(User, peças, viewer): Map
  ~hypeOf(HypeEntityType, ids): Map<UUID, HypeScoreCurrent>
}
class "ShowcaseService.RunwayFilter" as RunwayFilter <<record>> {
  +ranking: String
  +region: String
  +country: String
  +colors: List<String>
  +occasions: List<String>
  +styles: List<String>
  +sex: String
  +limit: Integer
  +offset: Integer
}
class "ShowcaseService.RunwayEntry" as RunwayEntry <<record>> {
  +dl: DailyLook
  +country: String
  +region: String
  +colors: Set<String>
  +occasions: Set<String>
  +styles: Set<String>
  +sex: String
}
class DailyLookService {
  +register(user, Scheme, DailyLookSource, LocalDate): DailyLook
  +today(userId): Optional<DailyLook>
  +feedback(user, LocalDate, DailyLookFeedback): Map
}
class SearchService <<helpers estáticos>> {
  ~showcaseAllows(viewer, owner): boolean
  ~publicScore(HypeScoreCurrent): Double
  ~trendFor(HypeScoreCurrent, self): Double
  ~risingFor(HypeScoreCurrent, self): boolean
  ~hypeSummary(HypeScoreCurrent, self, cfg): Map
}
class WorldRegions <<taxonomy>> {
  +{static} of(country): String
  +{static} label(region): String
  +{static} codes(): List<String>
}
class Avatar3dService {
  +forMannequin(ownerId, viewerId): Optional<Map>
}
class HypeScoreConfig <<hype>> {
  +algorithmVersion(): String
  +staleAfterHours(): int
}
}
package "fai-domain · model" {
class DailyLook {
  +user: User
  +scheme: Scheme
  +materializedFrom: DailyLook
  +lookDate: LocalDate
  +source: DailyLookSource
  +feedback: DailyLookFeedback
}
class User {
  +username: String
  +status: AccountStatus
  +profileType: ProfileType
  +country: String
  +sex: MannequinSex
  +avatarUrl: String
  +runwayOptOut: boolean
  +isTestAccount(): boolean
}
class Scheme {
  +user: User
  +title: String
  +style: String
  +occasion: String
  +visibility: Visibility
  +status: SchemeStatus
  +likeCount: long
}
class SchemeItem {
  +scheme: Scheme
  +wardrobeItem: WardrobeItem
  +sortOrder: int
}
class WardrobeItem {
  +color: String
  +styleTags: String
  +occasionTags: String
  +imageUrl: String
  +model3dStatus: Model3dStatus
  +model3dUrl: String
}
class UserPreferences {
  +mannequinSex: MannequinSex
  +mannequinSkinTone: String
  +mannequinBuild: BodyBuild
  +mannequinFaceJson: String
}
class Follow {
  +follower: User
  +following: User
  +status: FollowStatus
}
class HypeScoreCurrent {
  +entityType: HypeEntityType
  +entityId: UUID
  +algorithmVersion: String
  +status: HypeStatus
  +score: BigDecimal
  +level: HypeLevel
  +dimensions: HypeDimensions
  +momentum: HypeMomentum
  +publicEligible: boolean
  +calculatedAt: Instant
}
}
package "fai-domain · enums" {
enum DailyLookSource {
  MANUAL
  AUTOPILOTO
  COPILOT
  VISTA_ME
  SMART_MIRROR
}
enum HypeMomentum {
  EMERGING
  RISING
  STABLE
  COOLING
  CLASSIC
}
enum HypeStatus {
  AVAILABLE
  INSUFFICIENT_DATA
}
enum MannequinSex {
  MASCULINO
  FEMININO
}
}
package "fai-domain · repository" {
interface DailyLookRepository {
  +findByLookDate(LocalDate): List<DailyLook>
  +findByLookDateGreaterThanEqual(LocalDate): List<DailyLook>
  +findByUserIdAndLookDate(userId, LocalDate): Optional<DailyLook>
}
interface HypeScoreCurrentRepository {
  +findByEntityTypeAndEntityIdInAndAlgorithmVersion(\n  HypeEntityType, ids, String): List<HypeScoreCurrent>
}
}
ShowcaseController --> ShowcaseService
ShowcaseService ..> RunwayFilter
ShowcaseService ..> RunwayEntry
ShowcaseService --> DailyLookService : today()
ShowcaseService --> DailyLookRepository
ShowcaseService --> HypeScoreCurrentRepository
ShowcaseService ..> SearchService
ShowcaseService ..> WorldRegions
ShowcaseService --> Avatar3dService : cabeça AVATAR
ShowcaseService ..> HypeScoreConfig
RunwayEntry --> "1" DailyLook
DailyLook "*" --> "1" User : user
DailyLook "*" --> "1" Scheme : scheme
DailyLook "0..1" --> "0..1" DailyLook : materializedFrom
DailyLook --> DailyLookSource
Scheme "*" --> "1" User : user
SchemeItem "*" --> "1" Scheme
SchemeItem "*" --> "1" WardrobeItem
UserPreferences "1" --> "1" User
UserPreferences --> MannequinSex
User --> MannequinSex
Follow "*" --> "1" User : follower
Follow "*" --> "1" User : following
HypeScoreCurrent ..> Scheme : entityId (SCHEME)
HypeScoreCurrent --> HypeMomentum
HypeScoreCurrent --> HypeStatus
DailyLookRepository ..> DailyLook
HypeScoreCurrentRepository ..> HypeScoreCurrent
note top of DailyLook : tabela daily_looks\n(único: user_id + look_date)
note top of HypeScoreCurrent : tabela hype_scores — gravada pelo job\nHypeSnapshotService e por HypeLiveRecalc;\na Passarela só lê
note bottom of User : tabela users (runway_opt_out na V16)
@enduml
