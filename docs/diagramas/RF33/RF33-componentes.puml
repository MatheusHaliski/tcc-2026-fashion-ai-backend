@startuml RF33_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF33 — Passarela 3D: Look do Dia desfilando em manequins, Top 100 Global/Regional/País e filtros\nDiagrama de componentes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "Frontend (Next.js)" {
  component "lib/api/client.ts" as APIC
}
package "fai-web (REST)" {
  component "ShowcaseController\n/api/explorer/runway" as ShowcaseController
  component "LookbookController\n/api/me/daily-looks" as LookbookController
}
package "fai-application (casos de uso)" {
  component "ShowcaseService" as ShowcaseService
  component "DailyLookService" as DailyLookService
  component "MediaService" as MediaService <<apoio>>
  component "SchemeService" as SchemeService <<apoio>>
  component "InstitutionalService" as InstitutionalService <<apoio>>
  component "Model3dService" as Model3dService <<apoio>>
  component "Avatar3dService" as Avatar3dService <<apoio>>
  component "HypeScoreConfig" as HypeScoreConfig <<apoio>>
}
package "fai-domain (repositórios)" {
  component "FollowRepository\nUserRepository\nSchemeRepository\nSchemeItemRepository\nWardrobeItemRepository\nSchemeGroupingRepository\nDailyLookRepository\nUserPreferencesRepository\nCelebrityProfileRepository\nHypeScoreCurrentRepository" as REPO_MySQL
}
database "MySQL\n• celebrity_profiles\n• daily_looks\n• follows\n• hype_scores\n• scheme_groupings\n• scheme_items\n• schemes\n• user_preferences\n• users\n• wardrobe_items" as DB_MySQL
component "Eventos de domínio\n(@TransactionalEventListener)" as EV
APIC --> LookbookController : HTTPS/JSON
APIC --> ShowcaseController : HTTPS/JSON
DailyLookService --> EV
DailyLookService --> REPO_MySQL
LookbookController --> DailyLookService
REPO_MySQL --> DB_MySQL : JPA/Flyway
ShowcaseController --> ShowcaseService
ShowcaseService --> REPO_MySQL
ShowcaseService ..> Avatar3dService
ShowcaseService ..> DailyLookService
ShowcaseService ..> HypeScoreConfig
ShowcaseService ..> InstitutionalService
ShowcaseService ..> MediaService
ShowcaseService ..> Model3dService
ShowcaseService ..> SchemeService
@enduml
