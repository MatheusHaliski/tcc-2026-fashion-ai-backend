@startuml RF33_MaquinaDeEstados_LookDoDia
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  StartColor #20A77A
  EndColor #4B5563
}
title RF33 — ciclo de vida de DailyLook.source e feedback\nDiagrama de máquina de estados — gerado do código em 2026-10-06 (scripts/diagramas/v5)\nenum DailyLookSource · enum DailyLookFeedback · tabela daily_looks

state "DailyLook.source" as Ciclo_DailyLook {
  state Ciclo_DailyLook_MANUAL as "MANUAL"
  state Ciclo_DailyLook_AUTOPILOTO as "AUTOPILOTO"
  state Ciclo_DailyLook_COPILOT as "COPILOT"
  state Ciclo_DailyLook_VISTA_ME as "VISTA_ME"
  state Ciclo_DailyLook_SMART_MIRROR as "SMART_MIRROR"
}
[*] --> Ciclo_DailyLook_MANUAL : criação
note bottom of Ciclo_DailyLook
  Recebe o valor escolhido em: register(source)
end note
state "DailyLook.feedback" as Ciclo_DailyLook_feedback {
  state Ciclo_DailyLook_feedback_ADOREI as "ADOREI"
  state Ciclo_DailyLook_feedback_NAO_USEI as "NAO_USEI"
  state Ciclo_DailyLook_feedback_NAO_GOSTEI as "NAO_GOSTEI"
}
Ciclo_DailyLook_feedback --> Ciclo_DailyLook_feedback_ADOREI : feedback()\nPUT /api/me/daily-looks/{date}/feedback
Ciclo_DailyLook_feedback --> Ciclo_DailyLook_feedback_NAO_USEI : feedback()\nPUT /api/me/daily-looks/{date}/feedback
Ciclo_DailyLook_feedback --> Ciclo_DailyLook_feedback_NAO_GOSTEI : feedback()\nPUT /api/me/daily-looks/{date}/feedback
note right of Ciclo_DailyLook
  Setas que saem da borda: a mudança vale
  a partir de qualquer estado (o código não
  testa o estado anterior).
end note
@enduml
