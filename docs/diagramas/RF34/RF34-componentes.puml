@startuml RF34_Componentes
title RF34 — Eras da celebridade: busca por era, Insights de Eras e My Stage 3D\nDiagrama de componentes — aba Eras (React Three Fiber) → ShowcaseController/LookbookController → serviços → MySQL e storage
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam interface {
  BackgroundColor #FFF5F8
  BorderColor #4A4852
}
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
left to right direction

package "Frontend (Next.js · brands/[slug] › aba Eras)" {
  component "components/showcase/showcase-tabs.tsx\nErasTab · GroupingSearch · GroupingForm ·\nAssignDialog · ErasInsights · MiniStage2D (SVG) ·\nMyStage · StageFallback" as FE0
  component "components/three/stage-scene.tsx\n(StageScene: palco, telão LED, feixes, plateia)" as FE1
  component "components/three/mannequin.tsx ·\navatar-bust.tsx · common.tsx\n(useWebGL, useReducedMotion)" as FE2
  component "three · @react-three/fiber · drei\n(carregados sob demanda)" as LIB
}

package "fai-web · controllers" {
  [ShowcaseController\nGET /api/institutional/{slug}/showcase/{kind}\nGET …/showcase/{kind}/items · …/insights\nGET /api/institutional/{slug}/stage\nPOST /api/groupings/{id}/cover] as SC
  [LookbookController\nPOST /api/groupings · PUT/DELETE /api/groupings/{id}\nPOST /api/groupings/{id}/items] as LC
  [SchemeController · WardrobeController\nGET /api/me/schemes · GET /api/me/closet] as MC
}

package "fai-application" {
  [ShowcaseService\nlist · items · insights · stage ·\ngroupingCover · look · mannequin] as S
  [LookbookService\ncreate/update/delete/assignToGrouping] as LS
  [InstitutionalService\ninstitutionalUser] as IS
  [SchemeService · Guard\ncanView · view · requireOwner] as G
  [SearchService (helpers)\nscoreFor · growthFor · trendFor · hypeRows] as SH
  [Avatar3dService (RF40)\nforMannequin] as AV
  [MediaService · OwnMedia\nImageOps (1800×1200, JPEG)] as M
  interface "MediaStoragePort" as MSP <<port>>
}

package "fai-domain · repository (JPA)" {
  [SchemeGroupingRepository · SchemeRepository\nSchemeItemRepository · WardrobeItemRepository\nCelebrityProfileRepository · UserPreferencesRepository\nHypeScoreCurrentRepository · UserAvatar3dRepository] as REPOS
}

package "fai-infrastructure" {
  [S3MediaStorageAdapter /\nLocalFileMediaStorage] as STO
}

database "MySQL\n• scheme_groupings (cover_url · period_from/to,\n  accent_color, sort_order — V16)\n• schemes.grouping_id · wardrobe_items.grouping_id\n• celebrity_profiles · users (sex) · user_preferences\n• hype_scores · user_avatars_3d" as DB
database "Objetos de mídia\n(S3/R2 ou disco local)" as OBJ

FE0 --> SC : eras · items · insights · stage · cover
FE0 --> LC : criar/editar/excluir era · ligar itens
FE0 --> MC : lista para ligar
FE0 --> FE1 : dynamic(), sem SSR
FE1 --> FE2
FE1 --> LIB
SC --> S
LC --> LS
S --> IS : owner(slug, ERAS)
S --> G
S ..> SH
S --> AV
S --> M
S --> REPOS
LS --> G
LS --> M : OwnMedia.require(coverUrl)
LS --> REPOS
AV --> REPOS
M --> MSP
MSP <|.. STO
STO --> OBJ
REPOS --> DB : JPA · Flyway

note bottom of S
  Tudo é leitura de dados existentes: a cena 3D roda no
  navegador. Ranking calculado na hora (sem tabela nova).
  Trello pede celebrity_eras + era_id: o código usa
  scheme_groupings (ERA · PHASE · TOUR) + grouping_id.
end note
@enduml
