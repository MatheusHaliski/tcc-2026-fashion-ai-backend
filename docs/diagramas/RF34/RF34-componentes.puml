@startuml RF34_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF34 — Explorar as 'Eras' de uma celebridade: busca por era, Insights de Eras e My Stage 3D\nDiagrama de componentes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "Frontend (Next.js)" {
  component "/brands/[slug]\n(site)/(app)/brands/[slug]/page.tsx" as FE0
  component "lib/api/client.ts" as APIC
}
package "fai-web (REST)" {
  component "ProfileController\n/api/institutional/{…}\n/api/institutional/{…}/store\n/api/institutional/{…}/tabs/{…}\n/api/me/celebrity-profile" as ProfileController
  component "ShowcaseController\n/api/groupings/{…}/cover\n/api/institutional/{…}/showcase/{…}\n/api/institutional/{…}/showcase/{…}/insights\n/api/institutional/{…}/showcase/{…}/items\n(+1 rotas)" as ShowcaseController
  component "WardrobeController\n/api/pieces/{…}/worn" as WardrobeController
}
package "fai-application (casos de uso)" {
  component "InstitutionalService" as InstitutionalService
  component "ShowcaseService" as ShowcaseService
  component "WardrobeService" as WardrobeService
  component "SchemeService" as SchemeService <<apoio>>
  component "SealService" as SealService <<apoio>>
  component "HypeQueryService" as HypeQueryService <<apoio>>
  component "MediaService" as MediaService <<apoio>>
  component "DailyLookService" as DailyLookService <<apoio>>
  component "Model3dService" as Model3dService <<apoio>>
  component "Avatar3dService" as Avatar3dService <<apoio>>
  component "HypeScoreConfig" as HypeScoreConfig <<apoio>>
  component "JobQueuePort\n«InMemoryJobQueue»" as JobQueuePort <<port>>
}
package "fai-domain (repositórios)" {
  component "UserRepository\nBrandProfileRepository\nCelebrityProfileRepository\nFollowRepository\nSealRepository\nSealBondRepository\nSchemeRepository\nSchemeItemRepository\nWardrobeItemRepository\nSavedItemRepository\n(+12)" as REPO_MySQL
}
database "MySQL\n• brand_profiles\n• brands\n• celebrity_profiles\n• daily_looks\n• follows\n• hype_scores\n• moderation_queue\n• photos\n• pipeline_jobs\n• processing_jobs_log\n• quality_scores\n• reactions\n(+10)" as DB_MySQL
cloud "Motor de IA (RF24)\nprovedores externos + reserva local" as AI
component "Eventos de domínio\n(@TransactionalEventListener)" as EV
APIC --> ProfileController : HTTPS/JSON
APIC --> ShowcaseController : HTTPS/JSON
APIC --> WardrobeController : HTTPS/JSON
FE0 --> APIC
InstitutionalService --> AI
InstitutionalService --> REPO_MySQL
InstitutionalService ..> HypeQueryService
InstitutionalService ..> SchemeService
InstitutionalService ..> SealService
ProfileController --> InstitutionalService
REPO_MySQL --> DB_MySQL : JPA/Flyway
ShowcaseController --> ShowcaseService
ShowcaseService --> REPO_MySQL
ShowcaseService ..> Avatar3dService
ShowcaseService ..> DailyLookService
ShowcaseService ..> HypeScoreConfig
ShowcaseService ..> InstitutionalService
ShowcaseService ..> MediaService
ShowcaseService ..> Model3dService
ShowcaseService ..> SchemeService
WardrobeController --> WardrobeService
WardrobeService --> AI
WardrobeService --> EV
WardrobeService --> JobQueuePort
WardrobeService --> REPO_MySQL
WardrobeService ..> MediaService
WardrobeService ..> Model3dService
@enduml
