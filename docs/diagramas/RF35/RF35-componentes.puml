@startuml RF35_Componentes
title RF35 — Coleções da marca: busca por coleção e Collections Insights com mini lojas 3D\nDiagrama de componentes — aba Coleções (React Three Fiber) → ShowcaseController/LookbookController → serviços → MySQL e storage
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam interface {
  BackgroundColor #FFF5F8
  BorderColor #4A4852
}
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
left to right direction

package "Frontend (Next.js · brands/[slug] › aba Coleções)" {
  component "components/showcase/showcase-tabs.tsx\nCollectionsTab · GroupingSearch · GroupingForm ·\nAssignDialog · CollectionsInsights · GroupHypeValue" as FE0
  component "components/three/store-street-scene.tsx\n(StoreStreetScene: Store, Sign, Awning,\nRankBadge, Crowd, Fireworks)" as FE1
  component "components/three/common.tsx\n(useWebGL, useReducedMotion, texturas)" as FE2
  component "three · @react-three/fiber · drei\n(carregados sob demanda)" as LIB
}

package "fai-web · controllers" {
  [ShowcaseController\nGET /api/institutional/{slug}/showcase/collections\nGET …/collections/items · …/collections/insights\nPOST /api/groupings/{id}/cover] as SC
  [LookbookController\nPOST /api/groupings · PUT/DELETE /api/groupings/{id}\nPOST /api/groupings/{id}/items] as LC
  [SchemeController · WardrobeController\nGET /api/me/schemes · GET /api/me/closet] as MC
}

package "fai-application" {
  [ShowcaseService\nlist · items · insights · groupingCover] as S
  [LookbookService\ncreate/update/delete/assignToGrouping] as LS
  [InstitutionalService\ninstitutionalUser · coverLabel do perfil] as IS
  [SchemeService · Guard\ncanView · view · requireOwner] as G
  [SearchService (helpers)\nscoreFor · growthFor · trendFor · hypeRows] as SH
  [MediaService · OwnMedia · ImageOps] as M
  interface "MediaStoragePort" as MSP <<port>>
}

package "fai-domain · repository (JPA)" {
  [SchemeGroupingRepository · SchemeRepository\nSchemeItemRepository · WardrobeItemRepository\nHypeScoreCurrentRepository · UserRepository] as REPOS
}

package "fai-infrastructure" {
  [S3MediaStorageAdapter /\nLocalFileMediaStorage] as STO
}

database "MySQL\n• scheme_groupings (type COLLECTION, cover_url,\n  period_from/to, accent_color, sort_order)\n• schemes.grouping_id · wardrobe_items.grouping_id\n• brand_profiles · users · hype_scores" as DB
database "Objetos de mídia\n(S3/R2 ou disco local)" as OBJ

FE0 --> SC : collections · items · insights · cover
FE0 --> LC : criar/editar/excluir coleção · ligar itens
FE0 --> MC : lista para ligar
FE0 --> FE1 : dynamic(), sem SSR (até 7 lojas)
FE1 --> FE2
FE1 --> LIB
SC --> S
LC --> LS
S --> IS : owner(slug, COLLECTIONS)
S --> G
S ..> SH
S --> M
S --> REPOS
LS --> G
LS --> M : OwnMedia.require(coverUrl)
LS --> REPOS
M --> MSP
MSP <|.. STO
STO --> OBJ
REPOS --> DB : JPA · Flyway

note bottom of S
  Mesmo serviço e mesma fórmula das Eras (RF34), com
  Kind COLLECTIONS: só MARCA, só type COLLECTION,
  público de 80 e fogos nas 4 primeiras (fraction ≥ 0,25).
  Trello pede brand_collections + collection_id: o código
  usa scheme_groupings + grouping_id.
end note
@enduml
