@startuml RF35_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF35 — Explorar as 'Coleções' de uma marca: busca por coleção, Collections Insights e mini lojas 3D\nDiagrama de componentes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "Frontend (Next.js)" {
  component "/brands/[slug]\n(site)/(app)/brands/[slug]/page.tsx" as FE0
  component "/u/[username]\n(site)/(app)/u/[username]/page.tsx" as FE1
  component "lib/api/client.ts" as APIC
}
package "fai-web (REST)" {
  component "LookbookController\n/api/users/{…}/groupings" as LookbookController
  component "ProfileController\n/api/brands\n/api/celebrities\n/api/institutional/{…}\n/api/institutional/{…}/store\n(+3 rotas)" as ProfileController
  component "ShowcaseController\n/api/groupings/{…}/cover\n/api/institutional/{…}/showcase/{…}\n/api/institutional/{…}/showcase/{…}/insights\n/api/institutional/{…}/showcase/{…}/items\n(+1 rotas)" as ShowcaseController
}
package "fai-application (casos de uso)" {
  component "LookbookService" as LookbookService
  component "InstitutionalService" as InstitutionalService
  component "ShowcaseService" as ShowcaseService
  component "WardrobeService" as WardrobeService <<apoio>>
  component "SchemeService" as SchemeService <<apoio>>
  component "SocialService" as SocialService <<apoio>>
  component "DailyLookService" as DailyLookService <<apoio>>
  component "HypeScoreService" as HypeScoreService <<apoio>>
  component "OwnMedia" as OwnMedia <<apoio>>
  component "SealService" as SealService <<apoio>>
  component "HypeQueryService" as HypeQueryService <<apoio>>
}
package "fai-domain (repositórios)" {
  component "SchemeRepository\nSchemeItemRepository\nWardrobeItemRepository\nSavedItemRepository\nUserRepository\nAcervoGroupRepository\nSchemeGroupingRepository\nBrandProfileRepository\nCelebrityProfileRepository\nFollowRepository\n(+7)" as REPO_MySQL
}
database "MySQL\n• acervo_groups\n• brand_profiles\n• celebrity_profiles\n• daily_looks\n• follows\n• hype_scores\n• reactions\n• saved_items\n• scheme_groupings\n• scheme_items\n• schemes\n• seal_bonds\n(+5)" as DB_MySQL
cloud "Motor de IA (RF24)\nprovedores externos + reserva local" as AI
APIC --> LookbookController : HTTPS/JSON
APIC --> ProfileController : HTTPS/JSON
APIC --> ShowcaseController : HTTPS/JSON
FE0 --> APIC
FE1 --> APIC
InstitutionalService --> AI
InstitutionalService --> REPO_MySQL
InstitutionalService ..> HypeQueryService
InstitutionalService ..> SchemeService
InstitutionalService ..> SealService
LookbookController --> LookbookService
LookbookService --> AI
LookbookService --> REPO_MySQL
LookbookService ..> DailyLookService
LookbookService ..> HypeScoreService
LookbookService ..> OwnMedia
LookbookService ..> SchemeService
LookbookService ..> SocialService
LookbookService ..> WardrobeService
ProfileController --> InstitutionalService
REPO_MySQL --> DB_MySQL : JPA/Flyway
ShowcaseController --> ShowcaseService
ShowcaseService --> REPO_MySQL
ShowcaseService ..> DailyLookService
ShowcaseService ..> InstitutionalService
ShowcaseService ..> SchemeService
@enduml
