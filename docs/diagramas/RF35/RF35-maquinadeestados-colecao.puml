@startuml RF35_MaquinaDeEstados_Colecao
!pragma layout smetana
title RF35 — Coleções da marca: busca por coleção e Collections Insights com mini lojas 3D\nDiagrama de máquina de estados — coleção da marca (scheme_groupings type COLLECTION) e sua mini loja no ranking
skinparam backgroundColor #FFFFFF
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  ArrowColor #52606D
}
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
[*] --> Vazia : POST /api/groupings {type: COLLECTION, label, período, cor}\n(perfil MARCA — LookbookService.BRAND)
state "Sem itens\n(loja vazia no ranking, pontuação 0)" as Vazia
state "Com itens\n(schemes/wardrobe_items.grouping_id = coleção)" as ComItens {
  [*] --> ArteAuto
  state "Vitrine automática\n(capa do look de maior Hype v2\nou foto de peça — coverSource esquema)" as ArteAuto
  state "Vitrine com a arte da coleção\n(coverSource upload)" as ArteUpload
  ArteAuto --> ArteUpload : POST /api/groupings/{id}/cover
}
state "Mini loja em Collections Insights" as Loja {
  state "Pódio com fogos\n(posições 1–4 com fraction ≥ 0,25:\nfogos = 4 − posição, público grande)" as Podio
  state "Demais lojas\n(público = fraction × 80, sem fogos)" as Demais
  Demais --> Podio : sobe no ranking
  Podio --> Demais : outra coleção ultrapassa\nou fraction < 0,25
}

Vazia --> Vazia : POST …/cover · PUT /api/groupings/{id}\n(label, descrição, período, cor, ordem)
Vazia --> ComItens : POST /api/groupings/{id}/items {schemeIds, pieceIds}
ComItens --> Vazia : todos os itens ligados a outra coleção\n(não há endpoint só para desligar)
ComItens --> Loja : GET …/showcase/collections/insights\n(calculado na hora, sem tabela de ranking)
Loja --> ComItens : curtidas e itens mudam (nova leitura reordena)
Vazia --> [*] : DELETE /api/groupings/{id}
ComItens --> [*] : DELETE /api/groupings/{id}\n(looks e peças ficam, grouping_id = NULL)

note right of Loja
  score = 0,75·curtidas/máx + 0,25·itens/máx (×100).
  O 1º lugar fica no centro da rua e maior (escala 1,3).
  O frontend mostra só as 7 primeiras lojas em 3D e até
  90 pessoas por loja. Hype v2 à parte (top, média, faixa).
end note
@enduml
