@startuml RF35_Sequencia
title RF35 — Coleções da marca: busca por coleção e Collections Insights com mini lojas 3D\nDiagrama de sequência — busca por coleção, ranking em mini lojas 3D e arte da coleção
skinparam backgroundColor #FFFFFF
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
}
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
autonumber
actor "Pessoa" as U
actor "Marca (dona)" as M
participant "CollectionsTab\n(showcase-tabs.tsx)" as FE
participant "StoreStreetScene\n(three · R3F)" as ST
participant "ShowcaseController" as C
participant "LookbookController" as LC
participant "ShowcaseService" as S
participant "LookbookService" as LS
participant "InstitutionalService ·\nSchemeService · Guard" as G
database "MySQL" as DB
database "MediaStoragePort\n(S3 / disco)" as MS

== Coleções (busca) ==
U -> FE: aba "Coleções"
FE -> C: GET /api/institutional/{slug}/showcase/collections
C -> S: list(viewer, slug, COLLECTIONS)
S -> G: institutionalUser(slug)
alt não é perfil institucional ou não é MARCA
  S --> FE: 404 ("Coleções só em perfis de marca")
else
  S -> DB: scheme_groupings (COLLECTION) · schemes · wardrobe_items do dono
  S -> G: canView (look e peça) — visibilidade × perfil × bloqueio
  S -> DB: hype_scores (SCHEME)
  S --> FE: 200 {items [{label, period, accentColor, coverUrl, coverSource,\nschemes, pieces}], ungrouped}
end
U -> FE: escolhe "Resort 2026", texto, ano, tipo e ordem
FE -> C: GET …/showcase/collections/items?groupingId&q&type&sort&year
C -> S: items(viewer, slug, COLLECTIONS, …)
alt groupingId não é coleção da marca
  S --> FE: 404 Coleção
else
  S -> S: filtra · order(HYPE | GROWTH | CURTIDAS | RECENTES)
  S --> FE: 200 {header (arte da coleção), schemes ≤ 60, pieces ≤ 60, years, sorts}
end

== Collections Insights (mini lojas 3D) ==
U -> FE: Collections Insights
FE -> C: GET …/showcase/collections/insights
C -> S: insights(viewer, slug, COLLECTIONS)
S -> DB: looks e peças visíveis · hype_scores (SCHEME, PIECE)
S -> S: por coleção: likes, items, comments, shares, groupHype, topScheme
S -> S: score = 0,75·likes/máx + 0,25·itens/máx · rank\naudience = fraction × 80 · fireworks = máx(0, 4 − i) se fraction ≥ 0,25
S --> FE: 200 {ranking [{id, label, rank, score, audience, capacity 80,\naudienceFraction, fireworks, spotlights, hype, coverUrl}], mostLiked, mostHype, method}
alt WebGL disponível
  FE -> ST: stores = 7 primeiras {label, rank, audience, fraction, fireworks,\naccentColor, artUrl = coverUrl, score}
  ST -> ST: rua em arco (1º no centro, maior), arte na vitrine,\nnome no letreiro, público (≤ 90) e fogos
  U -> ST: clica numa loja
  ST -> FE: onPick(id) → card da coleção escolhida
else sem WebGL
  FE -> FE: aviso + só a lista ranqueada
end

== Arte da coleção (dona) ==
M -> FE: "Nova coleção" (GroupingForm) e depois "Arte da coleção"
FE -> LC: POST /api/groupings {type: COLLECTION, label, período, cor}
LC -> LS: createGrouping(user, form)
LS --> FE: 201 (ou 400 TIPO_INVALIDO / PERIODO_INVALIDO / COR_INVALIDA)
FE -> C: POST /api/groupings/{id}/cover (multipart)
C -> S: groupingCover(user, id, bytes)
S -> G: requireCanCreate · requireOwner (403 se não é a dona)
S -> MS: put(cover-….jpg — 1800×1200, JPEG 0,9)
S -> DB: UPDATE scheme_groupings SET cover_url
S --> FE: 200 {id, coverUrl}
FE -> LC: POST /api/groupings/{id}/items {schemeIds, pieceIds}
LC -> LS: assignToGrouping(…)
LS -> DB: UPDATE schemes / wardrobe_items SET grouping_id
@enduml
