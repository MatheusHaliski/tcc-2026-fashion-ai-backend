@startuml RF36_Classes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  StereotypeFontColor #6B6470
}
hide empty members
left to right direction
title RF36 — 'Foto com meu manequim': peça (RF4) ou look inteiro (RF5) no manequim com rosto 3D da foto de perfil\nDiagrama de classes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "fai-domain (entidades JPA)" {
  class Brand <<brands>> {
    +id: UUID
    +name: String
    +slug: String
    +logoUrl: String
    +website: String
    +source: BrandSource
    +catalogOrigin: CatalogOrigin
    +fixtureKey: String
    +sourceConfidence: BigDecimal
    +verifiedAt: Instant
    .. +2 campos ..
  }
  class BrandProfile <<brand_profiles>> {
    +id: UUID
    +owner: User
    +brandName: String
    +slug: String
    +logoUrl: String
    +coverUrl: String
    +bio: String
    +storeUrl: String
    +cnpj: String
    +razaoSocial: String
    .. +21 campos ..
  }
  class Scheme <<schemes>> {
    +id: UUID
    +user: User
    +originalScheme: Scheme
    +title: String
    +description: String
    +creationMode: CreationMode
    +origin: SchemeOrigin
    +style: String
    +occasion: String
    +season: Season
    .. +46 campos ..
  }
  class SchemeItem <<scheme_items>> {
    +id: UUID
    +scheme: Scheme
    +wardrobeItem: WardrobeItem
    +slot: SchemeSlot
    +tryOnLayer: TryOnLayer
    +sortOrder: int
    +zIndex: int
    +positionX: BigDecimal
    +positionY: BigDecimal
    +scale: BigDecimal
    .. +4 campos ..
  }
  class User <<users>> {
    +id: UUID
    +username: String
    +displayName: String
    +email: String
    +emailHash: String
    +emailVerified: boolean
    +phone: String
    +birthDate: String
    +passwordHash: String
    +profileType: ProfileType
    .. +24 campos ..
  }
  class UserPreferences <<user_preferences>> {
    +id: UUID
    +user: User
    +theme: ThemeMode
    +language: UiLanguage
    +density: UiDensity
    +fontScale: int
    +highContrast: boolean
    +reduceMotion: boolean
    +chromeBackgroundId: String
    +sizeSystem: SizeSystem
    .. +16 campos ..
  }
  class WardrobeItem <<wardrobe_items>> {
    +id: UUID
    +user: User
    +brandProfile: BrandProfile
    +brand: Brand
    +name: String
    +category: String
    +subcategory: String
    +sex: String
    +brandName: String
    +brandLogoUrl: String
    .. +70 campos ..
  }
}
package "fai-domain (enums)" {
  enum ApprovalStatus {
    PENDENTE
    AJUSTES
    APROVADO
    RECUSADO
    SUSPENSO
  }
  enum SchemeStatus {
    DRAFT
    PUBLISHED
    ARCHIVED
  }
  enum RenderStatus {
    PENDING
    RENDERING
    ENHANCING
    COMPOSITING
    CACHED
    COMPLETED
    FAILED
  }
  enum AccountStatus {
    PENDING_EMAIL_VERIFICATION
    ACTIVE
    PENDING_VALIDATION
    SUSPENDED
    DELETION_SCHEDULED
    DELETED
  }
  enum AvailabilityStatus {
    AVAILABLE
    UNAVAILABLE
    ARCHIVED
  }
  enum ModerationStatus {
    PENDING
    APPROVED
    REJECTED_POLICY
    REJECTED_NOT_CLOTHING
  }
}
package "fai-application" {
  class SchemeService <<service>> {
    +builder()
    +compose()
    +create()
    +suggestSealsAfterSave()
    +uploadLookPhoto()
    +preview()
    +get()
    +update()
    +publish()
    +archive()
  }
}
SchemeService ..> Scheme : usa
SchemeService ..> SchemeItem : usa
SchemeService ..> User : usa
SchemeService ..> WardrobeItem : usa
Brand "*" --> "1" BrandProfile : brandProfile
BrandProfile "1" --> "1" User : owner
BrandProfile --> ApprovalStatus
Scheme "*" --> "1" User : user
Scheme --> RenderStatus
Scheme --> SchemeStatus
SchemeItem "*" --> "1" Scheme : scheme
SchemeItem "*" --> "1" WardrobeItem : wardrobeItem
User --> AccountStatus
UserPreferences "1" --> "1" User : user
WardrobeItem "*" --> "1" Brand : brand
WardrobeItem "*" --> "1" BrandProfile : brandProfile
WardrobeItem "*" --> "1" User : user
WardrobeItem --> AvailabilityStatus
WardrobeItem --> ModerationStatus
@enduml
