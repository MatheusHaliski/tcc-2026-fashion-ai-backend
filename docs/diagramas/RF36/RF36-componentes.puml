@startuml RF36_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF36 — 'Foto com meu manequim': peça (RF4) ou look inteiro (RF5) no manequim com rosto 3D da foto de perfil\nDiagrama de componentes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "Frontend (Next.js)" {
  component "/schemes/[id]/edit\n(site)/(app)/schemes/[id]/edit/page.tsx" as FE0
  component "/schemes/new\n(site)/(app)/schemes/new/page.tsx" as FE1
  component "lib/api/client.ts" as APIC
}
package "fai-web (REST)" {
  component "SchemeController\n/api/schemes\n/api/schemes/builder\n/api/schemes/compositions\n/api/schemes/photos\n(+3 rotas)" as SchemeController
  component "ShowcaseController\n/api/pieces/{…}/mannequin-photo\n/api/schemes/{…}/mannequin-photo\n/api/{…}/{…}/mannequin-photo" as ShowcaseController
}
package "fai-application (casos de uso)" {
  component "SchemeService" as SchemeService
  component "CopilotService" as CopilotService
  component "LookPreviewService" as LookPreviewService
  component "ShowcaseService" as ShowcaseService
  component "WardrobeService" as WardrobeService <<apoio>>
  component "BackgroundStudioService" as BackgroundStudioService <<apoio>>
  component "SealService" as SealService <<apoio>>
  component "SchemeCardRenderer" as SchemeCardRenderer <<apoio>>
  component "ProjectionService" as ProjectionService <<apoio>>
  component "NotificationService" as NotificationService <<apoio>>
  component "MediaService" as MediaService <<apoio>>
  component "DailyLookService" as DailyLookService <<apoio>>
  component "CounterStorePort\n«InMemoryCounterStore»" as CounterStorePort <<port>>
}
package "fai-domain (repositórios)" {
  component "SchemeRepository\nSchemeItemRepository\nWardrobeItemRepository\nUserRepository\nReactionRepository\nSavedItemRepository\nStyleDnaRepository\nHypeScoreCurrentRepository\nDailyLookRepository\nUserPreferencesRepository\n(+3)" as REPO_MySQL
}
database "MySQL\n• celebrity_profiles\n• daily_looks\n• follows\n• hype_scores\n• reactions\n• saved_items\n• scheme_groupings\n• scheme_items\n• schemes\n• style_dna\n• user_preferences\n• users\n(+1)" as DB_MySQL
cloud "Motor de IA (RF24)\nprovedores externos + reserva local" as AI
component "Eventos de domínio\n(@TransactionalEventListener)" as EV
APIC --> SchemeController : HTTPS/JSON
APIC --> ShowcaseController : HTTPS/JSON
CopilotService --> AI
CopilotService --> REPO_MySQL
CopilotService ..> BackgroundStudioService
CopilotService ..> DailyLookService
CopilotService ..> SchemeService
CopilotService ..> WardrobeService
FE0 --> APIC
FE1 --> APIC
LookPreviewService --> REPO_MySQL
REPO_MySQL --> DB_MySQL : JPA/Flyway
SchemeController --> CopilotService
SchemeController --> LookPreviewService
SchemeController --> SchemeService
SchemeService --> AI
SchemeService --> CounterStorePort
SchemeService --> EV
SchemeService --> REPO_MySQL
SchemeService ..> BackgroundStudioService
SchemeService ..> DailyLookService
SchemeService ..> MediaService
SchemeService ..> NotificationService
SchemeService ..> ProjectionService
SchemeService ..> SchemeCardRenderer
SchemeService ..> SealService
SchemeService ..> WardrobeService
ShowcaseController --> ShowcaseService
ShowcaseService --> REPO_MySQL
ShowcaseService ..> DailyLookService
ShowcaseService ..> MediaService
ShowcaseService ..> SchemeService
@enduml
