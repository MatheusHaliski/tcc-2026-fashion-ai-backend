@startuml RF36_Componentes
title RF36 — Foto com meu manequim (peça do RF4 ou look do RF5)\nDiagrama de componentes — diálogo com Three.js → ShowcaseController → ShowcaseService → MySQL e storage de mídia
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam interface {
  BackgroundColor #FFF5F8
  BorderColor #4A4852
}
left to right direction

package "Frontend (Next.js · Three.js)" {
  component "pieces/[id]/page.tsx · schemes/[id]/page.tsx\n→ expanded-card.tsx (ExpandedPiece: menu;\nExpandedScheme: MannequinPhotoButton)" as Pages
  component "mannequin-photo.tsx\n(MannequinPhotoDialog)" as Dialog
  component "three/look-viewer.tsx (LookViewer)\n+ three/mannequin.tsx · common.tsx (useWebGL)" as Viewer
  component "look-exports.tsx\n(capa = coverImageUrl ?? mannequinImageUrl)" as Exports
}
package "fai-web" {
  [ShowcaseController\nGET /api/{pieces|schemes}/{id}/look3d\nPOST /api/{pieces|schemes}/{id}/mannequin-photo\nDELETE /api/{pieces|schemes}/{id}/mannequin-photo] as Ctl
  [Uploads.image\n(multipart)] as Up
}
package "fai-application" {
  [ShowcaseService\n(look3d, piece3d, mannequinBase,\npiece/schemeMannequinPhoto, faceOf)] as Svc
  [Avatar3dService (RF40)\nforMannequin] as Av
  [SchemeService\n(owned, canView)] as Sch
  [Guard] as G
  [ImageOps\n(requireAcceptedImage,\nscaleToFit, jpeg)] as Img
  [MediaService] as Media
  [PreferencesService\n(PATCH /api/me/profile:\nmannequinFace)] as Pref
  interface "MediaStoragePort" as MSP <<port>>
}
package "fai-domain" {
  [WardrobeItemRepository · SchemeRepository ·\nSchemeItemRepository · UserPreferencesRepository ·\nUserAvatar3dRepository] as Repos
}
package "fai-infrastructure" {
  database "MySQL\nwardrobe_items · schemes · scheme_items ·\nusers · user_preferences · user_avatars_3d" as DB
  [S3MediaStorageAdapter /\nLocalFileMediaStorage\nusers/{id}/{pieces|schemes}/{id}/mannequin-*.jpg] as ST
}

Pages --> Dialog
Dialog --> Viewer
Pages --> Exports
Dialog --> Ctl : look3d · mannequin-photo (POST/DELETE)
Ctl --> Up
Ctl --> Svc
Svc --> Av
Svc --> Sch
Svc --> G
Svc --> Img
Svc --> Media
Svc --> Repos
Av --> Repos
Pref --> Repos
Media --> MSP
MSP <|.. ST
Repos --> DB : JPA
@enduml
