@startuml RF36_MaquinaDeEstados_FotoManequim
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  ArrowColor #52606D
}
title RF36 — Foto com meu manequim: mannequin_image_url da peça (RF4) ou do esquema (RF5)
[*] --> SemFoto : peça/esquema criado
state "Sem foto\n(mannequinImageUrl = null)" as SemFoto
state "Manequim montado no cliente\n(GET /api/pieces/{id}/look3d · GET /api/schemes/{id}/look3d)" as Montado {
  state "rosto da foto de perfil\n(face = avatar)" as ComRosto
  state "manequim padrão\n(MASCULINO | FEMININO pelo sexo do RF1)" as Padrao
  Padrao --> ComRosto : usuário cadastra foto de perfil (RF1/RF23)
  ComRosto --> ComRosto : PUT /api/me/preferences (ajuste do rosto)
}
state "Foto gerada e guardada\n(storage próprio, mannequinImageFace)" as Gerada
state "Capa do post do esquema\n(schemes.cover_image_url = foto)" as Capa
SemFoto --> Montado : botão "Foto com meu manequim"\nno detalhe da peça/esquema
Montado --> Gerada : POST /api/pieces/{id}/mannequin-photo\nPOST /api/schemes/{id}/mannequin-photo (PNG do cliente)
Montado --> Capa : POST /api/schemes/{id}/mannequin-photo?asCover=true
Gerada --> Capa : nova geração com asCover=true (só esquema)
Gerada --> Montado : gerar de novo (substitui o arquivo)
Gerada --> SemFoto : DELETE /api/{pieces|schemes}/{id}/mannequin-photo
Capa --> SemFoto : DELETE /api/schemes/{id}/mannequin-photo\n(cover_image_url volta a null)
note right of Montado : peça: só superior ou corpo inteiro; o ghost mannequin\n(RF4) não é usado aqui; sem biometria — foto só como textura
note bottom of Gerada : face registrada na geração (avatar | padrão) para\nreexibir a mesma foto mesmo se a pessoa trocar o perfil
@enduml
