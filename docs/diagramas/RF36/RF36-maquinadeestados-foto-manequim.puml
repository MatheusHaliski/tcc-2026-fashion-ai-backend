@startuml RF36_MaquinaDeEstados_FotoManequim
!pragma layout smetana
title RF36 — Foto com meu manequim (peça do RF4 ou look do RF5)\nDiagrama de máquina de estados — foto da peça/do look (mannequin_image_url) e o diálogo que a gera
skinparam backgroundColor #FFFFFF
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  ArrowColor #52606D
}
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}

state "Foto guardada (WardrobeItem | Scheme)" as Foto {
  [*] --> SemFoto : peça ou look criado
  state "Sem foto\nmannequin_image_url = NULL" as SemFoto
  state "Com foto\nurl + face (FOTO | PADRAO)" as ComFoto
  state "Com foto e capa do post\n(só look) cover_image_url = url" as Capa
  SemFoto --> ComFoto : POST …/mannequin-photo\n(peça · look com asCover=false)
  SemFoto --> Capa : POST /api/schemes/{id}/mannequin-photo?asCover=true
  ComFoto --> ComFoto : gerar de novo (nova URL)
  ComFoto --> Capa : gerar de novo com asCover=true
  Capa --> ComFoto : gerar de novo com asCover=false\n(capa continua com a URL antiga)
  Capa --> Capa : gerar de novo com asCover=true
  ComFoto --> SemFoto : DELETE …/mannequin-photo (204)
  Capa --> SemFoto : DELETE …/mannequin-photo\n(capa = NULL se era a mesma foto)
  note bottom of ComFoto : face = FOTO se a dona tem foto de perfil e não é\nmarca; senão PADRAO (registrado na geração)
}

state "MannequinPhotoDialog" as Dialogo {
  [*] --> Montando : abrir ("Foto com meu manequim")
  state "Montando\nGET …/look3d (Skeleton)" as Montando
  state "Falhou ao montar\n(403/404, mensagem)" as FalhaMontar
  state "Sem WebGL\n(Gerar foto desabilitado)" as SemWebGL
  state "Pronto\n(LookViewer parado; cabeça neutra\nou rosto do Avatar 3D)" as Pronto
  state "Enviando\n(busy; JPEG 0,93 do canvas)" as Enviando
  state "Prévia salva\n(foto do servidor)" as Previa
  Montando --> FalhaMontar : erro
  Montando --> SemWebGL : 200, useWebGL() = false
  Montando --> Pronto : 200, WebGL
  Pronto --> Enviando : "Gerar foto"
  Pronto --> Pronto : captura falhou (toast)
  Enviando --> Previa : 200 {url, face}
  Enviando --> Pronto : 400 · 401 · 403 · 422 SEM_FOTO_NO_MANEQUIM (toast)
  Previa --> Pronto : "Gerar de novo"
  Previa --> [*] : "Remover foto" (DELETE) ou fechar
  Pronto --> [*] : fechar
}
@enduml
