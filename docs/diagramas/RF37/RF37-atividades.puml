@startuml RF37_Atividades
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam activity {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  DiamondBackgroundColor #FFF5F8
  DiamondBorderColor #F08DB1
  StartColor #20A77A
  EndColor #4B5563
}
skinparam swimlane {
  BorderColor #CBC6BE
  TitleFontColor #2D2438
}
title RF37 — FLAIR: jogo de cartas de moda (peça → carta → look → time/deck → competição), 15 modos e combinações das lojas\nDiagrama de atividades — gerado do código em 2026-10-14 (scripts/diagramas/v5)

|Pessoa usuária|
start
:Abre /coupons, /flair, /brands/[slug];
|Tela (Next.js)|
:Carrega os dados da tela\nGET /api/flair/combinations/{id}/check\nGET /api/flair/combinations\nGET /api/flair/modes/deck\nGET /api/flair/decks/{schemeId};
|Pessoa usuária|
:FLAIR — duelo de estilo 1×1 (5\nrodadas) contra @usuário ou…;
|Tela (Next.js)|
:POST /api/flair/duels;
|API (Spring Boot)|
:FlairController.duel\n→ FlairService.duel;
if (deck arquivado?) then (sim)
  :400 DECK_ARQUIVADO\n«Esse esquema está arquivado.»\n→ a tela mostra o aviso;
  stop
endif
if (deck vazio?) then (sim)
  :400 DECK_VAZIO\n«Esse esquema não tem peças.»\n→ a tela mostra o aviso;
  stop
endif
if (duelo consigo?) then (sim)
  :400 DUELO_CONSIGO\n«Escolha outra pessoa ou a Casa.»\n→ a tela mostra o aviso;
  stop
endif
|Dados e serviços|
:Lê: scheme_items\nhype_scores\nwardrobe_items\nusers\nschemes\nflair_profiles (+3);
:Usa: Guard.requireCanCreate\nSchemeService.owned\nHypeScoreConfig.algorithmVersion\nSchemeService.canView\nFaiPointsService.game;
:Grava: flair_matches\nflair_match_entries\nflair_profiles\nflair_coin_entries;
:Estado: status → FINISHED;
:Evento: CouponRightsCheck;
|Tela (Next.js)|
:Atualiza a tela com a resposta;
|Pessoa usuária|
if (Faz outra ação?) then (sim)
  switch (Qual?)
  case (FLAIR — troca o deck que completa…)
    :POST /api/flair/combinations/{id}/redeem\n→ FlairService.redeem\nvalida: COMBINACAO_INCOMPLETA,\nCOMBINACAO_INDISPONIVEL, CUPOM_JA_EMITIDO,\nDECK_ARQUIVADO\nlê: flair_combinations, scheme_items,\nhype_scores …\nusa: Guard.requireCanCreate, SchemeService.owned,\nHypeScoreConfig.algorithmVersion\ngrava: flair_redemptions, flair_coin_entries,\nflair_profiles;
  case (FLAIR — a loja edita uma combinaç…)
    :PUT /api/flair/brand/combinations/{id}\n→ FlairService.saveCombination\nvalida: DESCONTO_OBRIGATORIO, ERRO, SEM_REQUISITOS,\nTIPO_INVALIDO\nlê: users, flair_combinations, brand_profiles …\nusa: Guard.requireApprovedInstitutional\ngrava: flair_combinations;
  case (Battle of Looks — Look × Look com…)
    :POST /api/flair/modes/battle\n→ FlairModesService.battle\nvalida: LOOK_ARQUIVADO, OPONENTE_INVALIDO,\nSEM_LOOK_PUBLICO\nlê: scheme_items, users, schemes …\nusa: Guard.requireCanCreate, SchemeService.owned,\nFlairService.publicLookHype …\ngrava: flair_matches, flair_match_entries;
  case (FLAIR — a loja cria uma combinaçã…)
    :POST /api/flair/brand/combinations\n→ FlairService.saveCombination\nvalida: DESCONTO_OBRIGATORIO, ERRO, SEM_REQUISITOS,\nTIPO_INVALIDO\nlê: users, flair_combinations, brand_profiles …\nusa: Guard.requireApprovedInstitutional\ngrava: flair_combinations;
  case (FLAIR Runway — desfila um look: q…)
    :POST /api/flair/modes/runway\n→ FlairModesService.enterRunway\nvalida: JA_NA_RUNWAY, LOOK_ARQUIVADO\nlê: scheme_items, schemes, flair_trophies …\nusa: Guard.requireCanCreate, SchemeService.owned,\nFlairService.publicLookHype …\ngrava: flair_trophies, flair_mode_states,\nflair_matches …;
  endswitch
  note right
  Outras ações deste RF:
  FLAIR Squad — 5 looks × 5 loo…, FLAIR — no caixa,
  a loja conf…, FLAIR — a loja remove a combi…, sim,
  resgatar: emite o cupom…, dispensar o cupom
  conquistado
  end note
  |Tela (Next.js)|
  :Atualiza a tela;
endif
|Pessoa usuária|
stop
@enduml
