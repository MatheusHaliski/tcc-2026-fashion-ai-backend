@startuml RF37_Classes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  StereotypeFontColor #6B6470
}
hide empty members
left to right direction
title RF37 — FLAIR: jogo de cartas de moda (peça → carta → look → time/deck → competição), 15 modos e combinações das lojas\nDiagrama de classes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "fai-domain (entidades JPA)" {
  class Brand <<brands>> {
    +id: UUID
    +name: String
    +slug: String
    +logoUrl: String
    +website: String
    +source: BrandSource
    +catalogOrigin: CatalogOrigin
    +fixtureKey: String
    +sourceConfidence: BigDecimal
    +verifiedAt: Instant
    .. +2 campos ..
  }
  class BrandProfile <<brand_profiles>> {
    +id: UUID
    +owner: User
    +brandName: String
    +slug: String
    +logoUrl: String
    +coverUrl: String
    +bio: String
    +storeUrl: String
    +cnpj: String
    +razaoSocial: String
    .. +21 campos ..
  }
  class FlairCoinEntry <<flair_coin_entries>> {
    +id: UUID
    +user: User
    +delta: int
    +reason: String
    +ref: String
  }
  class FlairCombination <<flair_combinations>> {
    +id: UUID
    +brand: User
    +name: String
    +description: String
    +gameType: String
    +requiredCategoriesJson: String
    +requiredStylesJson: String
    +requiredOccasionsJson: String
    +minBrandPieces: int
    +minDeckPower: int
    .. +14 campos ..
  }
  class FlairMatch <<flair_matches>> {
    +id: UUID
    +mode: String
    +status: String
    +theme: String
    +playDate: LocalDate
    +createdByUser: User
    +teamAId: UUID
    +teamBId: UUID
    +winnerSide: String
    +resultJson: String
  }
  class FlairMatchEntry <<flair_match_entries>> {
    +id: UUID
    +match: FlairMatch
    +user: User
    +scheme: Scheme
    +side: String
    +deckPower: int
    +score: BigDecimal
    +brandPiecesJson: String
  }
  class FlairModeState <<flair_mode_states>> {
    +id: UUID
    +user: User
    +mode: String
    +seasonKey: String
    +stateJson: String
  }
  class FlairProfile <<flair_profiles>> {
    +id: UUID
    +user: User
    +coins: int
    +rankPoints: int
    +wins: int
    +losses: int
    +draws: int
    +skinsJson: String
    +activeSkin: String
  }
  class FlairRedemption <<flair_redemptions>> {
    +id: UUID
    +combination: FlairCombination
    +user: User
    +scheme: Scheme
    +code: String
    +status: String
    +deckPower: Integer
    +expiresAt: Instant
    +usedAt: Instant
  }
  class FlairTeam <<flair_teams>> {
    +id: UUID
    +name: String
    +code: String
    +owner: User
    +color: String
    +points: int
  }
  class FlairTeamMember <<flair_team_members>> {
    +id: UUID
    +team: FlairTeam
    +user: User
    +role: String
  }
  class FlairTerritory <<flair_territories>> {
    +id: UUID
    +mapCode: String
    +territoryCode: String
    +owner: User
    +defenderJson: String
    +capturedAt: Instant
    +defenses: int
  }
}
package "fai-domain (enums)" {
  enum ApprovalStatus {
    PENDENTE
    AJUSTES
    APROVADO
    RECUSADO
    SUSPENSO
  }
}
package "fai-application" {
  class FlairService <<service>> {
    +cards()
    +decks()
    +deckOf()
    +quests()
    +combinationsFor()
    +checkCombination()
    +redeem()
    +vouchers()
    +saveCombination()
    +deleteCombination()
  }
}
FlairService ..> BrandProfile : usa
FlairService ..> FlairCoinEntry : usa
FlairService ..> FlairCombination : usa
FlairService ..> FlairMatch : usa
FlairService ..> FlairMatchEntry : usa
FlairService ..> FlairProfile : usa
Brand "*" --> "1" BrandProfile : brandProfile
BrandProfile --> ApprovalStatus
FlairMatchEntry "*" --> "1" FlairMatch : match
FlairRedemption "*" --> "1" FlairCombination : combination
FlairTeamMember "*" --> "1" FlairTeam : team
@enduml
