@startuml RF37_Componentes
title RF37 — FLAIR: jogo de cartas de moda (peça → carta → look → time/deck → competição), 15 modos e combinações das lojas\nDiagrama de componentes — gerado do código (controllers → serviços → repositórios/ports)
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
left to right direction

package "Frontend (Next.js · React Three Fiber)" {
  component "flair — Modos de jogo (15)" as FE0
  component "flair — Duelos, equipes, cartas, decks, quests, carteira" as FE1
  component "brands/[slug] — aba FLAIR (combinações da loja)" as FE2
}
package "fai-web (REST)" {
  [FlairController] as FlairController
  [FlairModesController] as FlairModesController
}
package "fai-application (casos de uso)" {
  [FlairService] as FlairService
  [FlairModesService] as FlairModesService
  [SchemeService] as SchemeService #FAFAFA
  [InstitutionalService] as InstitutionalService #FAFAFA
}
package "fai-domain (repositórios JPA)" {
  [BrandProfileRepository\nFlairCoinEntryRepository\nFlairCombinationRepository\nFlairMatchEntryRepository\nFlairMatchRepository\nFlairModeStateRepository\nFlairProfileRepository\nFlairRedemptionRepository\nFlairTeamMemberRepository\nFlairTeamRepository\nFlairTerritoryRepository\nFlairTrophyRepository\nReactionRepository\nSchemeItemRepository\nSchemeRepository\nUserRepository\nWardrobeItemRepository] as REPOS
}
database "MySQL · fashionai_app\n• brand_profiles\n• flair_coin_entries\n• flair_combinations\n• flair_match_entries\n• flair_matches\n• flair_mode_states\n• flair_profiles\n• flair_redemptions\n• flair_team_members\n• flair_teams\n• flair_territories\n• flair_trophies\n• reactions\n• scheme_items\n• schemes\n• users\n• wardrobe_items" as DB
[NotificationService\n(RNF10)] as P_notif
[Eventos de domínio\n(@TransactionalEventListener AFTER_COMMIT)] as P_events

FE0 --> FlairController : HTTPS/JSON
FE0 --> FlairModesController : HTTPS/JSON
FE1 --> FlairController : HTTPS/JSON
FE1 --> FlairModesController : HTTPS/JSON
FE2 --> FlairController : HTTPS/JSON
FE2 --> FlairModesController : HTTPS/JSON
FlairController --> FlairService
FlairModesController --> FlairModesService
FlairService ..> SchemeService
FlairService ..> InstitutionalService
FlairService --> REPOS
FlairService --> P_events
FlairModesService ..> FlairService
FlairModesService ..> SchemeService
FlairModesService --> REPOS
FlairModesService --> P_notif
REPOS --> DB : JPA/Flyway
@enduml
