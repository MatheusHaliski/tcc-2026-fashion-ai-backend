@startuml RF37_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF37 — FLAIR: jogo de cartas de moda (peça → carta → look → time/deck → competição), 15 modos e combinações das lojas\nDiagrama de componentes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "Frontend (Next.js)" {
  component "/flair\n(site)/(app)/flair/page.tsx" as FE0
  component "/brands/[slug]\n(site)/(app)/brands/[slug]/page.tsx" as FE1
  component "lib/api/client.ts" as APIC
}
package "fai-web (REST)" {
  component "FlairController\n/api/flair/decks\n/api/flair/decks/{…}\n/api/flair/quests" as FlairController
  component "FlairModesController\n/api/flair/modes/deck" as FlairModesController
}
package "fai-application (casos de uso)" {
  component "FlairService" as FlairService
  component "FlairModesService" as FlairModesService
  component "SchemeService" as SchemeService <<apoio>>
  component "InstitutionalService" as InstitutionalService <<apoio>>
  component "FaiPointsService" as FaiPointsService <<apoio>>
  component "HypeScoreConfig" as HypeScoreConfig <<apoio>>
  component "NotificationService" as NotificationService <<apoio>>
}
package "fai-domain (repositórios)" {
  component "FlairProfileRepository\nFlairCoinEntryRepository\nFlairCombinationRepository\nFlairRedemptionRepository\nFlairTeamRepository\nFlairTeamMemberRepository\nFlairMatchRepository\nFlairMatchEntryRepository\nUserRepository\nWardrobeItemRepository\n(+8)" as REPO_MySQL
}
database "MySQL\n• brand_profiles\n• flair_coin_entries\n• flair_combinations\n• flair_match_entries\n• flair_matches\n• flair_mode_states\n• flair_profiles\n• flair_redemptions\n• flair_team_members\n• flair_teams\n• flair_territories\n• flair_trophies\n(+6)" as DB_MySQL
APIC --> FlairController : HTTPS/JSON
APIC --> FlairModesController : HTTPS/JSON
FE0 --> APIC
FE1 --> APIC
FlairController --> FlairService
FlairModesController --> FlairModesService
FlairModesService --> REPO_MySQL
FlairModesService ..> FaiPointsService
FlairModesService ..> FlairService
FlairModesService ..> NotificationService
FlairModesService ..> SchemeService
FlairService --> REPO_MySQL
FlairService ..> FaiPointsService
FlairService ..> HypeScoreConfig
FlairService ..> InstitutionalService
FlairService ..> SchemeService
REPO_MySQL --> DB_MySQL : JPA/Flyway
@enduml
