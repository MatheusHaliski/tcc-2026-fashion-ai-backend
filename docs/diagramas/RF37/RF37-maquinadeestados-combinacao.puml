@startuml RF37_MaquinaDeEstados_Combinacao
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  StartColor #20A77A
  EndColor #4B5563
}
title RF37 — ciclo de vida de FlairRedemption.status\nDiagrama de máquina de estados — gerado do código em 2026-10-06 (scripts/diagramas/v5)\ncampo texto · tabela flair_redemptions

state "FlairRedemption.status" as Ciclo_FlairRedemption {
  state Ciclo_FlairRedemption_EMITIDO as "EMITIDO"
  state Ciclo_FlairRedemption_USADO as "USADO"
}
[*] --> Ciclo_FlairRedemption_EMITIDO : criação
Ciclo_FlairRedemption --> Ciclo_FlairRedemption_EMITIDO : redeem()\nPOST /api/flair/combinations/{id}/redeem
Ciclo_FlairRedemption_EMITIDO --> Ciclo_FlairRedemption_USADO : validateCode()\nPOST /api/flair/brand/redemptions/validate
note right of Ciclo_FlairRedemption
  Setas que saem da borda: a mudança vale
  a partir de qualquer estado (o código não
  testa o estado anterior).
end note
@enduml
