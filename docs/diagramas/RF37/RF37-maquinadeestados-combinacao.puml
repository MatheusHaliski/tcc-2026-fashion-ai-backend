@startuml RF37_MaquinaDeEstados_Combinacao
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  ArrowColor #52606D
}
title RF37 — Combinação da loja no FLAIR (flair_combinations) e cupom gerado (flair_redemptions)
[*] --> Ativa : POST /api/flair/brand/combinations\n(gameType COMBINACAO | COLECAO | DUELO_PATROCINADO)
state "Combinação da loja" as Comb {
  state "active = true\n(dentro de startsAt/endsAt, redeemed < stock)" as Ativa
  state "Indisponível\n(inativa, fora da janela ou estoque esgotado)" as Indisponivel
  Ativa --> Indisponivel : PUT /api/flair/brand/combinations/{id} {active:false}\n· passa endsAt · redeemed = stock
  Indisponivel --> Ativa : PUT …/combinations/{id} {active:true}\nou repõe stock
  Ativa --> [*] : DELETE /api/flair/brand/combinations/{id}
}
state "Deck do jogador" as Deck {
  state "Incompleto\n(422 COMBINACAO_INCOMPLETA — checks[])" as Incompleto
  state "Completo\n(categorias, estilos, ocasiões, minBrandPieces,\nminDeckPower, minRarity, minWins OK)" as Completo
  Incompleto --> Completo : joga modos / monta look (RF5)\n→ GET /api/flair/combinations/{id}/check
  Completo --> Incompleto : peça sai do look
}
state "Cupom FLAIR (flair_redemptions)" as Cupom {
  state "EMITIDO\n(code, expiresAt = agora + validDays)" as Emitido
  state "USADO\n(usedAt)" as Usado
  state "EXPIRADO" as Expirado
  Emitido --> Usado : POST /api/flair/brand/redemptions/validate {code}
  Emitido --> Expirado : passa expiresAt
}
Ativa --> Incompleto : jogador abre GET /api/flair/combinations
Completo --> Emitido : POST /api/flair/combinations/{id}/redeem\n(409 COMBINACAO_INDISPONIVEL se a loja desativou;\n409 CUPOM_JA_EMITIDO se repetir)
Emitido --> [*] : aparece em GET /api/flair/vouchers e\nem Meus cupons resgatados (RF38)
note right of Cupom : o direito ao cupom passa pelo fluxo único do RF38\n(coupon_rights → redeem/dismiss)
note bottom of Deck : cartas (EDGE, RANGE, CLOUT, GLOW, ART, SYNC) e decks\n(HYPE, STYLE, …, AI) vêm de GET /api/flair/cards e /decks
@enduml
