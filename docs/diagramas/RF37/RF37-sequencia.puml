@startuml RF37_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."
title RF37 — FLAIR: jogo de cartas de moda (peça → carta → look → time/deck → competição), 15 modos e combinações das lojas\nDiagrama de sequência — gerado do código em 2026-10-06 (scripts/diagramas/v5)

actor "Pessoa usuária" as U
boundary "Tela /flair" as P
control "FlairModesController" as FlairModesController
participant "FlairModesService" as FlairModesService
participant "Guard" as Guard
participant "SchemeService" as SchemeService
database "MySQL" as DB_MySQL
participant "FlairService" as FlairService
participant "NotificationService" as NotificationService
== FLAIR Runway — desfila um look: qualificação → semifinal → final ==
U -> P : FLAIR Runway — desfila um look: qualificação → se…
P -> FlairModesController : POST /api/flair/modes/runway
FlairModesController -> FlairModesService : enterRunway()
activate FlairModesService
FlairModesService -> Guard : requireCanCreate()
alt já na runway
FlairModesService --> FlairModesController : 409 JA_NA_RUNWAY
FlairModesController --> P : 409 + mensagem
end
FlairModesService -> SchemeService : owned()
SchemeService -> DB_MySQL : SELECT schemes
SchemeService --> FlairModesService
alt look arquivado
FlairModesService --> FlairModesController : 400 LOOK_ARQUIVADO
FlairModesController --> P : 400 + mensagem
end
FlairModesService -> FlairService : publicLookHype()
FlairService -> DB_MySQL : SELECT hype_scores
FlairService --> FlairModesService
FlairModesService -> DB_MySQL : SELECT scheme_items
FlairModesService -> FlairService : cardsOf()
FlairService -> DB_MySQL : SELECT hype_scores
FlairService --> FlairModesService
FlairModesService -> DB_MySQL : SELECT schemes
FlairModesService -> SchemeService : canView()
FlairModesService -> Guard : blocked()
Guard -> DB_MySQL : SELECT follows (×2)
Guard --> FlairModesService
FlairModesService -> FlairService : publicLookHype()
FlairModesService -> DB_MySQL : SELECT scheme_items
FlairModesService -> FlairService : cardsOf()
FlairModesService -> DB_MySQL : SELECT flair_trophies
FlairModesService -> FlairModesService : new FlairTrophy()
FlairModesService -> DB_MySQL : SELECT users
FlairModesService -> FlairModesService : seasonKey = set
FlairModesService -> DB_MySQL : INSERT/UPDATE flair_trophies
FlairModesService -> NotificationService : notify()
NotificationService -> DB_MySQL : SELECT users (×2)
NotificationService -> DB_MySQL : SELECT user_preferences
NotificationService -> DB_MySQL : INSERT/UPDATE notifications
NotificationService --> FlairModesService
note over FlairModesService : … e mais 24 passos no código
deactivate FlairModesService
FlairModesService --> FlairModesController : resultado
FlairModesController --> P : 201 JSON
P --> U : atualiza a tela
@enduml
