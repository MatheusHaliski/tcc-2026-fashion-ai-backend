@startuml RF38_Atividades
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam activity {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  DiamondBackgroundColor #FFF5F8
  DiamondBorderColor #F08DB1
  StartColor #20A77A
  EndColor #4B5563
}
skinparam swimlane {
  BorderColor #CBC6BE
  TitleFontColor #2D2438
}
title RF38 — Cupons Fashion AI: 'Meus cupons promocionais' (marca/celebridade) e 'Meus cupons resgatados' (lookbook)\nDiagrama de atividades — gerado do código em 2026-10-06 (scripts/diagramas/v5)

|Pessoa usuária|
start
:Abre /brands/[slug], /coupons;
|Tela (Next.js)|
:Carrega os dados da tela\nGET /api/me/coupons/admin\nGET /api/me/coupons;
|Pessoa usuária|
:sim, resgatar: emite o cupom Fashion\nAI da marca/celebridade;
|Tela (Next.js)|
:POST /api/me/coupon-rights/{id}/redeem;
|API (Spring Boot)|
:CouponController.redeem\n→ CouponService.redeem;
if (direito decidido?) then (sim)
  :409 DIREITO_DECIDIDO\n«Este cupom já foi …»\n→ a tela mostra o aviso;
  stop
endif
|Dados e serviços|
:Lê: coupon_rights\npromotion_redemptions\nusers\nbrand_profiles\nflair_redemptions;
:Usa: Guard.requireOwner\nSealService.redeem\nFlairService.redeem;
:Estado: status → RESGATADO\ndecidedAt → set;
|Tela (Next.js)|
:Atualiza a tela com a resposta;
|Pessoa usuária|
if (Faz outra ação?) then (sim)
  switch (Qual?)
  case (confere o código de um cupom Fash…)
    :POST /api/me/coupons/validate\n→ CouponService.validate\nvalida: CUPOM_EXPIRADO, CUPOM_USADO, NAO_ENCONTRADO\nlê: users, flair_redemptions, brand_profiles …\nusa: Guard.requireApprovedInstitutional,\nFlairService.validateCode\nestado: status → USED;
  case (dispensar o cupom conquistado)
    :POST /api/me/coupon-rights/{id}/dismiss\n→ CouponService.dismiss\nlê: coupon_rights, celebrity_profiles,\nbrand_profiles\nusa: Guard.requireOwner\nestado: status → DISPENSADO, decidedAt → set;
  endswitch
  |Tela (Next.js)|
  :Atualiza a tela;
endif
|Pessoa usuária|
stop
@enduml
