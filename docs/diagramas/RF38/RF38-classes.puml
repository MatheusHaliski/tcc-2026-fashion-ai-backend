@startuml RF38_Classes
title RF38 — Meus cupons promocionais (marca/celebridade) e Meus cupons resgatados\nDiagrama de classes — direito ao cupom (coupon_rights), fontes SELO e FLAIR e a carteira única
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  HeaderBackgroundColor #E4DEF0
}
skinparam packageStyle rectangle
hide empty methods

package "fai-web" {
class CouponController {
  +mine(user): Map  «GET /api/me/coupons»
  +redeem(user, id): Map  «POST /api/me/coupon-rights/{id}/redeem»
  +dismiss(user, id): Map  «POST …/{id}/dismiss»
  +admin(user): Map  «GET /api/me/coupons/admin»
  +validate(user, CodeRequest): Map  «POST /api/me/coupons/validate»
}
}
package "fai-application" {
class CouponService {
  +SELO = "SELO"
  +FLAIR = "FLAIR"
  ~PENDENTE = "PENDENTE"
  ~RESGATADO = "RESGATADO"
  ~DISPENSADO = "DISPENSADO"
  +onCheck(CouponRightsCheck)
  +onScheme(SchemeSaved)
  +onPiece(PieceCreated)
  +scan(userId): int
  +mine(user): Map
  +redeem(user, rightId): Map
  +dismiss(user, rightId): Map
  +admin(user): Map
  +validate(user, code): Map
  ~wallet(userId): List<Map>
  ~{static} discountText(pct, amount, minPurchase): String
}
class SealService <<RF25>> {
  +eligiblePromotions(userId): List<Promotion>
  +redeem(user, promotionId): Map
  +createPromotion(user, PromotionForm): Map
  +setPromotionStatus(user, id, PromotionStatus): Map
  ~{static} unavailable(Promotion, now): String
  +{static} httpsOnly(url): String
}
class FlairService <<RF37>> {
  +combinationsFor(user): List<Map>
  +redeem(user, combinationId, schemeId): Map
  +validateCode(user, code): Map
  ~available(FlairCombination): boolean
  +{static} sellerActive(User): boolean
}
class "DomainEvents.CouponRightsCheck" as Ev <<record>> {
  +userId: UUID
}
class NotificationService {
  +notify(recipient, actor, NotificationType, resourceType,\n  resourceId, title, body, payload)
}
}
package "fai-domain · model" {
class CouponRight {
  +user: User
  +owner: User
  +sourceType: String  «SELO | FLAIR»
  +sourceId: UUID
  +title: String
  +detail: String
  +status: String  «PENDENTE | RESGATADO | DISPENSADO»
  +schemeId: UUID
  +couponRef: UUID
  +decidedAt: Instant
}
class Promotion {
  +seal: Seal
  +type: PromotionType
  +title: String
  +discountPercent: Integer
  +partnerBrandUserId: UUID
  +status: PromotionStatus
  +ownerUserId: UUID
  +startsAt / expiresAt: Instant
  +totalQuota: Integer
  +perUserLimit: int
  +redeemedCount: int
  +storeUrl: String
}
class PromotionRedemption {
  +promotion: Promotion
  +sealBond: SealBond
  +user: User
  +code: String
  +issuerUserId: UUID
  +partnerBrandUserId: UUID
  +status: RedemptionStatus
  +redeemedAt / expiresAt: Instant
}
class FlairCombination {
  +brand: User
  +name: String
  +couponTitle: String
  +discountPercent: Integer
  +discountAmount / minPurchase: BigDecimal
  +validDays: int
  +stock: Integer
  +redeemed: int
  +active: boolean
  +storeUrl: String
}
class FlairRedemption {
  +combination: FlairCombination
  +user: User
  +scheme: Scheme
  +code: String  «FLR-XXXX-XXXX»
  +status: String  «EMITIDO | USADO»
  +expiresAt / usedAt: Instant
}
class SealBond {
  +requestedBy: User
  +targetOwner: User
  +seal: Seal
  +status: SealBondStatus
}
class Notification {
  +recipient: User
  +type: NotificationType
  +resourceType: String  «COUPON_RIGHT»
  +payloadJson: String
}
class BrandProfile {
  +owner: User
  +brandName: String
  +logoUrl: String
  +storeUrl: String
}
class CelebrityProfile {
  +owner: User
  +stageName: String
  +avatarUrl: String
}
class User {
  +profileType: ProfileType
  +status: AccountStatus
  +linksJson: String
}
}
package "fai-domain · enums" {
enum PromotionStatus {
  AVAILABLE
  REDEEMED
  EXPIRED
  REVOKED
}
enum RedemptionStatus {
  ISSUED
  USED
  EXPIRED
}
enum "NotificationType (trecho)" as NT {
  COUPON_AVAILABLE
  SEAL_GRANTED
  ACHIEVEMENT_UNLOCKED
}
}
package "fai-domain · repository" {
interface CouponRightRepository {
  +findByUserIdAndSourceTypeAndSourceId(…): Optional<CouponRight>
  +findByUserIdAndStatusOrderByCreatedAtDesc(…): List<CouponRight>
  +countByOwnerIdAndStatus(ownerId, status): long
  +countBySourceTypeAndSourceIdAndStatus(…): long
}
}
CouponController --> CouponService
CouponService --> SealService : SELO
CouponService --> FlairService : FLAIR
CouponService --> NotificationService : COUPON_AVAILABLE
CouponService --> CouponRightRepository
CouponService ..> Ev : escuta (AFTER_COMMIT)
SealService ..> Ev : publica
FlairService ..> Ev : publica
CouponRight "*" --> "1" User : user (quem conquistou)
CouponRight "*" --> "1" User : owner (loja)
CouponRight ..> Promotion : sourceId (SELO)
CouponRight ..> FlairCombination : sourceId (FLAIR)
CouponRight ..> PromotionRedemption : couponRef
CouponRight ..> FlairRedemption : couponRef
PromotionRedemption "*" --> "1" Promotion
PromotionRedemption "*" --> "1" SealBond
PromotionRedemption "*" --> "1" User
PromotionRedemption --> RedemptionStatus
Promotion --> PromotionStatus
Promotion ..> User : ownerUserId
FlairRedemption "*" --> "1" FlairCombination
FlairRedemption "*" --> "1" User
FlairCombination "*" --> "1" User : brand
SealBond "*" --> "1" User : requestedBy
Notification --> NT
Notification "*" --> "1" User : recipient
BrandProfile "0..1" --> "1" User : owner
CelebrityProfile "0..1" --> "1" User : owner
CouponRightRepository ..> CouponRight
note top of CouponRight : tabela coupon_rights (V19)\núnico: user_id + source_type + source_id
note bottom of PromotionRedemption : "EXPIRADO" na carteira é calculado na leitura\n(expiresAt no passado); nenhum job grava EXPIRED
@enduml
