@startuml RF38_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF38 — Cupons Fashion AI: 'Meus cupons promocionais' (marca/celebridade) e 'Meus cupons resgatados' (lookbook)\nDiagrama de componentes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "Frontend (Next.js)" {
  component "/coupons\n(site)/(app)/coupons/page.tsx" as FE0
  component "/brands/[slug]\n(site)/(app)/brands/[slug]/page.tsx" as FE1
  component "lib/api/client.ts" as APIC
}
package "fai-web (REST)" {
  component "CouponController\n/api/me/coupon-rights/{…}/dismiss\n/api/me/coupon-rights/{…}/redeem\n/api/me/coupons\n/api/me/coupons/admin\n(+1 rotas)" as CouponController
}
package "fai-application (casos de uso)" {
  component "CouponService" as CouponService
  component "SealService" as SealService <<apoio>>
  component "FlairService" as FlairService <<apoio>>
  component "NotificationService" as NotificationService <<apoio>>
}
package "fai-domain (repositórios)" {
  component "CouponRightRepository\nPromotionRepository\nPromotionRedemptionRepository\nFlairCombinationRepository\nFlairRedemptionRepository\nBrandProfileRepository\nCelebrityProfileRepository\nUserRepository" as REPO_MySQL
}
database "MySQL\n• brand_profiles\n• celebrity_profiles\n• coupon_rights\n• flair_combinations\n• flair_redemptions\n• promotion_redemptions\n• promotions\n• users" as DB_MySQL
APIC --> CouponController : HTTPS/JSON
CouponController --> CouponService
CouponService --> REPO_MySQL
CouponService ..> FlairService
CouponService ..> NotificationService
CouponService ..> SealService
FE0 --> APIC
FE1 --> APIC
REPO_MySQL --> DB_MySQL : JPA/Flyway
@enduml
