@startuml RF38_MaquinaDeEstados_Cupom
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  StartColor #20A77A
  EndColor #4B5563
}
title RF38 — ciclo de vida de CouponRight.status\nDiagrama de máquina de estados — gerado do código em 2026-10-06 (scripts/diagramas/v5)\ncampo texto · tabela coupon_rights

state "CouponRight.status" as Ciclo_CouponRight {
  state Ciclo_CouponRight_DISPENSADO as "DISPENSADO"
  state Ciclo_CouponRight_PENDENTE as "PENDENTE"
  state Ciclo_CouponRight_RESGATADO as "RESGATADO"
}
[*] --> Ciclo_CouponRight_PENDENTE : criação
Ciclo_CouponRight --> Ciclo_CouponRight_DISPENSADO : dismiss()\nPOST /api/me/coupon-rights/{id}/dismiss
Ciclo_CouponRight --> Ciclo_CouponRight_PENDENTE : grant(), mine()
Ciclo_CouponRight --> Ciclo_CouponRight_RESGATADO : mine(), redeem()
note right of Ciclo_CouponRight
  Setas que saem da borda: a mudança vale
  a partir de qualquer estado (o código não
  testa o estado anterior).
end note
@enduml
