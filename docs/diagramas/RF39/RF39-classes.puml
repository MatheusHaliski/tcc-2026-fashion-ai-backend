@startuml RF39_Classes
title RF39 — Criar guarda-roupa 3D com a identidade de uma marca/celebridade e vender na loja do quarto\nDiagrama de classes — criador, catálogo da loja, compra com FAI Points e montagem no quarto
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  HeaderBackgroundColor #E4DEF0
}
skinparam packageStyle rectangle
hide empty methods

package "fai-web" {
class RoomCreatorController {
  +options(user): Map  «GET /api/room-creator/options»
  +mine(user): Map  «GET /api/room-creator/items»
  +create(user, ItemForm): Map  «POST …/items (201)»
  +update(user, sku, ItemForm): Map  «PUT …/items/{sku}»
  +delete(user, sku)  «DELETE …/items/{sku} (204)»
  +upload(user, file, kind): Map  «POST …/uploads?kind=logo|art»
}
class HighlightsController {
  +shop(user): List<Map>  «GET /api/points/shop»
  +tryOn(user, sku, ModuleRequest)  «POST …/{sku}/try-on»
  +buy(user, sku)  «POST …/{sku}/purchase»
  +apply(user, inventoryId, ModuleRequest)\n  «POST /api/me/room-inventory/{id}/apply»
}
}
package "fai-application" {
class WardrobeCreatorService {
  +BLOCKS: List<Block> (20)
  +MATERIALS: Map<String, Material> (22)
  +COLORS: Map<String, String>
  +LEVELS = ESTREIA … MAISON (7)
  +options(user): Map
  +save(user, sku, ItemForm): Map
  +delete(user, sku)
  +mine(user): Map
  +uploadArt(user, bytes, kind): Map
  +seedFactory(): int
  +{static} availability(item, now): String
  +blocker(buyer, item): String
  +hasSeal(buyer, item): boolean
  +sellerActive(item): boolean
  +view(item, buyer): Map
  ~creator(user): User
}
class "WardrobeCreatorService.ItemForm" as ItemForm <<record>> {
  +kind: COMPONENT | WARDROBE
  +name, description, labelText
  +slotType, moldId, material, colorName, color
  +logoUrl, artUrl, sealId: UUID
  +pricePoints, requiredLevel, stock, perUserLimit
  +availableFrom, availableUntil: Instant
  +requiresSeal, active: Boolean
  +bundle: List<BundlePart>
}
class "WardrobeCreatorService.Block" as Block <<record>> {
  +slotType, moldId
  +widthCm, basePrice: int
  +minLevel: String
  +materials: List<String>
}
class "WardrobeCreatorService.Material" as Material <<record>> {
  +code, label
  +roughness, metalness, priceFactor: double
  +minLevel: String
  +colors: List<String>
}
class "WardrobeCreatorService.BundlePart" as BundlePart <<record>> {
  +slotType, moldId, material, colorName, color
}
class FaiPointsService {
  +shop(user): List<Map>
  +tryOn(user, sku, moduleId): Map
  +buy(user, sku): Map
  +apply(user, inventoryId, moduleId): Map
  +balance(userId): long
  +level(userId): Level
}
enum "FaiPointsService.Level" as Level {
  ESTREIA (0)
  STUDIO (300)
  LOFT (900)
  CLOSET (2000)
  ATELIER (4000)
  PENTHOUSE (7500)
  MAISON (12000)
}
interface "FaiPointsService.RoomLayoutAccess" as RLA {
  +compatibleModules(userId, item): List<String>
  +applyFinish(userId, moduleId, item)
  +layout(userId): RoomLayout
  +setLevel(userId, level)
}
class RoomService
class MediaService {
  +put(key, bytes, contentType): StoredObject
}
class NotificationService {
  +notify(recipientId, actorId, type, …): Notification
}
class Guard {
  +requireApprovedInstitutional(user, resource, msg)
  +deny(user, resource, msg): ApiException
}
}
package "fai-domain · model" {
class RoomCatalogItem {
  +sku: String  «FAI-… fábrica | BRD-… marca»
  +name: String
  +kind: String  «COMPONENT | WARDROBE»
  +slotType, moldId: String
  +widthCm: int
  +material, colorName: String
  +finishJson, bundleJson: String
  +rarity: String
  +pricePoints: int
  +requiredLevel: String
  +stockLimit: Integer
  +soldCount: int
  +perUserLimit: Integer
  +availableFrom / availableUntil: Instant
  +requiresSeal: boolean
  +active: boolean
  +creatorUserId, sealId, maisonBrandUserId: UUID
  +logoUrl, artUrl, labelText: String
}
class RoomInventoryItem {
  +userId: UUID
  +sku: String
  +serial: Integer
  +source: String  «PURCHASE»
  +appliedModule: String
  +acquiredAt: Instant
}
class RoomLayout {
  +user: User
  +level: String
  +modulesJson: String
}
class FaiPointsLedgerEntry {
  +userId: UUID
  +delta: int
  +actionCode: String  «SHOP_PURCHASE»
  +refType / refId: String
  +idempotencyKey: String
  +countsLifetime: boolean
}
class Seal {
  +owner: User
  +name: String
  +status: SealStatus
}
class SealBond {
  +requestedBy: User
  +targetOwner: User
  +seal: Seal
  +status: SealBondStatus
  +expiresAt: Instant
}
class User {
  +profileType: ProfileType
  +status: AccountStatus
}
}
package "fai-domain · repository" {
interface RoomCatalogItemRepository {
  +findByActiveTrueOrderByPricePoints()
  +findByCreatorUserIdOrderByCreatedAtDesc(id)
  +lockBySku(sku): Optional
}
interface RoomInventoryItemRepository {
  +findByUserId(id) · findBySku(sku)
  +countByUserIdAndSku(id, sku): long
}
}
RoomCreatorController --> WardrobeCreatorService
HighlightsController --> FaiPointsService
WardrobeCreatorService ..> ItemForm
ItemForm "1" o-- "*" BundlePart
WardrobeCreatorService ..> Block
WardrobeCreatorService ..> Material
WardrobeCreatorService --> MediaService : logo e arte
WardrobeCreatorService --> Guard : só marca/celebridade aprovada
FaiPointsService --> NotificationService : extrato FAI_POINTS
FaiPointsService --> WardrobeCreatorService : view · blocker · sellerActive
FaiPointsService --> RLA
RoomService ..|> RLA
FaiPointsService ..> Level
WardrobeCreatorService --> RoomCatalogItemRepository
FaiPointsService --> RoomCatalogItemRepository
FaiPointsService --> RoomInventoryItemRepository
RoomCatalogItemRepository ..> RoomCatalogItem
RoomInventoryItemRepository ..> RoomInventoryItem
RoomCatalogItem ..> User : creatorUserId (marca/celebridade)
RoomCatalogItem ..> Seal : sealId (selo de identidade)
RoomInventoryItem ..> RoomCatalogItem : sku
RoomInventoryItem ..> User : userId
RoomLayout "1" --> "1" User
FaiPointsLedgerEntry ..> User : userId
Seal "*" --> "1" User : owner
SealBond "*" --> "0..1" Seal
SealBond "*" --> "1" User : requestedBy
SealBond "*" --> "1" User : targetOwner
note top of RoomCatalogItem : tabela room_catalog (V5; V20: criador, bundle, janela,\nlimite por pessoa, exige selo; V27: @Version); a fábrica FAI\n(seedFactory) cria todos os blocos × material × cor
note bottom of SealBond : "exige selo": o comprador precisa de SealBond APPROVED\nnão vencido com a marca (e do selo do item, se houver)
@enduml
