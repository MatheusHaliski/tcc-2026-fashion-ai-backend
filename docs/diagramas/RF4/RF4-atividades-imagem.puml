@startuml RF4_Atividades_Imagem
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam activity {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  DiamondBackgroundColor #FFF5F8
  DiamondBorderColor #F08DB1
  StartColor #20A77A
  EndColor #4B5563
}
skinparam swimlane {
  BorderColor #CBC6BE
  TitleFontColor #2D2438
}
title RF4 — Adicionar uma nova peça por busca catalogada, formulário & fotografia\nDiagrama de atividades — gerado do código em 2026-10-14 (scripts/diagramas/v5)

|Pessoa usuária|
start
:Abre /pieces/new,\n/dna-schemes/[id]/edit,\n/dna-schemes/new;
|Tela (Next.js)|
:Carrega os dados da tela\nGET /api/studio/backdrops\nGET /api/taxonomy\nGET /api/pieces/{id}\nGET /api/lens/scans/{id};
|Pessoa usuária|
:Cadastrar a peça a partir do\nrascunho analisado;
|Tela (Next.js)|
:POST /api/pieces;
|API (Spring Boot)|
:WardrobeController.create\n→ WardrobeService.create;
if (formulario inválido?) then (sim)
  :400 FORMULARIO_INVALIDO\n«Corrija os campos destacados.»\n→ a tela mostra o aviso;
  stop
endif
if (erro?) then (sim)
  :500 ERRO\n→ a tela mostra o aviso;
  stop
endif
if (foto obrigatória?) then (sim)
  :400 FOTO_OBRIGATORIA\n«Envie uma foto ou escolha usar a\nimagem padrão da peça.»\n→ a tela mostra o aviso;
  stop
endif
if (conteúdo bloqueado?) then (sim)
  :400 CONTEUDO_BLOQUEADO\n«A foto viola a política de\nconteúdo e não pode ser usada.»\n→ a tela mostra o aviso;
  stop
endif
|Dados e serviços|
:Lê: users\npipeline_jobs\nwardrobe_items\nreactions;
:Usa: Guard.requireCanCreate\nAssetCatalogService.defaultPieceImage\nAssetCatalogService.publicFile\nAssetCatalogService.defaultPieceLogo\nMediaService.put\nMediaService.read (+4);
:IA: STUDIO_ENHANCER;
:Grava: wardrobe_items\nquality_scores\nprocessing_jobs_log\nmoderation_queue\npipeline_jobs;
:Estado: imageUrl → set\nthumbnailUrl → set\noriginalImageUrl → null\nmoderationStatus → APPROVED\nphotoProcessingStatus → COMPLETED\ndefaultImage → true (+10);
:Evento: PieceCreated\nPieceCapturedFromSession;
|Tela (Next.js)|
:Atualiza a tela com a resposta;
|Pessoa usuária|
if (Faz outra ação?) then (sim)
  switch (Qual?)
  case (RF4 · Estúdio — leva ao estúdio a…)
    :POST /api/me/pieces/studio\n→ WardrobeService.studioAll\nlê: wardrobe_items\nusa: Guard.requireCanCreate,\nAssetCatalogService.publicFile,\nAssetCatalogService.defaultPieceLogo …\nia: STUDIO_ENHANCER;
  case (Substituir a foto da peça [reproc…)
    :PUT /api/pieces/{id}/image\n→ WardrobeService.replaceImage\nlê: wardrobe_items, reactions\nusa: Guard.requireCanCreate, Guard.requireOwner,\nMediaService.put …\nia: STUDIO_ENHANCER;
  case (Reprocessar remoção de fundo)
    :POST /api/pieces/{id}/background-removal\n→ WardrobeService.removeBackground\nlê: wardrobe_items\nusa: Guard.requireCanCreate, Guard.requireOwner,\nMediaService.read …\nia: FLAT_LAY_STANDARDIZER, STUDIO_ENHANCER;
  case (RF4 · Estúdio — gera/refaz a foto…)
    :POST /api/pieces/{id}/studio\n→ WardrobeService.studioPiece\nvalida: ESTUDIO_INDISPONIVEL, NAO_ENCONTRADO,\nSEM_RECORTE\nlê: wardrobe_items, reactions\nusa: Guard.requireCanCreate, Guard.requireOwner,\nMediaService.read …\nia: STUDIO_ENHANCER;
  case (RF4 · Estúdio — descarta a versão…)
    :DELETE /api/pieces/{id}/studio/pending\n→ WardrobeService.discardStudio\nvalida: NADA_A_DESCARTAR\nlê: wardrobe_items, reactions\nusa: Guard.requireCanCreate, Guard.requireOwner,\nMediaService.deleteUrl;
  endswitch
  note right
  Outras ações deste RF:
  RF4 · Estúdio — aprova a foto…, Nova tentativa de
  ler a marca…, RF4 · Estúdio — refaz a foto…,
  Analisar várias fotos de uma…, Cadastrar várias
  peças de uma…, Editar a peça
  end note
  |Tela (Next.js)|
  :Atualiza a tela;
endif
|Pessoa usuária|
stop
@enduml
