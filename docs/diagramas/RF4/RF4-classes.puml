@startuml RF4_Classes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  StereotypeFontColor #6B6470
}
hide empty members
left to right direction
title RF4 — Adicionar uma nova peça por busca catalogada, formulário & fotografia\nDiagrama de classes — gerado do código em 2026-10-14 (scripts/diagramas/v5)

package "fai-domain (entidades JPA)" {
  class Brand <<brands>> {
    +id: UUID
    +name: String
    +slug: String
    +logoUrl: String
    +website: String
    +source: BrandSource
    +catalogOrigin: CatalogOrigin
    +fixtureKey: String
    +sourceConfidence: BigDecimal
    +verifiedAt: Instant
    .. +3 campos ..
  }
  class BrandProfile <<brand_profiles>> {
    +id: UUID
    +owner: User
    +brandName: String
    +slug: String
    +logoUrl: String
    +coverUrl: String
    +bio: String
    +storeUrl: String
    +cnpj: String
    +razaoSocial: String
    .. +21 campos ..
  }
  class CatalogImage <<catalog_images>> {
    +id: UUID
    +productId: UUID
    +variantId: UUID
    +imageUrl: String
    +imageUrlHash: String
    +imageType: CatalogImageType
    +sourceUrl: String
    +sourceDomain: String
    +sourceType: CatalogSourceType
    +primary: boolean
    .. +21 campos ..
  }
  class CatalogProduct <<catalog_products>> {
    +id: UUID
    +brandId: UUID
    +category: String
    +subcategory: String
    +variationCode: String
    +variationStatus: String
    +variationConfidence: BigDecimal
    +variationSource: String
    +attributes: Set<TaxonomyAttribute>
    +productName: String
    .. +34 campos ..
  }
  class CatalogSource <<catalog_sources>> {
    +id: UUID
    +brandId: UUID
    +domain: String
    +sourceType: CatalogSourceType
    +country: String
    +allowsImagePersistence: boolean
    +active: boolean
    +notes: String
  }
  class CatalogVariant <<catalog_variants>> {
    +id: UUID
    +productId: UUID
    +variantKey: String
    +color: String
    +colorName: String
    +variantCode: String
    +sku: String
    +gtin: String
    +availability: String
    +price: java.math.BigDecimal
    .. +1 campos ..
  }
  class User <<users>> {
    +id: UUID
    +username: String
    +displayName: String
    +email: String
    +emailHash: String
    +emailVerified: boolean
    +phone: String
    +birthDate: String
    +passwordHash: String
    +profileType: ProfileType
    .. +25 campos ..
  }
  class WardrobeItem <<wardrobe_items>> {
    +id: UUID
    +user: User
    +brandProfile: BrandProfile
    +brand: Brand
    +name: String
    +category: String
    +subcategory: String
    +variationCode: String
    +variationStatus: String
    +variationConfidence: BigDecimal
    .. +73 campos ..
  }
  class Seal <<seals>> {
    +id: UUID
    +owner: User
    +name: String
    +tier: SealTier
    +policyText: String
    +status: SealStatus
    +iconUrl: String
    +premium: boolean
    +backgroundConfigJson: String
    +availableFrom: Instant
    .. +4 campos ..
  }
}
package "fai-domain (enums)" {
  enum ApprovalStatus {
    PENDENTE
    AJUSTES
    APROVADO
    RECUSADO
    SUSPENSO
  }
  enum CatalogImageUsage {
    REFERENCE_ONLY
    PERSISTED
    REJECTED
  }
  enum CatalogSourceStatus {
    ACTIVE
    UNAVAILABLE
    SOURCE_REMOVED
    NEEDS_REVALIDATION
  }
  enum CatalogIngestionStatus {
    DISCOVERED
    VALIDATED
    PERSISTABLE
    REFERENCE_ONLY
    REJECTED
  }
  enum AccountStatus {
    PENDING_EMAIL_VERIFICATION
    ACTIVE
    PENDING_VALIDATION
    SUSPENDED
    DELETION_SCHEDULED
    DELETED
  }
  enum AvailabilityStatus {
    AVAILABLE
    UNAVAILABLE
    ARCHIVED
  }
}
package "fai-application" {
  class CatalogService <<service>> {
    +search()
    +suggestions()
    +brandSuggestions()
    +browse()
    +product()
    +discover()
    +addToWardrobe()
  }
}
CatalogService ..> Brand : usa
CatalogService ..> CatalogImage : usa
CatalogService ..> CatalogProduct : usa
CatalogService ..> CatalogSource : usa
CatalogService ..> CatalogVariant : usa
Brand "*" --> "1" BrandProfile : brandProfile
BrandProfile "1" --> "1" User : owner
BrandProfile --> ApprovalStatus
CatalogImage --> CatalogImageUsage
CatalogProduct --> CatalogIngestionStatus
CatalogProduct --> CatalogSourceStatus
CatalogProduct ..> Brand : brandId
CatalogSource ..> Brand : brandId
Seal "*" --> "1" User : owner
User --> AccountStatus
WardrobeItem "*" --> "1" Brand : brand
WardrobeItem "*" --> "1" BrandProfile : brandProfile
WardrobeItem "*" --> "1" User : user
WardrobeItem --> AvailabilityStatus
@enduml
