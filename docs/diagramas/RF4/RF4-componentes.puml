@startuml RF4_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF4 — Adicionar uma nova peça por busca catalogada, formulário & fotografia\nDiagrama de componentes — gerado do código em 2026-10-14 (scripts/diagramas/v5)

package "Frontend (Next.js)" {
  component "/pieces/new\n(site)/(app)/pieces/new/page.tsx" as FE0
  component "/dna-schemes/[id]/edit\n(site)/(app)/dna-schemes/[id]/edit/page.tsx" as FE1
  component "/dna-schemes/new\n(site)/(app)/dna-schemes/new/page.tsx" as FE2
  component "/dna\n(site)/(app)/dna/page.tsx" as FE3
  component "/pieces/[id]\n(site)/(app)/pieces/[id]/page.tsx" as FE4
  component "/schemes/[id]/edit\n(site)/(app)/schemes/[id]/edit/page.tsx" as FE5
  component "lib/api/client.ts" as APIC
}
package "fai-web (REST)" {
  component "BrandLogoController\n/api/brand-logos\n/api/brand-search" as BrandLogoController
  component "CatalogController\n/api/catalog/brands\n/api/catalog/discover\n/api/catalog/search\n/api/catalog/stores\n(+2 rotas)" as CatalogController
  component "LensController\n/api/lens/scans\n/api/lens/scans/{…}/detections/{…}/own\n/api/lens/scans/{…}/image" as LensController
  component "SealController\n/api/schemes/{…}/seal-bonds\n/api/schemes/{…}/seal-suggestions\n/api/seal-bonds/{…}/accept\n/api/seal-suggestions/preview\n(+1 rotas)" as SealController
  component "WardrobeController\n/api/me/pieces/studio\n/api/pieces\n/api/pieces/analysis/batch\n/api/pieces/analysis/multi\n(+18 rotas)" as WardrobeController
}
package "fai-application (casos de uso)" {
  component "BrandLogoService" as BrandLogoService
  component "CatalogService" as CatalogService
  component "LensService" as LensService
  component "SealService" as SealService
  component "WardrobeService" as WardrobeService
  component "MultiPieceService" as MultiPieceService
  component "MediaService" as MediaService <<apoio>>
  component "CatalogIngestService" as CatalogIngestService <<apoio>>
  component "OfficialCatalogDiscovery" as OfficialCatalogDiscovery <<apoio>>
  component "HypeScoreConfig" as HypeScoreConfig <<apoio>>
  component "LensConfig" as LensConfig <<apoio>>
  component "NotificationService" as NotificationService <<apoio>>
  component "OwnMedia" as OwnMedia <<apoio>>
  component "FlatLayPipeline" as FlatLayPipeline <<apoio>>
  component "WebFetchPort\n«JdkWebFetchAdapter»" as WebFetchPort <<port>>
  component "MediaStoragePort\n«LocalFileMediaStorage / S3MediaStorageAdapter»" as MediaStoragePort <<port>>
  component "RateLimitPort\n«InMemoryRateLimit»" as RateLimitPort <<port>>
  component "JobQueuePort\n«InMemoryJobQueue»" as JobQueuePort <<port>>
}
package "fai-domain (repositórios)" {
  component "BrandLogoRepository\nBrandRepository\nWardrobeItemRepository\nCatalogProductRepository\nCatalogVariantRepository\nCatalogImageRepository\nCatalogProductAliasRepository\nCatalogSourceRepository\nBrandAliasRepository\nLensScanRepository\n(+23)" as REPO_MySQL
}
database "MySQL\n• brand_aliases\n• brand_logos\n• brand_profiles\n• brands\n• catalog_images\n• catalog_product_aliases\n• catalog_products\n• catalog_sources\n• catalog_variants\n• celebrity_profiles\n• garment_embeddings\n• hype_scores\n(+21)" as DB_MySQL
cloud "Motor de IA (RF24)\nprovedores externos + reserva local" as AI
component "Eventos de domínio\n(@TransactionalEventListener)" as EV
cloud "S3" as CL_S3
