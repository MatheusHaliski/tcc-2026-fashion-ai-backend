@startuml RF4_Pipeline_Filtro_Logo
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam activity {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  DiamondBackgroundColor #FFF5F8
  DiamondBorderColor #F08DB1
  StartColor #20A77A
  EndColor #4B5563
}
skinparam swimlane {
  BorderColor #CBC6BE
  TitleFontColor #2D2438
}
title RF4 — Pipeline de filtro do logo da marca\nDiagrama de atividades — gerado do código em 2026-10-14 (scripts/diagramas/v5)

|Pessoa usuária|
start
:Abre /pieces/new, /admin/system,\n/dna-schemes/[id]/edit;
|Tela (Next.js)|
:Carrega os dados da tela\nGET /api/brand-search\nGET /api/studio/backdrops\nGET /api/taxonomy\nGET /api/catalog/products;
|Pessoa usuária|
:Cadastrar a peça a partir do\nrascunho analisado;
|Tela (Next.js)|
:POST /api/pieces;
|API (Spring Boot)|
:WardrobeController.create\n→ WardrobeService.create;
if (formulario inválido?) then (sim)
  :400 FORMULARIO_INVALIDO\n«Corrija os campos destacados.»\n→ a tela mostra o aviso;
  stop
endif
if (erro?) then (sim)
  :500 ERRO\n→ a tela mostra o aviso;
  stop
endif
if (foto obrigatória?) then (sim)
  :400 FOTO_OBRIGATORIA\n«Envie uma foto ou escolha usar a\nimagem padrão da peça.»\n→ a tela mostra o aviso;
  stop
endif
if (conteúdo bloqueado?) then (sim)
  :400 CONTEUDO_BLOQUEADO\n«A foto viola a política de\nconteúdo e não pode ser usada.»\n→ a tela mostra o aviso;
  stop
endif
|Dados e serviços|
:Lê: users\npipeline_jobs\nwardrobe_items\nreactions;
:Usa: Guard.requireCanCreate\nAssetCatalogService.defaultPieceImage\nAssetCatalogService.publicFile\nAssetCatalogService.defaultPieceLogo\nMediaService.put\nMediaService.read (+4);
:IA: STUDIO_ENHANCER;
:Grava: wardrobe_items\nquality_scores\nprocessing_jobs_log\nmoderation_queue\npipeline_jobs;
:Estado: imageUrl → set\nthumbnailUrl → set\noriginalImageUrl → null\nmoderationStatus → APPROVED\nphotoProcessingStatus → COMPLETED\ndefaultImage → true (+10);
:Evento: PieceCreated\nPieceCapturedFromSession;
|Tela (Next.js)|
:Atualiza a tela com a resposta;
|Pessoa usuária|
if (Faz outra ação?) then (sim)
  switch (Qual?)
  case (Reprocessar remoção de fundo)
    :POST /api/pieces/{id}/background-removal\n→ WardrobeService.removeBackground\nlê: wardrobe_items\nusa: Guard.requireCanCreate, Guard.requireOwner,\nMediaService.read …\nia: FLAT_LAY_STANDARDIZER, STUDIO_ENHANCER;
  case (Várias peças numa foto: a IA acha…)
    :POST /api/pieces/analysis/multi\n→ MultiPieceService.detect\nlê: users\nusa: Guard.requireCanCreate,\nBrandReader.available,\nBrandReader.findRobust …\nia: MULTI_PIECE_DETECTOR;
  case (RF4 · Estúdio — refaz a foto de e…)
    :POST /api/pieces/analysis/{draftId}/studio\n→ WardrobeService.studioDraft\nvalida: ERRO, ESTUDIO_INDISPONIVEL, SEM_RECORTE\nlê: pipeline_jobs\nusa: MediaService.read, MediaService.put\nia: STUDIO_ENHANCER;
  case (Nova tentativa de ler a marca: gr…)
    :POST /api/pieces/analysis/{draftId}/brand\n→ WardrobeService.retryBrand\nvalida: ERRO\nlê: pipeline_jobs\nusa: MediaService.read, MediaService.put\nia: PIECE_ANALYZER;
  case (Selos possíveis para uma peça ain…)
    :POST /api/seal-suggestions/preview-piece\n→ SealService.previewPiece\nia: SEALBOND_MATCHER;
  endswitch
  note right
  Outras ações deste RF:
  RF4 · Estúdio — gera/refaz a…, Substituir a foto
  da peça (re…, Cópia da peça por IA: recria…,
  Rascunho de uma peça da foto…, RF4 · Estúdio —
  leva ao estúd…, Rascunho da peça com a cópia…
  end note
  |Tela (Next.js)|
  :Atualiza a tela;
endif
|Pessoa usuária|
stop
@enduml
