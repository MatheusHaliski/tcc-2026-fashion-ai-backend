@startuml RF40_Roupa_Atividades
title RF40 — Avatar 3D: montagem da roupa (caimento de tecido, acabamentos e tênis) sobre o corpo com esqueleto\nDiagrama de atividades
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 18
skinparam ArrowColor #52606D
skinparam activity {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  DiamondBackgroundColor #FFF5F8
  DiamondBorderColor #F08DB1
  StartColor #20A77A
  EndColor #4B5563
  BarColor #4B4B4B
}
skinparam swimlane {
  BorderColor #CBC6BE
  TitleFontColor #2D2438
}
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
|HumanOutfit (navegador)|
start
:Recebe as peças do look (provador, espelho, perfil);
:kindOf(categoria, subcategoria) → molde\n(tee, shirt, hoodie, coat, jeans, dress, …);
if (Falta parte de cima, de baixo ou calçado?) then (sim)
  :Completa com as peças padrão FAI\n(nunca sem roupa; tênis FAI se descalço);
endif
:Ordena as camadas (base → intermediária → externa);
:bodyParam(asset, composed) — eixos, ombros, punhos, quadril;
:smoothBody — corpo suavizado (sem relevo de mamilos,\numbigo e costelas na roupa);
repeat
  :garmentGeometry — casca a partir do corpo suavizado,\ncom folga do molde e da camada de baixo;
  :relaxGarment — caimento (Laplaciano/Taubin)\nsem atravessar o corpo;
  :foldGarment — dobras discretas nos tecidos moles;
  :collarBand + garmentTrims — gola, barra e punhos\ncomo faixas 3D na cor do acabamento da foto;
  :texturedGeometry + garmentMaterial — foto da peça\ncomo textura, cor do tecido nas áreas sem foto;
repeat while (Mais peças?) is (sim)
->não;
:shoeParts — tênis/sapato com sola, cabedal e cadarço\nnas cores da foto (ou padrão FAI);
:Prende cada malha aos ossos (pesos do vértice\ndo corpo mais próximo) — acompanha a pose;
:Pose natural (respiração, apoio) e render;
stop
@enduml
