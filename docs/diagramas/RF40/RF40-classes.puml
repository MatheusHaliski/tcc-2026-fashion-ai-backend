@startuml RF40_Classes
title RF40 — Criar o próprio avatar 3D a partir de fotos, através da aba "Meu Avatar 3D", e usá-lo no manequim da Passarela 3D, do Meu Quarto e do Espelho\nDiagrama de classes — entidades JPA reais (fai-domain) e enums
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  HeaderBackgroundColor #E4DEF0
}
skinparam packageStyle rectangle
hide empty methods

package "fai-domain · model" {
class User {
  +username: String
  +displayName: String
  +avatarUrl: String
  +profileType: ProfileType
  +mannequinSex: MannequinSex
  .. +campos do RF1/RF3 ..
}
class UserAvatar3d {
  +user: User
  +modelVersion: int
  +modelJson: String
  +adjustJson: String
  +textureKey: String
  +photosCount: int
  +warningsJson: String
  +publicOnRunway: boolean
  +consentAt: Instant
  +textureModeration: ModerationStatus
}
class AiInferenceLog {
  +userId: UUID
  +capability: String
  +provider: String
  +result: AiCallResult
  +fallbackUsed: boolean
}
}
package "fai-domain · enums" {
enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED_POLICY
  REJECTED_NOT_CLOTHING
}
enum ProfileType {
  PESSOAL
  MARCA
  CELEBRIDADE
}
}
package "fai-application · service" {
class Avatar3dService {
  +get(user): Map
  +save(user, SaveCommand, texture): Map
  +update(user, SettingsCommand): Map
  +delete(user): void
  +deleteAllFor(userId): void
  +texture(viewer, ownerId): byte[]
  +forMannequin(ownerId, viewerId): Optional<Map>
  ~moderateTexture(userId, jpeg): ModerationStatus
  {static} ~publicTexture(a): boolean
}
class "Avatar3dService.SaveCommand" as SaveCmd <<record>> {
  +model: Map
  +adjust: Map
  +photos: Integer
  +warnings: List<String>
  +consent: Boolean
  +publicOnRunway: Boolean
}
class "Avatar3dService.SettingsCommand" as SetCmd <<record>> {
  +adjust: Map
  +publicOnRunway: Boolean
  +body: Map
  +sex: String
}
class ShowcaseService {
  ~mannequin(user, peças, viewer): Map
}
class AiEngine {
  +text(TextCall): AiOutcome
}
}
UserAvatar3d "1" --> "1" User : user
UserAvatar3d --> ModerationStatus : textureModeration
User --> ProfileType
Avatar3dService ..> UserAvatar3d
Avatar3dService ..> SaveCmd
Avatar3dService ..> SetCmd
Avatar3dService --> AiEngine : CONTENT_MODERATOR
AiEngine ..> AiInferenceLog : grava
ShowcaseService --> Avatar3dService : forMannequin
note top of UserAvatar3d : tabela user_avatars_3d (V25)\num avatar por pessoa; textura em chave privada
note top of User : tabela users
note top of AiInferenceLog : tabela ai_inference_log — ver RF24 (motor de IA)
note bottom of ShowcaseService : head=AVATAR na Passarela 3D e na Foto com meu manequim;\nMeu Quarto e Espelho: não implementado — conforme Trello (CA10)
@enduml
