@startuml RF40_Componentes
title RF40 — Criar o próprio avatar 3D a partir de fotos (aba "Meu Avatar 3D") e usá-lo no manequim\nDiagrama de componentes — pipeline no navegador, API do avatar e uso no manequim
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #4A4852
}
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}

package "Frontend (Next.js · React Three Fiber)" {
  package "Aba Meu Avatar 3D" {
    component "avatar/page.tsx\n→ my-avatar.tsx\n(Create · Saved)" as FMy
    component "body-editor.tsx\n(BodyEditor: corpo inteiro)" as FBody
  }
  package "lib/avatar3d (no navegador)" {
    component "pipeline.ts\nanalyzePhoto · buildAvatar · atlasBlob" as LPipe
    component "detect.ts · body-detect.ts\nsex-detect.ts" as LDetect
    component "quality.ts\ncheckPhoto · checkSet" as LQual
    component "geometry.ts · image-stats.ts\natlas.ts · hair*.ts" as LGeo
    component "model.ts · body-spec.ts\nvalidateModel · clampAdjust\nvalidateBody" as LModel
    component "human/export-glb.ts\nexportAvatarGlb" as LGlb
  }
  component "public/mediapipe\nface_landmarker · hair_segmenter\npose_landmarker · selfie_multiclass\nface-api (self-hosted)" as FMp
  package "components/three" {
    component "avatar-viewer.tsx\n(prévia girável)" as FViewer
    component "mannequin.tsx\nMannequin" as FMan
    component "human-avatar.tsx + human-outfit.tsx\n(corpo vestido: ver RF40-roupa-no-avatar)" as FHuman
    component "avatar-bust.tsx\nuseAvatarTexture" as FBust
  }
  package "Onde o avatar aparece" {
    component "generate-3d.tsx · mannequin-photo.tsx\n→ look-viewer.tsx\n(Passarela 3D, Foto com meu manequim)" as FShow
    component "try-on/page.tsx\n→ fitting-room-scene.tsx (RF18)" as FTry
    component "mirror-stage.tsx (Espelho, RF28)" as FMirror
    component "room-scene.tsx (Meu Quarto)" as FRoom <<planejado>> #FFF5F8
  }
  component "lab/avatar · lab/body · lab/human\n(só com AVATAR_LAB fora de produção)" as FLab
}

package "fai-web" {
  component "Avatar3dController\n/api/me/avatar3d\n/api/avatar3d/{userId}/texture" as CAv
  component "ShowcaseController\n/api/schemes/{id}/look3d\n/api/pieces/{id}/look3d" as CShow
  component "TryOnController\n/api/try-on" as CTry
}

package "fai-application" {
  component "Avatar3dService" as SAv
  component "ShowcaseService\nmannequin (head = AVATAR)" as SShow
  component "TryOnService\nresolve (digital double)" as STry
  component "AccountService\npurgeScheduledDeletions" as SAcc
  component "AiEngine\nCONTENT_MODERATOR" as SAi
  component "Audit" as SAud
  interface "MediaStoragePort" as IMedia <<port>>
  interface "AiProviderPort" as IAi <<port>>
  interface "AuditService" as IAud <<port>>
}

package "fai-domain" {
  component "UserAvatar3dRepository" as RAv
}

package "fai-infrastructure" {
  component "LocalFileMediaStorage\nS3MediaStorageAdapter" as AStore
  component "provedores de IA\n(adapters de AiProviderPort)" as AAi
  component "MysqlAuditService" as AAud
}

database "MySQL\n• user_avatars_3d (V25; V27 texture_moderation)\n• ai_inference_log · audit_log" as DB
database "Storage\nrestricted/users/{id}/avatar3d/\n(/media/restricted/** só ADMIN)" as ST

FMy --> LPipe : analyzePhoto · buildAvatar
FMy --> FBody
FBody --> LDetect : detectBody
LPipe --> LDetect
LPipe --> LQual
LPipe --> LGeo
LPipe --> LModel
LDetect --> FMp : carrega modelos
FMy --> FViewer
FMy --> LGlb : baixar GLB
FViewer --> FMan
FMan --> FHuman
FMan --> FBust : textura do rosto
FShow --> FMan
FTry --> FMan
FMirror --> FViewer
FLab --> LPipe

FMy --> CAv : GET · POST · PATCH · DELETE
FMirror --> CAv : GET /api/me/avatar3d
FBust --> CAv : GET …/texture
FShow --> CShow
FTry --> CTry
FRoom ..> CAv : CA10 ainda não usa

CAv --> SAv
CShow --> SShow
CTry --> STry
SShow --> SAv : forMannequin
STry --> SAv : forMannequin
SAcc --> SAv : deleteAllFor
SAv --> RAv
SAv --> IMedia
SAv --> SAi : moderateTexture
SAv --> SAud
SAud --> IAud
SAi --> IAi
IMedia <|.. AStore
IAi <|.. AAi
IAud <|.. AAud
RAv --> DB
AAud --> DB
SAi --> DB : ai_inference_log
AStore --> ST
@enduml
