@startuml RF41_Atividades
title RF41 — Ganhar FAI Points em todos os jogos (FLAIR e Desafios) e ao criar esquemas e peças\nDiagrama de atividades — de onde vêm os pontos e como a mesma regra decide se paga
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 18
skinparam ArrowColor #52606D
skinparam activity {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  DiamondBackgroundColor #FFF5F8
  DiamondBorderColor #F08DB1
  StartColor #20A77A
  EndColor #4B5563
  BarColor #4B4B4B
}
skinparam swimlane {
  BorderColor #CBC6BE
  TitleFontColor #2D2438
}
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
start
:Pessoa joga ou cria algo no app;
if (O que a pessoa faz?) then (joga)
  switch (Qual jogo?)
  case (duelo 1×1)
    :FlairService.duel\n(vs @usuário ou a Casa)\n→ game(FLAIR_DUEL,\npartida, resultado);
  case (15 modos)
    :FlairModesService.finish\n→ game(FLAIR_<MODO>,\npartida, resultado);
  case (times 3×3)
    :FlairService.teamBattle\nquem disparou: game(FLAIR_TEAM,\npartida, WIN ou PLAYED)\n+ cada membro vencedor:\naward(GAME_WON);
  case (Arena do dia)
    :FlairService.joinArena\n→ game(FLAIR_ARENA,\ndata) — só jogar;
  case (quest)
    :FlairService.claimQuest\n(feita e não resgatada)\n→ award(FLAIR_QUEST);
  case (Desafio)
    :ChallengeService.submitEntry\n→ game(CHALLENGE, desafio)\n1× por desafio;\nconclude → award(\nCHALLENGE_COMPLETED);
  endswitch
  :FaiPointsService.game() (duelo, modos, times, Arena, inscrição):\naward(GAME_PLAYED, ref jogo:partida) +5\ne, se WIN, award(GAME_WON, mesma ref) +10\n(quest e desafio concluído chamam award() direto);
else (cria)
  :SchemeService.create (Criar Look, Smart Mirror/Vista-me,\nDNA, Autopiloto, Provador; o remix também termina aqui)\n→ SchemeSaved(created = true) → SCHEME_CREATED +40;
  :WardrobeService.create / update → PieceCreated / PieceUpdated\n→ PIECE_CATALOGED +25 (foto real e completude ≥ 60%,\nno cadastro ou quando a edição deixa pronta)\n→ PIECE_COMPLETED +10 (completude ≥ 90%);
  :Model3dService conclui o 3D → awardIsolated(PIECE_3D) +15;
  note right
    Os eventos rodam depois do commit
    (WardrobeEventListeners + SideEffectRunner):
    falha nos pontos não desfaz a criação.
    Copiar a peça de outra pessoa
    (POST /api/pieces/{id}/copy) não pontua.
  end note
endif
:FaiPointsService.award(userId, actionCode, refType, refId, override);
if (Regra em fai_points_rules e ativa?) then (não)
  :Não paga\n("ação sem regra");
elseif (Chave usuário:ação:ref\njá existe?) then (sim)
  :Não paga\n("evento já pontuado":\na partida nunca paga 2×);
elseif (Contagem do dia ≥ dailyCap\n(ou da semana ≥ weeklyCap)?) then (sim)
  :Não paga\n(capReached = true);
  note right
    Tetos: GAME_PLAYED 6/dia · GAME_WON 4/dia ·
    FLAIR_QUEST 3/dia (= 100 pts/dia em jogos) ·
    SCHEME_CREATED 5/dia · PIECE_CATALOGED 10/dia.
    O teto nunca impede de jogar ou criar.
  end note
else (paga)
  :INSERT fai_points_ledger\n(+pontos, countsLifetime = true)\n+ notificação FAI_POINTS (extrato);
  if (Vitalício cruzou o próximo nível?) then (sim)
    :setLevel + ROOM_LEVEL_UP (RF30);
  endif
endif
if (A resposta do jogo traz faiPoints?) then (duelo · modos · times)
  :Tela de resultado mostra "+N FAI Pts" ao lado das\nFLAIR Coins (flair/page.tsx · modes-shared.tsx);
else (Arena · quest · Desafio · criações)
  :Aparece só no extrato (/notifications?cat=POINTS)\ne no saldo de /points;
  note right
    <<planejado>> selo "+N FAI Pts" na Arena e na
    inscrição em Desafio (RF40-RF41.md: pendente)
  end note
endif
stop
@enduml
