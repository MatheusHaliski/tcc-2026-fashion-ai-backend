@startuml RF41_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF41 — Ganhar FAI Points em todos os jogos (FLAIR e Desafios) e ao criar esquemas e peças\nDiagrama de componentes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "Frontend (Next.js)" {
  component "/challenges/[id]\n(site)/(app)/challenges/[id]/page.tsx" as FE0
  component "/challenges\n(site)/(app)/challenges/page.tsx" as FE1
  component "/flair\n(site)/(app)/flair/page.tsx" as FE2
  component "/points\n(site)/(app)/points/page.tsx" as FE3
  component "/schemes/[id]/edit\n(site)/(app)/schemes/[id]/edit/page.tsx" as FE4
  component "/schemes/new\n(site)/(app)/schemes/new/page.tsx" as FE5
  component "lib/api/client.ts" as APIC
}
package "fai-web (REST)" {
  component "ChallengeController\n/api/challenges/{…}/notes" as ChallengeController
  component "FlairController\n/api/flair/me" as FlairController
  component "HighlightsController\n/api/me/points" as HighlightsController
  component "RoomController\n/api/me/room" as RoomController
}
package "fai-application (casos de uso)" {
  component "ChallengeService" as ChallengeService
  component "FlairService" as FlairService
  component "FaiPointsService" as FaiPointsService
  component "RoomService" as RoomService
  component "NotificationService" as NotificationService <<apoio>>
  component "MediaService" as MediaService <<apoio>>
  component "SideEffectRunner" as SideEffectRunner <<apoio>>
  component "SchemeService" as SchemeService <<apoio>>
  component "InstitutionalService" as InstitutionalService <<apoio>>
  component "HypeScoreConfig" as HypeScoreConfig <<apoio>>
  component "RoomLayoutAccess" as RoomLayoutAccess <<apoio>>
  component "WardrobeCreatorService" as WardrobeCreatorService <<apoio>>
}
package "fai-domain (repositórios)" {
  component "ChallengeTemplateRepository\nChallengeInstanceRepository\nChallengeParticipantRepository\nChallengeEventRepository\nChallengeNoteRepository\nChallengeVoteRepository\nWardrobeItemRepository\nSchemeRepository\nSchemeItemRepository\nDailyLookRepository\n(+23)" as REPO_MySQL
}
database "MySQL\n• brand_profiles\n• challenge_events\n• challenge_instances\n• challenge_notes\n• challenge_participants\n• challenge_templates\n• challenge_votes\n• daily_looks\n• fai_points_ledger\n• fai_points_rules\n• flair_coin_entries\n• flair_combinations\n(+21)" as DB_MySQL
cloud "Motor de IA (RF24)\nprovedores externos + reserva local" as AI
component "Eventos de domínio\n(@TransactionalEventListener)" as EV
APIC --> ChallengeController : HTTPS/JSON
APIC --> FlairController : HTTPS/JSON
APIC --> HighlightsController : HTTPS/JSON
APIC --> RoomController : HTTPS/JSON
ChallengeController --> ChallengeService
ChallengeService --> REPO_MySQL
ChallengeService ..> FaiPointsService
ChallengeService ..> MediaService
ChallengeService ..> NotificationService
ChallengeService ..> RoomService
ChallengeService ..> SideEffectRunner
FE0 --> APIC
FE1 --> APIC
FE2 --> APIC
FE3 --> APIC
FE4 --> APIC
FE5 --> APIC
FaiPointsService --> REPO_MySQL
FaiPointsService ..> NotificationService
FaiPointsService ..> RoomLayoutAccess
FaiPointsService ..> WardrobeCreatorService
FlairController --> FlairService
FlairService --> REPO_MySQL
FlairService ..> FaiPointsService
FlairService ..> HypeScoreConfig
FlairService ..> InstitutionalService
FlairService ..> SchemeService
HighlightsController --> FaiPointsService
REPO_MySQL --> DB_MySQL : JPA/Flyway
RoomController --> RoomService
RoomService --> AI
RoomService --> EV
RoomService --> REPO_MySQL
RoomService ..> SideEffectRunner
@enduml
