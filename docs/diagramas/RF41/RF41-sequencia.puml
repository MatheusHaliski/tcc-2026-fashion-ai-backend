@startuml RF41_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."
title RF41 — Ganhar FAI Points em todos os jogos (FLAIR e Desafios) e ao criar esquemas e peças\nDiagrama de sequência — gerado do código em 2026-10-06 (scripts/diagramas/v5)

actor "Pessoa usuária" as U
boundary "Tela /flair" as P
control "FlairController" as FlairController
participant "FlairService" as FlairService
participant "Guard" as Guard
participant "SchemeService" as SchemeService
database "MySQL" as DB_MySQL
participant "HypeScoreConfig" as HypeScoreConfig
== FLAIR — duelo de estilo 1×1 (5 rodadas) contra @usuário ou contra a C… ==
U -> P : FLAIR — duelo de estilo 1×1 (5 rodadas) contra @u…
P -> FlairController : POST /api/flair/duels
FlairController -> FlairService : duel()
activate FlairService
FlairService -> Guard : requireCanCreate()
FlairService -> SchemeService : owned()
SchemeService -> DB_MySQL : SELECT schemes
SchemeService --> FlairService
alt deck arquivado
FlairService --> FlairController : 400 DECK_ARQUIVADO
FlairController --> P : 400 + mensagem
end
FlairService -> DB_MySQL : SELECT scheme_items
FlairService -> HypeScoreConfig : algorithmVersion()
FlairService -> DB_MySQL : SELECT hype_scores
alt deck vazio
FlairService --> FlairController : 400 DECK_VAZIO
FlairController --> P : 400 + mensagem
end
FlairService -> DB_MySQL : SELECT wardrobe_items
FlairService -> HypeScoreConfig : algorithmVersion()
FlairService -> DB_MySQL : SELECT hype_scores
FlairService -> DB_MySQL : SELECT users
alt duelo consigo
FlairService --> FlairController : 400 DUELO_CONSIGO
FlairController --> P : 400 + mensagem
end
FlairService -> DB_MySQL : SELECT schemes
FlairService -> SchemeService : canView()
FlairService -> DB_MySQL : SELECT scheme_items
FlairService -> FlairService : new FlairMatch()
FlairService -> FlairService : status = FINISHED
FlairService -> DB_MySQL : SELECT users
FlairService -> DB_MySQL : INSERT/UPDATE flair_matches
FlairService -> DB_MySQL : SELECT users
FlairService -> FlairService : new FlairMatchEntry()
FlairService -> DB_MySQL : INSERT/UPDATE flair_match_entries
FlairService -> FlairService : new FlairMatchEntry()
FlairService -> DB_MySQL : INSERT/UPDATE flair_match_entries
note over FlairService : … e mais 25 passos no código
deactivate FlairService
FlairService --> FlairController : resultado
FlairController --> P : 201 JSON
P --> U : atualiza a tela
@enduml
