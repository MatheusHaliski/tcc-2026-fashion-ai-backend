@startuml RF42_Classes
title RF42 — Marcar um look como "Look do dia"\nDiagrama de classes — DailyLook, DailyLookService, LookbookService, painel v2 (HypeScoreService) e sinais LOOK_WORN/PIECE_USED
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  HeaderBackgroundColor #E4DEF0
}
skinparam packageStyle rectangle
hide empty methods

package "fai-application · service" {
  class DailyLookService {
    +register(user, Scheme, DailyLookSource, date): DailyLook
    +today(userId): Optional<DailyLook>
    +feedback(user, date, DailyLookFeedback): Map
    +history(user): List<Map>
    +pendingFeedback(user): Map
    +view(DailyLook): Map
  }
  class LookbookService {
    +dailyLookTab(user, withAi): Map
    +markDailyLook(user, schemeId): Map
    +setPanelVersion(user, HypeScorePanelVersion): Map
    {static} +panelVersions(): List<Map>
  }
  class HypeScoreService {
    {static} +MAGAZINE_MIN_LEVEL = TRENDING
    +panel(DailyLook, withAi): Map
    {static} ~localTip(Scheme, dims): String
    ~currentV2(HypeEntityType, id): HypeScoreCurrent
    {static} +v2Summary(HypeScoreCurrent, cfg, now): Map
    {static} +magazineCover(v2): Map
  }
  class SchemeService {
    +owned(user, id): Scheme
    +create(user, SchemeForm): Map
  }
  class WardrobeEventListeners {
    +onDailyLook(DailyLookRegistered)
  }
  class PreferenceModel {
    ~peso por feedback (ADOREI · NAO_USEI · NAO_GOSTEI)
  }
}

package "fai-application · events e hype" {
  class "DomainEvents.DailyLookRegistered" as DLR <<record>> {
    +userId: UUID
    +schemeId: UUID
    +date: LocalDate
    +source: String
    +pieceIds: List<UUID>
  }
  class HypeSignalRecorder {
    +onDailyLook(DailyLookRegistered)
  }
  class HypeIntegrityPolicy {
    {static} ~OWNER_ACTIONS = {PIECE_USED, PIECE_IN_LOOK, LOOK_WORN}
    +weight(HypeSignal, day): double
  }
  class HypeLiveRecalc {
    +onDailyLook(DailyLookRegistered)
  }
}

package "fai-domain · model" {
  class DailyLook <<table daily_looks>> {
    +user: User
    +scheme: Scheme
    +materializedFrom: DailyLook
    +lookDate: LocalDate
    +source: DailyLookSource = MANUAL
    +feedback: DailyLookFeedback
    +feedbackAt: Instant
    +weekPlanDayId: String
  }
  class Scheme <<table schemes>> {
    +lookDoDia: boolean
    +lookDoDiaCount: int
    +status: SchemeStatus
    +likeCount · commentCount · shareCount · remixCount
  }
  class WardrobeItem <<table wardrobe_items>> {
    +disponivel: boolean
    +availabilityStatus: AvailabilityStatus
    +lookDoDiaCount: int
    +wearCount: int
    +lastWornDate: LocalDate
  }
  class User <<table users>> {
    +lookDoDiaPanelVersion: HypeScorePanelVersion
  }
  class HypeScoreCurrent <<table hype_scores>> {
    +entityType: HypeEntityType
    +score: BigDecimal
    +level: HypeLevel
    +dimensions: HypeDimensions
    +status: HypeStatus
    +calculatedAt: Instant
  }
  class HypeSignalDaily <<table hype_signal_daily>> {
    +signalType: HypeSignalType
    +signalDate: LocalDate
    +eventCount: int
    +weightedCount: BigDecimal
  }
}

package "fai-domain · enums" {
  enum DailyLookSource {
    MANUAL
    AUTOPILOTO
    COPILOT
    VISTA_ME
    SMART_MIRROR
  }
  enum DailyLookFeedback {
    ADOREI
    NAO_USEI
    NAO_GOSTEI
  }
  enum HypeScorePanelVersion {
    SPOTLIGHT_CLASSICO
    PASSARELA
    RAIO_X_ESTILO
    BENTO_DIA
    EDITORIAL_MINIMAL
    COACH_ESTILO
  }
  enum "HypeSignalType (trecho)" as HST {
    LOOK_WORN
    PIECE_USED
  }
}

package "fai-domain · repository" {
  interface DailyLookRepository {
    +findByUserIdAndLookDate(userId, date): Optional<DailyLook>
    +findFirstByUserIdAndLookDateBeforeOrderByLookDateDesc(userId, date)
    +findTop60ByUserIdOrderByLookDateDesc(userId): List<DailyLook>
    +findByLookDate(date): List<DailyLook>
    +countByUserIdAndFeedback(userId, feedback): long
  }
}

DailyLook "*" --> "1" User : user
DailyLook "*" --> "1" Scheme : scheme
DailyLook "0..1" --> "0..1" DailyLook : materializedFrom
DailyLook --> DailyLookSource
DailyLook --> DailyLookFeedback
User --> HypeScorePanelVersion
LookbookService --> DailyLookService
LookbookService --> HypeScoreService : panel
LookbookService --> SchemeService : owned
DailyLookService --> DailyLookRepository
DailyLookService ..> DLR : publica
DailyLookService ..> WardrobeItem : lookDoDiaCount · lastWornDate
SchemeService --> DailyLookService : register (lookDoDia)
HypeScoreService ..> HypeScoreCurrent : só lê
WardrobeEventListeners ..> DLR : ouve
HypeSignalRecorder ..> DLR : ouve
HypeLiveRecalc ..> DLR : ouve (markDirty)
HypeSignalRecorder --> HypeIntegrityPolicy
HypeSignalRecorder ..> HypeSignalDaily : LOOK_WORN · PIECE_USED
HypeSignalDaily --> HST
PreferenceModel ..> DailyLook : feedback

note bottom of DailyLook
  uq_daily_looks_user_date (user_id, look_date):
  um Look do Dia por pessoa e dia; marcar de novo
  troca o look e a origem na mesma linha.
end note
note right of HypeScoreService
  Painel v2 só leitura: o GET nunca recalcula.
  tip = dica local (ou STYLE_ADVISOR com withAi);
  sem dados = status, nunca 0.
end note
@enduml
