  component "/schemes/new\n(site)/(app)/schemes/new/page.tsx" as FE1
  component "/u/[username]\n(site)/(app)/u/[username]/page.tsx" as FE2
  component "lib/api/client.ts" as APIC
}
package "fai-web (REST)" {
  component "LookbookController\n/api/me/daily-look\n/api/me/daily-look-tab\n/api/me/daily-looks\n/api/me/daily-looks/{…}/feedback" as LookbookController
  component "SchemeController\n/api/schemes\n/api/schemes/{…}" as SchemeController
  component "ShowcaseController\n/api/explorer/runway" as ShowcaseController
}
package "fai-application (casos de uso)" {
  component "LookbookService" as LookbookService
  component "DailyLookService" as DailyLookService
  component "SchemeService" as SchemeService
  component "ShowcaseService" as ShowcaseService
  component "WardrobeService" as WardrobeService <<apoio>>
  component "SocialService" as SocialService <<apoio>>
  component "HypeScoreService" as HypeScoreService <<apoio>>
  component "OwnMedia" as OwnMedia <<apoio>>
  component "BackgroundStudioService" as BackgroundStudioService <<apoio>>
  component "SealService" as SealService <<apoio>>
  component "SchemeCardRenderer" as SchemeCardRenderer <<apoio>>
  component "ProjectionService" as ProjectionService <<apoio>>
  component "CounterStorePort\n«InMemoryCounterStore»" as CounterStorePort <<port>>
}
package "fai-domain (repositórios)" {
  component "SchemeRepository\nSchemeItemRepository\nWardrobeItemRepository\nSavedItemRepository\nUserRepository\nAcervoGroupRepository\nSchemeGroupingRepository\nDailyLookRepository\nReactionRepository\nStyleDnaRepository\n(+4)" as REPO_MySQL
}
database "MySQL\n• acervo_groups\n• celebrity_profiles\n• daily_looks\n• follows\n• hype_scores\n• reactions\n• saved_items\n• scheme_groupings\n• scheme_items\n• schemes\n• style_dna\n• user_preferences\n(+2)" as DB_MySQL
