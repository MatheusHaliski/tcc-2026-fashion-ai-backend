@startuml RF42_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."
title RF42 — Marcar um look como 'Look do dia'\nDiagrama de sequência — gerado do código em 2026-10-06 (scripts/diagramas/v5)

actor "Pessoa usuária" as U
boundary "Tela /schemes/[id]/edit" as P
control "LookbookController" as LookbookController
participant "LookbookService" as LookbookService
participant "SchemeService" as SchemeService
database "MySQL" as DB_MySQL
participant "DailyLookService" as DailyLookService
== Marcar esquema como Look do Dia ==
U -> P : Marcar esquema como Look do Dia
P -> LookbookController : POST /api/me/daily-look
LookbookController -> LookbookService : markDailyLook()
activate LookbookService
LookbookService -> SchemeService : owned()
SchemeService -> DB_MySQL : SELECT schemes
SchemeService --> LookbookService
LookbookService -> DailyLookService : register()
DailyLookService -> DB_MySQL : SELECT scheme_items
DailyLookService -> DB_MySQL : SELECT users
DailyLookService -> DB_MySQL : SELECT daily_looks
DailyLookService -> DB_MySQL : INSERT/UPDATE daily_looks
DailyLookService --> LookbookService
LookbookService -> DailyLookService : view()
deactivate LookbookService
LookbookService --> LookbookController : resultado
LookbookController --> P : 201 JSON
P --> U : atualiza a tela
== Feedback do look (ADOREI / OK / NAO_CURTI) alimenta as preferências ==
U -> P : Feedback do look (ADOREI / OK / NAO_CURTI) alimen…
P -> LookbookController : PUT /api/me/daily-looks/{date}/feedback
LookbookController -> DailyLookService : feedback()
activate DailyLookService
DailyLookService -> DB_MySQL : SELECT daily_looks (×2)
DailyLookService -> DailyLookService : new DailyLook()
DailyLookService -> DB_MySQL : INSERT/UPDATE daily_looks
DailyLookService -> DB_MySQL : SELECT daily_looks
DailyLookService -> DailyLookService : feedback = ?feedback
DailyLookService -> DailyLookService : feedbackAt = set
DailyLookService -> DB_MySQL : INSERT/UPDATE daily_looks
deactivate DailyLookService
DailyLookService --> LookbookController : resultado
LookbookController --> P : 200 JSON
P --> U : atualiza a tela
@enduml
