@startuml RF43_Classes
title RF43 — Autopiloto gera combinações de vestimentas com IA\nDiagrama de classes — AutopilotService (Hoje e Semana), motor local, LookScorer/RecommendationScoring, WeekPlan e insights AUTOPILOT
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  HeaderBackgroundColor #E4DEF0
}
skinparam packageStyle rectangle
hide empty methods

package "fai-application · service" {
  class AutopilotService {
    {static} +MIN_PIECES = 3
    {static} ~W_OCCASION = 0.35
    {static} ~W_CLIMATE = 0.25
    {static} ~W_PREFERENCE = 0.25
    {static} ~W_DIVERSITY = 0.15
    +daily(user, DailyRequest): Map
    +daily(user, DailyRequest, requiredPieceIds, weatherBand): Map
    +confirmDaily(user, pieceIds, title, occasion, mood): Map
    +planWeek(user, WeekRequest): Map
    +currentWeek(user): Map
    +editDay(user, dayId, pieceIds): Map
    +useDay(user, dayId): Map
    +discardWeek(user): Map
    ~candidates(userId, eligible, occasions, mood, ctx,\nexclude, alreadyUsed, limit, required): List<Candidate>
    ~pickWithAi(user, ranked, occasions, mood, ctx, holder): List<Map>
    ~scoresOf(userId, pool): Map<String, Scores>
    {static} ~byMode(pool, scores, Mode): List<Candidate>
    {static} ~attachScores(picks, pool, scores, Mode): List<Map>
    ~createScheme(user, pieceIds, title, occasion, SchemeOrigin, …): Scheme
    ~gap(DayRequest, eligible, ctx): Map
    ~planView(user, WeekPlan): Map
    {static} ~inferOccasion(event): String
  }
  class "AutopilotService.DailyRequest" as DailyRequest <<record>> {
    +occasion: List<String>
    +mood: String
    +city: String
    +latitude: Double
    +longitude: Double
    +excludeKeys: List<String>
    +mode: String
  }
  class "AutopilotService.WeekRequest" as WeekRequest <<record>> {
    +weekStart: LocalDate
    +days: List<DayRequest>
    +city: String
    +latitude · longitude: Double
  }
  class "AutopilotService.DayRequest" as DayRequest <<record>> {
    +date: LocalDate
    +event: String
    +occasion: String
  }
  class "AutopilotService.Candidate" as Candidate <<record>> {
    +pieces: List<WardrobeItem>
    +key: String
    +score: double
    +criteria: Map<String, Double>
    +composition: Composition
  }
  class LookScorer {
    ~scoreLooks(userId, looks): List<Scores>
    ~scoreCards(user, cards, Mode): List<Map>
  }
  class PreferenceModel {
    +of(userId): Model
  }
  class WeatherService {
    +resolve(latitude, longitude, city): Context
    {static} +withBand(Context, band): Context
    {static} +unsuitable(subcategory, band): boolean
    {static} +isLayer(subcategory): boolean
  }
  class DailyLookService {
    +register(user, scheme, DailyLookSource, date): DailyLook
  }
}

package "fai-application · ai, hype e insights" {
  class LocalSchemeComposer {
    {static} +compose(wardrobe, occasions, styles, season, mood, limit): List<Composition>
    {static} +slotOf(WardrobeItem): SchemeSlot
  }
  class AiEngine {
    +text(TextCall): AiOutcome
  }
  class RecommendationScoring <<final>> {
    {static} +rankValue(Mode, Scores): double
  }
  enum "RecommendationScoring.Mode" as Mode {
    SAFE
    DISCOVERY
    EXPERIMENTAL
    {static} +parse(raw): Mode
  }
  class "RecommendationScoring.Scores" as Scores <<record>> {
    +compatibility · hype · novelty: Integer
    +reuse · usage · sustainability: Integer
  }
  class InsightService {
    +itemsOrEmpty(user, InsightContext.AUTOPILOT): List<Map>
  }
}

package "fai-domain · model" {
  class WeekPlan <<table week_plans>> {
    +user: User
    +weekStart: LocalDate
    +status: WeekPlanStatus = ACTIVE
    +gapsJson: String
  }
  class WeekPlanDay <<table week_plan_days>> {
    +weekPlan: WeekPlan
    +dayDate: LocalDate
    +eventLabel: String
    +occasion: String
    +scheme: Scheme
    +pieceIdsJson: String
    +combinationKey: String
    +rationale: String
    +editedManually: boolean
  }
  class Scheme <<table schemes>> {
    +origin: SchemeOrigin
    +creationMode: CreationMode
  }
  class DailyLook <<table daily_looks>> {
    +lookDate: LocalDate
    +source: DailyLookSource
    +weekPlanDayId: String
  }
  class WardrobeItem <<table wardrobe_items>> {
    +disponivel: boolean
    +subcategory: String
    +occasionTags: String
    +wearCount: int
  }
}

package "fai-domain · enums" {
  enum WeekPlanStatus {
    ACTIVE
    DISCARDED
    COMPLETED
  }
  enum "SchemeOrigin (trecho)" as SO {
    AUTOPILOTO
  }
  enum "DailyLookSource (trecho)" as DLS {
    AUTOPILOTO
  }
}

package "fai-domain · repository" {
  interface WeekPlanRepository {
    +findFirstByUserIdAndStatusOrderByWeekStartDesc(userId, status): Optional<WeekPlan>
  }
  interface WeekPlanDayRepository {
    +findByWeekPlanIdOrderByDayDate(weekPlanId): List<WeekPlanDay>
  }
}

AutopilotService ..> DailyRequest
AutopilotService ..> WeekRequest
WeekRequest *-- "0..7" DayRequest
AutopilotService ..> Candidate
AutopilotService *-- "1" LookScorer : mesma régua do Copilot
AutopilotService --> PreferenceModel : preferências .25
AutopilotService --> WeatherService
AutopilotService --> AiEngine : COPILOT (escolhe 3)
AutopilotService ..> LocalSchemeComposer : candidatas e fallback
AutopilotService --> InsightService : AUTOPILOT
AutopilotService --> DailyLookService : register(AUTOPILOTO)
AutopilotService --> WeekPlanRepository
AutopilotService --> WeekPlanDayRepository
DailyRequest ..> Mode : mode (parse)
LookScorer ..> RecommendationScoring
RecommendationScoring ..> Scores
RecommendationScoring ..> Mode
Candidate "*" --> "2..*" WardrobeItem
WeekPlan "1" *-- "0..7" WeekPlanDay : dias (7 ao planejar;\napagados ao descartar)
WeekPlan --> WeekPlanStatus
WeekPlanDay "*" --> "0..1" Scheme : look usado
DailyLook ..> WeekPlanDay : weekPlanDayId
Scheme --> SO
DailyLook --> DLS

note bottom of WeekPlanStatus
  COMPLETED existe no enum, mas nenhum
  código atribui esse estado.
end note
note right of Candidate
  score = .35 ocasião + .25 clima
  + .25 preferências + .15 diversidade;
  os seis números (Scores) só reordenam
  quando há modo.
end note
@enduml
