hide empty members
left to right direction
title RF43 — Autopiloto gera combinações de vestimentas com IA de acordo com as especificações do usuário\nDiagrama de classes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "fai-domain (entidades JPA)" {
  class DailyLook <<daily_looks>> {
    +id: UUID
    +user: User
    +scheme: Scheme
    +materializedFrom: DailyLook
    +lookDate: LocalDate
    +source: DailyLookSource
    +feedback: DailyLookFeedback
    +feedbackAt: Instant
    +weekPlanDayId: UUID
  }
  class Scheme <<schemes>> {
    +id: UUID
    +user: User
    +originalScheme: Scheme
    +title: String
    +description: String
    +creationMode: CreationMode
    +origin: SchemeOrigin
    +style: String
    +occasion: String
    +season: Season
    .. +46 campos ..
  }
  class SchemeItem <<scheme_items>> {
    +id: UUID
    +scheme: Scheme
    +wardrobeItem: WardrobeItem
    +slot: SchemeSlot
    +tryOnLayer: TryOnLayer
    +sortOrder: int
    +zIndex: int
    +positionX: BigDecimal
    +positionY: BigDecimal
    +scale: BigDecimal
    .. +4 campos ..
  }
  class User <<users>> {
    +id: UUID
    +username: String
    +displayName: String
    +email: String
    +emailHash: String
    +emailVerified: boolean
    +phone: String
    +birthDate: String
    +passwordHash: String
    +profileType: ProfileType
    .. +24 campos ..
  }
  class WardrobeItem <<wardrobe_items>> {
    +id: UUID
    +user: User
    +brandProfile: BrandProfile
    +brand: Brand
    +name: String
    +category: String
    +subcategory: String
    +sex: String
    +brandName: String
    +brandLogoUrl: String
    .. +70 campos ..
  }
  class WeekPlan <<week_plans>> {
    +id: UUID
    +user: User
    +weekStart: LocalDate
    +status: WeekPlanStatus
    +gapsJson: String
  }
  class WeekPlanDay <<week_plan_days>> {
    +id: UUID
    +weekPlan: WeekPlan
    +dayDate: LocalDate
    +eventLabel: String
    +occasion: String
    +scheme: Scheme
    +pieceIdsJson: String
    +combinationKey: String
    +rationale: String
    +editedManually: boolean
  }
}
package "fai-domain (enums)" {
  enum SchemeStatus {
    DRAFT
    PUBLISHED
    ARCHIVED
  }
  enum RenderStatus {
    PENDING
    RENDERING
    ENHANCING
    COMPOSITING
    CACHED
    COMPLETED
    FAILED
  }
  enum AccountStatus {
    PENDING_EMAIL_VERIFICATION
    ACTIVE
    PENDING_VALIDATION
    SUSPENDED
    DELETION_SCHEDULED
    DELETED
  }
  enum AvailabilityStatus {
    AVAILABLE
    UNAVAILABLE
    ARCHIVED
  }
  enum ModerationStatus {
    PENDING
    APPROVED
    REJECTED_POLICY
    REJECTED_NOT_CLOTHING
  }
  enum PhotoProcessingStatus {
    NEW
    MODERATING
    PROCESSING
    COMPLETED
    NEEDS_REUPLOAD
    FAILED
  }
}
package "fai-application" {
  class AutopilotService <<service>> {
    +daily()
    +confirmDaily()
    +planWeek()
    +currentWeek()
    +editDay()
    +useDay()
    +discardWeek()
  }
}
AutopilotService ..> Scheme : usa
AutopilotService ..> SchemeItem : usa
AutopilotService ..> User : usa
AutopilotService ..> WardrobeItem : usa
AutopilotService ..> WeekPlan : usa
AutopilotService ..> WeekPlanDay : usa
DailyLook "*" --> "1" Scheme : scheme
DailyLook "*" --> "1" User : user
Scheme "*" --> "1" User : user
Scheme --> RenderStatus
Scheme --> SchemeStatus
SchemeItem "*" --> "1" Scheme : scheme
SchemeItem "*" --> "1" WardrobeItem : wardrobeItem
User --> AccountStatus
WardrobeItem "*" --> "1" User : user
WardrobeItem --> AvailabilityStatus
WardrobeItem --> ModerationStatus
WardrobeItem --> PhotoProcessingStatus
WeekPlan "*" --> "1" User : user
WeekPlanDay "*" --> "1" Scheme : scheme
WeekPlanDay "*" --> "1" WeekPlan : weekPlan
@enduml
