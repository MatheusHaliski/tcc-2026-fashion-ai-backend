@startuml RF43_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF43 — Autopiloto gera combinações de vestimentas com IA de acordo com as especificações do usuário\nDiagrama de componentes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "Frontend (Next.js)" {
  component "/autopilot\n(site)/(app)/autopilot/page.tsx" as FE0
  component "/pieces/new\n(site)/(app)/pieces/new/page.tsx" as FE1
  component "lib/api/client.ts" as APIC
}
package "fai-web (REST)" {
  component "AutopilotController\n/api/autopilot/daily\n/api/autopilot/days/{…}\n/api/autopilot/weeks" as AutopilotController
}
package "fai-application (casos de uso)" {
  component "AutopilotService" as AutopilotService
  component "WardrobeService" as WardrobeService <<apoio>>
  component "SchemeService" as SchemeService <<apoio>>
  component "DailyLookService" as DailyLookService <<apoio>>
  component "PreferenceModel" as PreferenceModel <<apoio>>
  component "WeatherService" as WeatherService <<apoio>>
  component "HypeQueryService" as HypeQueryService <<apoio>>
  component "InsightService" as InsightService <<apoio>>
}
package "fai-domain (repositórios)" {
  component "WardrobeItemRepository\nSchemeRepository\nSchemeItemRepository\nWeekPlanRepository\nWeekPlanDayRepository\nUserRepository\nUserPreferencesRepository\nStyleDnaRepository" as REPO_MySQL
}
database "MySQL\n• scheme_items\n• schemes\n• style_dna\n• user_preferences\n• users\n• wardrobe_items\n• week_plan_days\n• week_plans" as DB_MySQL
cloud "Motor de IA (RF24)\nprovedores externos + reserva local" as AI
APIC --> AutopilotController : HTTPS/JSON
AutopilotController --> AutopilotService
AutopilotService --> AI
AutopilotService --> REPO_MySQL
AutopilotService ..> DailyLookService
AutopilotService ..> HypeQueryService
AutopilotService ..> InsightService
AutopilotService ..> PreferenceModel
AutopilotService ..> SchemeService
AutopilotService ..> WardrobeService
AutopilotService ..> WeatherService
FE0 --> APIC
FE1 --> APIC
REPO_MySQL --> DB_MySQL : JPA/Flyway
@enduml
