@startuml RF43_MaquinaDeEstados_Sugestao
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  StartColor #20A77A
  EndColor #4B5563
}
title RF43 — ciclo de vida de WeekPlan.status\nDiagrama de máquina de estados — gerado do código em 2026-10-06 (scripts/diagramas/v5)\nenum WeekPlanStatus · tabela week_plans

state "WeekPlan.status" as Ciclo_WeekPlan {
  state Ciclo_WeekPlan_ACTIVE as "ACTIVE"
  state Ciclo_WeekPlan_DISCARDED as "DISCARDED"
  state Ciclo_WeekPlan_COMPLETED as "COMPLETED"
}
[*] --> Ciclo_WeekPlan_ACTIVE : criação
Ciclo_WeekPlan --> Ciclo_WeekPlan_ACTIVE : planWeek()\nPOST /api/autopilot/weeks
Ciclo_WeekPlan --> Ciclo_WeekPlan_DISCARDED : discardWeek(), planWeek()
note bottom of Ciclo_WeekPlan
  Sem mudança explícita no código para: COMPLETED
  (valor vindo de importação, regra calculada ou dado legado)
end note
note right of Ciclo_WeekPlan
  Setas que saem da borda: a mudança vale
  a partir de qualquer estado (o código não
  testa o estado anterior).
end note
@enduml
