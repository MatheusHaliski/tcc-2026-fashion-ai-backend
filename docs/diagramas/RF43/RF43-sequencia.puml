@startuml RF43_Sequencia
title RF43 — Autopiloto gera combinações de vestimentas com IA\nDiagrama de sequência — aba Hoje: POST /api/autopilot/daily (motor, modo, seis números, IA com fallback, insights AUTOPILOT) e confirmação
skinparam backgroundColor #FFFFFF
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
}
autonumber
actor "Pessoa" as U
participant "autopilot/page.tsx\nLookScores · InsightStrip" as FE
participant "AutopilotController" as AC
participant "AutopilotService" as AP
participant "WeatherService\n(OpenMeteoAdapter)" as WS
participant "LocalSchemeComposer\nPreferenceModel" as LC
participant "LookScorer\nRecommendationScoring" as LSC
participant "AiEngine (RF24)\nCOPILOT" as AI
participant "InsightService\n(PersonalInsights)" as IS
participant "SchemeService\nDailyLookService" as SD
database "MySQL" as DB

U -> FE: ocasião, humor, cidade e modo (SAFE padrão)
FE -> AC: POST /api/autopilot/daily {occasion, mood, city, mode, excludeKeys}
AC -> AP: daily(user, DailyRequest)
AP -> DB: wardrobe_items elegíveis (WardrobeService.eligible)
alt menos de 3
  AP --> FE: 422 ACERVO_INSUFICIENTE {href: /pieces/new, pieces}
else
  AP -> WS: resolve(lat, lon, city)
  WS --> AP: Context {band, season, note, available}
  AP -> LC: compose(peças adequadas ao clima, ocasiões, estação, humor, 60)
  AP -> LC: PreferenceModel.of(userId).pieceScore(look)
  AP -> AP: nota = ocasião .35 + clima .25 + preferências .25\n+ diversidade .15; sem excludeKeys; 30 melhores
  alt nenhuma candidata
    AP --> FE: 200 {weather, suggestions: [], message}
  else
    AP -> LSC: scoreLooks(userId, 10 primeiras)
    LSC -> DB: style_dna · pares já usados · hype_scores (HypeQueryService)
    LSC --> AP: Scores {compatibility, hype, novelty, reuse, usage, sustainability}
    opt Mode.parse(mode) ≠ nulo
      AP -> AP: byMode: ordena por rankValue(mode, scores)
    end
    AP -> AI: text(COPILOT, "escolha 3 de c1..c10 e justifique", JSON)
    alt resposta válida
      AI --> AP: picks {ref, rationale}
    else IA indisponível, sem cota ou JSON inválido
      AI --> AP: fallback local (3 primeiras, localRationale)
    end
    AP -> AP: suggestionView (key, title, pieceIds, pieces, criteria,\nrationale, mannequin) + attachScores (com modo, reordena e renumera)
    AP -> IS: itemsOrEmpty(user, AUTOPILOT)
    IS --> AP: insights (redescoberta, peças paradas, DNA, Hype ao lado)\n— falha = lista vazia
    AP --> FE: 200 {weather, suggestions[{…, scores}], mode, excludeKeys, fallbackUsed,\nexplanation, quota, message, weatherNotice?, notice?, insights}
  end
end
FE -> FE: cards com LookScores; InsightStrip(preset = insights)
note right of FE: A tela lê p.why ?? p.reason, mas a API manda\n"rationale": a justificativa não aparece (divergência).

opt "Outras opções"
  FE -> AC: POST /api/autopilot/daily {…, excludeKeys acumuladas}
end
U -> FE: "Usar hoje" num look
FE -> AC: POST /api/autopilot/daily/confirmation {pieceIds, title, occasion, mood}
AC -> AP: confirmDaily(user, pieceIds, title, occasion, mood)
AP -> AP: createScheme(…, AUTOPILOTO)
alt menos de 2 peças
  AP --> FE: 400 SEM_PECAS
else peça de outra pessoa
  AP --> FE: 403 (Guard.requireOwner)
else mesma combinação já salva
  AP -> DB: reaproveita o look existente
else
  AP -> SD: SchemeService.create (AI_ASSISTED, origin AUTOPILOTO)
  SD -> DB: INSERT schemes · scheme_items
end
AP -> SD: DailyLookService.register(user, scheme, AUTOPILOTO, hoje)
alt peça indisponível
  SD --> FE: 409 PECA_INDISPONIVEL
else
  SD -> DB: INSERT/UPDATE daily_looks
  SD ->> SD: DailyLookRegistered (AFTER_COMMIT: diário, LOOK_WORN, PIECE_USED)
  AP --> FE: 201 {schemeId, dailyLook}
  FE -> FE: redireciona para /schemes/{schemeId}
end
@enduml
