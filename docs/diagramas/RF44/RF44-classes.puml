@startuml RF44_Classes
title RF44 — FAI Creative Engine\nDiagrama de classes — serviços criativos reais, motor de IA (RF24) e portas de provedor de imagem
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  HeaderBackgroundColor #E4DEF0
}
skinparam packageStyle rectangle
hide empty methods
hide empty fields

package "fai-application · serviços criativos" {
  class BackgroundStudioService <<Service>> {
    +catalog(): Map
    +recommend(styles, occasions): Map
    +generateArt(CurrentUser, ArtRequest): Map
    +upload(CurrentUser, byte[], String target): Map
    +applyToScheme(Scheme, Map config, boolean)
    +savePiece(CurrentUser, UUID, Object cfg): Map
    +generateSkinThumbnail(CurrentUser, String, boolean): Map
  }
  class "BackgroundStudioService.ArtRequest" as ArtRequest <<record>> {
    prompt: String
    direction: String
    celebrityId: UUID
    era: String
    passePartout: boolean
    target: String
  }
  class WardrobeService <<Service>> {
    +studioPiece(CurrentUser, UUID, String): PieceView
    +approveStudio(CurrentUser, UUID): PieceView
    +discardStudio(CurrentUser, UUID): PieceView
    +studioAll(CurrentUser, String): Map
    ~offerStudio(WardrobeItem, Map, boolean): String
  }
  class StudioPipeline <<Component>> {
    +SIZE = 1600
    +BACKDROPS: List<Backdrop> (7 fundos)
    +externalAvailable(): boolean
    +run(BufferedImage cutout, String backdropId,\n  boolean allowExternal, Hints): Result
  }
  class "StudioPipeline.Result" as StudioResult <<record>> {
    studioJpeg, thumbJpeg, detailJpeg, feedJpeg: byte[]
    enhancedPng: byte[]
    backdrop: Backdrop
    stages: List<Stage>
    costUsd: BigDecimal
    fallbackUsed: boolean
  }
  class MultiPieceService <<Service>> {
    +recreate(CurrentUser, UUID draftId, Integer, byte[],\n  name, category, color): AiImage
    +aiPieceDraft(CurrentUser, UUID draftId, UUID aiImageId): PieceDraft
    ~recreatePrompt(name, category, color): String
  }
  class "MultiPieceService.AiImage" as AiImage <<record>> {
    aiImageId: UUID
    previewUrl: String
    explanation: AiOutcome.Explanation
    quota: AiOutcome.Quota
  }
  class AiSeal <<final>> {
    HEIGHT_RATIO = 0.075
    MIN_HEIGHT = 22
    +{static} stamp(BufferedImage, String label): BufferedImage
  }
  class SealDesignService <<Service>> {
    +catalog(): Map
    +upload(CurrentUser, byte[]): Map
    +uploadCore(CurrentUser, byte[]): Map
  }
}

package "fai-application · ai (RF24)" {
  class AiEngine <<Service>> {
    +execute(UUID userId, AiCapability, List<String> inputs,\n  String prompt, Collection<String> protectedNames,\n  List<RemoteStep<T>>, Supplier<T> local): AiOutcome<T>
    +remoteAllowed(UUID, AiCapability): boolean
  }
  interface "AiEngine.RemoteStep<T>" as RemoteStep {
    +provider(): String
    +model(): String
    +available(): boolean
    +call(): RemoteResult<T>
  }
  class "AiOutcome<T>" as AiOutcome <<record>> {
    value: T
    inferenceId: UUID
    result: AiCallResult
    fallbackUsed: boolean
    provider, model: String
    latencyMs: long
    costUsd: BigDecimal
    userMessage: String
  }
  class CelebrityPromptValidator <<final>> {
    +{static} validate(String prompt,\n  Collection<String> names): Verdict
  }
  enum AiCapability {
    BACKGROUND_GENERATOR
    STUDIO_ENHANCER
    PIECE_IMAGE_RECREATOR
    FLAT_LAY_STANDARDIZER
    .. +22 capacidades ..
  }
}

package "fai-application · imaging · ImageProviderPorts" {
  interface ImageGenerationPort <<port>> {
    +available(): boolean
    +generate(prompt, negativePrompt,\n  width, height): Optional<ProviderImage>
  }
  interface ImageEditPort <<port>> {
    +available(): boolean
    +edit(byte[] image, String mimeType,\n  String prompt): Optional<ProviderImage>
  }
  interface StudioShotPort <<port>> {
    +available(): boolean
    +studio(cutoutPng, backgroundHex, width,\n  height, padding): Optional<ProviderImage>
  }
  interface UpscalePort <<port>> {
    +available(): boolean
    +upscale(byte[] png): Optional<ProviderImage>
  }
  class ProviderImage <<record>> {
    bytes: byte[]
    mimeType: String
    provider: String
    costUsd: BigDecimal
    latencyMs: long
    confidence: double
    metadata: Map
  }
}

package "fai-infrastructure · ai-providers" {
  class ReplicateImageGenerationAdapter <<adapter>> {
    FLUX schnell
  }
  class GeminiImageEditAdapter <<adapter>> {
    gemini-2.5-flash-image
  }
  class ReplicateImageEditAdapter <<adapter>> {
    flux-kontext-pro
  }
  class PhotoroomStudioAdapter <<adapter>>
  class StabilityUpscaleAdapter <<adapter>>
  class "AdobeFireflyAdapter" as Firefly <<planejado>> #FAFAFA
}

class Photo <<Entity>>
class WardrobeItem <<Entity>>
class PipelineJob <<Entity>>
class AiInferenceLog <<Entity>>

BackgroundStudioService ..> ArtRequest
BackgroundStudioService --> "0..*" ImageGenerationPort : fallback em ordem
BackgroundStudioService --> AiEngine
BackgroundStudioService ..> Photo : registra (BACKGROUND_STUDIO)
BackgroundStudioService ..> WardrobeItem : backgroundConfigJson (rev)
WardrobeService --> StudioPipeline
WardrobeService --> AiEngine : STUDIO_ENHANCER
WardrobeService ..> WardrobeItem : versão pendente / aprovada
StudioPipeline ..> StudioResult
StudioPipeline --> "0..*" StudioShotPort
StudioPipeline --> "0..*" UpscalePort
MultiPieceService --> "0..*" ImageEditPort
MultiPieceService --> AiEngine : PIECE_IMAGE_RECREATOR
MultiPieceService ..> AiSeal : carimba as versões
MultiPieceService ..> AiImage
MultiPieceService ..> PipelineJob : AI_PIECE_IMAGE
AiEngine ..> RemoteStep
AiEngine ..> AiOutcome
AiEngine ..> CelebrityPromptValidator
AiEngine ..> AiCapability
AiEngine --> AiInferenceLog : uma linha por tentativa
ImageGenerationPort ..> ProviderImage
ImageEditPort ..> ProviderImage
ImageGenerationPort <|.. ReplicateImageGenerationAdapter
ImageGenerationPort <|.. Firefly
ImageEditPort <|.. GeminiImageEditAdapter
ImageEditPort <|.. ReplicateImageEditAdapter
StudioShotPort <|.. PhotoroomStudioAdapter
UpscalePort <|.. StabilityUpscaleAdapter

note bottom of AiSeal
  RN46.03 hoje: selo "gerada por IA" no arquivo
  + flag WardrobeItem.aiGeneratedImage
end note
note bottom of CelebrityPromptValidator
  RN46.04 parcial: rejeita prompt com nome de
  celebridade cadastrada ou pedido de rosto
  (422 PROMPT_REJEITADO)
end note
note bottom of Firefly
  RN46.10: a porta já abstrai o provedor;
  Adobe só aparece como opção "firefly"
  no AiCatalog (sem adaptador)
end note
@enduml
