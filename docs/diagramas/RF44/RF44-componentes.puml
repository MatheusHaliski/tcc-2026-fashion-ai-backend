@startuml RF44_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF44 — Permitir que marcas & celebridades vendam itens únicos e personalizáveis do Meu Quarto e do Background Studio na loja do app\nDiagrama de componentes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "Frontend (Next.js)" {
  component "/brands/[slug]\n(site)/(app)/brands/[slug]/page.tsx" as FE0
  component "/dna-schemes/[id]/edit\n(site)/(app)/dna-schemes/[id]/edit/page.tsx" as FE1
  component "/dna-schemes/new\n(site)/(app)/dna-schemes/new/page.tsx" as FE2
  component "/dna\n(site)/(app)/dna/page.tsx" as FE3
  component "/pieces/new\n(site)/(app)/pieces/new/page.tsx" as FE4
  component "/points\n(site)/(app)/points/page.tsx" as FE5
  component "lib/api/client.ts" as APIC
}
package "fai-web (REST)" {
  component "BackgroundController\n/api/assets/skins\n/api/backgrounds/catalog\n/api/backgrounds/recommendations" as BackgroundController
  component "HighlightsController\n/api/me/room-inventory/{…}/apply\n/api/points/shop\n/api/points/shop/{…}/purchase\n/api/points/shop/{…}/try-on" as HighlightsController
  component "RoomController\n/api/me/room" as RoomController
  component "RoomCreatorController\n/api/room-creator/options" as RoomCreatorController
}
package "fai-application (casos de uso)" {
  component "BackgroundStudioService" as BackgroundStudioService
  component "AssetCatalogService" as AssetCatalogService
  component "FaiPointsService" as FaiPointsService
  component "RoomService" as RoomService
  component "WardrobeCreatorService" as WardrobeCreatorService
  component "MediaService" as MediaService <<apoio>>
  component "RoomLayoutAccess" as RoomLayoutAccess <<apoio>>
  component "NotificationService" as NotificationService <<apoio>>
  component "SideEffectRunner" as SideEffectRunner <<apoio>>
}
package "fai-domain (repositórios)" {
  component "AssetPresetRepository\nSchemeRepository\nWardrobeItemRepository\nUserRepository\nCelebrityProfileRepository\nFaiPointsLedgerEntryRepository\nFaiPointsRuleRepository\nRoomCatalogItemRepository\nRoomInventoryItemRepository\nRoomLayoutRepository\n(+10)" as REPO_MySQL
}
database "MySQL\n• asset_presets\n• brand_profiles\n• celebrity_profiles\n• daily_looks\n• fai_points_ledger\n• fai_points_rules\n• piece_usage_diary\n• room_catalog\n• room_inventory\n• room_layouts\n• room_storage_map\n• scheme_items\n(+8)" as DB_MySQL
cloud "Motor de IA (RF24)\nprovedores externos + reserva local" as AI
component "Eventos de domínio\n(@TransactionalEventListener)" as EV
APIC --> BackgroundController : HTTPS/JSON
APIC --> HighlightsController : HTTPS/JSON
APIC --> RoomController : HTTPS/JSON
APIC --> RoomCreatorController : HTTPS/JSON
AssetCatalogService --> REPO_MySQL
BackgroundController --> AssetCatalogService
BackgroundController --> BackgroundStudioService
BackgroundStudioService --> AI
BackgroundStudioService --> REPO_MySQL
BackgroundStudioService ..> AssetCatalogService
BackgroundStudioService ..> MediaService
FE0 --> APIC
FE1 --> APIC
FE2 --> APIC
FE3 --> APIC
FE4 --> APIC
FE5 --> APIC
FaiPointsService --> REPO_MySQL
FaiPointsService ..> NotificationService
FaiPointsService ..> RoomLayoutAccess
FaiPointsService ..> WardrobeCreatorService
HighlightsController --> FaiPointsService
REPO_MySQL --> DB_MySQL : JPA/Flyway
RoomController --> RoomService
RoomCreatorController --> WardrobeCreatorService
RoomService --> AI
RoomService --> EV
RoomService --> REPO_MySQL
RoomService ..> SideEffectRunner
WardrobeCreatorService --> REPO_MySQL
WardrobeCreatorService ..> MediaService
@enduml
