@startuml RF44_Componentes
title RF44 — FAI Creative Engine\nDiagrama de componentes — telas → controllers → serviços criativos → motor de IA e portas → provedores, storage e MySQL
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
left to right direction

package "Frontend (Next.js)" {
  component "schemes/new · schemes/[id]/edit\n(scheme-builder.tsx: arte por IA)" as FE_SB
  component "components/background-studio.tsx\n(catálogo, presets AURA, materiais)" as FE_BS
  component "pieces/[id] · detail-modal\n(expanded-card.tsx: foto de estúdio,\naprovar / descartar)" as FE_EC
  component "closet/page.tsx\n(estúdio em todas as peças)" as FE_CL
  component "components/multi-piece-review.tsx\n(cópia por IA; nenhuma página monta hoje)" as FE_MP
  component "brands/[slug] → seal-wizard.tsx\nseal-creator.tsx · seal-core-editor.tsx" as FE_SEAL
  component "lib/api/client.ts (api)" as FE_API
}
package "fai-web · controllers" {
  [BackgroundController\nPOST /api/backgrounds/art · uploads\nGET /api/backgrounds/catalog · recommendations\nPUT /api/pieces/{id}/background] as BC
  [SchemeController\nPOST /api/schemes · PUT /api/schemes/{id}] as SC
  [WardrobeController\nPOST /api/pieces/{id}/studio · studio/approve\nDELETE /api/pieces/{id}/studio/pending\nPOST /api/me/pieces/studio · GET /api/studio/backdrops\nPOST /api/pieces/analysis/multi/{draftId}/ai-image\nPOST …/ai-images/{aiImageId}/piece] as WC
  [SealController\nGET /api/seals/design-catalog\nPOST /api/seals/uploads] as SLC
  [CreativeController\n<<planejado>>] as CC #FAFAFA
}
package "fai-application · serviços criativos" {
  [BackgroundStudioService\ngenerateArt · applyToScheme · savePiece] as BSS
  [SchemeService] as SS
  [WardrobeService\nstudioPiece · approveStudio · discardStudio] as WS
  [StudioPipeline\n(+ FlatLayPipeline)] as SP
  [MultiPieceService\nrecreate · aiPieceDraft] as MPS
  [AiSeal] as SEAL
  [AssetCatalogService] as ACS
  [MediaService] as MS
  [SealDesignService] as SDS
  package "FAI Creative Engine <<planejado>>" {
    [CreativeRequest → TemplateResolver\n→ composição → validação\n→ CreativeAsset + AssetVersion] as CE #FAFAFA
  }
}
package "fai-application · ai (RF24)" {
  [AiEngine\nconsentimento · AiBudget · cota · fallback] as AIE
  [CelebrityPromptValidator] as CPV
  [AiCatalog\nopções por capacidade (inclui "firefly")] as CAT
}
package "Portas (ImageProviderPorts)" {
  interface "ImageGenerationPort" as IGP
  interface "ImageEditPort" as IEP
  interface "StudioShotPort" as SSP
  interface "UpscalePort" as UP
  interface "MediaStoragePort" as MSP
}
package "fai-infrastructure" {
  [ReplicateImageGenerationAdapter] as REPG
  [GeminiImageEditAdapter\nReplicateImageEditAdapter] as EDIT
  [PhotoroomStudioAdapter] as PHR
  [StabilityUpscaleAdapter] as STB
  [AdobeFireflyAdapter · Photoshop API\n<<planejado>>] as FF #FAFAFA
  [S3MediaStorageAdapter\nLocalFileMediaStorage] as S3
  [Repositórios JPA\nPipelineJobRepository · AiInferenceLogRepository\nPhotoRepository · WardrobeItemRepository\nSchemeRepository · CelebrityProfileRepository] as REPOS
}
database "MySQL\n• pipeline_jobs\n• ai_inference_log\n• photos\n• wardrobe_items (studio_*, background_config_json,\n  is_ai_generated_image, canonical_image_url)\n• piece_images (V29)\n• schemes · asset_presets" as DB
cloud "Replicate\n(FLUX schnell · FLUX Kontext)" as EXT_R
cloud "Google Gemini\n(2.5 Flash Image)" as EXT_G
cloud "Photoroom · Stability AI" as EXT_P
cloud "Adobe Firefly / Photoshop / Express\n<<planejado>>" as EXT_A
cloud "S3 / R2 / disco local" as EXT_S

FE_SB --> FE_API
FE_BS --> FE_API
FE_EC --> FE_API
FE_CL --> FE_API
FE_MP --> FE_API
FE_SEAL --> FE_API
FE_API --> BC : HTTPS/JSON
FE_API --> SC
FE_API --> WC
FE_API --> SLC
FE_API ..> CC : <<planejado>>
BC --> BSS
SC --> SS
SS --> BSS : applyToScheme
WC --> WS
WC --> MPS
SLC --> SDS
BSS --> ACS : presets e galeria
BSS --> AIE : BACKGROUND_GENERATOR
BSS --> IGP
BSS --> MS
WS --> AIE : STUDIO_ENHANCER
WS --> SP
WS --> MS
SP --> SSP
SP --> UP
MPS --> AIE : PIECE_IMAGE_RECREATOR
MPS --> IEP
MPS --> SEAL
MPS --> MS
SDS --> MSP
AIE --> CPV
AIE --> CAT
AIE --> REPOS : ai_inference_log
MS --> MSP
MS --> REPOS : photos
WS --> REPOS
MPS --> REPOS : pipeline_jobs
IGP <|.. REPG
IGP <|.. FF
IEP <|.. EDIT
SSP <|.. PHR
UP <|.. STB
MSP <|.. S3
REPG --> EXT_R
EDIT --> EXT_G
EDIT --> EXT_R
PHR --> EXT_P
STB --> EXT_P
FF ..> EXT_A
S3 --> EXT_S
REPOS --> DB : JPA / Flyway
CC ..> CE
CE ..> IGP : provedor criativo
note bottom of CE
  pipeline de confiança (RF4: original, recorte,
  canônico) × pipeline criativo (RF44): o criativo
  lê o canônico e nunca o substitui (RN46.01);
  geração em PipelineJob assíncrono (RN46.05)
end note
@enduml
