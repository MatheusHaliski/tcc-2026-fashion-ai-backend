@startuml RF44_MaquinaDeEstados_Venda
!pragma layout smetana
title RF44 — Venda de item único: do anúncio da marca (room_catalog) à unidade do comprador (room_inventory)
skinparam backgroundColor #FFFFFF
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  ArrowColor #52606D
}
state "Anúncio (RoomCatalogItem)" as Anuncio {
  [*] --> AVenda : POST /api/room-creator/items\n(active=true, sold_count=0)
  state "active=true" as AVenda {
    [*] --> Vendendo
    Vendendo --> Vendendo : POST /api/points/shop/{sku}/purchase\n(sold_count + 1)
    Vendendo --> Esgotado : sold_count = stock_limit\n(availability ESGOTADO)
    Vendendo --> ForaDaVitrine : criador suspenso/pendente\n(sellerActive = false)
    ForaDaVitrine --> Vendendo : criador volta a ACTIVE
  }
  AVenda --> Inativo : PUT .../items/{sku} active=false\nou DELETE com vendas
  state "active=false" as Inativo
  Inativo --> AVenda : PUT .../items/{sku} active=true
  AVenda --> [*] : DELETE sem vendas\n(linha apagada)
}
state "Unidade do comprador (RoomInventoryItem)" as Unidade {
  [*] --> Adquirida : buy(): INSERT room_inventory\nsource=PURCHASE, serial = sold_count
  state "appliedModule = null" as Adquirida
  state "appliedModule = <moduleId>" as Aplicada
  Adquirida --> Aplicada : POST /api/me/room-inventory/{id}/apply\n(compatibleModules, RoomService.applyFinish)
  Aplicada --> Aplicada : apply em outro módulo\n(ou moduleId=ALL para guarda-roupa inteiro)
}
Vendendo --> Adquirida : compra aprovada
note right of Vendendo : a compra passa por blocker(): nível, EM_BREVE/EXPIRADO,\nlimite por pessoa, selo exigido (SealBond APPROVED) e saldo.\nA janela de disponibilidade do item está no RF39\n(RF39_MaquinaDeEstados_ItemDaLoja) — não repetida aqui.
note bottom of Unidade : a unidade nunca é removida quando o anúncio\né desativado ou expira: quem comprou continua com ela
@enduml
