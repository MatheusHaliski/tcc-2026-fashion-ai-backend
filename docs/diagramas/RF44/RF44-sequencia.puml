@startuml RF44_Sequencia
title RF44 — FAI Creative Engine\nDiagrama de sequência — arte de fundo por IA (endpoints reais) e o motor criativo planejado
skinparam backgroundColor #FFFFFF
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
}
autonumber
actor "Pessoa" as U
participant "schemes/new · schemes/[id]/edit\n(scheme-builder.tsx)" as FE
participant "BackgroundController" as C
participant "SchemeController\n→ SchemeService" as SC
participant "BackgroundStudioService" as S
participant "AiEngine (RF24)" as AI
participant "CelebrityPromptValidator" as V
participant "ImageGenerationPort\n(ReplicateImageGenerationAdapter)" as P
participant "MediaService\n(→ MediaStoragePort)" as M
participant "FAI Creative Engine\n<<planejado>>" as CE #FAFAFA
database "MySQL" as DB

U -> FE: escolhe uma composição no modo IA
FE -> C: GET /api/backgrounds/recommendations?styles=…&occasions=…
C -> S: recommend(styles, occasions)
C --> FE: 200 direção recomendada (skin, aura, material)
FE -> C: POST /api/backgrounds/art {prompt, direction, passePartout}
C -> S: generateArt(user, ArtRequest)
alt perfil sem permissão de criar
  S --> FE: 403
else prompt vazio
  S --> FE: 400 PROMPT_VAZIO
end
S -> DB: SELECT celebrity_profiles (stageName, realName)
S -> AI: execute(BACKGROUND_GENERATOR, inputs, prompt da pessoa, protectedNames, steps, local = null)
AI -> V: validate(prompt, protectedNames)
alt cita celebridade ou pede rosto/retrato
  AI -> DB: INSERT ai_inference_log (PROMPT_REJECTED)
  AI --> FE: 422 PROMPT_REJEITADO {violations, inferenceId}
end
AI -> AI: consentimento, AiBudget.check, cota diária (RateLimitPort)
loop cada ImageGenerationPort disponível, até o primeiro que responder
  AI -> P: generate(prompt, negativePrompt, 896, 1344)
  P --> AI: ProviderImage(bytes, mimeType, provider, costUsd, latencyMs)
  AI -> DB: INSERT ai_inference_log (provider, model, latência, custo, SUCCESS | erro)
end
alt nenhum provedor devolveu imagem (ou IA remota indisponível)
  AI --> S: AiOutcome(value = null, userMessage)
  S -> S: gallerySuggestions(prompt) — até 6 presets AURA
  S --> FE: 200 {status: FALLBACK_GALLERY, message, suggestions}
  FE -> FE: mantém o preset recomendado
else imagem gerada
  AI --> S: AiOutcome(bytes, provider, latencyMs, costUsd, inferenceId)
  S -> S: cropTo(900 × 2160 | 900 × 2080)
  S -> M: put(users/{id}/backgrounds/{uuid}.png)
  S -> M: register(owner, PhotoOrigin.BACKGROUND_STUDIO, …, metadata {prompt, provider})
  M -> DB: INSERT photos
  S --> FE: 200 {status: READY, url, provider, latencyMs, costUsd, explanation, quota}
end
U -> FE: salva o look
FE -> SC: POST /api/schemes ou PUT /api/schemes/{id} {…, background}
SC -> S: applyToScheme(scheme, background, applyRecommendedDirection)
S -> DB: UPDATE schemes (background_art_url, background_color,\nbackground_gradient, animação…)
SC --> FE: 200 look salvo
note over S, DB: na peça: PUT /api/pieces/{id}/background com baseRev;\nrevisão diferente → 409 ARTE_ALTERADA; senão grava\nwardrobe_items.background_config_json (rev + 1).\nA foto da peça (original e recorte) não muda (RN46.01).
opt <<planejado>> — não implementado (RN46.02, RN46.05–RN46.07)
  FE -> CE: CreativeRequest {assetType, templateId, sourceAssetIds, prompt}
  CE -> DB: INSERT pipeline_jobs (PENDING)
  CE --> FE: 202 jobId (sem requisição bloqueante)
  CE -> CE: TemplateResolver (template versionado) + composição\ncom o asset canônico da peça (RF4)
  CE -> CE: provedor criativo (Adobe Firefly / Photoshop API) e validação de qualidade
  CE -> DB: CreativeAsset + AssetVersion + proveniência;\njob COMPLETED ou REQUIRES_REVIEW
end
@enduml
