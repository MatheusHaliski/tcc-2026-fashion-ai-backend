@startuml RF45_Atividades
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam activity {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  DiamondBackgroundColor #FFF5F8
  DiamondBorderColor #F08DB1
  StartColor #20A77A
  EndColor #4B5563
}
skinparam swimlane {
  BorderColor #CBC6BE
  TitleFontColor #2D2438
}
title RF45 — Processar e padronizar imagens canônicas de peças, calçados e acessórios (pipeline de validação e padronização)\nDiagrama de atividades — gerado do código em 2026-10-06 (scripts/diagramas/v5)

|Pessoa usuária|
start
:Abre /pieces/new;
|Tela (Next.js)|
:Carrega os dados da tela\nGET /api/studio/backdrops\nGET /api/taxonomy\nGET /api/pieces/{id};
|Pessoa usuária|
:RF4 · Estúdio — gera/refaz a foto de\nestúdio de uma peça ca…;
|Tela (Next.js)|
:POST /api/pieces/{id}/studio;
|API (Spring Boot)|
:WardrobeController.studioPiece\n→ WardrobeService.studioPiece;
if (sem recorte?) then (sim)
  :422 SEM_RECORTE\n«A peça precisa de uma foto própria\ncom o fundo removido para ir ao\nestúdio.»\n→ a tela mostra o aviso;
  stop
endif
if (Foto da peça não encontrado[a]?) then (sim)
  :404 NAO_ENCONTRADO\n«Foto da peça não encontrado(a)»\n→ a tela mostra o aviso;
  stop
endif
if (estudio indisponível?) then (sim)
  :503 ESTUDIO_INDISPONIVEL\n«Não deu para gerar o estúdio\nagora. Tente de novo em instantes.»\n→ a tela mostra o aviso;
  stop
endif
|Dados e serviços|
:Lê: wardrobe_items\nreactions;
:Usa: Guard.requireCanCreate\nGuard.requireOwner\nMediaService.read\nMediaService.put\nMediaService.deleteUrl;
:IA: STUDIO_ENHANCER;
:Estado: studioImageUrl → set\nstudioDetailUrl → set;
|Tela (Next.js)|
:Atualiza a tela com a resposta;
|Pessoa usuária|
if (Faz outra ação?) then (sim)
  switch (Qual?)
  case (Cadastrar a peça a partir do rasc…)
    :POST /api/pieces\n→ WardrobeService.create\nvalida: CONTEUDO_BLOQUEADO, ERRO,\nFORMULARIO_INVALIDO, FOTO_OBRIGATORIA\nlê: users, pipeline_jobs, wardrobe_items …\nusa: Guard.requireCanCreate, OwnMedia.accepts,\nMediaService.read …\nia: STUDIO_ENHANCER;
  case (Substituir a foto da peça [reproc…)
    :PUT /api/pieces/{id}/image\n→ WardrobeService.replaceImage\nlê: wardrobe_items, reactions\nusa: Guard.requireCanCreate, Guard.requireOwner,\nMediaService.put …\nia: STUDIO_ENHANCER;
  case (RF4 · Estúdio — leva ao estúdio a…)
    :POST /api/me/pieces/studio\n→ WardrobeService.studioAll\nlê: wardrobe_items\nusa: Guard.requireCanCreate,\nAssetCatalogService.publicFile,\nAssetCatalogService.defaultPieceLogo …\nia: STUDIO_ENHANCER;
  case (RF4 · Estúdio — refaz a foto de e…)
    :POST /api/pieces/analysis/{draftId}/studio\n→ WardrobeService.studioDraft\nvalida: ERRO, ESTUDIO_INDISPONIVEL, SEM_RECORTE\nlê: pipeline_jobs\nusa: MediaService.read, MediaService.put\nia: STUDIO_ENHANCER;
  case (RF4 · Estúdio — aprova a foto de…)
    :POST /api/pieces/{id}/studio/approve\n→ WardrobeService.approveStudio\nlê: wardrobe_items, reactions\nusa: Guard.requireCanCreate, Guard.requireOwner\nestado: studioImageUrl → set, studioDetailUrl → set;
  endswitch
  note right
  Outras ações deste RF:
  Nova tentativa de ler a marca…, Cadastrar várias
  peças de uma…, Reprocessar remoção de fundo, RF4 ·
  Estúdio — descarta a ve…, Editar a peça, Excluir a
  peça
  end note
  |Tela (Next.js)|
  :Atualiza a tela;
endif
|Pessoa usuária|
stop
@enduml
