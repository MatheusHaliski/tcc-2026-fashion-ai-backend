@startuml RF45_Atividades
!pragma layout smetana
title RF45 — FashionAI Lens\nDiagrama de atividades — captura → rostos borrados no aparelho → envio → peças → leitura, correspondências e Recriar → corrigir, Quero/Eu tenho e salvar
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 18
skinparam ArrowColor #52606D
skinparam activity {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  DiamondBackgroundColor #FFF5F8
  DiamondBorderColor #F08DB1
  StartColor #20A77A
  EndColor #4B5563
  BarColor #4B4B4B
}
skinparam swimlane {
  BorderColor #CBC6BE
  TitleFontColor #2D2438
}
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
|Pessoa (app)|
start
:Abre /lens (login obrigatório)\nCâmera · Galeria · Recentes;
:Tira a foto (input capture="environment")\nou escolhe uma imagem;
|Navegador (lib/lens/redact.ts)|
:Decodifica com a orientação do EXIF e redesenha\nnum canvas ≤ 2048 px (descarta EXIF/GPS);
if (MediaPipe Face Landmarker carregou?) then (sim)
  repeat
    :Acha rostos (até 3 por passada);
    :Pixela (≈ 6 blocos) e desfoca cada rosto;
  repeat while (Achou rosto novo e passadas < 4?) is (sim) not (não)
  :faces = rostos borrados;
else (não: offline, sem WebAssembly/WebGL,\nheadless ou tempo esgotado)
  :faces = -1;
endif
:Regrava em JPEG;
|Pessoa (app)|
:Vê a prévia já borrada;
if (faces = -1?) then (sim)
  :Marca "Confirmo que a foto não mostra\no rosto de ninguém (ou já recortei)";
endif
:Analisar;
|Backend|
:POST /api/lens/scans (multipart: image, source,\nintent, facesRedacted, redactionConfirmed);
:UploadSafetyInterceptor (ImageSafety);
if (Veredito?) then (BLOCK)
  #FFE3E3:422 IMAGEM_RECUSADA (nada guardado);
  stop
elseif (REVIEW) then
  #FFE3E3:Quarentena + fila do admin\n422 IMAGEM_EM_REVISAO;
  stop
else (ALLOW)
endif
:LensService.create;
if (Origem válida (CAMERA, GALLERY, UPLOAD)\ne arquivo com imagem legível?) then (não)
  #FFE3E3:400 ORIGEM_INVALIDA / ARQUIVO_VAZIO\n/ VALOR_INVALIDO;
  stop
endif
:Reduz a ≤ 2048 px;
if (Cota do dia (30 scans) disponível?) then (não)
  #FFE3E3:429 QUOTA {limit, used, resetAt}\n(nada gravado);
  stop
endif
:MultiPieceService.detectPieces via AiEngine\n(MULTI_PIECE_DETECTOR: consentimento\nAI_EXTERNAL_PHOTO_PROCESSING, cota, orçamento);
if (Resultado?) then (exceção)
  :Scan FAILED (a cota volta para a pessoa);
elseif (IA indisponível ou sem consentimento) then
  :Leitura LOCAL: 1 peça cobrindo a foto,\nsem categoria, confiança 0 (faixa baixa);\nerrorCode CONSENT_REQUIRED ou QUOTA;
  :Scan READY (aiSource = local);
elseif (0 peças) then
  :Scan NO_FASHION_FOUND;
else (≥ 1 peça)
  :Scan READY (aiSource = ia);
endif
:Grava JPEG sem metadados + miniatura 480 px\nem restricted/users/{id}/lens/{scanId}.jpg;
:Para cada peça (de cima para baixo):\nLensImageAnalysis do recorte → paleta com fração,\npadrão e embedding de 96 dimensões;
:Grava lens_scans + lens_detections\n(expires_at = criação + 30 dias);
:200 com o scan pronto (MVP síncrono);
note right
  <<planejado>> (especificação, fora do MVP):
  pipeline assíncrono (JobQueuePort, 202),
  borrão de rosto também no servidor,
  estado PARTIAL e evento LensScanCompleted
end note
|Pessoa (app)|
:/lens/{scanId}: imagem com hotspots,\nFoco (?focus=) e abas (?tab=);
fork
  :Leitura: estilos, paleta, ocasiões, estação\n(GET …/reading);
fork again
  :Seu guarda-roupa: peças próprias parecidas\n(GET …/matches?scope=MY_CLOSET, piso 55)\nou "sem correspondência" + lacuna (nunca 0%);
fork again
  :Recriar: plano por slots no modo\nSeguro / Descoberta / Experimental\n(POST …/recreate) → Salvar como look;
fork again
  :Estilo & Hype: compatibilidade com o DNA\ne Hype do grupo (≥ 5 peças públicas), separados;
fork again
  :Descobrir: peças públicas de outras pessoas\n(scope=COMMUNITY, piso 65; só semelhança);
end fork
note right
  <<planejado>>: Catálogo RF47 e peças à venda
  no Descobrir, provar o plano (RF18), modo
  ao vivo, "desde o scan" (LensDiff)
end note
|Backend|
:Camada viva calculada a cada leitura\n(guarda-roupa, DNA e Hype de agora);\nnunca escreve hype_signal_daily;
|Pessoa (app)|
if (A leitura está errada ou faltou peça?) then (sim)
  :Corrige chips (PATCH …/detections/{did}),\n"não é roupa" (dismissed) ou marca uma peça\n(POST …/detections, imagem inteira como caixa);
  |Backend|
  :Grava lens_feedback (training_consent só com\nAI_MODEL_TRAINING) e refaz as correspondências;
  |Pessoa (app)|
endif
:"Quero" (PUT …/want) ou "Eu tenho" (POST …/own:\nliga a uma peça sua ou abre /pieces/new pré-preenchido,\nnunca com o recorte da foto);
if (Salvar como inspiração?) then (sim)
  :PATCH /api/lens/scans/{id} {saved: true}: não expira;
else (não)
  |Backend|
  :LensRetentionJob (diário, 04:40): vencido o prazo,\napaga imagem, miniatura, peças e correções;
endif
stop
@enduml
