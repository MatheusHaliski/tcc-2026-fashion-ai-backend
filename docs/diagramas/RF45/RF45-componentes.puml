@startuml RF45_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF45 — Processar e padronizar imagens canônicas de peças, calçados e acessórios (pipeline de validação e padronização)\nDiagrama de componentes — gerado do código em 2026-10-14 (scripts/diagramas/v5)

package "Frontend (Next.js)" {
  component "/dna-schemes/[id]/edit\n(site)/(app)/dna-schemes/[id]/edit/page.tsx" as FE0
  component "/dna-schemes/new\n(site)/(app)/dna-schemes/new/page.tsx" as FE1
  component "/dna\n(site)/(app)/dna/page.tsx" as FE2
  component "/pieces/[id]\n(site)/(app)/pieces/[id]/page.tsx" as FE3
  component "/pieces/new\n(site)/(app)/pieces/new/page.tsx" as FE4
  component "/schemes/[id]/edit\n(site)/(app)/schemes/[id]/edit/page.tsx" as FE5
  component "lib/api/client.ts" as APIC
}
package "fai-web (REST)" {
  component "AdminController\n/api/admin/approvals/{…}\n/api/admin/moderation" as AdminController
  component "WardrobeController\n/api/me/pieces/studio\n/api/pieces\n/api/pieces/analysis/batch\n/api/pieces/analysis/multi\n(+15 rotas)" as WardrobeController
}
package "fai-application (casos de uso)" {
  component "IssuerReviewService" as IssuerReviewService
  component "AdminService" as AdminService
  component "WardrobeService" as WardrobeService
  component "MultiPieceService" as MultiPieceService
  component "SideEffectRunner" as SideEffectRunner <<apoio>>
  component "NotificationService" as NotificationService <<apoio>>
  component "IssuerVerificationPolicy" as IssuerVerificationPolicy <<apoio>>
  component "SealService" as SealService <<apoio>>
  component "MediaService" as MediaService <<apoio>>
  component "IdentityService" as IdentityService <<apoio>>
  component "AssetCatalogService" as AssetCatalogService <<apoio>>
  component "ChallengeService" as ChallengeService <<apoio>>
  component "EmailSenderPort\n«LoggingEmailSender / ResendEmailSender»" as EmailSenderPort <<port>>
  component "MediaStoragePort\n«LocalFileMediaStorage / S3MediaStorageAdapter»" as MediaStoragePort <<port>>
  component "AnalyticsQueryPort\n«MysqlAnalyticsAdapter»" as AnalyticsQueryPort <<port>>
  component "JobQueuePort\n«InMemoryJobQueue»" as JobQueuePort <<port>>
}
package "fai-domain (repositórios)" {
  component "UserRepository\nBrandProfileRepository\nCelebrityProfileRepository\nModerationQueueRepository\nWardrobeItemRepository\nCommentRepository\nAuditLogRepository\nAiInferenceLogRepository\nBackupRecordRepository\nBrandRepository\n(+8)" as REPO_MySQL
}
database "MySQL\n• ai_inference_log\n• audit_log\n• backup_records\n• brand_profiles\n• brands\n• celebrity_profiles\n• comments\n• moderation_queue\n• photos\n• pipeline_jobs\n• processing_jobs_log\n• quality_scores\n(+6)" as DB_MySQL
cloud "Motor de IA (RF24)\nprovedores externos + reserva local" as AI
component "Eventos de domínio\n(@TransactionalEventListener)" as EV
cloud "Resend" as CL_Resend
cloud "S3" as CL_S3
APIC --> AdminController : HTTPS/JSON
APIC --> WardrobeController : HTTPS/JSON
AdminController --> AdminService
AdminController --> IssuerReviewService
AdminService --> AI
AdminService --> AnalyticsQueryPort
AdminService --> REPO_MySQL
AdminService ..> AssetCatalogService
AdminService ..> ChallengeService
AdminService ..> IdentityService
AdminService ..> NotificationService
EmailSenderPort --> CL_Resend
FE0 --> APIC
FE1 --> APIC
FE2 --> APIC
FE3 --> APIC
FE4 --> APIC
FE5 --> APIC
IssuerReviewService --> EmailSenderPort
IssuerReviewService --> MediaStoragePort
IssuerReviewService --> REPO_MySQL
IssuerReviewService ..> IssuerVerificationPolicy
IssuerReviewService ..> MediaService
IssuerReviewService ..> NotificationService
IssuerReviewService ..> SealService
IssuerReviewService ..> SideEffectRunner
MediaStoragePort --> CL_S3
MultiPieceService --> AI
MultiPieceService --> REPO_MySQL
MultiPieceService ..> MediaService
MultiPieceService ..> WardrobeService
REPO_MySQL --> DB_MySQL : JPA/Flyway
WardrobeController --> MultiPieceService
WardrobeController --> WardrobeService
WardrobeService --> AI
WardrobeService --> EV
WardrobeService --> JobQueuePort
WardrobeService --> REPO_MySQL
WardrobeService ..> AssetCatalogService
WardrobeService ..> MediaService
WardrobeService ..> NotificationService
@enduml
