@startuml RF46_Componentes
title RF46 — Gerar assets criativos do FashionAI por meio do FAI Creative Engine e serviços Adobe\nDiagrama de componentes — gerado do código (controllers → serviços → repositórios/ports)
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
left to right direction

package "Frontend (Next.js)" {
  component "components/background-studio.tsx" as FE0
  component "components/scheme-builder.tsx" as FE1
  component "components/seal-creator.tsx\n+ seal-medallion.tsx" as FE2
}
package "fai-web · controllers" {
  [BackgroundController\n/api/backgrounds/** · /api/assets/**\n/api/schemes/{id}/background · /api/pieces/{id}/background] as BC
  [SealController\n/api/seals/design-catalog · /api/seals/uploads] as SC
  [CreativeController\n<<planejado>>] as CC #FAFAFA
}
package "fai-application · services" {
  [BackgroundStudioService\ngenerateArt · upload · savePiece · saveScheme] as BSS
  [SealDesignService\ncatalog · upload] as SDS
  [AssetCatalogService] as ACS
  [AiEngine (RF24)\nAiCapability.BACKGROUND_GENERATOR] as AIE
  package "FAI Creative Engine <<planejado>>" {
    [CreativeRequest → TemplateResolver\n→ Prompt/Composition Resolver\n→ Quality Validation] as CE #FAFAFA
  }
  [ImageGenerationPort\n(provider abstrato)] as IGP
  [MediaService] as MS
  [MediaStoragePort] as MSP
}
package "fai-infrastructure · adapters" {
  [ReplicateImageGenerationAdapter] as REP
  [FireflyAdapter / Photoshop API\n<<planejado>>] as FF #FAFAFA
  [S3MediaStorageAdapter\nLocalFileMediaStorage] as S3
  [AssetPresetRepository\nPipelineJobRepository\nSchemeRepository · WardrobeItemRepository\nPhotoRepository] as REPOS
}
database "MySQL\n• asset_presets\n• pipeline_jobs\n• schemes\n• photos\n• wardrobe_items\n• piece_images (canônicos RF45, só leitura)" as DB
cloud "Replicate (flux-schnell / SDXL)" as EXT1
cloud "Adobe Firefly · Photoshop API · Express\n<<planejado>>" as EXT2

FE0 --> BC : chama (HTTPS/JSON)
FE1 --> BC : chama
FE2 --> SC : chama
BC --> BSS : chama
SC --> SDS : chama
BSS --> ACS : lê catálogo de assets
BSS --> AIE : chama
AIE --> IGP : fallback entre provedores
IGP <|.. REP
IGP <|.. FF
REP --> EXT1 : chama
FF ..> EXT2 : chama
BSS --> MS : grava PNG + registra (photos)
MS --> MSP : put
SDS --> MSP : grava arte do selo
MSP <|.. S3
BSS --> REPOS : lê/grava
CC ..> CE : chama
CE ..> IGP : provider criativo
CE ..> REPOS : PipelineJob assíncrono
CE ..> DB : lê asset canônico (RF45)
REPOS --> DB : JPA/Flyway
note bottom of CE : RF45 = verdade visual (pipeline de confiança)\nRF46 = expressão criativa (pipeline criativo)\no criativo lê o canônico, nunca o substitui (RN46.01)
@enduml
