@startuml RF46_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."
title RF46 — Gerar assets criativos do FashionAI por meio do FAI Creative Engine e serviços Adobe\nDiagrama de sequência — gerado do código em 2026-10-06 (scripts/diagramas/v5)

actor "Pessoa usuária" as U
boundary "Tela /schemes/[id]/edit" as P
control "BackgroundController" as BackgroundController
participant "BackgroundStudioService" as BackgroundStudioService
participant "Guard" as Guard
database "MySQL" as DB_MySQL
participant "AiEngine\n(provedor de IA + reserva local)" as AI
participant "AssetCatalogService" as AssetCatalogService
participant "MediaService" as MediaService
== Gerar arte de fundo por prompt (Background Generator) ==
U -> P : Gerar arte de fundo por prompt (Background Genera…
P -> BackgroundController : POST /api/backgrounds/art
BackgroundController -> BackgroundStudioService : generateArt()
activate BackgroundStudioService
BackgroundStudioService -> Guard : requireCanCreate()
alt prompt vazio
BackgroundStudioService --> BackgroundController : 400 PROMPT_VAZIO
BackgroundController --> P : 400 + mensagem
end
BackgroundStudioService -> DB_MySQL : SELECT celebrity_profiles
BackgroundStudioService -> AI : BACKGROUND_GENERATOR
AI --> BackgroundStudioService : resposta (ou reserva local)
BackgroundStudioService -> AssetCatalogService : list()
BackgroundStudioService -> DB_MySQL : SELECT users
BackgroundStudioService -> MediaService : put()
BackgroundStudioService -> MediaService : register()
MediaService -> DB_MySQL : INSERT/UPDATE photos
MediaService --> BackgroundStudioService
deactivate BackgroundStudioService
BackgroundStudioService --> BackgroundController : resultado
BackgroundController --> P : 201 JSON
P --> U : atualiza a tela
== Fundo do card da peça ==
U -> P : Fundo do card da peça
P -> BackgroundController : PUT /api/pieces/{id}/background
BackgroundController -> BackgroundStudioService : savePiece()
activate BackgroundStudioService
BackgroundStudioService -> Guard : requireCanCreate()
BackgroundStudioService -> DB_MySQL : SELECT wardrobe_items
BackgroundStudioService -> Guard : requireOwner()
alt arte alterada
BackgroundStudioService --> BackgroundController : 409 ARTE_ALTERADA
BackgroundController --> P : 409 + mensagem
end
deactivate BackgroundStudioService
BackgroundStudioService --> BackgroundController : resultado
BackgroundController --> P : 200 JSON
P --> U : atualiza a tela
@enduml
