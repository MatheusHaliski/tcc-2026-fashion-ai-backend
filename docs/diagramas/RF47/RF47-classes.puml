@startuml RF47_Classes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  StereotypeFontColor #6B6470
}
hide empty members
left to right direction
title RF47 — Acervo & Busca Catalogada\nDiagrama de classes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "fai-domain (entidades JPA)" {
  class Brand <<brands>> {
    +id: UUID
    +name: String
    +slug: String
    +logoUrl: String
    +website: String
    +source: BrandSource
    +catalogOrigin: CatalogOrigin
    +fixtureKey: String
    +sourceConfidence: BigDecimal
    +verifiedAt: Instant
    .. +2 campos ..
  }
  class BrandAlias <<brand_aliases>> {
    +id: UUID
    +brandId: UUID
    +alias: String
    +aliasNorm: String
  }
  class CatalogImage <<catalog_images>> {
    +id: UUID
    +productId: UUID
    +variantId: UUID
    +imageUrl: String
    +imageUrlHash: String
    +imageType: CatalogImageType
    +sourceUrl: String
    +sourceDomain: String
    +sourceType: CatalogSourceType
    +primary: boolean
    .. +4 campos ..
  }
  class CatalogIngestionRun <<catalog_ingestion_runs>> {
    +id: UUID
    +kind: String
    +source: String
    +dryRun: boolean
    +totalRead: int
    +createdCount: int
    +updatedCount: int
    +skippedCount: int
    +duplicatesCount: int
    +errorCount: int
    .. +3 campos ..
  }
  class CatalogProduct <<catalog_products>> {
    +id: UUID
    +brandId: UUID
    +category: String
    +subcategory: String
    +productName: String
    +modelName: String
    +productCode: String
    +sku: String
    +gtin: String
    +ean: String
    .. +20 campos ..
  }
  class CatalogProductAlias <<catalog_product_aliases>> {
    +id: UUID
    +productId: UUID
    +alias: String
    +aliasNorm: String
  }
  class CatalogSource <<catalog_sources>> {
    +id: UUID
    +brandId: UUID
    +domain: String
    +sourceType: CatalogSourceType
    +country: String
    +allowsImagePersistence: boolean
    +active: boolean
    +notes: String
  }
  class CatalogVariant <<catalog_variants>> {
    +id: UUID
    +productId: UUID
    +variantKey: String
    +color: String
    +colorName: String
    +variantCode: String
    +sku: String
    +gtin: String
    +availability: String
  }
  class WardrobeItem <<wardrobe_items>> {
    +id: UUID
    +user: User
    +brandProfile: BrandProfile
    +brand: Brand
    +name: String
    +category: String
    +subcategory: String
    +sex: String
    +brandName: String
    +brandLogoUrl: String
    .. +70 campos ..
  }
}
package "fai-domain (enums)" {
  enum CatalogImageUsage {
    REFERENCE_ONLY
    PERSISTED
    REJECTED
  }
  enum CatalogSourceStatus {
    ACTIVE
    UNAVAILABLE
    SOURCE_REMOVED
    NEEDS_REVALIDATION
  }
  enum CatalogIngestionStatus {
    DISCOVERED
    VALIDATED
    PERSISTABLE
    REFERENCE_ONLY
    REJECTED
  }
  enum AvailabilityStatus {
    AVAILABLE
    UNAVAILABLE
    ARCHIVED
  }
  enum ModerationStatus {
    PENDING
    APPROVED
    REJECTED_POLICY
    REJECTED_NOT_CLOTHING
  }
  enum PhotoProcessingStatus {
    NEW
    MODERATING
    PROCESSING
    COMPLETED
    NEEDS_REUPLOAD
    FAILED
  }
}
package "fai-application" {
  class CatalogService <<service>> {
    +search()
    +suggestions()
    +brandSuggestions()
    +catalogBrands()
    +product()
    +discover()
    +addToWardrobe()
  }
}
CatalogService ..> Brand : usa
CatalogService ..> BrandAlias : usa
CatalogService ..> CatalogImage : usa
CatalogService ..> CatalogProduct : usa
CatalogService ..> CatalogProductAlias : usa
CatalogService ..> CatalogSource : usa
BrandAlias ..> Brand : brandId
CatalogImage --> CatalogImageUsage
CatalogProduct --> CatalogIngestionStatus
CatalogProduct --> CatalogSourceStatus
CatalogProduct ..> Brand : brandId
CatalogSource ..> Brand : brandId
WardrobeItem "*" --> "1" Brand : brand
WardrobeItem --> AvailabilityStatus
WardrobeItem --> ModerationStatus
WardrobeItem --> PhotoProcessingStatus
@enduml
