@startuml RF47_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF47 — Acervo & Busca Catalogada\nDiagrama de componentes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "Frontend (Next.js)" {
  component "/pieces/new\n(site)/(app)/pieces/new/page.tsx" as FE0
  component "/try-on\n(site)/(app)/try-on/page.tsx" as FE1
  component "lib/api/client.ts" as APIC
}
package "fai-web (REST)" {
  component "CatalogController\n/api/catalog/brands\n/api/catalog/discover\n/api/catalog/products/{…}\n/api/catalog/search\n(+3 rotas)" as CatalogController
  component "DiscoveryController\n/api/explorer/brands\n/api/search" as DiscoveryController
  component "WardrobeController\n/api/pieces\n/api/pieces/{…}" as WardrobeController
}
package "fai-application (casos de uso)" {
  component "CatalogService" as CatalogService
  component "SearchService" as SearchService
  component "ExplorerService" as ExplorerService
  component "WardrobeService" as WardrobeService
  component "CatalogIngestService" as CatalogIngestService <<apoio>>
  component "OfficialCatalogDiscovery" as OfficialCatalogDiscovery <<apoio>>
  component "SchemeService" as SchemeService <<apoio>>
  component "ChallengeService" as ChallengeService <<apoio>>
  component "HypeScoreConfig" as HypeScoreConfig <<apoio>>
  component "FlatLayPipeline" as FlatLayPipeline <<apoio>>
  component "MediaService" as MediaService <<apoio>>
  component "AssetCatalogService" as AssetCatalogService <<apoio>>
  component "AnalyticsQueryPort\n«MysqlAnalyticsAdapter»" as AnalyticsQueryPort <<port>>
  component "JobQueuePort\n«InMemoryJobQueue»" as JobQueuePort <<port>>
}
package "fai-domain (repositórios)" {
  component "CatalogProductRepository\nCatalogVariantRepository\nCatalogImageRepository\nCatalogProductAliasRepository\nCatalogSourceRepository\nBrandRepository\nBrandAliasRepository\nSchemeRepository\nSchemeItemRepository\nWardrobeItemRepository\n(+15)" as REPO_MySQL
}
database "MySQL\n• brand_aliases\n• brand_profiles\n• brands\n• catalog_images\n• catalog_product_aliases\n• catalog_products\n• catalog_sources\n• catalog_variants\n• celebrity_profiles\n• follows\n• hype_scores\n• moderation_queue\n(+13)" as DB_MySQL
cloud "Motor de IA (RF24)\nprovedores externos + reserva local" as AI
component "Eventos de domínio\n(@TransactionalEventListener)" as EV
APIC --> CatalogController : HTTPS/JSON
APIC --> DiscoveryController : HTTPS/JSON
APIC --> WardrobeController : HTTPS/JSON
CatalogController --> CatalogService
CatalogService --> REPO_MySQL
CatalogService ..> CatalogIngestService
CatalogService ..> OfficialCatalogDiscovery
CatalogService ..> WardrobeService
DiscoveryController --> ExplorerService
DiscoveryController --> SearchService
ExplorerService --> AI
ExplorerService --> AnalyticsQueryPort
ExplorerService --> REPO_MySQL
ExplorerService ..> HypeScoreConfig
FE0 --> APIC
FE1 --> APIC
REPO_MySQL --> DB_MySQL : JPA/Flyway
SearchService --> REPO_MySQL
SearchService ..> ChallengeService
SearchService ..> HypeScoreConfig
SearchService ..> SchemeService
WardrobeController --> WardrobeService
WardrobeService --> AI
WardrobeService --> EV
WardrobeService --> JobQueuePort
WardrobeService --> REPO_MySQL
WardrobeService ..> AssetCatalogService
WardrobeService ..> FlatLayPipeline
WardrobeService ..> MediaService
@enduml
