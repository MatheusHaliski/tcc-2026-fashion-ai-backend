title RF47 — Acervo & Busca Catalogada\nDiagrama de sequência — gerado do código em 2026-10-06 (scripts/diagramas/v5)

actor "Pessoa usuária" as U
boundary "Tela (Next.js)" as P
control "CatalogController" as CatalogController
participant "CatalogService" as CatalogService
database "MySQL" as DB_MySQL
participant "OfficialCatalogDiscovery" as OfficialCatalogDiscovery
participant "CatalogNormalizer" as CatalogNormalizer
participant "CatalogIngestService" as CatalogIngestService
participant "CatalogMatchScorer" as CatalogMatchScorer
