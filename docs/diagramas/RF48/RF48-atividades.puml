@startuml RF48_Atividades
!pragma layout smetana
title RF48 — FAI Points: resgate em dinheiro e doações\nDiagrama de atividades (doação no Look do dia e resgate mensal)
skinparam backgroundColor #FFFFFF
skinparam activity {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  ArrowColor #52606D
}
|Doador (app)|
start
:Abre o look do dia de outra pessoa\n(perfil, Passarela 3D ou /schemes/{id});
:GET /api/users/{id}/daily-look;
if (canSupport?) then (não)
  :Botão desabilitado com motivo\n(menor de 18, bloqueio, conta nova,\nrecebedor não aceita apoios);
  stop
else (sim)
endif
:Toca "Apoiar com FAI Points";
:GET /api/points/transfers/quote\n(limites, saldo doável, exige 2FA?);
:Escolhe 5 / 10 / 25 / 50 ou valor livre,\nmensagem da lista fechada, anônimo?;
:Confirma na folha (doação é definitiva);
if (valor >= 100 ou soma do dia >= 200?) then (sim)
  :Informa código 2FA;
endif
|Servidor|
:POST /api/points/transfers\n(Idempotency-Key);
:Trava users de A e B\nem ordem crescente de id;
:Revalida elegibilidade, bloqueio,\nlimites do doador, do recebedor e do par;
if (saldo doável suficiente?\n(EARNED_STANDARD + EARNED_CASHABLE)) then (não)
  :409 SALDO_INSUFICIENTE;
  stop
else (sim)
endif
:Motor de risco síncrono;
if (risco) then (BLOCK)
  :409 e risk_flag;
  stop
elseif (REVIEW) then
  :points_transfers HELD\n(maturação só após revisão);
else (OK)
  :points_transfers COMPLETED;
endif
:Ledger: débito(s) de A por bucket\n+ crédito de B em DONATION_RECEIVED\n(mature_at = agora + 14 dias, mesmo transfer_id);
:Audit PONTOS_DOACAO_ENVIADA;
:Commit → notificação POINTS_RECEIVED\npara B e recibo para A;
|Recebedor / resgate (F2)|
:Pontos sacáveis e doações amadurecem;
:Abre Carteira → Resgatar;
if (KYC aprovado e chave PIX do mesmo CPF?) then (não)
  :Aceita o Termo e faz KYC no parceiro;
  stop
else (sim)
endif
:POST /api/me/payout-requests (2FA)\n→ REQUESTED, pontos reservados;
|Servidor|
:Motor de risco → UNDER_REVIEW\n(automático ou fila manual);
:Fechamento do mês: taxa = fundo ÷ pontos pedidos\n(limitada por piso e teto);
if (cabe no fundo + reserva?) then (sim)
  :APPROVED com valor bruto, retenção e líquido;
  :Parceiro executa o PIX → PAID;
else (não)
  :DEFERRED → pontos voltam para disponível;
endif
stop
@enduml
