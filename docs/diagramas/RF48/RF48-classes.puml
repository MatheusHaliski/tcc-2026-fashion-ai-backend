@startuml RF48_Classes
!pragma layout smetana
title RF48 — FAI Points: resgate em dinheiro e doações\nDiagrama de classes (entidades novas e alteradas, proposta V33)
skinparam backgroundColor #FFFFFF
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
}
hide methods

class User <<existente>> {
  id : UUID
  country : CHAR(2)
  birthDate : enc
  emailVerified : boolean
  twoFactorEnabled : boolean
  status : AccountStatus
  profileType : ProfileType
}
class FaiPointsRule <<alterada>> {
  actionCode : String <<PK>>
  points : int
  dailyCap : Integer
  weeklyCap : Integer
  oncePerRef : boolean
  active : boolean
  + cashable : boolean
  + maturationDays : int
}
class FaiPointsLedgerEntry <<alterada>> {
  id : UUID
  userId : UUID
  delta : int
  actionCode : String
  refType : String
  refId : String
  idempotencyKey : String <<unique>>
  countsLifetime : boolean
  createdAt : Instant
  + bucket : PointsBucket
  + matureAt : Instant
  + counterpartyUserId : UUID
  + transferId : UUID
  + payoutRequestId : UUID
  + operationId : UUID
  + reversesEntryId : UUID
}
class PointsTransfer <<nova>> {
  id : UUID
  senderUserId : UUID
  receiverUserId : UUID
  amount : int
  contextType : TransferContext
  contextId : UUID
  messageCode : String
  anonymous : boolean
  status : TransferStatus
  riskScore : Integer
  idempotencyKey : String
  createdAt : Instant
  reversedAt : Instant
}
class PayoutAccount <<nova>> {
  id : UUID
  userId : UUID <<unique>>
  country : CHAR(2)
  provider : String
  providerAccountRef : String
  kycStatus : KycStatus
  cpfEnc : String
  cpfHash : String <<unique>>
  pixKeyType : String
  pixKeyEnc : String
  pixKeyHash : String
  pixKeyChangedAt : Instant
  termsVersion : String
}
class PayoutRequest <<nova>> {
  id : UUID
  userId : UUID
  payoutAccountId : UUID
  periodMonth : String
  points : int
  pointsFromDonations : int
  currency : CHAR(3)
  rate : decimal
  amountGross : decimal
  taxWithheld : decimal
  amountNet : decimal
  status : PayoutStatus
  providerPayoutRef : String
}
class CreatorFundPeriod <<nova>> {
  id : UUID
  periodMonth : String
  country : CHAR(2)
  netRevenue : decimal
  fundPct : decimal
  fundAmount : decimal
  reserveIn : decimal
  pointsRequested : long
  rateFloor : decimal
  rateCeiling : decimal
  rateApplied : decimal
  reserveOut : decimal
  status : String
}
class RiskFlag <<nova>> {
  id : UUID
  userId : UUID
  relatedUserId : UUID
  kind : RiskKind
  severity : RiskSeverity
  score : int
  status : String
}
class PointsWalletStatus <<nova>> {
  userId : UUID <<PK>>
  frozen : boolean
  frozenReason : String
  receiveSupport : boolean
}
class DailyLook <<existente>> {
  id : UUID
  date : LocalDate
  source : DailyLookSource
}

enum PointsBucket {
  EARNED_STANDARD
  EARNED_CASHABLE
  DONATION_RECEIVED
}
enum TransferStatus {
  COMPLETED
  HELD
  REVERSED
}
enum PayoutStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  PROCESSING
  PAID
  REJECTED
  DEFERRED
  FAILED
  CANCELLED
  REVERSED
}
enum KycStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

User "1" -- "0..*" FaiPointsLedgerEntry
FaiPointsRule "1" -- "0..*" FaiPointsLedgerEntry : actionCode
PointsTransfer "1" -- "2..*" FaiPointsLedgerEntry : transferId
User "1" -- "0..*" PointsTransfer : envia
User "1" -- "0..*" PointsTransfer : recebe
PointsTransfer "0..*" -- "1" DailyLook : contexto (F1)
User "1" -- "0..1" PayoutAccount
PayoutAccount "1" -- "0..*" PayoutRequest
PayoutRequest "1" -- "1..*" FaiPointsLedgerEntry : reserva/devolução
CreatorFundPeriod "1" -- "0..*" PayoutRequest : periodMonth + country
User "1" -- "0..*" RiskFlag
User "1" -- "0..1" PointsWalletStatus
FaiPointsLedgerEntry ..> PointsBucket
PointsTransfer ..> TransferStatus
PayoutRequest ..> PayoutStatus
PayoutAccount ..> KycStatus
@enduml
