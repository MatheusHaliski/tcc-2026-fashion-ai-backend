@startuml RF49_Classes
!include ../seguranca/_estilo.iuml
title RF49 — Segurança, integridade e operação\nDiagrama de classes: freios de autenticação, contadores, origem da conta, integridade por domínio e dados demo

package "fai-web · support" {
  class AuthRateLimitFilter <<OncePerRequestFilter · @Order(-102)>> {
    ~RULES : List<Rule>
    -hashing : Semaphore «teto de hashes Argon2»
    -hashWaitMillis : long = 2000
    ~ruleFor(method, path) : Optional<Rule>
    ~bucketKey(ip) : String «IPv6 → prefixo /64»
    ~defaultHashPermits(cores, dbPool) : int
    #doFilterInternal(req, res, chain) «429 · 503 + Retry-After»
  }
  class Rule <<record>> {
    method : String
    path : String «* = um segmento»
    limit : int
    window : Duration
    hashes : boolean
  }
  class ClientIpResolver {
    ~MAX_SKEW_SECONDS = 60
    ~MIN_SECRET_LENGTH = 32
    +resolve(request) : String
    ~signedIp(ip, ts, sig) : String «HMAC-SHA256, tempo constante»
  }
}

package "fai-application" {
  interface RateLimitPort {
    +tryAcquire(owner, bucket, limit, window) : boolean
    +status(owner, bucket, limit, window) : QuotaStatus
    +reset(owner, bucket)
    +release(owner, bucket) «nunca abaixo de 0»
  }
  class IdentityService {
    ~LOGIN_FAIL = "login-fail"
    -MAX_LOGIN_FAILURES = 5
    -LOCK_WINDOW = 15 min
    +login(cmd, ip, userAgent) : Session
    +changePassword(user, sessão, atual, nova, confirma) : int
    +reauthenticate(userId, senha)
    -passwordMatchesWithLockout(user, senha, via) : boolean «429 MUITAS_TENTATIVAS»
  }
  class DemoEnvironmentGuard {
    +requireEnabled() «FASHIONAI_DEMO_ENABLED; produção exige ALLOW_PRODUCTION»
    +production() : boolean
  }
  class DemoFixtures <<@Component @Lazy>> {
    +SEED = 2026
    +personas(profile) : List<Persona>
    +fixtureKeys(profile) : List<String>
    «campo omitido = 0 · validado contra a taxonomia»
  }
  interface DemoDataAdminPort {
    +testAccountIds() : List<UUID>
    +realAccountsAmong(ids) : long
    +plan(ids) : ResetCounts
    +interactionsOnRealContent(ids) : List<CounterDelta>
    +deletePolymorphicTargeting(ids) : Map
    +deleteTestAccounts(ids) : long «só TEST_SEED/DEMO»
    +integrityProblems(fixtureKeys) : List<String>
  }
  class "DemoDataService\n(planejado)" as DDS #FFFFFF {
    +seed(profile) · plan() · reset(planHash) · verify()
  }
}

package "fai-infrastructure" {
  class InMemoryRateLimit {
    -windows : ConcurrentHashMap «teto 100 mil, varredura»
  }
  class RedisRateLimit <<RedisAdapters>> {
    «INCR + TTL · RELEASE em script Lua»
  }
  class MysqlDemoDataAdminAdapter {
    ~edges() : List<Edge> «FKs reais do INFORMATION_SCHEMA»
    ~deletedRows(edges) : Map<tabela, condição> «CASCADE recursivo»
  }
  class "V34__integridade_referencial_por_dominio" as V34 <<Flyway Java>> {
    +POLICY : List<Fk> «131 FKs»
    +sameRule(atual, política) : boolean
    +migrate(ctx) «uma ALTER por FK · órfão adia só aquela»
  }
  class Fk <<record>> {
    table · column · refTable · refColumn
    onDelete : CASCADE | RESTRICT | SET NULL
  }
}

package "fai-domain" {
  class User {
    -accountOrigin : AccountOrigin = REAL
    -fixtureKey : String «único»
    -testAccountColumn : Boolean «gerada (V35)»
    +isTestAccount() : boolean
    +isTestUsername(username) : boolean «e2e_ · demo_»
  }
  enum AccountOrigin {
    REAL
    TEST_SEED
    DEMO
    SYSTEM
  }
}

AuthRateLimitFilter *-- Rule
AuthRateLimitFilter --> ClientIpResolver
AuthRateLimitFilter --> RateLimitPort : balde por IP
IdentityService --> RateLimitPort : balde por conta
RateLimitPort <|.. InMemoryRateLimit
RateLimitPort <|.. RedisRateLimit
DemoDataAdminPort <|.. MysqlDemoDataAdminAdapter
MysqlDemoDataAdminAdapter ..> V34 : confere desvio da política
V34 *-- Fk
DDS ..> DemoEnvironmentGuard
DDS ..> DemoFixtures
DDS ..> DemoDataAdminPort
User --> AccountOrigin
IdentityService ..> User
@enduml
