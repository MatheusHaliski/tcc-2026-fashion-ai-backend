    +claimPendingUpload()
  }
  class RedisAdapters  {
    +redisRateLimit()
    +redisCounterStore()
    +redisRenderCache()
    +redisJobQueue()
  }
  class MysqlDemoDataAdminAdapter  {
    -jdbc: NamedParameterJdbcTemplate
    +edges()
    +deletedRows()
    +condition()
    +ids()
    +count()
    +uuids()
    +testAccountIds()
    +realAccountsAmong()
  }
  class V34__integridade_referencial_por_dominio  {
    +canExecuteInTransaction()
    +migrate()
    +sameRule()
    +norm()
    +existing()
    +problem()
    +column()
    +sha()
  }
}
