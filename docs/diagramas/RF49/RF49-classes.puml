package "Backend (Java)" {
  class DemoEnvironmentGuard <<service>> {
    -enabled: boolean
    -allowProduction: boolean
    -environment: String
    +production()
    +environment()
    +requireEnabled()
  }
  class DemoFixtures <<service>> {
    -personas: List<Persona>
    -followers: JsonNode
    -pieces: List<PieceTemplate>
    -colors: List<String>
    -materials: List<String>
    -sizes: List<String>
    +validate()
    +personas()
    +fixtureKeys()
    +pieces()
    +colors()
    +materials()
    +sizes()
    +priceMin()
  }
  class DemoDataAdminPort <<interface>> {
    +testAccountIds()
    +realAccountsAmong()
    +plan()
    +lockAccounts()
    +pieceIdsOf()
    +schemeIdsOf()
    +storageKeysOf()
    +interactionsOnRealContent()
  }
  class RateLimitPort <<interface>> {
    +tryAcquire()
    +status()
    +reset()
    +release()
  }
  class IdentityService <<service>> {
    -audit: Audit
    -frontendUrl: String
    -dummyHash: String
