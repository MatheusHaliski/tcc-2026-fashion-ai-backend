@startuml RF49_Classes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  StereotypeFontColor #6B6470
}
hide empty members
left to right direction
title RF49 — Segurança, integridade e operação\nDiagrama de classes — gerado do código em 2026-10-14 (scripts/diagramas/v5)

package "components/photo-edit/piece-photo-editor.tsx" {
  class Session as "Session" <<interface>> {
    +originalUrl: string
    +width: number
    +height: number
    +category: string
    +currentRecipe: { target?: string; ops?: Op[] } | null
  }
  class Quality as "Quality" <<interface>> {
    +sharpness: number
    +exposure: number
    +occupancy: number
    +colorDeltaE: number
    +touchesEdge: boolean
    +cutConfidence: number
    +width: number
    +height: number
  }
  class Version as "Version" <<interface>> {
    +id: string
    +target: Target
    +url: string
    +current: boolean
    +createdAt: string
    +recipe: { target?: string; ops?: Op[] }
    +warnings: string[]
    +syntheticShadow: boolean
  }
  class Preview as "Preview" <<interface>> {
    +png: string
    +quality: Quality
    +warnings: string[]
  }
  enum Tool as "Tool" {
    adjust
    crop
    cutout
    present
    review
  }
  enum Pointer as "Pointer" {
    none
    brush
    eyedropper
    heal
  }
  class mod_piece_photo_editor_tsx as "piece-photo-editor.tsx" <<módulo>> {
    +PiecePhotoEditor()
  }
}
package "Backend (Java)" {
  class DemoEnvironmentGuard <<service>> {
    -enabled: boolean
    -allowProduction: boolean
    -environment: String
    +production()
    +environment()
    +requireEnabled()
  }
  class DemoFixtures <<service>> {
    -personas: List<Persona>
    -followers: JsonNode
    -pieces: List<PieceTemplate>
    -colors: List<String>
    -materials: List<String>
    -sizes: List<String>
    +validate()
    +personas()
    +fixtureKeys()
    +pieces()
    +colors()
    +materials()
    +sizes()
    +priceMin()
  }
  class DemoDataAdminPort <<interface>> {
    +testAccountIds()
    +realAccountsAmong()
    +plan()
    +lockAccounts()
    +pieceIdsOf()
    +schemeIdsOf()
    +storageKeysOf()
    +interactionsOnRealContent()
  }
  class RateLimitPort <<interface>> {
    +tryAcquire()
    +status()
    +reset()
    +release()
  }
  class IdentityService <<service>> {
    -audit: Audit
    -frontendUrl: String
    -dummyHash: String
    -mailExecutor: Executor
    +setIssuerReview()
    +preRegistrationUpload()
    +pendingUpload()
    +purgeStalePendingUploads()
    +pendingReferenced()
    +register()
    +readQuietly()
    +claimPendingUpload()
  }
  class RedisAdapters  {
    +redisRateLimit()
    +redisCounterStore()
    +redisRenderCache()
    +redisJobQueue()
  }
  class MysqlDemoDataAdminAdapter  {
    -jdbc: NamedParameterJdbcTemplate
    +edges()
    +deletedRows()
    +condition()
    +ids()
    +count()
    +uuids()
    +testAccountIds()
    +realAccountsAmong()
  }
  class V34__integridade_referencial_por_dominio  {
    +canExecuteInTransaction()
    +migrate()
    +sameRule()
    +norm()
    +existing()
    +problem()
    +column()
    +sha()
  }
}
