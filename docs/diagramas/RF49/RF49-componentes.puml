@startuml RF49_Componentes
title RF49 — HypeScore v2: Hype de peças e looks\nDiagrama de componentes — gerado do código (controllers → serviços → repositórios/ports)
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
left to right direction

package "Frontend (Next.js)" {
  component "PieceCard · SchemeCard\n(FashionCard: frente/verso, CardFlipButton)" as FE_CARD
  component "components/hype\nHypeBadge · HypeCardBack · HypeAnalyticsDrawer\nHypeHistoryChart · HypeExplanation · HypeVsStyle" as FE_HYPE
  component "lib/hype\nuseHypeSummary (lote 100, TTL 5 min)\nmodel (estados) · explain (motivos)" as FE_LIB
  component "explorer — aba Em alta\n(HypeTrendingPanel)" as FE_TREND
  component "lookbook — aba Insights\n(HypeWardrobeInsights)" as FE_INS
  component "/history — Linha do tempo · Estilo\nUso · Hype · Insights" as FE_HIST
  component "closet — ordenar por Hype,\ncrescimento, raridade, uso\n+ filtro de nível" as FE_CLOSET
  component "copilot — modos Seguro /\nDescoberta / Experimental" as FE_COP
}
package "fai-web · controllers" {
  [HypeController] as HC
  [SocialController] as SOCC
  [SchemeController\nWardrobeController] as SWC
  [AutopilotController\n(/api/copilot/*)] as APC
  [LookbookController\n(/api/hype/method)] as LBC
  [AdminController\n(job "hype")] as ADM
}
package "fai-application · hype" {
  [HypeQueryService] as HQ
  [HypeSnapshotService\n@Scheduled 6/6 h] as JOB
  [HypeSignalRecorder\n@TransactionalEventListener] as REC
  [HypeIntegrityPolicy] as POL
  [HypeCalculator\nHypeSignalSeries] as CALC
  [HypeScoreConfig\n(pesos, janelas, faixas, HYPE_V2)] as CFG
  [HypeCache\n(geração + TTL 10 min)] as HCACHE
  [StyleCompatibility\nRecommendationScoring] as REC2
}
package "fai-application · services" {
  [SocialService\nSchemeService\nWardrobeService\nDailyLookService] as PUB
  [CopilotService] as COP
  [AdminService] as ADMS
  [HypeScoreService (v1)] as V1
}
package "fai-domain · repositories" {
  [HypeSignalDailyRepository\nHypeScoreCurrentRepository\nHypeScoreSnapshotRepository] as REPOS
  [WardrobeItemRepository\nSchemeRepository · SchemeItemRepository\nStyleDnaRepository · UserRepository] as OREPOS
}
package "fai-infrastructure · adapters" {
  [RenderCachePort\n(Redis ou memória)] as RCP
}
database "MySQL" {
  [hype_signal_daily] as T1
  [hype_scores] as T2
  [hype_score_snapshots] as T3
}

FE_CARD --> FE_HYPE
FE_HYPE --> FE_LIB
FE_LIB --> HC : GET /api/hype/summaries\n/pieces|looks/{id}[/history]
FE_TREND --> HC : GET /api/hype/trending
FE_INS --> HC : GET /api/me/hype/wardrobe
FE_HIST --> HC : GET /api/me/hype/movers
FE_CLOSET --> SWC : GET /api/me/closet?sort=&hypeLevel=
FE_COP --> APC : POST /api/copilot/messages {mode}
FE_CARD --> SOCC : curtir, comentar, salvar…

HC --> HQ
HC --> JOB : POST /api/admin/hype/snapshots
SOCC --> PUB
SWC --> PUB
APC --> COP
ADM --> ADMS
LBC --> CFG

PUB ..> REC : DomainEvents.HypeSignal\nPieceWorn · SchemeSaved\nDailyLookRegistered
REC --> POL
POL --> OREPOS : idade da conta (UserRepository)
POL --> RCP : dedupe 26 h
REC --> REPOS
JOB --> CALC
JOB --> CFG
JOB --> REPOS
JOB --> OREPOS
JOB --> HCACHE : bump()
HQ --> REPOS
HQ --> OREPOS
HQ --> HCACHE
HQ --> REC2
HCACHE --> RCP
COP --> HQ : hypeAnswer · scoreLooks
COP --> REC2
PUB --> REPOS : WardrobeService: ordenações por Hype
ADMS --> JOB : v2
ADMS --> V1 : v1 (convive)

REPOS --> T1
REPOS --> T2
REPOS --> T3
@enduml
