@startuml RF49_Sequencia
!include ../seguranca/_estilo.iuml
title RF49 — Segurança, integridade e operação\nDiagrama de sequência: login pelo BFF com IP assinado, limite por IP, teto de hashes e bloqueio por conta
autonumber

actor Pessoa
participant "Navegador\n(lib/api/client.ts)" as NAV
participant "Vercel · BFF\n/bff/auth/login" as BFF
participant "DevGateFilter\n(-103)" as GATE
participant "ClientIpResolver" as IP
participant "AuthRateLimitFilter\n(-102)" as ARL
participant "IdentityService" as IDS
participant "RateLimitPort\n(memória · Redis)" as RL
participant "Argon2id\n(PasswordHasherPort)" as HASH
database "MySQL 9\n(TLS · fai_app)" as DB
participant "Audit" as AUD

Pessoa -> NAV : e-mail/usuário + senha
NAV -> BFF : POST /bff/auth/login (mesma origem)
BFF -> BFF : ts = agora · sig = HMAC-SHA256(EDGE_PROXY_SECRET, ip|ts)
BFF -> GATE : POST /api/auth/login\nX-Fai-Client-Ip · X-Fai-Proxy-Ts · X-Fai-Proxy-Sig · X-Dev-Gate
GATE -> GATE : token do gate (ga) válido
GATE -> ARL
ARL -> IP : resolve(request)
IP --> ARL : IP do cliente (assinatura conferida em tempo constante;\nIPv6 vira o prefixo /64)
ARL -> RL : tryAcquire(ip, "ip:post:api:auth:login", 30, 10 min)
alt balde do IP estourado
  RL --> ARL : false
  ARL --> BFF : 429 MUITAS_TENTATIVAS · Retry-After
else dentro do limite
  RL --> ARL : true
  ARL -> ARL : vaga no teto de hashes (Semaphore, espera até 2 s)
  alt sem vaga (pico de logins)
    ARL --> BFF : 503 AUTENTICACAO_OCUPADA · Retry-After: 2
  else com vaga
    ARL -> IDS : login(identificador, senha, ip, user-agent)
    IDS -> DB : findByEmailHash / findByUsername
    alt conta não existe
      IDS -> HASH : matches(senha, hashFalso) — tempo igual
      IDS -> AUD : LOGIN_FALHO (usuario_inexistente)
      IDS --> ARL : 401 NAO_AUTENTICADO
    else conta existe
      IDS -> RL : tryAcquire(userId, "login-fail", 5, 15 min) — reserva atômica
      IDS -> HASH : matches(senha, hash da conta)
      alt reserva acima do limite (bloqueada)
        IDS -> AUD : LOGIN_BLOQUEADO_TENTATIVAS
        IDS --> ARL : 401 genérico (nem a senha certa entra)
      else senha errada
        IDS -> AUD : LOGIN_FALHO (senha) — a reserva fica
        IDS --> ARL : 401 genérico
      else senha certa
        IDS -> RL : release(userId, "login-fail")
        opt 2FA ligado
          IDS -> DB : código TWO_FACTOR válido?
        end
        IDS -> RL : reset(userId, "login-fail")
        IDS -> DB : refresh token (hash) + lastLoginAt
        IDS -> AUD : LOGIN_SUCESSO
        IDS --> ARL : sessão (JWT RS256 aud, 15 min + refresh)
      end
    end
    ARL -> ARL : devolve a vaga do teto de hashes (finally)
    ARL --> BFF : resposta
  end
end
BFF --> NAV : access token no corpo · refresh em cookie HttpOnly fai_rt
NAV -> NAV : guarda o access token só em memória

note over IDS, RL
  Troca de senha, PATCH /api/me/sensitive e POST /api/me/deletion usam a
  mesma reserva no "login-fail": 5 erros → 429 MUITAS_TENTATIVAS
  (uma sessão roubada não testa a senha atual sem limite).
end note
@enduml
