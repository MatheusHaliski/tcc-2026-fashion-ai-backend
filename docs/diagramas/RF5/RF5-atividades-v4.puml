@startuml RF5_Criar_Look_v4
title RF5 — Criar um esquema de vestimenta na aba "Criar Look"\nDiagrama de atividades — construtor de looks (SchemeBuilder): modo, peças, dados, Background Studio, revisar e salvar
skinparam backgroundColor #FFFFFF
skinparam activity {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  DiamondBackgroundColor #FBF0DC
  DiamondBorderColor #8A5A12
}
skinparam swimlane {
  BorderColor #CBC6BE
  TitleBackgroundColor #F4F2EF
}
skinparam note {
  BackgroundColor #FBF0DC
  BorderColor #8A5A12
}

|Pessoa|
|Frontend (schemes/new · SchemeBuilder)|
|API · Serviço (SchemeController · SchemeService)|
|Banco/IA|
|Pessoa|
start
:Abre "Criar Look" (/schemes/new)\n(?pieces=a,b chega com peças já escolhidas);
|Frontend (schemes/new · SchemeBuilder)|
:GET /api/schemes/builder;
|API · Serviço (SchemeController · SchemeService)|
if (Sessão?) then (não)
  #FFE3E3:401 (curinga público de /api/schemes/*);
  stop
endif
:builder: wardrobe.eligible — só peças do próprio acervo,\nAVAILABLE e não reprovadas na moderação (CA07b);\nlistas por tipo + defaultVisibility do perfil (CA03);
|Banco/IA|
:MySQL: wardrobe_items do usuário;
|Frontend (schemes/new · SchemeBuilder)|
if (status = INSUFICIENTE (< 2 peças elegíveis)?) then (sim)
  :Estado vazio com o atalho "Adicionar nova peça"\n→ /pieces/new (RF4) — CA02;
  stop
endif

partition "Etapa 1 · Modo" {
  |Pessoa|
  if (Modo?) then (manual)
  else (IA)
    :Escolhe ocasião, estilo e orientação livre (≤ 500);
    |Frontend (schemes/new · SchemeBuilder)|
    :POST /api/schemes/compositions;
    |API · Serviço (SchemeController · SchemeService)|
    if (< 2 peças elegíveis?) then (sim)
      #FFE3E3:422 ACERVO_INSUFICIENTE (href /pieces/new);
      stop
    endif
    :compose: AiEngine.text(SCHEME_COMPOSER) com o acervo\n+ HypeScore v2 das peças → EXATAMENTE 3 looks\nsó com peças do acervo (CA04);
    |Banco/IA|
    :Provedor de IA (ou LocalSchemeComposer como plano B);\nai_inference_log;
    |API · Serviço (SchemeController · SchemeService)|
    :+ CopilotService.orientation (arte, ocasião, estilo,\nestação, humor) + LookPreviewService.compositions\n(os seis números de cada look; nulo se falhar);
    |Pessoa|
    :Escolhe uma das 3 composições\n(applyComposition: uma peça por tipo + arte sugerida);
  endif
}

partition "Etapa 2 · Peças" {
  |Pessoa|
  :Seleciona peças do próprio Closet (PieceCard selecionável);
  |Frontend (schemes/new · SchemeBuilder)|
  :onePerType: uma peça por tipo (peça de corpo inteiro\nocupa cima e baixo); slot sugerido pela categoria;
  :SlotBrand: a marca do slot vem da peça (nome + logo, 🔒);\no esquema não tem campo de marca;
  :LookHypePreview: POST /api/schemes/scores\n(os seis números; nada é gravado, nenhum sinal de Hype);
  if (≥ 2 peças?) then (não)
    :"Próximo" desabilitado;
    stop
  endif
}

partition "Etapa 3 · Dados" {
  |Pessoa|
  :Título (2–120), descrição, ocasião e estilo (≤ 3 cada,\nvocabulário da taxonomia), estação, humor, tags,\nvisibilidade (padrão do perfil), Look do Dia;
  |Frontend (schemes/new · SchemeBuilder)|
  :Selos possíveis: POST /api/seal-suggestions/preview\n(nada é gravado; a pessoa marca os que quer pedir);
  :Foto do look (opcional): POST /api/schemes/photos\n(400 IMAGEM_PEQUENA · PROPORCAO_INVALIDA);
}

partition "Etapa 4 · Aparência (Background Studio — RF11)" {
  |Pessoa|
  :Skin, anatomia do esquema e das peças, cor/gradiente,\narte com IA (GET /api/backgrounds/recommendations ·\nPOST /api/backgrounds/art), "Desfazer";
}

partition "Etapa 5 · Revisar e salvar" {
  |Frontend (schemes/new · SchemeBuilder)|
  :Prévia ao vivo do card (e POST /api/schemes/preview → PNG);
  |Pessoa|
  if (Ação?) then (Salvar)
    :publish = false;
  else (Publicar)
    :publish = true\n(PRIVATE vira PUBLIC na publicação);
  endif
  |Frontend (schemes/new · SchemeBuilder)|
  :POST /api/schemes (SchemeForm: items[wardrobeItemId, slot,\nsortOrder], background, cardSkin, layoutAnatomy, lookDoDia);
  |API · Serviço (SchemeController · SchemeService)|
  :Guard.requireCanCreate (401 · 403 EMAIL_NAO_CONFIRMADO…);
  if (items vazio?) then (sim)
    #FFE3E3:400 SEM_PECAS (CA06);
    stop
  endif
  if (applyForm / replaceItems válidos?) then (não)
    #FFE3E3:400 FORMULARIO_INVALIDO · PECA_DE_OUTRO_USUARIO\n· PECA_INDISPONIVEL · 404 peça;
    stop
  endif
  :Scheme DRAFT, creationMode, origin CRIAR_LOOK,\nvisibilidade herdada do perfil se vazia (CA03);\nBackgroundStudioService.applyToScheme + foto do look;
  if (publish?) then (sim)
    :publishInternal: PUBLISHED, publishedAt,\ncommunityIndexed = PUBLIC, snapshot_json das peças\n(feed do RF8 respeita a visibilidade — CA05);
  endif
  |Banco/IA|
  :INSERT schemes + scheme_items; projeções (OpenSearch/Cassandra);\nnotificação SCHEME_CREATED; audit CRIACAO_ESQUEMA;
  :SchemeSaved (AFTER_COMMIT): FAI Points SCHEME_CREATED,\nHypeSignalRecorder/HypeLiveRecalc, desafios,\nconquistas, Inventory Score, cupons;
  |API · Serviço (SchemeController · SchemeService)|
  if (lookDoDia?) then (sim)
    :DailyLookService.register (falha vira\ndailyLookWarning, sem desfazer o look);
  endif
  :Depois do commit (≥ 2 peças): suggestSealsAfterSave\n(falha → lista vazia + mensagem);
  |Frontend (schemes/new · SchemeBuilder)|
  :Para cada selo marcado: POST /api/schemes/{id}/seal-bonds\n(EDITED → aprovado pela política ou PENDING_REVIEW);\num pedido recusado não desfaz o look;
  :Tela de sucesso → card do look;
}
|Pessoa|
stop
@enduml
