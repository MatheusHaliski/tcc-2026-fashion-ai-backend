  }
}
package "fai-domain (enums)" {
  enum SchemeStatus {
    DRAFT
    PUBLISHED
    ARCHIVED
  }
  enum RenderStatus {
    PENDING
    RENDERING
    ENHANCING
    COMPOSITING
    CACHED
    COMPLETED
    FAILED
  }
  enum SealBondStatus {
    SUGGESTED
    ACCEPTED
    EDITED
    REFUSED
    PENDING_REVIEW
    APPROVED
    REJECTED
    REVOKED
  }
  enum AccountStatus {
    PENDING_EMAIL_VERIFICATION
    ACTIVE
    PENDING_VALIDATION
    SUSPENDED
    DELETION_SCHEDULED
    DELETED
  }
  enum AvailabilityStatus {
    AVAILABLE
    UNAVAILABLE
    ARCHIVED
  }
  enum ModerationStatus {
    PENDING
    APPROVED
    REJECTED_POLICY
    REJECTED_NOT_CLOTHING
  }
}
package "fai-application" {
  class SchemeService <<service>> {
    +builder()
    +compose()
    +create()
    +suggestSealsAfterSave()
    +uploadLookPhoto()
    +preview()
    +get()
    +publish()
  }
}
SchemeService ..> Scheme : usa
SchemeService ..> SchemeItem : usa
SchemeService ..> User : usa
SchemeService ..> WardrobeItem : usa
Scheme "*" --> "1" User : user
Scheme --> RenderStatus
Scheme --> SchemeStatus
SchemeItem "*" --> "1" Scheme : scheme
SchemeItem "*" --> "1" WardrobeItem : wardrobeItem
Seal "*" --> "1" User : owner
SealBond "*" --> "1" Scheme : scheme
SealBond "*" --> "1" Seal : seal
SealBond "*" --> "1" User : requestedBy
SealBond "*" --> "1" User : targetOwner
SealBond --> SealBondStatus
User --> AccountStatus
WardrobeItem "*" --> "1" User : user
WardrobeItem --> AvailabilityStatus
WardrobeItem --> ModerationStatus
@enduml
