    +description: String
    +creationMode: CreationMode
    +origin: SchemeOrigin
    +style: String
    +occasion: String
    +season: Season
    .. +46 campos ..
  }
  class SchemeItem <<scheme_items>> {
    +id: UUID
    +scheme: Scheme
    +wardrobeItem: WardrobeItem
