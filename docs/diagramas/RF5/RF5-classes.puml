    +positionY: BigDecimal
    +scale: BigDecimal
    .. +4 campos ..
  }
  class SealBond <<seal_bonds>> {
    +id: UUID
    +scheme: Scheme
    +targetOwner: User
    +requestedBy: User
    +tier: SealTier
    +linkedPieceIdsJson: String
