@startuml RF5_Classes
title RF5 — Criar um esquema de vestimenta na aba "Criar Look"\nDiagrama de classes — entidades (fai-domain), formulários e serviços do construtor de looks
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  HeaderBackgroundColor #E4DEF0
}
skinparam packageStyle rectangle
hide empty methods

package "fai-application · service" {
class SchemeService {
  +builder(user): Map
  +compose(user, ComposeRequest, AiCapability): ComposeResult
  +create(user, SchemeForm): Map
  +suggestSealsAfterSave(user, schemeId): Map
  +preview(user, SchemeForm): byte[]
  +uploadLookPhoto(user, bytes): Map
  +publish(user, id, Visibility): Map
  +get(viewer, id): Map
  +owned(user, id): Scheme
  -replaceItems(user, s, forms): List<SchemeItem>
  -publishInternal(s, items)
}
class "SchemeService.SchemeForm" as SchemeForm <<record>> {
  +title: String
  +description: String
  +occasion: List<String>
  +style: List<String>
  +season: Season
  +mood: Mood
  +visibility: Visibility
  +displayMode: DisplayMode
  +items: List<ItemForm>
  +creationMode: CreationMode
  +origin: SchemeOrigin
  +remixedFromId: UUID
  +background: Map
  +applyRecommendedDirection: Boolean
  +cardSkin: String
  +layoutAnatomy: String
  +tags, seals: List<String>
  +publish: Boolean
  +lookDoDia: Boolean
}
class "SchemeService.ItemForm" as ItemForm <<record>> {
  +wardrobeItemId: UUID
  +slot: SchemeSlot
  +sortOrder, zIndex: Integer
  +positionX, positionY, scale,\n rotation, opacity: BigDecimal
  +filters: Map
}
class "SchemeService.ComposeRequest" as ComposeRequest <<record>> {
  +occasion, style: List<String>
  +mood, season, prompt: String
  +excludeCombinations: List<String>
}
class "SchemeService.ComposeResult" as ComposeResult <<record>> {
  +compositions: List<Composition>
  +message: String
  +fallbackUsed: boolean
  +provider: String
  +orientation: Map
  +scores: List<Map>
}
class WardrobeService {
  +eligible(userId): List<WardrobeItem>
}
class LocalSchemeComposer {
  +compose(eligible, occasion, style, season, prompt, n): List<Composition>
  +slotOf(w): SchemeSlot
}
class LookPreviewService {
  +scores(user, PreviewRequest): Map
  +compositions(user, list): List<Map>
}
class BackgroundStudioService {
  +applyToScheme(s, background, applyRecommended)
}
class DailyLookService {
  +register(user, s, source, date)
}
}

package "fai-domain · model" {
class User {
  +username: String
  +profileVisibility: Visibility
  .. AccountService.defaultVisibility(u) (CA03) ..
}
class Scheme <<table schemes>> {
  +user: User
  +originalScheme: Scheme
  +title: String
  +description: String
  +creationMode: CreationMode
  +origin: SchemeOrigin
  +style: String
  +occasion: String
  +season: Season
  +mood: Mood
  +visibility: Visibility
  +status: SchemeStatus
  +displayMode: DisplayMode
  +disponivel: boolean
  +favorite: boolean
  +lookDoDia: boolean
  +communityIndexed: boolean
  +coverImageUrl: String
  +backgroundColor, backgroundGradient,\n backgroundArtUrl, studioConfigJson: String
  +cardSkin, layoutAnatomy: String
  +sealIdsJson, tags: String
  +totalPrice: BigDecimal
  +revalidationPending: boolean
  +publishedAt: Instant
  .. contadores, render, container ..
}
class SchemeItem <<table scheme_items>> {
  +scheme: Scheme
  +wardrobeItem: WardrobeItem
  +slot: SchemeSlot
  +tryOnLayer: TryOnLayer
  +sortOrder, zIndex: int
  +positionX, positionY, scale,\n rotation, opacity: BigDecimal
  +filtersJson: String
  +snapshotJson: String
}
class WardrobeItem <<table wardrobe_items>> {
  +user: User
  +name, category, subcategory: String
  +brandName, brandLogoUrl, brandSource: String
  +imageUrl: String
  +availabilityStatus: AvailabilityStatus
  +disponivel: boolean
  +schemeUsageCount: int
}
}

package "fai-domain · enums" {
enum SchemeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
enum SchemeOrigin {
  CRIAR_LOOK
  PROVADOR
  REMIX
  COPILOT
  DNA_DUPLICATE
  SMART_MIRROR
  VISTA_ME
  AUTOPILOTO
}
enum CreationMode {
  MANUAL
  AI_ASSISTED
}
enum SchemeSlot {
  TOP
  BOTTOM
  SHOES
  ACCESSORY
  FULL_BODY
  OUTERWEAR
}
enum Visibility {
  PRIVATE
  FOLLOWERS
  PUBLIC
}
enum Season {
  SPRING
  SUMMER
  AUTUMN
  WINTER
}
enum Mood {
  ENERGETIC
  ELEGANT
  COMFORTABLE
  SOPHISTICATED
}
}

Scheme "*" --> "1" User : user
Scheme "*" --> "0..1" Scheme : originalScheme (remix)
SchemeItem "*" --> "1" Scheme : scheme
SchemeItem "*" --> "1" WardrobeItem : wardrobeItem
WardrobeItem "*" --> "1" User : user
Scheme ..> SchemeStatus
Scheme ..> SchemeOrigin
Scheme ..> CreationMode
Scheme ..> Visibility
Scheme ..> Season
Scheme ..> Mood
SchemeItem ..> SchemeSlot
SchemeService ..> SchemeForm : recebe
SchemeForm *-- "1..*" ItemForm : items
SchemeService ..> ComposeRequest
SchemeService ..> ComposeResult
SchemeService --> WardrobeService : eligible (CA01/CA07b)
SchemeService --> LocalSchemeComposer : plano B sem IA
SchemeService --> BackgroundStudioService : arte (RF11)
SchemeService --> DailyLookService : Look do Dia (RF42)
SchemeService ..> Scheme : cria/publica
SchemeService ..> SchemeItem : replaceItems

note bottom of Scheme
  Sem campo de marca: a marca de cada slot vem de
  WardrobeItem.brandName/brandLogoUrl (RF4).
  O HypeScore v1 saiu da entidade (P3-16): o Hype
  do look fica em hype_scores (HypeScore v2, RF46).
end note
note right of ItemForm
  Regras (replaceItems): só peças do próprio
  acervo (400 PECA_DE_OUTRO_USUARIO) e
  disponíveis (400 PECA_INDISPONIVEL);
  peça repetida é ignorada.
end note
@enduml
