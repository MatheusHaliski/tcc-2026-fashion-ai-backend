  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF5 — Criar um esquema de vestimenta na aba 'Criar Look'\nDiagrama de componentes — gerado do código em 2026-10-14 (scripts/diagramas/v5)

package "Frontend (Next.js)" {
  component "/pieces/new\n(site)/(app)/pieces/new/page.tsx" as FE0
  component "/dna-schemes/[id]/edit\n(site)/(app)/dna-schemes/[id]/edit/page.tsx" as FE1
  component "/dna-schemes/new\n(site)/(app)/dna-schemes/new/page.tsx" as FE2
  component "/dna\n(site)/(app)/dna/page.tsx" as FE3
  component "/schemes/[id]/edit\n(site)/(app)/schemes/[id]/edit/page.tsx" as FE4
  component "/schemes/new\n(site)/(app)/schemes/new/page.tsx" as FE5
  component "lib/api/client.ts" as APIC
}
package "fai-web (REST)" {
  component "BackgroundController\n/api/backgrounds/art\n/api/backgrounds/catalog\n/api/backgrounds/recommendations\n/api/pieces/{…}/background" as BackgroundController
  component "SchemeController\n/api/schemes\n/api/schemes/builder\n/api/schemes/compositions\n/api/schemes/photos\n(+6 rotas)" as SchemeController
  component "SealController\n/api/schemes/{…}/seal-bonds\n/api/schemes/{…}/seal-suggestions\n/api/seal-bonds/{…}/accept\n/api/seal-suggestions/preview\n(+1 rotas)" as SealController
  component "WardrobeController\n/api/pieces\n/api/pieces/{…}\n/api/pieces/{…}/copy\n/api/pieces/{…}/deletion-impact\n(+5 rotas)" as WardrobeController
}
package "fai-application (casos de uso)" {
  component "BackgroundStudioService" as BackgroundStudioService
  component "SchemeService" as SchemeService
  component "CopilotService" as CopilotService
  component "LookPreviewService" as LookPreviewService
  component "SealService" as SealService
  component "WardrobeService" as WardrobeService
  component "AssetCatalogService" as AssetCatalogService <<apoio>>
  component "MediaService" as MediaService <<apoio>>
  component "SchemeCardRenderer" as SchemeCardRenderer <<apoio>>
  component "ProjectionService" as ProjectionService <<apoio>>
  component "NotificationService" as NotificationService <<apoio>>
  component "DailyLookService" as DailyLookService <<apoio>>
  component "HypeScoreConfig" as HypeScoreConfig <<apoio>>
  component "RoomService" as RoomService <<apoio>>
  component "CounterStorePort\n«InMemoryCounterStore»" as CounterStorePort <<port>>
  component "JobQueuePort\n«InMemoryJobQueue»" as JobQueuePort <<port>>
}
package "fai-domain (repositórios)" {
  component "AssetPresetRepository\nSchemeRepository\nWardrobeItemRepository\nUserRepository\nCelebrityProfileRepository\nSchemeItemRepository\nReactionRepository\nSavedItemRepository\nStyleDnaRepository\nHypeScoreCurrentRepository\n(+13)" as REPO_MySQL
}
database "MySQL\n• asset_presets\n• brand_profiles\n• brands\n• celebrity_profiles\n• daily_looks\n• hype_scores\n• moderation_queue\n• photos\n• pipeline_jobs\n• processing_jobs_log\n• promotion_redemptions\n• promotions\n(+11)" as DB_MySQL
cloud "Motor de IA (RF24)\nprovedores externos + reserva local" as AI
component "Eventos de domínio\n(@TransactionalEventListener)" as EV
