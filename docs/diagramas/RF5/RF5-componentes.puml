@startuml RF5_Componentes
title RF5 — Criar um esquema de vestimenta na aba "Criar Look"\nDiagrama de componentes — frontend → controllers → serviços → portas → infraestrutura
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #4A4852
}
left to right direction

package "Frontend (Next.js)" {
  component "(app)/schemes/new/page.tsx" as FE0
  component "scheme-builder.tsx\nSchemeBuilder · SlotBrand · onePerType" as FE1
  component "ai-compositions.tsx\n(AiCompositionCard)" as FE2
  component "hype/look-hype-preview.tsx\n(LookHypePreview · PieceHypeTag)" as FE3
  component "background-studio.tsx (RF11)" as FE4
  component "scheme-card.tsx + scheme-anatomies.tsx" as FE5
}
package "fai-web · controllers" {
  [SchemeController\nGET /api/schemes/builder\nPOST /api/schemes/compositions · /scores\nPOST /api/schemes · /photos · /preview] as SC
  [SealController\nPOST /api/seal-suggestions/preview\nPOST /api/schemes/{id}/seal-bonds] as SEALC
  [BackgroundController\nGET /api/backgrounds/recommendations\nPOST /api/backgrounds/art] as BGC
}
package "fai-application · serviços" {
  [SchemeService] as SS
  [WardrobeService\n(eligible)] as WS
  [CopilotService\n(orientation)] as CP
  [LookPreviewService\n(seis números · HypeScore v2)] as LP
  [BackgroundStudioService] as BG
  [SealService] as SEAL
  [DailyLookService] as DL
  [SchemeCardRenderer\n(imaging)] as REN
  [LocalSchemeComposer\n(plano B local)] as LOC
  [AiEngine (RF24)\nSCHEME_COMPOSER] as AI
  [ProjectionService · NotificationService\nGuard · Audit · MediaService] as X
  [Listeners de SchemeSaved (AFTER_COMMIT)\nWardrobeEventListeners · HypeSignalRecorder\nHypeLiveRecalc · ChallengeService\nAchievementService · InventoryScoreService\nCouponService] as EV
}
package "portas" {
  interface SearchIndexPort as P1
  interface TimelineProjectionPort as P2
  interface MediaStoragePort as P3
  interface CounterStorePort as P4
}
package "fai-infrastructure" {
  [Repositórios JPA\nSchemeRepository · SchemeItemRepository\nWardrobeItemRepository · UserRepository\nHypeScoreCurrentRepository · SealBondRepository] as REPOS
  [OpenSearchIndexAdapter] as OS
  [CassandraProjectionAdapter] as CAS
  [S3MediaStorageAdapter / LocalFileMediaStorage] as S3
  [RedisAdapters (contadores) /\nInMemoryCounterStore] as RED
  [Provedores de IA\n(ai-providers)] as PROV
}
database "MySQL\n• schemes · scheme_items\n• wardrobe_items · users\n• hype_scores · seal_bonds\n• notifications · audit_log" as DB

FE0 --> FE1
FE1 --> FE2
FE1 --> FE3
FE1 --> FE4
FE1 --> FE5
FE1 --> SC : builder · compositions · preview · salvar
FE3 --> SC : POST /api/schemes/scores
FE1 --> SEALC : selos possíveis e pedidos
FE4 --> BGC : arte de fundo
SC --> SS
SC --> CP
SC --> LP
SEALC --> SEAL
BGC --> BG
SS --> WS : peças elegíveis (CA01/CA07b)
SS --> AI : 3 looks só do acervo (CA04)
SS --> LOC : sem IA
SS --> BG : applyToScheme
SS --> SEAL : suggestSealsAfterSave
SS --> DL : Look do Dia
SS --> REN : prévia / card.png
SS --> X
SS ..> EV : publica SchemeSaved
AI --> PROV
X --> P1
X --> P2
X --> P3
SS --> P4 : remixes
OS ..|> P1
CAS ..|> P2
S3 ..|> P3
RED ..|> P4
SS --> REPOS
LP --> REPOS
REPOS --> DB : JPA / Flyway
note bottom of SS
  CA02: < 2 elegíveis → INSUFICIENTE (/pieces/new) e 422 ACERVO_INSUFICIENTE
  CA06: items vazio → 400 SEM_PECAS · CA05: publish → PUBLISHED e feed (RF8)
  CA03: visibilidade herdada do perfil (AccountService.defaultVisibility)
end note
@enduml
