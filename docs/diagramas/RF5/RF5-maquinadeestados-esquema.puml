@startuml RF5_MaquinaDeEstados_Esquema
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  StartColor #20A77A
  EndColor #4B5563
}
title RF5 — ciclo de vida de Scheme.status e visibility\nDiagrama de máquina de estados — gerado do código em 2026-10-06 (scripts/diagramas/v5)\nenum SchemeStatus · enum Visibility · tabela schemes

state "Scheme.status" as Ciclo_Scheme {
  state Ciclo_Scheme_DRAFT as "DRAFT"
  state Ciclo_Scheme_PUBLISHED as "PUBLISHED"
  state Ciclo_Scheme_ARCHIVED as "ARCHIVED"
}
[*] --> Ciclo_Scheme_DRAFT : criação
Ciclo_Scheme --> Ciclo_Scheme_ARCHIVED : purgeScheduledDeletions(), archive()
Ciclo_Scheme --> Ciclo_Scheme_PUBLISHED : create(), publish(),\npublishInternal(), update()
state "Scheme.visibility" as Ciclo_Scheme_visibility {
  state Ciclo_Scheme_visibility_PRIVATE as "PRIVATE"
  state Ciclo_Scheme_visibility_FOLLOWERS as "FOLLOWERS"
  state Ciclo_Scheme_visibility_PUBLIC as "PUBLIC"
}
[*] --> Ciclo_Scheme_visibility_PRIVATE : criação
Ciclo_Scheme_visibility --> Ciclo_Scheme_visibility_PRIVATE : publish(), purgeScheduledDeletions()
Ciclo_Scheme_visibility --> Ciclo_Scheme_visibility_FOLLOWERS : publish()\nPOST /api/schemes/{id}/publication
Ciclo_Scheme_visibility --> Ciclo_Scheme_visibility_PUBLIC : publish()\nPOST /api/schemes/{id}/publication
note right of Ciclo_Scheme
  Setas que saem da borda: a mudança vale
  a partir de qualquer estado (o código não
  testa o estado anterior).
end note
@enduml
