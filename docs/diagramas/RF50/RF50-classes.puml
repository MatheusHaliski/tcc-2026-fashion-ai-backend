@startuml RF50_Classes
title RF50 — Verificar perfis de Marca e Celebridade\nDiagrama de classes — entidades (fai-domain), política e serviço (fai-application)
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam class {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  ArrowColor #52606D
  HeaderBackgroundColor #E4DEF0
}
skinparam packageStyle rectangle
hide empty members

package "fai-domain · model" {
  enum ApprovalStatus {
    PENDENTE
    AJUSTES
    APROVADO
    RECUSADO
    SUSPENSO
  }
  enum AccountStatus {
    PENDING_EMAIL_VERIFICATION
    PENDING_VALIDATION
    ACTIVE
    SUSPENDED
    DELETION_SCHEDULED
    DELETED
  }
  enum ProfileType {
    PESSOAL
    MARCA
    CELEBRIDADE
    ADMIN
  }
  class User <<Entity users>> {
    +id : UUID
    +username : String
    {field} +email (cifrado) / emailHash
    +profileType : ProfileType
    +status : AccountStatus
    +emailVerified : boolean
    +verified : boolean
    +role : String
    +createdAt : Instant
  }
  interface ReviewableProfile {
    +getOwner() : User
    +getSlug() : String
    +publicName() : String
    +reviewStatus() : ApprovalStatus
    +reviewStatus(ApprovalStatus)
    +reviewAttempts : int
    +reviewSubmittedAt : Instant
    {field} +reviewReasons : String (csv)
    {field} +reviewChecklist : String (json)
    +reviewOwnerMessage : String
    +verificationNotes : String
    +approvedBy : UUID
    +approvedAt : Instant
    +identityVerified : boolean
    +getCreatedAt() : Instant
  }
  class BrandProfile <<Entity brand_profiles>> {
    +brandName, slug, logoUrl
    +razaoSocial, nomeFantasia
    {field} +cnpj (cifrado)
    +fashionCategory, officialHashtag
    +storeUrl, commercialContact
    {field} +activityProofUrl (restricted/)
    +approvalStatus : ApprovalStatus
    +documentVerified : boolean
    +requiresSealReview : boolean
  }
  class CelebrityProfile <<Entity celebrity_profiles>> {
    +stageName, slug
    {field} +realName (cifrado)
    +birthDate, areas, followers
    +verificationUrl, representationContact
    {field} +identityProofUrl (restricted/)
    +officialPhotoUrl
    +verificationStatus : ApprovalStatus
    +sealConsentGranted : boolean
    +requiresSealReview : boolean
  }
}

package "fai-application · service" {
  class IssuerVerificationPolicy <<Component>> {
    +VERSION = "1.0"
    +MAX_SUBMISSIONS = 5
    +SLA_BUSINESS_DAYS = 3
    +RESUBMIT_SLA_BUSINESS_DAYS = 2
    ~NOTORIETY_FOLLOWERS = 10000
    +BRAND : List<Criterion>
    +CELEBRITY : List<Criterion>
    +REASONS : List<String>
    +{static} criteria(ReviewableProfile) : List<Criterion>
    +checks(User, ReviewableProfile) : List<Check>
    +{static} verificationCode(UUID) : String
    +{static} validCnpj(String) : boolean
    +{static} webUrl(String) : boolean
  }
  enum Auto {
    OK
    FALHA
    ANALISTA
  }
  class Criterion <<record>> {
    +code : String
    +mandatory : boolean
  }
  class Check <<record>> {
    +code : String
    +mandatory : boolean
    +auto : Auto
    +detail : String
    +toMap() : Map
  }
  class IssuerReviewService <<Service>> {
    -DOC_IDENTITY = "identity"
    -DOC_ACTIVITY = "activity-proof"
    -notifyEmails : List<String>
    -frontendUrl : String
    +adminsConfigured() : boolean
    +submitted(UUID)
    ~notifyAdmins(UUID)
    +emailConfirmed(User)
    +status(CurrentUser) : Map
    +resubmit(CurrentUser, ResubmitCommand) : Map
    +queue(CurrentUser) : Map
    ~dossier(ReviewableProfile) : Map
    +document(CurrentUser, UUID, String) : byte[]
    +decide(CurrentUser, UUID, DecisionCommand) : Map
  }
  class ResubmitCommand <<record>> {
    +message : String
    +storeUrl : String
    +commercialContact : String
    +verificationUrl : String
    +representationContact : String
    +documentUrl : String
    +realName : String
  }
  class DecisionCommand <<record>> {
    +decision : APROVAR | AJUSTES | RECUSAR
    +reasons : List<String>
    +notes : String
    +checklist : Map<String, Boolean>
    {field} +approve : Boolean (formato antigo)
    +effective() : String
    +legacyRejection() : boolean
  }
  class IdentityService <<Service>> {
    +register(RegisterCommand, ip, userAgent) : Session
    +verifyEmail(CurrentUser, code) : UserCard
  }
  interface EmailSenderPort {
    +send(to, subject, html, category)
  }
}

User "1" -- "0..1" BrandProfile : owner
User "1" -- "0..1" CelebrityProfile : owner
BrandProfile ..|> ReviewableProfile
CelebrityProfile ..|> ReviewableProfile
ReviewableProfile ..> ApprovalStatus
User ..> AccountStatus
User ..> ProfileType
IssuerVerificationPolicy *-- "*" Criterion
IssuerVerificationPolicy ..> Check : checks()
Check ..> Auto
IssuerReviewService --> IssuerVerificationPolicy
IssuerReviewService ..> ReviewableProfile
IssuerReviewService ..> ResubmitCommand
IssuerReviewService ..> DecisionCommand
IssuerReviewService --> EmailSenderPort
IdentityService --> IssuerReviewService : submitted · emailConfirmed
@enduml
