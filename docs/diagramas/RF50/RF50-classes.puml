@startuml RF50_Classes
title RF50 — Cartela sazonal e animação no modal do Background Studio\nDiagrama de classes — componentes e tipos do frontend, serviço e entidades do backend
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam class {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  ArrowColor #52606D
  HeaderBackgroundColor #E4DEF0
}
skinparam packageStyle rectangle
hide empty members
set separator none

package "Frontend · components/background-studio.tsx" {
  class BgConfig <<type>> {
    +seasonalPresetId : string | null
    +seasonalAuto : boolean
    +animation : "NONE" | "SNOW" | "PETALS" | "LEAVES" | "SHIMMER" | null
    +color, gradient, gradientPresetId
    +aura, materialId, aiArt, uploadUrl, posterUrl
    +container
  }
  class BgCatalog <<type>> {
    +seasonal : SeasonalPreset[]
    +animations : string[]
  }
  class SeasonalPreset <<type>> {
    +id : frost | solstice | ember | bloom
    +name : string
    +season : Season
    +stops : string[]
    +animation : SNOW | SHIMMER | LEAVES | PETALS
  }
  class BackgroundStudio <<React>> {
    -seg : cor | aura | layout | container
    -seasonal : {enter?, patch?} | null
    +props value, onChange, anatomy, onAnatomy
    {field} +props season, layoutPanel(ctx {openSeasonal})
    -chooseAnatomy(a)
    -applySeasonal(draft)
  }
  class SeasonalDialog <<React>> {
    +open : boolean
    +value : BgConfig
    +season : string | null | undefined
    +onApply(draft)
    +onClose()
  }
  class SeasonalDraft <<React>> {
    -draft : {seasonalPresetId, seasonalAuto, animation}
  }
  class SeasonalOptions <<React>> {
    +forLayout : boolean
    +season : string | null | undefined
    +onChange(patch)
  }
  class ColorPanel <<React>> {
    +hideSeasonal : boolean
    +keepCartela : boolean
  }
  class CartelaHelpers <<module>> {
    +CLEAR_CARTELA = {seasonalPresetId: null,\n seasonalAuto: false, animation: "NONE"}
    +useLeaveCartela(active, clear)
    +useBgCatalog() : BgCatalog
  }
}
package "Frontend · lib/card-art.ts" {
  class CardArtLib <<module>> {
    +cartelaSeason(bg, season) : Season | null
    +resolveCardArt(bg, {season}) : CardArt
    +motionOf(animation) : snow | petals | leaves | shimmer | null
    +studioOf(bg) : Studio
    +SEASON_PRESET : Season → preset
  }
  class CardArt <<type>> {
    +kind : "seasonal" | …
    +season : Season
    +motion : snow | petals | leaves | shimmer | null
  }
}
package "Frontend · editores" {
  class SchemeBuilder <<React>> {
    -bg : BgConfig
    -anatomy : string
  }
  class DnaBuilder <<React>> {
    -bg : BgConfig
    -narrative : string
    -layoutPanel({openSeasonal})
  }
  class PieceArtEditor <<React>> {
    -seasonal : {variant?} | null
    -chooseTemplate(f, v)
    -applySeasonal(draft)
  }
}
package "Backend · fai-application / fai-domain" {
  class BackgroundStudioService <<Service>> {
    +catalog() : Map
    +applyToScheme(Scheme, Map, boolean)
    +savePiece(...)
    +resetScheme(...)
  }
  class Scheme <<Entity schemes>> {
    +season : Season
    +layoutAnatomy : String
    +backgroundGradient : String
    +backgroundAnimationType : BackgroundAnimation
    +studioConfigJson : String
  }
  class DnaScheme <<Entity dna_schemes>> {
    +narrativeType : String
    +seasonalTheme : Season
    +studioConfigJson : String
  }
  enum BackgroundAnimation {
    NONE
    SNOW
    PETALS
    LEAVES
    SHIMMER
  }
  enum Season {
    SPRING
    SUMMER
    AUTUMN
    WINTER
  }
}

BackgroundStudio *-- SeasonalDialog
SeasonalDialog *-- SeasonalDraft
SeasonalDraft *-- SeasonalOptions
BackgroundStudio *-- ColorPanel
BackgroundStudio ..> CartelaHelpers
BackgroundStudio ..> BgConfig
BgCatalog *-- SeasonalPreset
SeasonalOptions ..> BgCatalog
SchemeBuilder --> BackgroundStudio
DnaBuilder --> BackgroundStudio
DnaBuilder ..> CartelaHelpers : useLeaveCartela
PieceArtEditor --> SeasonalDialog
CardArtLib ..> CardArt
SchemeBuilder ..> CardArtLib : prévia
DnaBuilder ..> CardArtLib : seasonalTheme
SchemeBuilder ..> BackgroundStudioService : POST/PUT /api/schemes
BackgroundStudioService ..> Scheme : applyToScheme
Scheme --> BackgroundAnimation
Scheme --> Season
DnaScheme --> Season
@enduml
