@startuml RF50_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."
title RF50 — Verificar perfis de Marca e Celebridade (política v1.0)\nDiagrama de sequência — gerado do código em 2026-10-06 (scripts/diagramas/v5)

actor "Pessoa usuária" as U
boundary "Tela /admin/users" as P
control "AdminController" as AdminController
participant "IssuerReviewService" as IssuerReviewService
participant "Guard" as Guard
database "MySQL" as DB_MySQL
participant "IssuerVerificationPolicy" as IssuerVerificationPolicy
== Decidir a verificação: APROVAR (checklist completa), AJUSTES ou RECUS… ==
U -> P : Decidir a verificação: APROVAR (checklist complet…
P -> AdminController : POST /api/admin/approvals/{userId}
AdminController -> IssuerReviewService : decide()
activate IssuerReviewService
IssuerReviewService -> Guard : requireAdmin()
alt Um administrador não pode decidir a ver…
IssuerReviewService --> AdminController : 403 ACESSO_NEGADO
AdminController --> P : 403 + mensagem
end
IssuerReviewService -> DB_MySQL : SELECT users
alt perfil pessoal
IssuerReviewService --> AdminController : 400 PERFIL_PESSOAL
AdminController --> P : 400 + mensagem
end
IssuerReviewService -> DB_MySQL : SELECT brand_profiles
IssuerReviewService -> DB_MySQL : SELECT celebrity_profiles
alt decisao inválida
IssuerReviewService --> AdminController : 400 DECISAO_INVALIDA
AdminController --> P : 400 + mensagem
end
alt fora da fila
IssuerReviewService --> AdminController : 409 FORA_DA_FILA
AdminController --> P : 409 + mensagem
end
alt motivo inválido
IssuerReviewService --> AdminController : 400 MOTIVO_INVALIDO
AdminController --> P : 400 + mensagem
end
IssuerReviewService -> IssuerVerificationPolicy : checks()
IssuerVerificationPolicy -> DB_MySQL : SELECT brand_profiles
IssuerVerificationPolicy -> DB_MySQL : SELECT celebrity_profiles
IssuerVerificationPolicy --> IssuerReviewService
alt e-mail não confirmado
IssuerReviewService --> AdminController : 409 EMAIL_NAO_CONFIRMADO
AdminController --> P : 409 + mensagem
end
alt criterios pendentes
IssuerReviewService --> AdminController : 409 CRITERIOS_PENDENTES
AdminController --> P : 409 + mensagem
end
alt motivo obrigatório
IssuerReviewService --> AdminController : 400 MOTIVO_OBRIGATORIO
AdminController --> P : 400 + mensagem
end
alt observacao obrigatória
IssuerReviewService --> AdminController : 400 OBSERVACAO_OBRIGATORIA
AdminController --> P : 400 + mensagem
end
IssuerReviewService -> IssuerReviewService : approvedAt = set
IssuerReviewService -> IssuerReviewService : identityVerified = true
IssuerReviewService -> IssuerReviewService : documentVerified = true
note over IssuerReviewService : … e mais 15 passos no código
deactivate IssuerReviewService
IssuerReviewService --> AdminController : resultado
AdminController --> P : 201 JSON
P --> U : atualiza a tela
@enduml
