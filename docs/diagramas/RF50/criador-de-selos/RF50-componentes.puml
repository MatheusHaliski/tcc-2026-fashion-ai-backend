@startuml RF50_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF50 (evolução do RF25) — Criador de selo: componentes (frontend, backend, catálogo de modelos e armazenamento)\nDiagrama de componentes — gerado do código em 2026-10-14 (scripts/diagramas/v5)

package "app/(site)" {
  component "page.tsx" as m_app__site__page_tsx
}
package "lib/seals" {
  component "templates.ts" as m_lib_seals_templates_ts
}
package "components/ui" {
  component "index.tsx" as m_components_ui_index_tsx
  component "icons.tsx" as m_components_ui_icons_tsx <<apoio>>
}
package "components" {
  component "seal-wizard.tsx" as m_components_seal_wizard_tsx
  component "seal-policy-editor.tsx" as m_components_seal_policy_editor_tsx
  component "seal-core-editor.tsx" as m_components_seal_core_editor_tsx
  component "creator-welcome.tsx" as m_components_creator_welcome_tsx <<apoio>>
  component "manual-seal-policy.tsx" as m_components_manual_seal_policy_tsx <<apoio>>
  component "seal-creator.tsx" as m_components_seal_creator_tsx <<apoio>>
  component "seal-hype-editor.tsx" as m_components_seal_hype_editor_tsx <<apoio>>
}
package "lib" {
  component "dev-refs.ts" as m_lib_dev_refs_ts <<apoio>>
}
package "Backend (Spring Boot)" {
  component "SealController" as SealController
  component "SealDesigns" as SealDesigns <<apoio>>
  component "SealDrafts" as SealDrafts <<apoio>>
  component "OwnMedia" as OwnMedia
  component "SealDesignService" as SealDesignService
  component "SealPolicies" as SealPolicies <<apoio>>
  component "SealService" as SealService
}
database "MySQL" as DB_MySQL
SealController --> SealDesignService
SealController --> SealService
SealDesignService --> DB_MySQL : users
SealService --> DB_MySQL : brand_profiles, celebrity_profiles,\npromotion_redemptions, promotions,\nscheme_items, schemes
SealService --> OwnMedia
m_components_creator_welcome_tsx --> m_components_ui_index_tsx
m_components_manual_seal_policy_tsx --> SealController : HTTPS
m_components_manual_seal_policy_tsx --> m_components_seal_policy_editor_tsx
m_components_manual_seal_policy_tsx --> m_components_ui_index_tsx
m_components_seal_core_editor_tsx --> m_components_ui_index_tsx
m_components_seal_core_editor_tsx --> m_lib_seals_templates_ts
m_components_seal_creator_tsx --> m_components_seal_core_editor_tsx
m_components_seal_creator_tsx --> m_components_ui_index_tsx
m_components_seal_hype_editor_tsx --> m_components_seal_policy_editor_tsx
m_components_seal_hype_editor_tsx --> m_components_ui_index_tsx
m_components_seal_policy_editor_tsx --> m_components_ui_index_tsx
m_components_seal_wizard_tsx --> m_components_creator_welcome_tsx
m_components_seal_wizard_tsx --> m_components_manual_seal_policy_tsx
m_components_seal_wizard_tsx --> m_components_seal_core_editor_tsx
m_components_seal_wizard_tsx --> m_components_seal_creator_tsx
m_components_seal_wizard_tsx --> m_components_seal_hype_editor_tsx
m_components_seal_wizard_tsx --> m_components_seal_policy_editor_tsx
m_components_seal_wizard_tsx --> m_components_ui_index_tsx
m_components_seal_wizard_tsx --> m_lib_seals_templates_ts
m_components_ui_index_tsx --> m_components_ui_icons_tsx
m_components_ui_index_tsx --> m_lib_dev_refs_ts
@enduml
