@startuml RF51_Sequencia
title RF51 — Cartela sazonal e animação no modal do Background Studio\nDiagrama de sequência — abrir, rascunho, Aplicar/Cancelar, prévia e gravação (look; DNA e peça no fim)
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam sequence {
  ArrowColor #52606D
  LifeLineBorderColor #B695F5
  ParticipantBackgroundColor #F8F4FF
  ParticipantBorderColor #B695F5
  ActorBackgroundColor #F8F4FF
  GroupBackgroundColor #FFF5F8
}
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
autonumber
actor "Pessoa" as U
participant "SchemeBuilder\n(etapa 4 do look)" as H
participant "BackgroundStudio\n(background-studio.tsx)" as BS
participant "SeasonalDialog\nSeasonalDraft\nSeasonalOptions" as D
participant "lib/card-art.ts\ncartelaSeason · resolveCardArt\nmotionOf" as L
participant "SchemeCard\neffectiveAnatomy\nSeasonCard" as P
participant "BackgroundController\nSchemeController" as C
participant "SchemeService\nBackgroundStudioService" as S
database "MySQL\nschemes" as DB

U -> H : etapa 4 · Aparência
H -> BS : <BackgroundStudio value anatomy season>
BS -> C : GET /api/backgrounds/catalog
C -> S : catalog()
S --> BS : seasonal (frost, solstice, ember, bloom)\n+ animations (NONE, SNOW, PETALS, LEAVES, SHIMMER)
U -> BS : Layout & Estilo → clica "Cartela sazonal"
BS -> BS : chooseAnatomy("CARTELA_SAZONAL")
alt já é o layout atual
  BS -> D : setSeasonal({}) → modal em edição
else outro layout
  BS -> D : setSeasonal({enter: onAnatomy(CARTELA_SAZONAL),\npatch: limpa aura/material/arte com IA/upload})
  note right of BS : o layout ainda não muda
end
D -> D : draft = {seasonalPresetId, seasonalAuto, animation}\n(do valor atual)
loop enquanto a pessoa ajusta
  U -> D : cartela · automática (se o look tem estação) · animação
  D -> D : altera só o rascunho
end
alt Cancelar, X, Esc ou clique no fundo
  D -> BS : onClose() → setSeasonal(null)
  note right of BS : nenhum onChange/onAnatomy:\nlayout e arte como estavam
else Aplicar
  D -> BS : onApply(draft)
  BS -> H : enter() → onAnatomy("CARTELA_SAZONAL")
  BS -> H : onChange({...value, ...patch, ...draft})
  D -> BS : onClose()
end
H -> P : prévia ao vivo (draft do look)
P -> L : cartelaSeason(bg, estação do look)
alt há estação
  P -> L : motionOf(animation)
  P -> P : SeasonCard: gradiente da estação, SeasonDecor,\nMotionFall (neve/pétalas/folhas) ou brilho
  note right of P : movimento reduzido:\nanimações desligadas
else sem cartela e sem estação
  P -> P : effectiveAnatomy → LISTA_VERTICAL
end
opt troca para outro layout
  U -> BS : escolhe outro layout
  BS -> H : onAnatomy(outro) + onChange(CLEAR_CARTELA)\n{seasonalPresetId: null, seasonalAuto: false, animation: "NONE"}
end
U -> H : etapa 5 · salvar
H -> C : POST /api/schemes | PUT /api/schemes/{id}\n{background: {scheme: {...bg, layoutAnatomy}}, season, layoutAnatomy, cardSkin}
C -> S : create/update → applyForm (estação) → applyToScheme(scheme, config)
alt preset desconhecido
  S --> H : 400 PRESET_INVALIDO
else seasonalAuto sem estação
  S --> H : 400 ESTACAO_OBRIGATORIA
else válido
  S -> S : "animation" presente → BackgroundAnimation (null → NONE);\nausente → mantém; automática → preset e gradiente pela estação
  S -> DB : backgroundGradient, backgroundAnimationType,\nlayoutAnatomy, studioConfigJson
  S --> H : SchemeView (background.animation vem do studioConfigJson)
end
== DNA de Estilo (narrativa B11) ==
U -> BS : narrativa "Cartela sazonal" (layoutPanel → openSeasonal(enter = setNarrative))
note over BS, D : mesmo modal; Aplicar define a narrativa B11 e o fundo
BS -> C : POST /api/dna-schemes/preview (debounce 250 ms)
BS -> C : POST /api/dna-schemes | PUT /api/dna-schemes/{id}\n{background, narrativeType, seasonalTheme = cartelaSeason ?? AUTUMN}
note over BS : useLeaveCartela: qualquer saída da B11\n(outra narrativa, layout base, outro alvo) aplica CLEAR_CARTELA
== peça (família "seasonal") ==
U -> BS : PieceArtEditor → variante sazonal → mesmo modal (sem "automática")
BS -> C : PUT /api/pieces/{id}/background {...draft, baseRev}
C -> S : savePiece → 409 ARTE_ALTERADA se baseRev ficou velho
@enduml
