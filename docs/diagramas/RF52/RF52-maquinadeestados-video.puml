@startuml RF52_MaquinaDeEstados_Video
!pragma layout smetana
title RF52 — Um vídeo de Aura no card (ArtVideo)\nMáquina de estados — sem fonte, carregado, tocando, pausado, travado (plano B), liberado
skinparam backgroundColor #FFFFFF
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  ArrowColor #52606D
}
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
state "Sem fonte" as SemFonte
SemFonte : pôster visível; <video> sem src
state "Na área de carga (≤ 300 px)" as Area {
  state "Carregado" as Carregado
  Carregado : src definido; aguardando ficar visível
  state "Tocando" as Tocando
  state "Pausado" as Pausado
  Pausado : fora da vista; arquivo mantido
  state "Travado (plano B)" as Travado
  Travado : onStuck(true): pôster animado por anim-<still | drift>
  Travado : nova tentativa armada (1º toque ou tecla)
  [*] --> Carregado
  Carregado --> Tocando : visível ∧ aba visível ∧ play() ok
  Carregado --> Travado : play() → NotAllowedError
  Carregado --> Carregado : AbortError / outro erro (ignorado)
  Tocando --> Pausado : sai da vista → pause()
  Pausado --> Tocando : volta à vista → play() ok
  Pausado --> Travado : volta à vista → NotAllowedError
  Travado --> Tocando : toque · tecla · aba visível · pageshow ·\ncanplay · volta à vista → play() ok\n(dropRetry, onStuck(false))
  Travado --> Travado : recusado de novo
}
state "Liberado" as Liberado
Liberado : observadores e ouvintes removidos;
Liberado : onStuck(false)
[*] --> SemFonte : monta (navegador com IntersectionObserver)
SemFonte --> Area : card a até 300 px → src = arquivo
Area --> SemFonte : card além de 300 px\npause(); removeAttribute("src"); load()
Area --> Liberado : Aura trocada ou card desmontado\n(libera o arquivo)
SemFonte --> Liberado : Aura trocada ou card desmontado
Liberado --> SemFonte : nova Aura (outro src)
Liberado --> [*]
note right of SemFonte
  sem IntersectionObserver: autoplay = true
  e src definido direto (o navegador decide)
end note
@enduml
