@startuml RF53_Classes_Integracoes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  StereotypeFontColor #6B6470
}
hide empty members
left to right direction
title RF53 — HypeScore v2 nas integrações\nDiagrama de classes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "fai-domain (entidades JPA)" {
  class HypeScoreCurrent <<hype_scores>> {
    +id: UUID
    +entityType: HypeEntityType
    +entityId: UUID
    +ownerId: UUID
    +algorithmVersion: String
    +status: HypeStatus
    +score: BigDecimal
    +level: HypeLevel
    +dimensions: HypeDimensions
    +deltaPoints: BigDecimal
    .. +16 campos ..
  }
  class Seal <<seals>> {
    +id: UUID
    +owner: User
    +name: String
    +tier: SealTier
    +policyText: String
    +status: SealStatus
    +iconUrl: String
    +premium: boolean
    +backgroundConfigJson: String
    +availableFrom: Instant
    .. +4 campos ..
  }
}
package "fai-domain (enums)" {
  enum HypeStatus {
    AVAILABLE
    INSUFFICIENT_DATA
  }
  enum SealStatus {
    ACTIVE
    INACTIVE
  }
  enum HypeLevel {
    LOW_SIGNAL
    NICHE
    RELEVANT
    HOT
    TRENDING
    VIRAL
  }
  enum HypeMomentum {
    EMERGING
    RISING
    STABLE
    COOLING
    CLASSIC
  }
}
package "fai-application" {
  class InsightService <<service>> {
    +insights()
  }
}
InsightService ..> HypeScoreCurrent : usa
HypeScoreCurrent --> HypeLevel
HypeScoreCurrent --> HypeMomentum
HypeScoreCurrent --> HypeStatus
Seal --> SealStatus
@enduml
