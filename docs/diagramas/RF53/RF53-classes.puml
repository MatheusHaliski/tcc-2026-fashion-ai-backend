package "fai-domain (entidades JPA)" {
  class HypeMilestone <<hype_milestones>> {
    +id: UUID
    +entityType: HypeEntityType
    +entityId: UUID
    +ownerId: UUID
    +milestone: Kind
    +level: HypeLevel
    +momentum: HypeMomentum
    +score: BigDecimal
    +publicEligible: boolean
    +algorithmVersion: String
    .. +3 campos ..
  }
  class HypeScoreCurrent <<hype_scores>> {
    +id: UUID
    +entityType: HypeEntityType
    +entityId: UUID
    +ownerId: UUID
    +algorithmVersion: String
    +status: HypeStatus
    +score: BigDecimal
    +level: HypeLevel
    +dimensions: HypeDimensions
    +deltaPoints: BigDecimal
    .. +16 campos ..
  }
  class HypeScoreSnapshot <<hype_score_snapshots>> {
    +id: UUID
    +entityType: HypeEntityType
    +entityId: UUID
    +algorithmVersion: String
    +snapshotDate: LocalDate
    +status: HypeStatus
    +score: BigDecimal
    +level: HypeLevel
    +dimensions: HypeDimensions
    +publicEligible: boolean
    .. +3 campos ..
  }
  class HypeSignalDaily <<hype_signal_daily>> {
    +id: UUID
    +entityType: HypeEntityType
    +entityId: UUID
    +signalType: HypeSignalType
    +signalDate: LocalDate
    +eventCount: int
    +weightedCount: BigDecimal
  }
  class Scheme <<schemes>> {
    +id: UUID
    +user: User
    +originalScheme: Scheme
    +title: String
    +description: String
    +creationMode: CreationMode
    +origin: SchemeOrigin
    +style: String
    +occasion: String
    +season: Season
    .. +46 campos ..
  }
  class User <<users>> {
    +id: UUID
    +username: String
    +displayName: String
    +email: String
    +emailHash: String
    +emailVerified: boolean
    +phone: String
    +birthDate: String
    +passwordHash: String
    +profileType: ProfileType
    .. +24 campos ..
  }
  class WardrobeItem <<wardrobe_items>> {
    +id: UUID
    +user: User
    +brandProfile: BrandProfile
    +brand: Brand
    +name: String
    +category: String
    +subcategory: String
    +sex: String
    +brandName: String
    +brandLogoUrl: String
    .. +70 campos ..
  }
}
package "fai-domain (enums)" {
  enum HypeStatus {
    AVAILABLE
    INSUFFICIENT_DATA
  }
  enum SchemeStatus {
    DRAFT
    PUBLISHED
    ARCHIVED
  }
  enum RenderStatus {
    PENDING
    RENDERING
    ENHANCING
    COMPOSITING
    CACHED
    COMPLETED
    FAILED
  }
  enum AccountStatus {
    PENDING_EMAIL_VERIFICATION
    ACTIVE
    PENDING_VALIDATION
    SUSPENDED
    DELETION_SCHEDULED
    DELETED
  }
  enum AvailabilityStatus {
    AVAILABLE
    UNAVAILABLE
    ARCHIVED
  }
  enum ModerationStatus {
    PENDING
    APPROVED
    REJECTED_POLICY
    REJECTED_NOT_CLOTHING
  }
}
package "fai-application" {
  class AdminService <<service>> {
    +runJob()
  }
}
AdminService ..> User : usa
AdminService ..> WardrobeItem : usa
HypeMilestone ..> User : ownerId
HypeScoreCurrent --> HypeStatus
HypeScoreCurrent ..> User : ownerId
HypeScoreSnapshot --> HypeStatus
Scheme "*" --> "1" User : user
Scheme --> RenderStatus
Scheme --> SchemeStatus
User --> AccountStatus
WardrobeItem "*" --> "1" User : user
WardrobeItem --> AvailabilityStatus
WardrobeItem --> ModerationStatus
@enduml
