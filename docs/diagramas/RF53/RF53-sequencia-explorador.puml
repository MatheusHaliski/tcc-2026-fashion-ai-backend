@startuml RF53_Sequencia_Explorador
title RF53 — HypeScore v2 no Explorador\nDiagrama de sequência — Ranking de HypeScore, facetas, Globo do Painel global e Insights dinâmicos
skinparam backgroundColor #FFFFFF
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
}
autonumber
actor "Visitante ou\npessoa logada" as U
participant "explorer/page.tsx\nHypeRankingPanel · HypeGlobe\nInsightStrip" as FE
participant "HypeController" as HC
participant "InsightsController" as IC
participant "HypeQueryService" as HQ
participant "InsightService\n(PublicInsights)" as INS
participant "HypeCache\n(geração do job)" as CACHE
participant "AiEngine\n(INSIGHT_GENERATOR)" as AI
database "MySQL\nhype_scores (V39)" as DB

== 1. Ranking de HypeScore (aba Ranking; filtros na URL) ==
U -> FE: escolhe Peças/Looks, 7 dias, região "América do Norte",\ncategoria "Calçados"
FE -> HC: GET /api/hype/ranking?type=PIECE&window=7&region=AMERICA_DO_NORTE\n&category=shoes_piece&page=0&size=24
HC -> HQ: ranking(viewer, …)
HQ -> CACHE: get("ranking:PIECE:7:AMERICA_DO_NORTE:…", loader)
alt sem cache
  HQ -> DB: publicPool: public_eligible = true, AVAILABLE, score não nulo
  HQ -> HQ: filtra região/país/categoria/subcategoria\n(look: categorias das peças); ordena pela métrica\n(1 = trend, 7 = score, 30 = média do mês; desempate pelo id)
  HQ -> CACHE: ids + valores ordenados (independem de quem vê)
end
HQ -> DB: estado atual e views só da página
HQ -> HQ: tira da página o que quem vê não pode ver\n(bloqueio, visibilidade); a numeração não muda
opt type = LOOK
  HQ -> DB: scheme_items → peças do look com o Hype de cada uma
end
HQ --> FE: {total, page, hasMore, items[{rank, value, hype,\nregion, regionLabel, country, piece | scheme + pieces}]}
FE -> HC: GET /api/hype/ranking/facets?type=PIECE&window=7&region=…&category=…
HC -> HQ: rankingFacets(…)
HQ --> FE: world {count, avgHype}, regions [{key, count, avgHype}],\ncountries, categories, subcategories
FE --> U: barra "Hype por região", chips com contagem,\ncards com #posição e região

== 2. Globo do Painel global (aba Painel global) ==
U -> FE: liga camadas (números, colunas, bonecos, cards, calor),\nmétrica, tipo, janela, categoria, nível mínimo
FE -> HC: GET /api/hype/globe?type=PIECE&window=7&category=&minLevel=
HC -> HQ: globe(viewer, …)
alt minLevel fora da escala
  HQ --> FE: 400
end
HQ -> CACHE: get(chave de todos os filtros, loader)
alt sem cache
  HQ -> DB: publicPool + cores das peças
  HQ -> HQ: agrega por country: count, creators, avgHype, maxHype,\ntrend (média da dimensão TREND), rising, levels, topLevel,\ncor dominante, categoria mais frequente, candidatos a destaque;\nsufficient = count ≥ 3; sem país → só no world
end
HQ -> DB: mini card do destaque: o 1º candidato\nque quem vê pode ver (senão o próximo)
HQ --> FE: {world, countries[], regions[]}
FE --> U: globo 3D com as camadas (país com < 3 itens apagado,\nsem card); legenda; "Ver como tabela" (HypeGlobeTable)
U -> FE: clica no card flutuante do país
FE -> HC: GET /api/hype/pieces/{top.id} (+ history, positions)
HC --> FE: análise completa do item de destaque

== 3. Insights dinâmicos da aba ==
FE -> IC: GET /api/insights?context=EXPLORER_RANKING&window=7&region=…
alt contexto pessoal sem login
  IC --> FE: 401
end
IC -> INS: insights(viewer, context, …)
alt contexto desconhecido ou região inválida
  INS --> FE: 400 CONTEXTO_INVALIDO / REGIAO_INVALIDA
end
INS -> CACHE: get(contexto + filtros, loader) — contextos públicos
alt sem cache
  INS -> HQ: agregados públicos (hype_scores públicos,\ntrending, grupos BRAND;\nExplorerService: painel global e insights globais)
  INS -> INS: PublicInsights: até 5 insights determinísticos\n(REGION_LEADER, REGION_CATEGORY_RISING, TREND_VS_POPULARITY…)
end
opt withAi = true
  INS -> AI: reescrever só o texto
  AI --> INS: texto novo
  INS -> INS: InsightMath.numbers(local) == numbers(novo)?\nsenão descarta e mantém o texto local
end
INS --> FE: {context, algorithmVersion, source, items[{code, tone,\ntitle, text, metric, action, basis}]}
FE --> U: InsightStrip ("Ver ranking", "Ver no globo"…)
@enduml
