@startuml RF53_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."
title RF53 — HypeScore v2: Hype de peças e looks\nDiagrama de sequência — gerado do código em 2026-10-06 (scripts/diagramas/v5)

actor "Pessoa usuária" as U
boundary "Tela (Next.js)" as P
control "HypeController" as HypeController
participant "HypeQueryService" as HypeQueryService
database "MySQL" as DB_MySQL
participant "Guard" as Guard
participant "HypeScoreConfig" as HypeScoreConfig
control "SocialController" as SocialController
participant "SocialService" as SocialService
participant "SchemeService" as SchemeService
queue "Eventos de domínio" as EV
== Análise completa do Hype de um look ==
U -> P : Análise completa do Hype de um look
P -> HypeController : GET /api/hype/looks/{id}
HypeController -> HypeQueryService : detail()
activate HypeQueryService
HypeQueryService -> DB_MySQL : SELECT wardrobe_items
HypeQueryService -> Guard : canView()
Guard -> DB_MySQL : SELECT follows (×3)
Guard --> HypeQueryService
HypeQueryService -> DB_MySQL : SELECT scheme_items
HypeQueryService -> DB_MySQL : SELECT schemes
HypeQueryService -> Guard : canView()
HypeQueryService -> DB_MySQL : SELECT scheme_items
HypeQueryService -> HypeScoreConfig : algorithmVersion()
HypeQueryService -> DB_MySQL : SELECT hype_scores
HypeQueryService -> HypeScoreConfig : staleAfterHours()
HypeQueryService -> HypeScoreConfig : describe()
HypeQueryService -> HypeScoreConfig : levelThresholds()
HypeQueryService -> DB_MySQL : SELECT style_dna
HypeQueryService -> Guard : canView()
HypeQueryService -> HypeScoreConfig : algorithmVersion()
HypeQueryService -> DB_MySQL : SELECT hype_scores
HypeQueryService -> HypeScoreConfig : staleAfterHours()
deactivate HypeQueryService
HypeQueryService --> HypeController : resultado
HypeController --> P : 200 JSON
P --> U : atualiza a tela
== Marcar item salvo como favorito ==
U -> P : Marcar item salvo como favorito
P -> SocialController : PUT /api/interactions/{type}/{id}/saves/favorite
SocialController -> SocialService : favoriteSaved()
activate SocialService
SocialService -> DB_MySQL : SELECT saved_items
SocialService -> SocialService : favorite = ?favorite
SocialService -> DB_MySQL : SELECT schemes
SocialService -> SchemeService : requireView()
SocialService -> DB_MySQL : SELECT wardrobe_items
alt Peça não encontrado(a)
SocialService --> SocialController : 404 NAO_ENCONTRADO
SocialController --> P : 404 + mensagem
end
SocialService -> Guard : requireView()
SocialService -> DB_MySQL : SELECT dna_schemes
SocialService -> Guard : requireView()
SocialService ->> EV : HypeSignal
deactivate SocialService
SocialService --> SocialController : resultado
SocialController --> P : 200 JSON
P --> U : atualiza a tela
@enduml
