@startuml RF54_Classes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  StereotypeFontColor #6B6470
}
hide empty members
left to right direction
title RF54 — FashionAI Lens (MVP)\nDiagrama de classes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "fai-domain (entidades JPA)" {
  class AuditableEntity <<auditable_entity>> {
    +id: UUID
  }
  class HypeScoreCurrent <<hype_scores>> {
    +id: UUID
    +entityType: HypeEntityType
    +entityId: UUID
    +ownerId: UUID
    +algorithmVersion: String
    +status: HypeStatus
    +score: BigDecimal
    +level: HypeLevel
    +dimensions: HypeDimensions
    +deltaPoints: BigDecimal
    .. +16 campos ..
  }
  class LensDetection <<lens_detections>> {
    +id: UUID
    +scanId: UUID
    +ordinal: int
    +boxJson: String
    +label: String
    +category: String
    +subcategory: String
    +material: String
    +sex: String
    +colorsJson: String
    .. +11 campos ..
  }
  class LensFeedback <<lens_feedback>> {
    +id: UUID
    +scanId: UUID
    +detectionId: UUID
    +userId: UUID
    +kind: LensFeedbackKind
    +beforeJson: String
    +afterJson: String
    +trainingConsent: boolean
  }
  class LensScan <<lens_scans>> {
    +id: UUID
    +userId: UUID
    +source: LensSource
    +sourceRefId: UUID
    +intent: LensIntent
    +status: LensScanStatus
    +errorCode: String
    +imageKey: String
    +thumbKey: String
    +width: int
    .. +10 campos ..
  }
  class User <<users>> {
    +id: UUID
    +username: String
    +displayName: String
    +email: String
    +emailHash: String
    +emailVerified: boolean
    +phone: String
    +birthDate: String
    +passwordHash: String
    +profileType: ProfileType
    .. +24 campos ..
  }
  class VersionedAuditableEntity <<versioned_auditable_entity>> {
    +id: UUID
  }
  class WardrobeItem <<wardrobe_items>> {
    +id: UUID
    +user: User
    +brandProfile: BrandProfile
    +brand: Brand
    +name: String
    +category: String
    +subcategory: String
    +sex: String
    +brandName: String
    +brandLogoUrl: String
    .. +70 campos ..
  }
}
package "fai-domain (enums)" {
  enum HypeStatus {
    AVAILABLE
    INSUFFICIENT_DATA
  }
  enum LensDetectionStatus {
    DETECTED
    CORRECTED
    ADDED_BY_USER
    DISMISSED
  }
  enum LensScanStatus {
    READY
    PARTIAL
    NO_FASHION_FOUND
    FAILED
  }
  enum AccountStatus {
    PENDING_EMAIL_VERIFICATION
    ACTIVE
    PENDING_VALIDATION
    SUSPENDED
    DELETION_SCHEDULED
    DELETED
  }
  enum AvailabilityStatus {
    AVAILABLE
    UNAVAILABLE
    ARCHIVED
  }
  enum ModerationStatus {
    PENDING
    APPROVED
    REJECTED_POLICY
    REJECTED_NOT_CLOTHING
  }
}
package "fai-application" {
  class LensService <<service>> {
    +create()
    +fromApp()
    +get()
    +image()
    +history()
    +setSaved()
    +delete()
    +matches()
    +reading()
    +recreate()
  }
}
LensService ..> HypeScoreCurrent : usa
LensService ..> LensDetection : usa
LensService ..> LensFeedback : usa
LensService ..> LensScan : usa
LensService ..> WardrobeItem : usa
HypeScoreCurrent --> HypeStatus
HypeScoreCurrent ..> User : ownerId
LensDetection --> LensDetectionStatus
LensFeedback ..> User : userId
LensScan --> LensScanStatus
LensScan ..> User : userId
User --> AccountStatus
WardrobeItem "*" --> "1" User : user
WardrobeItem --> AvailabilityStatus
WardrobeItem --> ModerationStatus
@enduml
