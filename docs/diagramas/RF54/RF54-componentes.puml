}
left to right direction
title RF54 — FashionAI Lens (MVP)\nDiagrama de componentes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "Frontend (Next.js)" {
  component "/lens\n(site)/(app)/lens/page.tsx" as FE0
  component "/lens/[scanId]\n(site)/(app)/lens/[scanId]/page.tsx" as FE1
  component "/pieces/new\n(site)/(app)/pieces/new/page.tsx" as FE2
  component "lib/api/client.ts" as APIC
}
package "fai-web (REST)" {
  component "LensController\n/api/lens/scans\n/api/lens/scans/from-app\n/api/lens/scans/{…}\n/api/lens/scans/{…}/detections\n(+8 rotas)" as LensController
  component "MeController\n/api/me" as MeController
  component "WardrobeController\n/api/pieces\n/api/pieces/{…}/model3d\n/api/studio/backdrops" as WardrobeController
}
package "fai-application (casos de uso)" {
  component "LensService" as LensService
  component "AccountService" as AccountService
  component "WardrobeService" as WardrobeService
  component "HypeScoreConfig" as HypeScoreConfig <<apoio>>
  component "MultiPieceService" as MultiPieceService <<apoio>>
  component "MediaService" as MediaService <<apoio>>
  component "LensConfig" as LensConfig <<apoio>>
  component "IdentityService" as IdentityService <<apoio>>
  component "NotificationService" as NotificationService <<apoio>>
  component "Avatar3dService" as Avatar3dService <<apoio>>
  component "FlatLayPipeline" as FlatLayPipeline <<apoio>>
  component "MediaStoragePort\n«LocalFileMediaStorage / S3MediaStorageAdapter»" as MediaStoragePort <<port>>
  component "RateLimitPort\n«InMemoryRateLimit»" as RateLimitPort <<port>>
  component "EmailSenderPort\n«LoggingEmailSender / ResendEmailSender»" as EmailSenderPort <<port>>
  component "JobQueuePort\n«InMemoryJobQueue»" as JobQueuePort <<port>>
}
package "fai-domain (repositórios)" {
  component "LensScanRepository\nLensDetectionRepository\nLensFeedbackRepository\nWardrobeItemRepository\nSchemeRepository\nSchemeItemRepository\nStyleDnaRepository\nHypeScoreCurrentRepository\nGarmentEmbeddingRepository\nPieceImageRepository\n(+22)" as REPO_MySQL
}
database "MySQL\n• ai_inference_log\n• brand_profiles\n• brands\n• celebrity_profiles\n• comments\n• data_export_requests\n• dna_schemes\n• follows\n• garment_embeddings\n• hype_milestones\n• hype_score_snapshots\n• hype_scores\n(+20)" as DB_MySQL
cloud "Motor de IA (RF24)\nprovedores externos + reserva local" as AI
component "Eventos de domínio\n(@TransactionalEventListener)" as EV
cloud "S3" as CL_S3
cloud "Resend" as CL_Resend
