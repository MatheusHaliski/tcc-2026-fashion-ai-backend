@startuml RF54_Componentes
title RF54 — FashionAI Lens (MVP)\nDiagrama de componentes — gerado do código (telas → controller → serviço → núcleos reaproveitados → banco e armazenamento)
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
left to right direction

package "Frontend (Next.js)" {
  component "app/(app)/lens/page.tsx\nLensCapture (Câmera · Galeria · Recentes)\nLensScanCard" as F_CAP
  component "lib/lens/redact.ts\nredactFaces (canvas, sem EXIF/GPS)\n+ MediaPipe Face Landmarker\n(lib/avatar3d/detect)" as F_RED
  component "app/(app)/lens/[scanId]/page.tsx\nLensResult · LensStage (hotspots)\nLensFocusBar · LensProvider" as F_RES
  component "abas: LensReadingTab · LensClosetTab\nLensRecreateTab · LensStyleTab · LensDiscoverTab" as F_TABS
  component "LensDetectionCard (flip) · LensReadingCard\nLensCorrectDialog · LensOwnDialog\nLensMatchBadge · LensGapCard · LensFitTrend" as F_CARDS
  component "lib/lens/api.ts · model.ts · types.ts" as F_LIB
}
package "fai-web" {
  [UploadSafetyInterceptor\n(ImageSafety: ALLOW/REVIEW/BLOCK)] as W_USI
  [LensController\n13 rotas /api/lens/** +\nGET /api/me/lens/scans] as W_LC
  [SecurityConfig\n(anyRequest().authenticated())] as W_SEC
}
package "fai-application · lens" {
  [LensService\n(dono ou 404; MVP síncrono;\ncamada viva na leitura)] as A_LS
  [LensConfig\n(LENS_V1, pesos, pisos,\ncota 30/dia, retenção 30 dias)] as A_CFG
  [LensSimilarity\n(ΔE00 CIEDE2000, renormalização)] as A_SIM
  [LensImageAnalysis\n(paleta, padrão, embedding)] as A_IMG
  [LensReading\n(estilo, paleta, Hype do grupo, slots)] as A_READ
  [LensViews\n(ScanView, DetectionView, Matches,\nReadingView, RecreatePlan, ScanCard)] as A_VIEWS
  [LensRetentionJob\n(@Scheduled 04:40)] as A_JOB
}
package "fai-application · reaproveitados" {
  [MultiPieceService.detectPieces\n(núcleo do cadastro de várias peças)] as R_MP
  [AiEngine\n(MULTI_PIECE_DETECTOR: consentimento,\ncota, orçamento, fallback local)] as R_AI
  [GarmentEmbedder · ColorMath\nImageOps] as R_VIS
  [StyleCompatibility\nRecommendationScoring\nHypeScoreConfig] as R_HYPE
  [WardrobeService · Guard\n(visibilidade, /pieces/new)] as R_WS
  [AccountService\n(excluir conta → deleteAllFor)] as R_ACC
}
package "fai-application · ports" {
  [RateLimitPort\n(lens:scan)] as P_RL
  [MediaStoragePort\n(restricted/users/{id}/lens/…)] as P_ST
}
package "fai-domain · repositories" {
  [LensScanRepository\nLensDetectionRepository\nLensFeedbackRepository] as D_LENS
  [WardrobeItemRepository · SchemeRepository\nSchemeItemRepository · StyleDnaRepository\nGarmentEmbeddingRepository · PieceImageRepository\nUserConsentRepository] as D_OTHER
  [HypeScoreCurrentRepository\n(só leitura)] as D_HYPE
}
database "MySQL" {
  [lens_scans] as T1
  [lens_detections] as T2
  [lens_feedback] as T3
  [hype_scores] as T4
}

F_CAP --> F_RED : foto → rostos borrados
F_CAP --> F_LIB
F_RES --> F_TABS
F_TABS --> F_CARDS
F_RES --> F_LIB
F_LIB --> W_USI : POST /api/lens/scans (multipart)
F_LIB --> W_LC : GET/PATCH/DELETE /api/lens/scans/{id}\n/image · /matches · /reading · /recreate\n/detections[/{did}[/want|/own]]\nGET /api/me/lens/scans
W_USI --> W_LC
W_SEC ..> W_LC : login obrigatório
W_LC --> A_LS
A_LS --> A_CFG
A_LS --> A_SIM
A_LS --> A_IMG
A_LS --> A_READ
A_LS --> A_VIEWS
A_JOB --> A_LS : purgeExpired(agora)
R_ACC --> A_LS : deleteAllFor(userId)
A_LS --> R_MP : detectPieces(userId, foto)
R_MP --> R_AI
A_IMG --> R_VIS
A_SIM --> R_VIS
A_LS --> R_HYPE : fit (DNA), seis números,\nfaixa do Hype do grupo
A_LS --> R_WS
A_LS --> P_RL : cota diária
A_LS --> P_ST : imagem e miniatura
A_LS --> D_LENS
A_LS --> D_OTHER
A_LS --> D_HYPE : Hype do grupo e\ncomunidade elegível
D_LENS --> T1
D_LENS --> T2
D_LENS --> T3
D_HYPE --> T4
@enduml
