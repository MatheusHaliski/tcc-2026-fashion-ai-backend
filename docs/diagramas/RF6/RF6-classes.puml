package "fai-domain (entidades JPA)" {
  class AcervoGroup <<acervo_groups>> {
    +id: UUID
    +user: User
    +entityType: HypeEntityType
    +label: String
    +memberIdsJson: String
    +centroidJson: String
    +memberCount: int
    +computedAt: Instant
  }
  class DailyLook <<daily_looks>> {
    +id: UUID
    +user: User
    +scheme: Scheme
    +materializedFrom: DailyLook
    +lookDate: LocalDate
    +source: DailyLookSource
    +feedback: DailyLookFeedback
    +feedbackAt: Instant
    +weekPlanDayId: UUID
  }
  class HypeScoreCurrent <<hype_scores>> {
    +id: UUID
    +entityType: HypeEntityType
    +entityId: UUID
    +ownerId: UUID
    +algorithmVersion: String
    +status: HypeStatus
    +score: BigDecimal
    +level: HypeLevel
    +dimensions: HypeDimensions
    +deltaPoints: BigDecimal
    .. +16 campos ..
  }
  class HypeScoreMetric <<hype_score_metrics>> {
    +id: UUID
    +dailyLook: DailyLook
    +scheme: Scheme
    +user: User
    +scoreDate: LocalDate
    +likesCount: long
    +commentsCount: long
    +sharesCount: long
    +remixesCount: long
    +engagementRaw: BigDecimal
    .. +14 campos ..
  }
  class HypeScoreSnapshot <<hype_score_snapshots>> {
    +id: UUID
    +entityType: HypeEntityType
    +entityId: UUID
    +algorithmVersion: String
    +snapshotDate: LocalDate
    +status: HypeStatus
    +score: BigDecimal
    +level: HypeLevel
    +dimensions: HypeDimensions
    +publicEligible: boolean
    .. +3 campos ..
  }
  class SavedItem <<saved_items>> {
    +id: UUID
    +user: User
    +targetType: TargetType
    +targetId: UUID
    +savedAt: Instant
    +favorite: boolean
  }
  class Scheme <<schemes>> {
    +id: UUID
    +user: User
    +originalScheme: Scheme
    +title: String
    +description: String
    +creationMode: CreationMode
    +origin: SchemeOrigin
    +style: String
    +occasion: String
    +season: Season
    .. +46 campos ..
  }
  class SchemeGrouping <<scheme_groupings>> {
    +id: UUID
    +owner: User
    +type: GroupingType
    +label: String
    +description: String
    +coverUrl: String
    +atmospherePrompt: String
    +periodFrom: Integer
    +periodTo: Integer
    +accentColor: String
    .. +1 campos ..
  }
  class User <<users>> {
    +id: UUID
    +username: String
    +displayName: String
    +email: String
    +emailHash: String
    +emailVerified: boolean
    +phone: String
    +birthDate: String
    +passwordHash: String
    +profileType: ProfileType
    .. +24 campos ..
  }
}
package "fai-domain (enums)" {
  enum HypeStatus {
    AVAILABLE
    INSUFFICIENT_DATA
  }
  enum SchemeStatus {
    DRAFT
    PUBLISHED
    ARCHIVED
  }
  enum RenderStatus {
    PENDING
    RENDERING
    ENHANCING
    COMPOSITING
    CACHED
    COMPLETED
    FAILED
  }
  enum AccountStatus {
    PENDING_EMAIL_VERIFICATION
    ACTIVE
    PENDING_VALIDATION
    SUSPENDED
    DELETION_SCHEDULED
    DELETED
  }
  enum HypeEntityType {
    PIECE
    SCHEME
  }
  enum DailyLookSource {
    MANUAL
    AUTOPILOTO
    COPILOT
    VISTA_ME
    SMART_MIRROR
  }
}
package "fai-application" {
  class LookbookService <<service>> {
    +overview()
    +publications()
    +favorites()
    +savedPieces()
    +savedLooks()
    +favorite()
    +removeSaved()
    +dailyLookTab()
    +setPanelVersion()
    +markDailyLook()
  }
}
LookbookService ..> AcervoGroup : usa
LookbookService ..> SavedItem : usa
LookbookService ..> Scheme : usa
LookbookService ..> SchemeGrouping : usa
LookbookService ..> User : usa
AcervoGroup "*" --> "1" User : user
AcervoGroup --> HypeEntityType
DailyLook "*" --> "1" Scheme : scheme
DailyLook "*" --> "1" User : user
DailyLook --> DailyLookSource
HypeScoreCurrent --> HypeEntityType
HypeScoreCurrent --> HypeStatus
HypeScoreCurrent ..> User : ownerId
HypeScoreMetric "*" --> "1" DailyLook : dailyLook
HypeScoreMetric "*" --> "1" Scheme : scheme
HypeScoreMetric "*" --> "1" User : user
HypeScoreSnapshot --> HypeEntityType
HypeScoreSnapshot --> HypeStatus
SavedItem "*" --> "1" User : user
Scheme "*" --> "1" User : user
Scheme --> RenderStatus
Scheme --> SchemeStatus
SchemeGrouping "*" --> "1" User : owner
User --> AccountStatus
@enduml
