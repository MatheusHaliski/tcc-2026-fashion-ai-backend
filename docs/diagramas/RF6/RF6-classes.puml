@startuml RF6_Classes
title RF6 — Acessar e gerenciar o Perfil Lookbook\nDiagrama de classes — entidades, enums, repositórios e serviços do Lookbook (Look do Dia, Salvos, Agrupamentos, HypeScore v2)
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  HeaderBackgroundColor #E4DEF0
}
skinparam packageStyle rectangle
hide empty methods

package "fai-domain · model" {
  class User <<table users>> {
    +username: String
    +profileType: ProfileType
    +profileVisibility: Visibility
    +lookDoDiaPanelVersion: HypeScorePanelVersion
  }
  class Scheme <<table schemes>> {
    +title: String
    +status: SchemeStatus
    +visibility: Visibility
    +favorite: boolean
    +lookDoDia: boolean
    +lookDoDiaCount: int
    +groupingId: UUID
    +publishedAt: Instant
  }
  class WardrobeItem <<table wardrobe_items>> {
    +name: String
    +category: String
    +visibility: Visibility
    +availabilityStatus: AvailabilityStatus
    +moderationStatus: ModerationStatus
    +favorite: boolean
    +groupingId: UUID
  }
  class SavedItem <<table saved_items>> {
    +targetType: TargetType
    +targetId: UUID
    +savedAt: Instant
    +favorite: boolean
  }
  class DailyLook <<table daily_looks>> {
    +lookDate: LocalDate
    +source: DailyLookSource = MANUAL
    +feedback: DailyLookFeedback
    +feedbackAt: Instant
    +weekPlanDayId: UUID
  }
  class AcervoGroup <<table acervo_groups>> {
    +entityType: HypeEntityType
    +label: String
    +memberIdsJson: String
    +centroidJson: String
    +memberCount: int
    +computedAt: Instant
  }
  class SchemeGrouping <<table scheme_groupings>> {
    +type: GroupingType
    +label: String
    +description: String
    +coverUrl: String
    +atmospherePrompt: String
    +periodFrom: Integer
    +periodTo: Integer
    +accentColor: String
    +sortOrder: int
  }
  class HypeScoreCurrent <<table hype_scores>> {
    +entityType: HypeEntityType
    +entityId: UUID
    +ownerId: UUID
    +algorithmVersion: String
    +status: HypeStatus
    +score: BigDecimal
    +level: HypeLevel
    +dimensions: HypeDimensions
    +deltaPoints: BigDecimal
    +momentum: HypeMomentum
    +publicEligible: boolean
    +calculatedAt: Instant
  }
  class HypeScoreSnapshot <<table hype_score_snapshots>> {
    +entityType: HypeEntityType
    +entityId: UUID
    +snapshotDate: LocalDate
    +status: HypeStatus
    +score: BigDecimal
    +level: HypeLevel
  }
}

package "fai-domain · enums" {
  enum TargetType {
    PIECE
    SCHEME
    DNA
  }
  enum DailyLookSource {
    MANUAL
    AUTOPILOTO
    COPILOT
    VISTA_ME
    SMART_MIRROR
  }
  enum DailyLookFeedback {
    ADOREI
    NAO_USEI
    NAO_GOSTEI
  }
  enum HypeScorePanelVersion {
    SPOTLIGHT_CLASSICO
    PASSARELA
    RAIO_X_ESTILO
    BENTO_DIA
    EDITORIAL_MINIMAL
    COACH_ESTILO
  }
  enum GroupingType {
    COLLECTION
    PROMOTION
    SIGNATURE_SERIES
    EVOLUTION
    STYLE_LINE
    ERA
    PHASE
    SEASON
    TOUR
  }
  enum HypeEntityType {
    PIECE
    SCHEME
  }
  enum HypeLevel {
    LOW_SIGNAL
    NICHE
    RELEVANT
    HOT
    TRENDING
    VIRAL
  }
  enum HypeStatus {
    AVAILABLE
    INSUFFICIENT_DATA
  }
}

package "fai-domain · repository" {
  interface SavedItemRepository {
    +findByUserIdAndTargetTypeOrderBySavedAtDesc(userId, targetType)
    +findByUserIdAndTargetTypeAndTargetId(userId, targetType, targetId)
    +countByUserIdAndTargetType(userId, targetType)
  }
  interface DailyLookRepository {
    +findByUserIdAndLookDate(userId, date)
    +findFirstByUserIdAndLookDateBeforeOrderByLookDateDesc(userId, date)
    +findTop60ByUserIdOrderByLookDateDesc(userId)
  }
  interface AcervoGroupRepository {
    +findByUserIdAndEntityTypeOrderByMemberCountDesc(userId, type)
    +deleteByUserIdAndEntityType(userId, type)
  }
  interface SchemeGroupingRepository {
    +findByOwnerIdOrderByCreatedAtDesc(ownerId)
  }
  interface HypeScoreCurrentRepository {
    +findByEntityTypeAndEntityIdInAndAlgorithmVersion(type, ids, version)
    +findByEntityTypeAndEntityIdAndAlgorithmVersion(type, id, version)
  }
}

package "fai-application · service" {
  class LookbookService {
    {static} +GROUPING_MIN_PIECES = 20
    +overview(viewer, ownerId): Map
    +publications(viewer, ownerId, page, size): Page
    +favorites(viewer, ownerId): Map
    +savedLooks(user, occasion, sort, page, size): Page
    +savedPieces(user, category, page, size): Page
    +favorite(user, schemeId, favorite): Map
    +removeSaved(user, schemeId): Map
    +dailyLookTab(user, withAi): Map
    +setPanelVersion(user, version): Map
    +markDailyLook(user, schemeId): Map
    +capsule(user, category): Map
    +suggestGroups(user, HypeEntityType): Map
    +groups(user, HypeEntityType): List
    +discardGroup(user, groupId)
    +createGrouping(user, GroupingForm): Map
    +assignToGrouping(user, id, schemeIds, pieceIds): Map
    +groupingsOf(viewer, ownerId): List
    {static} +lookSort(raw): String
    {static} ~hypeOrder(sort, rowOf): Comparator
    {static} ~rankable(rows, viewerId): Map
  }
  class "LookbookService.GroupingForm" as GroupingForm <<record>> {
    +type: GroupingType
    +label: String
    +coverUrl: String
    +atmospherePrompt: String
    +periodFrom: Integer
    +periodTo: Integer
    +accentColor: String
  }
  class DailyLookService {
    +register(user, scheme, source, date): DailyLook
    +today(userId): Optional<DailyLook>
    +feedback(user, date, feedback): Map
    +history(user): List
    +pendingFeedback(user): Map
    +view(dailyLook): Map
  }
  class HypeScoreService {
    {static} +MAGAZINE_MIN_LEVEL = TRENDING
    +panel(dailyLook, withAi): Map
    {static} +v2Summary(current, config, now): Map
    {static} +magazineCover(v2): Map
    {static} ~localTip(scheme, dims): String
    {static} ~cluster(signatures): List
  }
  class SocialService {
    +toggleSave(user, type, id): Map
    +favoriteSaved(user, type, id, favorite): Map
  }
}

package "fai-application · hype" {
  class HypeQueryService {
    {static} +MAX_BATCH = 100
    +summaries(viewer, type, ids): Map
    +detail(viewer, type, id): Map
    +history(viewer, type, id, days): Map
    +positions(viewer, type, id): Map
    +wardrobe(user): Map
  }
}

User "1" <-- "*" SavedItem : user
User "1" <-- "*" DailyLook : user
User "1" <-- "*" AcervoGroup : user
User "1" <-- "*" SchemeGrouping : owner
User --> HypeScorePanelVersion
DailyLook "*" --> "1" Scheme : scheme
DailyLook "*" --> "0..1" DailyLook : materializedFrom
DailyLook --> DailyLookSource
DailyLook --> DailyLookFeedback
SavedItem --> TargetType
SchemeGrouping --> GroupingType
AcervoGroup --> HypeEntityType
Scheme "*" ..> "0..1" SchemeGrouping : groupingId
WardrobeItem "*" ..> "0..1" SchemeGrouping : groupingId
HypeScoreCurrent --> HypeLevel
HypeScoreCurrent --> HypeStatus
HypeScoreSnapshot --> HypeLevel
HypeScoreCurrent ..> Scheme : entityId (SCHEME)
HypeScoreCurrent ..> WardrobeItem : entityId (PIECE)

LookbookService ..> SavedItemRepository
LookbookService ..> AcervoGroupRepository
LookbookService ..> SchemeGroupingRepository
LookbookService ..> HypeScoreCurrentRepository : ordena Salvos/Looks\ne Hype médio dos grupos
LookbookService --> DailyLookService : today · register · history
LookbookService --> HypeScoreService : panel · cluster
LookbookService --> SocialService : favoriteSaved · toggleSave
LookbookService ..> GroupingForm
DailyLookService ..> DailyLookRepository
HypeScoreService ..> HypeScoreCurrentRepository : só leitura
HypeScoreService ..> DailyLookRepository : previousDailyLook
HypeQueryService ..> HypeScoreCurrent : lê
HypeQueryService ..> HypeScoreSnapshot : history

note bottom of SavedItem : único (user_id, target_type, target_id)
note bottom of DailyLook : uq_daily_looks_user_date (user_id, look_date):\num Look do Dia por pessoa e por dia
note bottom of AcervoGroup : agrupamento sugerido por SIMILARIDADE\n(≥ 0,70, 3+ membros) — não é Hype
note bottom of HypeScoreCurrent : único (entity_type, entity_id, algorithm_version);\ngravado só pelo job HypeSnapshotService (V31, V39)
note top of HypeScoreService : o painel do Look do Dia só lê o v2;\no v1 (hype_score_metrics, HypeGroups,\nHypeScoreBand) foi removido em P3-16
@enduml
