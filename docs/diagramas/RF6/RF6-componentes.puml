@startuml RF6_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF6 — Acessar e gerenciar o Perfil Lookbook (Closet Digital + Looks Salvos)\nDiagrama de componentes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "Frontend (Next.js)" {
  component "/lookbook\n(site)/(app)/lookbook/page.tsx" as FE0
  component "/coupons\n(site)/(app)/coupons/page.tsx" as FE1
  component "/history\n(site)/(app)/history/page.tsx" as FE2
  component "/closet\n(site)/(app)/closet/page.tsx" as FE3
  component "/brands/[slug]\n(site)/(app)/brands/[slug]/page.tsx" as FE4
  component "/looks\n(site)/(app)/looks/page.tsx" as FE5
  component "lib/api/client.ts" as APIC
}
package "fai-web (REST)" {
  component "HypeController\n/api/hype/groups\n/api/hype/looks/{…}\n/api/hype/pieces/{…}\n/api/hype/summaries\n(+2 rotas)" as HypeController
  component "LookbookController\n/api/groupings\n/api/groupings/{…}\n/api/groupings/{…}/items\n/api/groupings/{…}/schemes\n(+20 rotas)" as LookbookController
  component "SocialController\n/api/interactions/{…}/{…}/saves\n/api/interactions/{…}/{…}/saves/favorite" as SocialController
  component "WardrobeController\n/api/me/closet\n/api/me/pieces/studio\n/api/pieces/{…}\n/api/users/{…}/closet" as WardrobeController
}
package "fai-application (casos de uso)" {
  component "HypeQueryService" as HypeQueryService
  component "LookbookService" as LookbookService
  component "DailyLookService" as DailyLookService
  component "HypeScoreService" as HypeScoreService
  component "SocialService" as SocialService
  component "WardrobeService" as WardrobeService
  component "HypeScoreConfig" as HypeScoreConfig <<apoio>>
  component "SchemeService" as SchemeService <<apoio>>
  component "HypeCache" as HypeCache <<apoio>>
  component "OwnMedia" as OwnMedia <<apoio>>
  component "NotificationService" as NotificationService <<apoio>>
  component "MediaService" as MediaService <<apoio>>
  component "FlatLayPipeline" as FlatLayPipeline <<apoio>>
  component "AssetCatalogService" as AssetCatalogService <<apoio>>
  component "CounterStorePort\n«InMemoryCounterStore»" as CounterStorePort <<port>>
  component "JobQueuePort\n«InMemoryJobQueue»" as JobQueuePort <<port>>
}
package "fai-domain (repositórios)" {
  component "HypeScoreCurrentRepository\nHypeScoreSnapshotRepository\nWardrobeItemRepository\nSchemeRepository\nSchemeItemRepository\nStyleDnaRepository\nBrandProfileRepository\nSavedItemRepository\nUserRepository\nAcervoGroupRepository\n(+15)" as REPO_MySQL
}
database "MySQL\n• acervo_groups\n• brand_profiles\n• brands\n• comments\n• daily_looks\n• dna_schemes\n• hype_groups\n• hype_score_metrics\n• hype_score_snapshots\n• hype_scores\n• metric_snapshots\n• moderation_queue\n(+13)" as DB_MySQL
cloud "Motor de IA (RF24)\nprovedores externos + reserva local" as AI
component "Eventos de domínio\n(@TransactionalEventListener)" as EV
APIC --> HypeController : HTTPS/JSON
APIC --> LookbookController : HTTPS/JSON
APIC --> SocialController : HTTPS/JSON
APIC --> WardrobeController : HTTPS/JSON
DailyLookService --> EV
DailyLookService --> REPO_MySQL
FE0 --> APIC
FE1 --> APIC
FE2 --> APIC
FE3 --> APIC
FE4 --> APIC
FE5 --> APIC
HypeController --> HypeQueryService
HypeQueryService --> REPO_MySQL
HypeQueryService ..> HypeCache
HypeQueryService ..> HypeScoreConfig
HypeQueryService ..> SchemeService
HypeQueryService ..> WardrobeService
HypeScoreService --> AI
HypeScoreService --> REPO_MySQL
HypeScoreService ..> HypeScoreConfig
LookbookController --> DailyLookService
LookbookController --> HypeScoreService
LookbookController --> LookbookService
LookbookService --> AI
LookbookService --> REPO_MySQL
LookbookService ..> DailyLookService
LookbookService ..> HypeScoreService
LookbookService ..> OwnMedia
LookbookService ..> SchemeService
LookbookService ..> SocialService
LookbookService ..> WardrobeService
REPO_MySQL --> DB_MySQL : JPA/Flyway
SocialController --> SocialService
SocialService --> CounterStorePort
SocialService --> EV
SocialService --> REPO_MySQL
SocialService ..> MediaService
SocialService ..> NotificationService
SocialService ..> SchemeService
WardrobeController --> WardrobeService
WardrobeService --> AI
WardrobeService --> EV
WardrobeService --> JobQueuePort
WardrobeService --> REPO_MySQL
WardrobeService ..> AssetCatalogService
WardrobeService ..> FlatLayPipeline
WardrobeService ..> MediaService
WardrobeService ..> NotificationService
WardrobeService ..> OwnMedia
@enduml
