@startuml RF6_Sequencia_LookDoDia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."
title RF6 — Acessar e gerenciar o Perfil Lookbook\nDiagrama de sequência — gerado do código em 2026-10-14 (scripts/diagramas/v5)

actor "Pessoa usuária" as U
boundary "Tela /u/[username]" as P
control "LookbookController" as LookbookController
participant "LookbookService" as LookbookService
database "MySQL" as DB_MySQL
participant "Guard" as Guard
participant "DailyLookService" as DailyLookService
participant "SchemeService" as SchemeService
== Visão geral do lookbook (closet digital, looks, agrupamentos) ==
U -> P : Visão geral do lookbook (closet digital, looks, a…
P -> LookbookController : GET /api/users/{ownerId}/lookbook
LookbookController -> LookbookService : overview()
activate LookbookService
LookbookService -> DB_MySQL : SELECT users
LookbookService -> Guard : canView()
Guard -> DB_MySQL : SELECT follows (×3)
Guard --> LookbookService
LookbookService -> DB_MySQL : SELECT wardrobe_items
LookbookService -> DB_MySQL : SELECT schemes
LookbookService -> Guard : canView() (×2)
LookbookService -> DB_MySQL : SELECT schemes
LookbookService -> Guard : canView()
LookbookService -> DB_MySQL : SELECT wardrobe_items
LookbookService -> Guard : canView()
LookbookService -> DB_MySQL : SELECT saved_items (×2)
LookbookService -> DailyLookService : today()
DailyLookService -> DB_MySQL : SELECT daily_looks (×2)
DailyLookService -> DB_MySQL : INSERT/UPDATE daily_looks
DailyLookService --> LookbookService
LookbookService -> DB_MySQL : SELECT scheme_items
deactivate LookbookService
LookbookService --> LookbookController : resultado
LookbookController --> P : 200 JSON
P --> U : atualiza a tela
== Marcar esquema como Look do Dia ==
U -> P : Marcar esquema como Look do Dia
P -> LookbookController : POST /api/me/daily-look
LookbookController -> LookbookService : markDailyLook()
activate LookbookService
LookbookService -> SchemeService : owned()
SchemeService -> DB_MySQL : SELECT schemes
SchemeService --> LookbookService
LookbookService -> DailyLookService : register()
DailyLookService -> DB_MySQL : SELECT scheme_items
DailyLookService -> DB_MySQL : SELECT users
DailyLookService -> DB_MySQL : SELECT daily_looks
DailyLookService -> DB_MySQL : INSERT/UPDATE daily_looks
DailyLookService --> LookbookService
LookbookService -> DailyLookService : view()
deactivate LookbookService
LookbookService --> LookbookController : resultado
LookbookController --> P : 201 JSON
P --> U : atualiza a tela
@enduml
