@startuml RF6_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."
title RF6 — Acessar e gerenciar o Perfil Lookbook (Closet Digital + Looks Salvos)\nDiagrama de sequência — gerado do código em 2026-10-06 (scripts/diagramas/v5)

actor "Pessoa usuária" as U
boundary "Tela /u/[username]" as P
control "LookbookController" as LookbookController
participant "LookbookService" as LookbookService
database "MySQL" as DB_MySQL
participant "Guard" as Guard
participant "DailyLookService" as DailyLookService
control "SocialController" as SocialController
participant "SocialService" as SocialService
participant "SchemeService" as SchemeService
queue "Eventos de domínio" as EV
== Visão geral do lookbook (closet digital, looks, agrupamentos) ==
U -> P : Visão geral do lookbook (closet digital, looks, a…
P -> LookbookController : GET /api/users/{ownerId}/lookbook
LookbookController -> LookbookService : overview()
activate LookbookService
LookbookService -> DB_MySQL : SELECT users
LookbookService -> Guard : canView()
Guard -> DB_MySQL : SELECT follows (×3)
Guard --> LookbookService
LookbookService -> DB_MySQL : SELECT wardrobe_items
LookbookService -> DB_MySQL : SELECT schemes
LookbookService -> Guard : canView() (×2)
LookbookService -> DB_MySQL : SELECT schemes
LookbookService -> Guard : canView()
LookbookService -> DB_MySQL : SELECT wardrobe_items
LookbookService -> Guard : canView()
LookbookService -> DB_MySQL : SELECT saved_items (×2)
LookbookService -> DailyLookService : today()
DailyLookService -> DB_MySQL : SELECT daily_looks (×2)
DailyLookService -> DB_MySQL : INSERT/UPDATE daily_looks
DailyLookService --> LookbookService
LookbookService -> DB_MySQL : SELECT scheme_items
deactivate LookbookService
LookbookService --> LookbookController : resultado
LookbookController --> P : 200 JSON
P --> U : atualiza a tela
== Marcar item salvo como favorito ==
U -> P : Marcar item salvo como favorito
P -> SocialController : PUT /api/interactions/{type}/{id}/saves/favorite
SocialController -> SocialService : favoriteSaved()
activate SocialService
SocialService -> DB_MySQL : SELECT saved_items
SocialService -> SocialService : favorite = ?favorite
SocialService -> DB_MySQL : SELECT schemes
SocialService -> SchemeService : requireView()
SocialService -> DB_MySQL : SELECT wardrobe_items
alt Peça não encontrado(a)
SocialService --> SocialController : 404 NAO_ENCONTRADO
SocialController --> P : 404 + mensagem
end
SocialService -> Guard : requireView()
SocialService -> DB_MySQL : SELECT dna_schemes
SocialService -> Guard : requireView()
SocialService ->> EV : HypeSignal
deactivate SocialService
SocialService --> SocialController : resultado
SocialController --> P : 200 JSON
P --> U : atualiza a tela
@enduml
