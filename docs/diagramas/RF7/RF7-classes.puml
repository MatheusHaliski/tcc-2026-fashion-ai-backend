@startuml RF7_Classes
title RF7 — Acessar o detalhe de uma peça ou esquema clicando em um item da lista do Closet\nDiagrama de classes — entidades JPA reais (fai-domain) e enums
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  HeaderBackgroundColor #E4DEF0
}
skinparam packageStyle rectangle
hide empty methods

package "fai-domain · model" {
class WardrobeItem {
  +user: User
  +brand: Brand
  +name: String
  +category: String
  +sex: String
  +imageUrl: String
  +visibility: Visibility
  +disponivel: boolean
  +availabilityStatus: AvailabilityStatus
  +moderationStatus: ModerationStatus
  +favorite: boolean
  +forSale: boolean
  +wearCount: int
  +lastWornDate: LocalDate
  +viewCount: long
}
class Scheme {
  +user: User
  +title: String
  +status: SchemeStatus
  +visibility: Visibility
  +coverImageUrl: String
  +originalScheme: Scheme
}
class SchemeItem {
  +scheme: Scheme
  +wardrobeItem: WardrobeItem
  +slot: SchemeSlot
  +sortOrder: int
  +snapshotJson: String
}
class WardrobeAvailabilityChange {
  +id: UUID
  +wardrobeItemId: UUID
  +userId: UUID
  +available: boolean
  +changedAt: Instant
}
class Comment {
  +author: User
  +targetType: TargetType
  +targetId: UUID
  +parentCommentId: UUID
  +content: String
  +active: boolean
}
}
package "fai-domain · enums" {
enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  ARCHIVED
}
enum Visibility {
  PRIVATE
  FOLLOWERS
  PUBLIC
}
enum TargetType {
  PIECE
  SCHEME
  DNA
}
}
package "fai-application · service" {
class WardrobeService {
  +detail(viewer, id, fromSchemeId): Map
  +update(user, id, PieceForm): PieceView
  +toggles(user, id, favorite, disponivel, forSale): PieceView
  +deletionImpact(user, id): Map
  +delete(user, id): Map
  {static} +effectiveVisibility(w): Visibility
}
class SchemeService {
  +get(viewer, id): Map
  +requireView(viewer, scheme)
}
class SocialService {
  +returnToOrigin(user, pieceId, fromSchemeId): Map
  +deleteComment(user, commentId)
}
class WardrobeEventListeners {
  .. on AvailabilityChanged ..
}
}
SchemeItem "*" --> "1" Scheme : scheme
SchemeItem "*" --> "1" WardrobeItem : wardrobeItem
Scheme "*" --> "0..1" Scheme : originalScheme
WardrobeAvailabilityChange ..> WardrobeItem : wardrobeItemId
Comment ..> WardrobeItem : targetType = PIECE
WardrobeItem --> AvailabilityStatus
WardrobeItem --> Visibility
Comment --> TargetType
WardrobeService ..> WardrobeItem : lê/atualiza
WardrobeService ..> SchemeItem : snapshot ao excluir
SchemeService ..> Scheme : lê
SocialService ..> SchemeItem : esquemas de origem
WardrobeEventListeners ..> WardrobeAvailabilityChange : grava
note top of WardrobeItem : tabela wardrobe_items
note top of SchemeItem : tabela scheme_items\n(snapshotJson = retrato da peça na publicação — CA03)
note top of WardrobeAvailabilityChange : tabela wardrobe_availability_log
note bottom of Comment : tabela comments
@enduml
