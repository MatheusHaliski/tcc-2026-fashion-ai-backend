@startuml RF7_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF7 — Acessar o detalhe de uma peça ou esquema clicando em um item da lista do Closet\nDiagrama de componentes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "Frontend (Next.js)" {
  component "/schemes/[id]\n(site)/(app)/schemes/[id]/page.tsx" as FE0
  component "/closet\n(site)/(app)/closet/page.tsx" as FE1
  component "/schemes/[id]/edit\n(site)/(app)/schemes/[id]/edit/page.tsx" as FE2
  component "/schemes/new\n(site)/(app)/schemes/new/page.tsx" as FE3
  component "lib/api/client.ts" as APIC
}
package "fai-web (REST)" {
  component "CommentController\n/api/comments/{…}\n/api/pieces/{…}/return-to-origin" as CommentController
  component "SchemeController\n/api/schemes\n/api/schemes/{…}\n/api/schemes/{…}/card.png\n/api/schemes/{…}/flags" as SchemeController
  component "SocialController\n/api/interactions/{…}/{…}/comments" as SocialController
  component "WardrobeController\n/api/me/closet\n/api/me/pieces/studio\n/api/pieces\n/api/pieces/{…}\n(+6 rotas)" as WardrobeController
}
package "fai-application (casos de uso)" {
  component "SocialService" as SocialService
  component "SchemeService" as SchemeService
  component "WardrobeService" as WardrobeService
  component "NotificationService" as NotificationService <<apoio>>
  component "MediaService" as MediaService <<apoio>>
  component "BackgroundStudioService" as BackgroundStudioService <<apoio>>
  component "SealService" as SealService <<apoio>>
  component "SchemeCardRenderer" as SchemeCardRenderer <<apoio>>
  component "ProjectionService" as ProjectionService <<apoio>>
  component "DailyLookService" as DailyLookService <<apoio>>
  component "HypeScoreConfig" as HypeScoreConfig <<apoio>>
  component "CounterStorePort\n«InMemoryCounterStore»" as CounterStorePort <<port>>
  component "JobQueuePort\n«InMemoryJobQueue»" as JobQueuePort <<port>>
}
package "fai-domain (repositórios)" {
  component "ReactionRepository\nCommentRepository\nSavedItemRepository\nShareRepository\nSchemeRepository\nWardrobeItemRepository\nDnaSchemeRepository\nUserRepository\nSchemeItemRepository\nStyleDnaRepository\n(+7)" as REPO_MySQL
}
database "MySQL\n• brands\n• comments\n• dna_schemes\n• hype_scores\n• moderation_queue\n• photos\n• pipeline_jobs\n• processing_jobs_log\n• quality_scores\n• reactions\n• saved_items\n• scheme_items\n(+5)" as DB_MySQL
cloud "Motor de IA (RF24)\nprovedores externos + reserva local" as AI
component "Eventos de domínio\n(@TransactionalEventListener)" as EV
APIC --> CommentController : HTTPS/JSON
APIC --> SchemeController : HTTPS/JSON
APIC --> SocialController : HTTPS/JSON
APIC --> WardrobeController : HTTPS/JSON
CommentController --> SocialService
FE0 --> APIC
FE1 --> APIC
FE2 --> APIC
FE3 --> APIC
