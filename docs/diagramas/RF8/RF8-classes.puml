package "fai-domain (entidades JPA)" {
  class Follow <<follows>> {
    +id: UUID
    +follower: User
    +following: User
    +status: FollowStatus
    +respondedAt: Instant
  }
  class Comment <<comments>> {
    +id: UUID
    +author: User
    +targetType: TargetType
    +targetId: UUID
    +parentCommentId: UUID
    +content: String
    +active: boolean
  }
  class Reaction <<reactions>> {
    +id: UUID
    +actor: User
    +targetType: TargetType
    +targetId: UUID
    +reactionType: ReactionType
  }
  class Scheme <<schemes>> {
    +id: UUID
    +user: User
    +originalScheme: Scheme
    +title: String
    +description: String
    +creationMode: CreationMode
    +origin: SchemeOrigin
    +style: String
    +occasion: String
    +season: Season
    .. +46 campos ..
  }
  class SchemeItem <<scheme_items>> {
    +id: UUID
    +scheme: Scheme
    +wardrobeItem: WardrobeItem
    +slot: SchemeSlot
    +tryOnLayer: TryOnLayer
    +sortOrder: int
    +zIndex: int
    +positionX: BigDecimal
    +positionY: BigDecimal
    +scale: BigDecimal
    .. +4 campos ..
  }
  class StyleDna <<style_dna>> {
    +id: UUID
    +user: User
    +archetype: StyleArchetype
    +boldnessIndex: int
    +identityPhrase: String
    +colorPalette: String
    +styleKeywords: String
    +occasionKeywords: String
    +iconPieceName: String
    +latestDnaSchemeId: UUID
    .. +9 campos ..
  }
  class User <<users>> {
    +id: UUID
    +username: String
    +displayName: String
    +email: String
    +emailHash: String
    +emailVerified: boolean
    +phone: String
    +birthDate: String
    +passwordHash: String
    +profileType: ProfileType
    .. +24 campos ..
  }
  class WardrobeItem <<wardrobe_items>> {
    +id: UUID
    +user: User
    +brandProfile: BrandProfile
    +brand: Brand
    +name: String
    +category: String
    +subcategory: String
    +sex: String
    +brandName: String
    +brandLogoUrl: String
    .. +70 campos ..
  }
}
package "fai-domain (enums)" {
  enum FollowStatus {
    PENDENTE
    ACEITO
    BLOQUEADO
  }
  enum SchemeStatus {
    DRAFT
    PUBLISHED
    ARCHIVED
  }
  enum RenderStatus {
    PENDING
    RENDERING
    ENHANCING
    COMPOSITING
    CACHED
    COMPLETED
    FAILED
  }
  enum AccountStatus {
    PENDING_EMAIL_VERIFICATION
    ACTIVE
    PENDING_VALIDATION
    SUSPENDED
    DELETION_SCHEDULED
    DELETED
  }
  enum AvailabilityStatus {
    AVAILABLE
    UNAVAILABLE
    ARCHIVED
  }
  enum ModerationStatus {
    PENDING
    APPROVED
    REJECTED_POLICY
    REJECTED_NOT_CLOTHING
  }
}
package "fai-application" {
  class SocialService <<service>> {
    +deleteComment()
    +react()
    +comments()
    +comment()
    +toggleSave()
    +share()
    +counters()
  }
}
SocialService ..> Comment : usa
SocialService ..> Reaction : usa
SocialService ..> Scheme : usa
SocialService ..> User : usa
SocialService ..> WardrobeItem : usa
Comment "*" --> "1" User : author
Follow "*" --> "1" User : follower
Follow "*" --> "1" User : following
Follow --> FollowStatus
Reaction "*" --> "1" User : actor
Scheme "*" --> "1" User : user
Scheme --> RenderStatus
Scheme --> SchemeStatus
SchemeItem "*" --> "1" Scheme : scheme
SchemeItem "*" --> "1" WardrobeItem : wardrobeItem
StyleDna "1" --> "1" User : user
User --> AccountStatus
WardrobeItem "*" --> "1" User : user
WardrobeItem --> AvailabilityStatus
WardrobeItem --> ModerationStatus
@enduml
