@startuml RF8_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF8 — Visualizar esquemas de vestimenta & peças de roupa criados por outros usuários na rede social, através da aba 'Buscar'\nDiagrama de componentes — gerado do código em 2026-10-06 (scripts/diagramas/v5)

package "Frontend (Next.js)" {
  component "/feed\n(site)/(app)/feed/page.tsx" as FE0
  component "/schemes/[id]/edit\n(site)/(app)/schemes/[id]/edit/page.tsx" as FE1
  component "/schemes/new\n(site)/(app)/schemes/new/page.tsx" as FE2
  component "/search\n(site)/(app)/search/page.tsx" as FE3
  component "lib/api/client.ts" as APIC
}
package "fai-web (REST)" {
  component "CommentController\n/api/comments/{…}" as CommentController
  component "DiscoveryController\n/api/feed\n/api/public-pieces\n/api/runway\n/api/search" as DiscoveryController
  component "SchemeController\n/api/schemes\n/api/schemes/{…}" as SchemeController
  component "SocialController\n/api/interactions/{…}/{…}/comments\n/api/interactions/{…}/{…}/counters\n/api/interactions/{…}/{…}/reactions\n/api/interactions/{…}/{…}/saves\n(+1 rotas)" as SocialController
}
package "fai-application (casos de uso)" {
  component "SocialService" as SocialService
  component "SearchService" as SearchService
  component "SchemeService" as SchemeService
  component "NotificationService" as NotificationService <<apoio>>
  component "MediaService" as MediaService <<apoio>>
  component "ChallengeService" as ChallengeService <<apoio>>
  component "HypeScoreConfig" as HypeScoreConfig <<apoio>>
  component "WardrobeService" as WardrobeService <<apoio>>
  component "BackgroundStudioService" as BackgroundStudioService <<apoio>>
  component "SealService" as SealService <<apoio>>
  component "SchemeCardRenderer" as SchemeCardRenderer <<apoio>>
  component "CounterStorePort\n«InMemoryCounterStore»" as CounterStorePort <<port>>
}
package "fai-domain (repositórios)" {
  component "ReactionRepository\nCommentRepository\nSavedItemRepository\nShareRepository\nSchemeRepository\nWardrobeItemRepository\nDnaSchemeRepository\nUserRepository\nSchemeItemRepository\nBrandProfileRepository\n(+6)" as REPO_MySQL
}
database "MySQL\n• brand_profiles\n• brands\n• celebrity_profiles\n• comments\n• dna_schemes\n• follows\n• hype_scores\n• reactions\n• saved_items\n• scheme_items\n• schemes\n• seal_bonds\n(+4)" as DB_MySQL
cloud "Motor de IA (RF24)\nprovedores externos + reserva local" as AI
component "Eventos de domínio\n(@TransactionalEventListener)" as EV
APIC --> CommentController : HTTPS/JSON
APIC --> DiscoveryController : HTTPS/JSON
APIC --> SchemeController : HTTPS/JSON
APIC --> SocialController : HTTPS/JSON
CommentController --> SocialService
DiscoveryController --> SearchService
FE0 --> APIC
FE1 --> APIC
FE2 --> APIC
FE3 --> APIC
REPO_MySQL --> DB_MySQL : JPA/Flyway
SchemeController --> SchemeService
SchemeService --> AI
SchemeService --> CounterStorePort
SchemeService --> EV
SchemeService --> REPO_MySQL
SchemeService ..> BackgroundStudioService
SchemeService ..> HypeScoreConfig
SchemeService ..> MediaService
SchemeService ..> NotificationService
SchemeService ..> SchemeCardRenderer
SchemeService ..> SealService
SchemeService ..> WardrobeService
SearchService --> REPO_MySQL
SearchService ..> ChallengeService
SearchService ..> HypeScoreConfig
SearchService ..> SchemeService
SocialController --> SocialService
SocialService --> CounterStorePort
SocialService --> EV
SocialService --> REPO_MySQL
SocialService ..> MediaService
SocialService ..> NotificationService
SocialService ..> SchemeService
@enduml
