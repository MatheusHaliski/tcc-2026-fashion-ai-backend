@startuml RF8_Sequencia_Busca
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."
title RF8 — Visualizar esquemas de vestimenta & peças de roupa criados por outros usuários na rede social, através da aba 'Buscar'\nDiagrama de sequência — gerado do código em 2026-10-14 (scripts/diagramas/v5)

actor "Pessoa usuária" as U
boundary "Tela /search" as P
control "DiscoveryController" as DiscoveryController
participant "SearchService" as SearchService
database "MySQL" as DB_MySQL
participant "SchemeService" as SchemeService
== Feed da comunidade (cursor opaco, relevância = recência + HypeScore v… ==
U -> P : Feed da comunidade (cursor opaco, relevância = re…
P -> DiscoveryController : GET /api/feed
DiscoveryController -> SearchService : communityFeed()
activate SearchService
SearchService -> DB_MySQL : SELECT follows (×2)
SearchService -> DB_MySQL : SELECT style_dna
SearchService -> DB_MySQL : SELECT schemes
SearchService -> DB_MySQL : SELECT shares
SearchService -> DB_MySQL : SELECT schemes
SearchService -> DB_MySQL : SELECT wardrobe_items
SearchService -> SchemeService : canView() (×2)
SearchService -> DB_MySQL : SELECT scheme_items
SearchService -> SchemeService : view()
SchemeService -> DB_MySQL : SELECT reactions
SchemeService -> DB_MySQL : SELECT saved_items
SchemeService --> SearchService
deactivate SearchService
SearchService --> DiscoveryController : resultado
DiscoveryController --> P : 200 JSON
P --> U : atualiza a tela
== Buscar por abas (LOOKS, PECAS, PESSOAS, MARCAS, CELEBRIDADES); hypeLe… ==
U -> P : Buscar por abas (LOOKS, PECAS, PESSOAS, MARCAS, C…
P -> DiscoveryController : GET /api/search
DiscoveryController -> SearchService : search()
activate SearchService
deactivate SearchService
SearchService --> DiscoveryController : resultado
DiscoveryController --> P : 200 JSON
P --> U : atualiza a tela
@enduml
