@startuml RF8_Sequencia
title RF8 — Visualizar esquemas e peças de outros usuários na aba Buscar\nDiagrama de sequência — feed da comunidade (relevância com Hype público v2), Passarela, insights FEED e abertura do card
skinparam backgroundColor #FFFFFF
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
}
autonumber
actor "Pessoa" as U
participant "feed/page.tsx\nInsightStrip · SchemeCard\nInfiniteSentinel" as FE
participant "InsightsController\nInsightService\nPublicInsights" as IS
participant "DiscoveryController" as DC
participant "SearchService" as SS
participant "SchemeService\nGuard" as SCH
participant "HypeController\nHypeQueryService" as HQ
participant "HypeCache\n(RenderCachePort)" as HC
participant "CassandraProjectionAdapter\n(TimelineProjectionPort)" as TL
database "MySQL" as DB

U -> FE: abre /feed (aba Feed)
FE -> IS: GET /api/insights?context=FEED&window=7 (público)
IS -> HC: get("insights:FEED:7:…", loader) por geração
alt cache vazio na geração atual
  IS -> DB: hype_scores públicos (public_eligible) dos looks
  IS -> IS: PublicInsights.feed → FEED_STYLE_RISING,\nFEED_HOT_SHARE, FEED_TREND_VS_POPULARITY…
end
IS --> FE: 200 {context: FEED, source: local, items[≤ 5]}
U -> FE: liga o chip "Em alta" (opcional)
FE -> DC: GET /api/feed?cursor&size=12&hypeLevel=HOT&style&occasion…
DC -> SS: communityFeed(viewer, cursor, size, Filters)
alt hypeLevel ou cursor inválidos
  SS --> FE: 400 NIVEL_INVALIDO | CURSOR_INVALIDO
else
  SS -> DB: follows BLOQUEADO (dois sentidos) · style_dna de quem vê
  SS -> DB: schemes.findPublicFeed (até 400, PUBLIC + PUBLISHED)
  loop candidatos depois do cursor, mais recentes primeiro
    SS -> SCH: canView(viewer, scheme) — dono ACTIVE, não bloqueado,\nmoreRestrictive(look, perfil)
    opt filtro hypeLevel
      SS -> SS: meetsLevel(hype_scores públicos, faixa mínima)
    end
    SS -> SS: matches(filtros) — até completar a página
  end
  SS -> DB: hype_scores da página (uma consulta, HYPE_V2)
  SS -> SS: relevance = 0,5·recência + 0,3·Hype público\n(sem Hype = 0,5) + 0,2·afinidade DNA
  SS --> FE: 200 {items: SchemeView[], nextCursor, chips, order}
end
FE -> HQ: GET /api/hype/summaries?type=SCHEME&ids= (HypeBadge, lote)
HQ --> FE: 200 {items} (só ids visíveis para quem vê)
U -> FE: rola até o fim
FE -> DC: GET /api/feed?cursor=<nextCursor>…
note right of FE: nextCursor nulo = fim (sem itens repetidos)

== Passarela (quem eu sigo) — exige login ==
U -> FE: aba Passarela
FE -> DC: GET /api/runway?cursor&size=12
DC -> SS: runway(viewer, cursor, size)
SS -> DB: follows ACEITO (quem sigo)
opt projeção de timeline ligada
  SS -> TL: readTimeline(viewerId, 300)
end
SS -> DB: looks de quem sigo · shares FEED · vínculos APPROVED\ndas marcas seguidas (reason SEGUINDO | COMPARTILHADO | VINCULO_*)
alt ninguém seguido ou sem entradas
  SS -> DB: findPublicFeed (reason COMUNIDADE, fallbackToCommunity)
end
SS --> FE: 200 {items: [{reason, scheme, at}], nextCursor, waywt, battles}
FE -> FE: card recebe só item.scheme

== Abrir o card de outra pessoa ==
U -> FE: toca no card
FE -> SCH: GET /api/schemes/{id} (SchemeController)
SCH -> SCH: requireView(viewer, scheme)
alt sem permissão
  SCH -> DB: INSERT audit_log (ACESSO_NEGADO_403)
  SCH --> FE: 403
else
  opt quem vê não é o dono
    SCH -> DB: UPDATE schemes.view_count + 1 (CounterStorePort "views")
    SCH ->> SCH: logado → publishEvent HypeSignal(LOOK_VIEWED)\n(HypeSignalRecorder grava depois do commit — RF19)
  end
  SCH --> FE: 200 {scheme, wearstyles, seals, canEdit = false}
end
FE -> FE: CardActions → GET /api/interactions/SCHEME/{id}/counters (RF19)
@enduml
