    :POST /api/schemes/{id}/archive\n→ SchemeService.archive\nlê: schemes\nusa: Guard.requireCanCreate, Guard.requireOwner,\nSealService.revokeForScheme …\nestado: status → ARCHIVED;
  case (Pedir melhoria por instrução [Edi…)
    :POST /api/schemes/{id}/improvements\n→ SchemeService.improve\nlê: schemes\nusa: Guard.requireCanCreate, Guard.requireOwner\nia: EDIT_ASSISTANT;
  case (Aplicar o diff aceito)
    :POST /api/schemes/{id}/improvements/apply\n→ SchemeService.applyDiff\nvalida: DIFF_INVALIDO\nlê: schemes, scheme_items, reactions …\nusa: Guard.requireCanCreate, Guard.requireOwner,\nWardrobeService.reactionCounts …;
  case (Salvar esquema [manual, IA, autop…)
    :POST /api/schemes\n→ SchemeService.create\nvalida: FORMULARIO_INVALIDO, FOTO_INVALIDA,\nINDISPONIVEL, NAO_ENCONTRADO …\nlê: users, schemes, wardrobe_items …\nusa: Guard.requireCanCreate, Guard.requireView,\nBackgroundStudioService.applyToScheme …\ngrava: schemes, scheme_items;
  case (Editar a peça)
    :PUT /api/pieces/{id}\n→ WardrobeService.update\nvalida: FORMULARIO_INVALIDO\nlê: wardrobe_items, brands, reactions\nusa: Guard.requireCanCreate, Guard.requireOwner,\nOwnMedia.accepts …\nestado: brandLogoUrl → null, brandLogoUrl → set;
