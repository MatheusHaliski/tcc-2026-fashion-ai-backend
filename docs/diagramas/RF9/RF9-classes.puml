@startuml RF9_Classes
title RF9 — Editar os dados de um esquema de vestimenta e das peças que o compõem\nDiagrama de classes — SchemeService.update/improve/applyDiff, selos em revalidação e edição da peça
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  HeaderBackgroundColor #E4DEF0
}
skinparam packageStyle rectangle
hide empty members

package "fai-web · controller" {
  class SchemeController <<RestController>> {
    +get(viewer, id) «GET /api/schemes/{id}»
    +update(user, id, SchemeForm) «PUT /api/schemes/{id}»
    +improve(user, id, ImproveRequest) «POST /api/schemes/{id}/improvements»
    +applyDiff(user, id, Map) «POST /api/schemes/{id}/improvements/apply»
    +archive(user, id) «POST /api/schemes/{id}/archive»
    +delete(user, id) «DELETE /api/schemes/{id}»
  }
  class WardrobeController <<RestController>> {
    +update(user, id, PieceForm) «PUT /api/pieces/{id}»
  }
  class SealController <<RestController>> {
    +review(user, bondId, ReviewRequest) «POST /api/seal-bonds/{bondId}/review»
  }
}

package "fai-application" {
  class SchemeService <<Service>> {
    +update(user, id, SchemeForm) : Map
    +improve(user, id, instruction) : Map
    +applyDiff(user, id, accepted) : Map
    +archive(user, id) : Map
    +owned(user, id) : Scheme
    -applyForm(s, form)
    -replaceItems(user, s, items) : List<SchemeItem>
    ~applyLookPhoto(user, s, background, items)
    -publishInternal(s, items)
    ~parseDiff(text, current) : List<FieldChange>
    ~{static} validChange(field, value) : boolean
  }
  class "SchemeService.SchemeForm" as SchemeForm <<record>> {
    title, description : String
    occasion, style, tags, seals : List<String>
    season : Season ; mood : Mood
    visibility : Visibility
    items : List<ItemForm>
    background : Map ; applyRecommendedDirection : Boolean
    cardSkin, layoutAnatomy : String
    publish, lookDoDia : Boolean
  }
  class "SchemeService.ItemForm" as ItemForm <<record>> {
    wardrobeItemId : UUID ; slot : SchemeSlot
    sortOrder, zIndex : Integer
    positionX, positionY, scale : BigDecimal
    rotation, opacity : BigDecimal
    filters : Map
  }
  class "LocalAdvisors.FieldChange" as FieldChange <<record>> {
    field : String
    current, proposed : Object
    reason : String
  }
  class LocalAdvisors {
    +{static} proposeEdit(current, instruction) : List<FieldChange>
  }
  class AiEngine {
    +text(TextCall) : AiOutcome
  }
  class SealService <<Service>> {
    +flagRevalidation(scheme)
    +revokeForScheme(schemeId, reason)
    +review(user, bondId, approve, reason) : Map
  }
  class BackgroundStudioService <<Service>> {
    +applyToScheme(s, config, applyRecommendedDirection)
  }
  class WardrobeService <<Service>> {
    +update(user, id, PieceForm) : PieceView
    +owned(user, id) : WardrobeItem
    -validate(PieceForm)
    -apply(w, form, creating)
  }
  class Guard <<Component>> {
    +requireCanCreate(user)
    +requireOwner(user, ownerId, resource)
  }
  class "DomainEvents" as Ev <<events>> {
    SchemeSaved(userId, schemeId, pieceIds, origin, created)
    PieceUpdated(userId, pieceId, completeness)
  }
}

package "fai-domain · model" {
  class Scheme <<Entity>> <<table schemes>> {
    title, description : String
    occasion, style, tags : String «csv»
    season : Season ; mood : Mood
    visibility : Visibility ; status : SchemeStatus
    coverImageUrl, studioConfigJson : String
    cardSkin, layoutAnatomy : String
    totalPrice : BigDecimal
    revalidationPending : boolean
    publishedAt, updatedAt : Instant
    version : long «@Version»
  }
  class SchemeItem <<Entity>> <<table scheme_items>> {
    slot : SchemeSlot ; sortOrder, zIndex : int
    positionX, positionY, scale : BigDecimal
    filtersJson, snapshotJson : String
  }
  class WardrobeItem <<Entity>> <<table wardrobe_items>> {
    name, category, subcategory, color : String
    disponivel : boolean
    schemeUsageCount : int
    version : long «@Version»
  }
  class SealBond <<Entity>> <<table seal_bonds>> {
    targetOwner, requestedBy : User
    status : SealBondStatus
    reviewNote : String ; reviewedAt : Instant
  }
}
package "fai-domain · enums" {
  enum SchemeStatus {
    DRAFT
    PUBLISHED
    ARCHIVED
  }
  enum SealBondStatus {
    SUGGESTED
    ACCEPTED
    EDITED
    REFUSED
    PENDING_REVIEW
    APPROVED
    REJECTED
    REVOKED
  }
  enum Season {
    SPRING
    SUMMER
    AUTUMN
    WINTER
  }
  enum Mood {
    ENERGETIC
    ELEGANT
    COMFORTABLE
    SOPHISTICATED
  }
}

SchemeController --> SchemeService
WardrobeController --> WardrobeService
SealController --> SealService
SchemeService ..> SchemeForm
SchemeForm *-- "1..*" ItemForm
SchemeService --> Guard
WardrobeService --> Guard
SchemeService --> SealService : CA05 · RF20.CA14
SchemeService --> BackgroundStudioService : arte do look
SchemeService --> AiEngine : EDIT_ASSISTANT
SchemeService ..> LocalAdvisors : plano B local (na TextCall)
SchemeService ..> FieldChange
SchemeService ..> Ev : SchemeSaved
WardrobeService ..> Ev : PieceUpdated
SchemeService ..> Scheme
SchemeService ..> SchemeItem : replaceItems (CA02)
SealService ..> SealBond
WardrobeService ..> WardrobeItem : CA07
Scheme "1" *-- "1..*" SchemeItem
SchemeItem "*" --> "1" WardrobeItem
SealBond "*" --> "1" Scheme
Scheme --> SchemeStatus
Scheme --> Season
Scheme --> Mood
SealBond --> SealBondStatus

note bottom of SchemeItem
  Remover a peça do look apaga só o scheme_item:
  a WardrobeItem continua no Closet (CA02).
end note
note right of SealBond
  flagRevalidation: só vínculos APPROVED;
  review(approve) limpa revalidationPending,
  review(recusa) → REVOKED.
end note
@enduml
