@startuml RF9_Sequencia
title RF9 — Editar os dados de um esquema de vestimenta e das peças que o compõem\nDiagrama de sequência — endpoints reais
skinparam backgroundColor #FFFFFF
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
}
autonumber
actor "Autor" as U
participant "Frontend\nschemes/[id]/edit · SchemeBuilder" as FE
participant "SchemeController" as SC
participant "SchemeService" as SS
participant "Guard" as G
participant "AiEngine (RF24)\nEDIT_ASSISTANT" as AI
participant "SealService" as SEAL
participant "WardrobeController" as WC
participant "WardrobeService" as WS
database "MySQL" as DB
U -> FE: abre edição do esquema
FE -> SC: GET /api/schemes/{id}
SC -> SS: get(viewer, id)
SS -> DB: SELECT schemes, scheme_items
SS --> FE: 200 {scheme, canEdit}
alt canEdit = false (CA04)
  FE -> FE: botão Editar oculto
else autor
  FE -> FE: SchemeBuilder(initial) — título, descrição,\nocasião, visibilidade, arte, peças (CA01)
end
opt "melhorar com IA" (RF30.CA10)
  U -> FE: instrução em linguagem natural
  FE -> SC: POST /api/schemes/{id}/improvements {instruction}
  SC -> SS: improve(user, id, instruction)
  SS -> G: requireOwner(user, ownerId, "scheme:{id}")
  SS -> AI: text(TextCall EDIT_ASSISTANT, campos atuais + instrução)
  AI --> SS: changes[{field, current, proposed, reason}] (ou LocalAdvisors.proposeEdit)
  SS --> FE: 200 {changes, explanation, inferenceId}
  U -> FE: aceita/recusa item a item
  FE -> SC: POST /api/schemes/{id}/improvements/apply {field: valor}
  SC -> SS: applyDiff(user, id, accepted)
  SS -> SS: validChange(field, valor) → 400 DIFF_INVALIDO se inválido
  SS -> DB: UPDATE schemes; INSERT audit_log (EDICAO_ESQUEMA aiDiffFields)
  SS --> FE: 200 {scheme}
end
U -> FE: salva as alterações
FE -> SC: PUT /api/schemes/{id} (SchemeForm)
SC -> SS: update(user, id, form)
SS -> G: requireOwner(user, ownerId, "scheme:{id}")
alt não é o autor
  G -> DB: INSERT audit_log (ACESSO_NEGADO_403)
  G --> FE: 403
else autor
  SS -> DB: SELECT scheme_items (before)
  SS -> SS: applyForm; replaceItems(form.items) — CA02: só scheme_items
  alt items vazio
    SS --> FE: 400 SEM_PECAS
  end
  opt peças mudaram e status = PUBLISHED (CA05)
    SS -> SEAL: flagRevalidation(scheme)
    SEAL -> DB: SELECT seal_bonds WHERE status = APPROVED
    SEAL -> DB: INSERT notifications (SEAL_BOND_REVIEW → marca)
    SEAL --> SS: revalidationPending = true
  end
  opt visibilidade virou PRIVATE
    SS -> SEAL: revokeForScheme(id) — RF20.CA14
  end
  SS -> DB: UPDATE schemes, scheme_items; INSERT audit_log (EDICAO_ESQUEMA)
  SS --> FE: 200 {scheme, revalidationPending}
end
opt editar uma peça do esquema (CA07)
  U -> FE: edita a peça (PieceForm)
  FE -> WC: PUT /api/pieces/{id}
  WC -> WS: update(user, id, form)
  WS -> G: requireOwner(user, ownerId, "piece:{id}")
  WS -> DB: UPDATE wardrobe_items; INSERT audit_log (EDICAO_PECA)
  WS --> FE: 200 PieceView
end
@enduml
