@startuml RF9_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."
title RF9 — Editar os dados de um esquema de vestimenta e das peças que o compõem\nDiagrama de sequência — gerado do código em 2026-10-06 (scripts/diagramas/v5)

actor "Pessoa usuária" as U
boundary "Tela /schemes/[id]/edit" as P
control "SchemeController" as SchemeController
participant "SchemeService" as SchemeService
participant "Guard" as Guard
database "MySQL" as DB_MySQL
participant "BackgroundStudioService" as BackgroundStudioService
participant "MediaService" as MediaService
== Editar esquema ==
U -> P : Editar esquema
P -> SchemeController : PUT /api/schemes/{id}
SchemeController -> SchemeService : update()
activate SchemeService
SchemeService -> Guard : requireCanCreate()
SchemeService -> DB_MySQL : SELECT schemes
SchemeService -> Guard : requireOwner()
SchemeService -> DB_MySQL : SELECT scheme_items
alt formulario inválido
SchemeService --> SchemeController : 400 FORMULARIO_INVALIDO
SchemeController --> P : 400 + mensagem
end
SchemeService -> DB_MySQL : SELECT scheme_items
alt formulario inválido
SchemeService --> SchemeController : 400 FORMULARIO_INVALIDO
SchemeController --> P : 400 + mensagem
end
SchemeService -> DB_MySQL : SELECT wardrobe_items
alt peça de outro usuário
SchemeService --> SchemeController : 400 PECA_DE_OUTRO_USUARIO
SchemeController --> P : 400 + mensagem
end
alt peça indisponível
SchemeService --> SchemeController : 400 PECA_INDISPONIVEL
SchemeController --> P : 400 + mensagem
end
SchemeService -> DB_MySQL : SELECT scheme_items
SchemeService -> SchemeService : new SchemeItem()
SchemeService -> DB_MySQL : INSERT/UPDATE scheme_items
SchemeService -> DB_MySQL : DELETE scheme_items
SchemeService -> SchemeService : coverImageUrl = set
alt sem peças
SchemeService --> SchemeController : 400 SEM_PECAS
SchemeController --> P : 400 + mensagem
end
SchemeService -> BackgroundStudioService : applyToScheme()
BackgroundStudioService -> DB_MySQL : SELECT wardrobe_items
BackgroundStudioService --> SchemeService
SchemeService -> SchemeService : coverImageUrl = set
alt foto inválida
SchemeService --> SchemeController : 400 FOTO_INVALIDA
SchemeController --> P : 400 + mensagem
end
SchemeService -> SchemeService : coverImageUrl = set
SchemeService -> MediaService : linkSource()
MediaService -> DB_MySQL : SELECT photos
MediaService --> SchemeService
note over SchemeService : … e mais 18 passos no código
deactivate SchemeService
SchemeService --> SchemeController : resultado
SchemeController --> P : 200 JSON
P --> U : atualiza a tela
@enduml
