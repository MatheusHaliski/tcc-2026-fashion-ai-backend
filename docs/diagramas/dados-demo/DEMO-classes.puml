@startuml DEMO_Classes
title Fashion AI — Classes: pipeline demo e integridade por domínio (V34/V35 aplicadas · serviço e controller planejados)
!include ../seguranca/_estilo.iuml
left to right direction

enum AccountOrigin {
  REAL
  TEST_SEED
  DEMO
  SYSTEM
}
enum CatalogOrigin {
  REAL
  SEED
  DEMO
}
class User {
  -accountOrigin : AccountOrigin
  -fixtureKey : String «único»
  -testAccountColumn : Boolean «gerada (V35): origem ∈ {TEST_SEED, DEMO}»
}
class Brand {
  -catalogOrigin : CatalogOrigin
  -fixtureKey : String «único»
}
User --> AccountOrigin
Brand --> CatalogOrigin

class "DemoAdminController (planejado)" as DemoAdminController {
  +seed(profile) : DemoReport
  +verify() : VerifyReport
  +reset(dryRun, confirm) : ResetPlan | DemoReport
  +resetCatalog(dryRun) : ResetPlan
}
class "DemoDataService (planejado)" as DemoDataService {
  -guard : DemoEnvironmentGuard
  +seed(profile) : DemoReport
  +plan() : ResetPlan
  +reset(planHash) : DemoReport
  +verify() : VerifyReport
}
class DemoEnvironmentGuard {
  +requireEnabled()
  -- FASHIONAI_DEMO_ENABLED
  -- produção: FASHIONAI_DEMO_ALLOW_PRODUCTION
}
class DemoFixtures <<@Lazy>> {
  +personas() : List<Persona>
  +seed : long = 2026
}
class Persona <<record>> {
  fixtureKey : String
  kind : USER | BRAND | CELEBRITY | CREATOR
  pieces : int
  looks : int
  privateAccount : boolean
}
class ResetPlan <<record>> {
  countsByTable : Map<String, Long>
  realUsersToDelete : long
  planHash : String
}
class DemoReport <<record>> {
  lines : List<String> «[CREATED] [FOUND] [UPDATED] [DELETE] [CASCADE] [KEEP]»
}
class "V34__integridade_referencial_por_dominio" as V34 <<Flyway Java>> {
  +POLICY : List<Fk>
  +migrate(ctx) «INFORMATION_SCHEMA · órfãos · idempotente»
}
class Fk <<record>> {
  table : String
  column : String
  refTable : String
  refColumn : String = "id"
  onDelete : CASCADE | RESTRICT | SET NULL
}

DemoAdminController --> DemoDataService
DemoDataService --> DemoEnvironmentGuard
DemoDataService --> DemoFixtures
DemoFixtures *-- Persona
DemoDataService ..> ResetPlan
DemoDataService ..> DemoReport
DemoDataService ..> User
V34 *-- Fk
@enduml
