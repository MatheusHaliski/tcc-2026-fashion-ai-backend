package "app/(site)/(app)/search/page.tsx" {
  class Brand as "Brand" <<interface>> {
    +id: string
    +userId: string
    +slug: string
    +name: string
    +logoUrl: string | null
    +registered: boolean
    +publicPieces: number
    +avatarUrl: string | null
  }
  enum Tab as "Tab" {
    LOOKS
    PECAS
    PESSOAS
    MARCAS
    CELEBRIDADES
  }
  class Filters as "Filters" <<type>> {
    +style: string
    +occasion: string
    +color: string
    +brand: string
    +category: string
    +hypeLevel: string
  }
  class Page as "Page" <<interface>> {
    +items: Row[]
    +nextCursor: string | null
    +empty: { message?: string; alternatives?: stri…
    +engine: string
  }
  class mod_page_tsx as "page.tsx" <<módulo>> {
    +SearchPage()
  }
}
package "app/(gate)/gate/verify/route.ts" {
  class mod_route_ts as "route.ts" <<módulo>> {
    +POST()
    +DELETE()
  }
}
package "Backend (Java)" {
  class DemoEnvironmentGuard <<service>> {
    -enabled: boolean
    -allowProduction: boolean
    -environment: String
    +production()
    +environment()
    +requireEnabled()
  }
  class DemoFixtures <<service>> {
    -personas: List<Persona>
    -followers: JsonNode
    -pieces: List<PieceTemplate>
    -colors: List<String>
    -materials: List<String>
    -sizes: List<String>
    +validate()
    +personas()
    +fixtureKeys()
    +pieces()
    +colors()
    +materials()
    +sizes()
    +priceMin()
  }
  class V34__integridade_referencial_por_dominio  {
    +canExecuteInTransaction()
    +migrate()
    +sameRule()
    +norm()
    +existing()
    +problem()
    +column()
    +sha()
  }
}
@enduml
