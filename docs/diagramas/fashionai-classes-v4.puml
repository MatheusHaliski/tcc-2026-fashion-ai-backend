  +status: HypeStatus
  +score: BigDecimal
  .. +16 campos ..
}
class HypeScoreSnapshot {
  +entityType: HypeEntityType
  +entityId: UUID
  +algorithmVersion: String
  +snapshotDate: LocalDate
  +status: HypeStatus
  +score: BigDecimal
  .. +7 campos ..
}
class HypeDimensions <<Embeddable>> {
  +popularity: BigDecimal
  +engagement: BigDecimal
  +trend: BigDecimal
  +trendVelocity: BigDecimal
  +novelty: BigDecimal
  +longevity: BigDecimal
  +rarity: BigDecimal
  +originality: BigDecimal
  +influence: BigDecimal
}
enum HypeEntityType {
  PIECE
  SCHEME
}
enum HypeSignalType {
  LIKE_CREATED
  COMMENT_CREATED
  SAVE_CREATED
  SHARE_CREATED
  FAVORITE_CREATED
  LOOK_REMIXED
  PIECE_REMIXED
  LOOK_VIEWED
  PIECE_VIEWED
  PIECE_USED
  PIECE_IN_LOOK
  LOOK_WORN
}
enum HypeStatus {
  AVAILABLE
  INSUFFICIENT_DATA
}
enum HypeLevel {
  LOW_SIGNAL
  NICHE
  RELEVANT
  HOT
  TRENDING
  VIRAL
}
enum HypeMomentum {
  EMERGING
  RISING
  STABLE
  COOLING
  CLASSIC
}
interface HypeSignalDailyRepository <<JpaRepository>>
interface HypeScoreCurrentRepository <<JpaRepository>>
interface HypeScoreSnapshotRepository <<JpaRepository>>
note "Vínculo polimórfico (entity_type, entity_id), sem FK JPA:\nPIECE → WardrobeItem · SCHEME → Scheme.\nalgorithm_version (HYPE_V2…) separa as séries;\nsem dados = INSUFFICIENT_DATA com score nulo (nunca 0)." as N_HYPE
}
