package "HypeScore v2 (RF49)" {
class HypeSignalDaily {
  +entityType: HypeEntityType
  +entityId: UUID
  +signalType: HypeSignalType
  +signalDate: LocalDate
  +eventCount: int
  +weightedCount: BigDecimal
  .. +2 campos ..
}
class HypeScoreCurrent {
  +entityType: HypeEntityType
  +entityId: UUID
  +ownerId: UUID
