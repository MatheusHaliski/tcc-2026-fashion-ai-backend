@startuml FashionAI_Classes_v5_Hype_Lens
title FashionAI — Visão global do domínio (v5)\nDiagrama de classes — HypeScore v2 e FashionAI Lens (RF46 HypeScore v2 · RF45 FashionAI Lens) · entidades JPA de fai-domain, Flyway V1–V42
!pragma layout smetana
set separator none
skinparam backgroundColor #FFFFFF
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  HeaderBackgroundColor #E4DEF0
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86A
}
skinparam packageStyle rectangle
hide empty methods

package "HypeScore v2 — V31, V39, V41 (RF46)" {
class HypeSignalDaily << (S,#F0D2B8) hype_signal_daily >> {
  +entityType: HypeEntityType
  +entityId: UUID
  +signalType: HypeSignalType
  +signalDate: LocalDate
  +eventCount: int
  +weightedCount: BigDecimal
}
class HypeScoreCurrent << (S,#F0D2B8) hype_scores >> {
  +entityType: HypeEntityType
  +entityId: UUID
  +ownerId: UUID
  +algorithmVersion: String
  +status: HypeStatus
  +score: BigDecimal
  +level: HypeLevel
  +dimensions: HypeDimensions
  +deltaPoints: BigDecimal
  +deltaPercent: BigDecimal
  +direction: String
  +momentum: HypeMomentum
  +publicEligible: boolean
  +category: String
  +country: String
  +region: String
  +categories: String
  +subcategories: String
  +signalsJson: String
  +reasonsJson: String
  +calculatedAt: Instant
  .. +4 campos ..
}
class HypeScoreSnapshot << (S,#F0D2B8) hype_score_snapshots >> {
  +entityType: HypeEntityType
  +entityId: UUID
  +algorithmVersion: String
  +snapshotDate: LocalDate
  +status: HypeStatus
  +score: BigDecimal
  +level: HypeLevel
  +dimensions: HypeDimensions
  +publicEligible: boolean
  +calculatedAt: Instant
  .. +2 campos ..
}
class HypeDimensions << (M,#D2E4F0) @Embeddable >> {
  +popularity: BigDecimal
  +engagement: BigDecimal
  +trend: BigDecimal
  +trendVelocity: BigDecimal
  +novelty: BigDecimal
  +longevity: BigDecimal
  +rarity: BigDecimal
  +originality: BigDecimal
  +influence: BigDecimal
}
class HypeMilestone << (S,#F0D2B8) hype_milestones >> {
  +entityType: HypeEntityType
  +entityId: UUID
  +ownerId: UUID
  +milestone: Kind
  +level: HypeLevel
  +momentum: HypeMomentum
  +score: BigDecimal
  +publicEligible: boolean
  +algorithmVersion: String
  +achievedAt: Instant
  +digestDate: LocalDate
  +notificationId: UUID
}
}
package "FashionAI Lens — V40 (RF45)" {
class LensScan << (V,#C9B8F0) lens_scans >> {
  +userId: UUID
  +source: LensSource
  +sourceRefId: UUID
  +intent: LensIntent
  +status: LensScanStatus
  +errorCode: String
  +imageKey: String
  +facesRedacted: int
  +redactionConfirmed: boolean
  +aiSource: String
  +algorithmVersion: String
  +aiInferenceId: UUID
  +savedAt: Instant
  +expiresAt: Instant
  +processedAt: Instant
  .. +4 campos ..
}
class LensDetection << (V,#C9B8F0) lens_detections >> {
  +scanId: UUID
  +ordinal: int
  +boxJson: String
  +label: String
  +category: String
  +subcategory: String
  +colorsJson: String
  +pattern: String
  +styleTags: String
  +confidence: BigDecimal
  +embeddingModel: String
  +status: LensDetectionStatus
  +dismissedAt: Instant
  +wantedAt: Instant
  +ownedItemId: UUID
  .. +5 campos ..
}
class LensFeedback << (A,#B8DCC0) lens_feedback >> {
  +scanId: UUID
  +detectionId: UUID
  +userId: UUID
  +kind: LensFeedbackKind
  +beforeJson: String
  +afterJson: String
  +trainingConsent: boolean
}
}
enum "HypeMilestone.Kind" as HypeMilestoneKind {
  HOT
  TRENDING
  VIRAL
  EMERGING
}
package "Enums-chave (domain/model/enums)" {
enum HypeEntityType {
  PIECE
  SCHEME
}
enum HypeSignalType {
  LIKE_CREATED
  COMMENT_CREATED
  SAVE_CREATED
  SHARE_CREATED
  FAVORITE_CREATED
  LOOK_REMIXED
  PIECE_REMIXED
  LOOK_VIEWED
  PIECE_VIEWED
  PIECE_USED
  PIECE_IN_LOOK
  LOOK_WORN
}
enum HypeStatus {
  AVAILABLE
  INSUFFICIENT_DATA
}
enum HypeLevel {
  LOW_SIGNAL
  NICHE
  RELEVANT
  HOT
  TRENDING
  VIRAL
}
enum HypeMomentum {
  EMERGING
  RISING
  STABLE
  COOLING
  CLASSIC
}
enum LensSource {
  CAMERA
  GALLERY
  UPLOAD
  IN_APP_PIECE
  IN_APP_LOOK
}
enum LensIntent {
  IDENTIFY
  RECREATE
}
enum LensScanStatus {
  READY
  PARTIAL
  NO_FASHION_FOUND
  FAILED
}
enum LensDetectionStatus {
  DETECTED
  CORRECTED
  ADDED_BY_USER
  DISMISSED
}
enum LensFeedbackKind {
  WRONG_CATEGORY
  WRONG_COLOR
  WRONG_ATTRIBUTE
  NOT_CLOTHING
  MISSING_PIECE
  BAD_BOX
  WRONG_MATCH
  GOOD_MATCH
}
}
package "Referências a outras áreas" #FAFAFA {
class User <<outra área>> #FFFFFF;line.dashed;line:9A97A0 {
}
class WardrobeItem <<outra área>> #FFFFFF;line.dashed;line:9A97A0 {
}
class Scheme <<outra área>> #FFFFFF;line.dashed;line:9A97A0 {
}
class Notification <<outra área>> #FFFFFF;line.dashed;line:9A97A0 {
}
class AiInferenceLog <<outra área>> #FFFFFF;line.dashed;line:9A97A0 {
}
class UserPreferences <<outra área>> #FFFFFF;line.dashed;line:9A97A0 {
  +hypeCreatorOptOut: boolean (V42)
}
}

' --- associações JPA (geradas do código) ---
' --- referências por id, sem FK JPA ---
HypeScoreCurrent *-- HypeDimensions : dimensions
HypeScoreSnapshot *-- HypeDimensions : dimensions
HypeMilestone --> HypeMilestoneKind : milestone
HypeSignalDaily ..> WardrobeItem : entityId (PIECE)
HypeSignalDaily ..> Scheme : entityId (SCHEME)
HypeScoreCurrent ..> WardrobeItem : entityId (PIECE)
HypeScoreCurrent ..> Scheme : entityId (SCHEME)
HypeScoreCurrent ..> User : ownerId
HypeScoreSnapshot ..> HypeScoreCurrent : mesma (entityType, entityId)
HypeMilestone ..> HypeScoreCurrent : mesma (entityType, entityId)
HypeMilestone ..> Notification : notificationId
UserPreferences ..> HypeScoreCurrent : opt-out de «Criadores em alta»
LensScan ..> User : userId
LensScan ..> AiInferenceLog : aiInferenceId
LensScan ..> WardrobeItem : sourceRefId (IN_APP_PIECE)
LensScan ..> Scheme : sourceRefId (IN_APP_LOOK)
LensDetection ..> LensScan : scanId
LensDetection ..> WardrobeItem : ownedItemId («Eu tenho»)
LensFeedback ..> LensScan : scanId
LensFeedback ..> LensDetection : detectionId
note "Sem dados: status INSUFFICIENT_DATA e score nulo (nunca 0).\nalgorithm_version (HYPE_V2) separa as séries.\nV39: country, region, categories, subcategories\n(ranking regional e facetas).\nO v1 (HypeScoreMetric, HypeGroup, MetricSnapshot,\nHypeScoreBand) foi removido do código em P3-16;\nas tabelas antigas ficam no banco só como histórico." as N_HYPE
N_HYPE .. HypeScoreCurrent
note "V41: um marco por entidade e Kind (dedupe);\nsó subida; digestDate + notificationId agrupam\nos marcos do dia num resumo por dono." as N_MS
N_MS .. HypeMilestone
note "Rostos borrados no aparelho antes do envio\n(facesRedacted, redactionConfirmed);\nretenção: expiresAt (LensRetentionJob, diário)." as N_LENS
N_LENS .. LensScan
legend right
  <b>Letra do ícone</b>
  V = estende VersionedAuditableEntity (id UUID, createdAt/updatedAt, createdBy/lastModifiedBy, @Version)
  A = estende AuditableEntity (id UUID e auditoria, sem @Version)
  S = @Entity sem superclasse (id e datas próprios) · M = @Embeddable (colunas embutidas na tabela dona)
  E = enum
  ⟶ seta cheia = associação JPA (@ManyToOne/@OneToOne) · seta tracejada = id guardado sem FK JPA
  <<outra área>> = classe detalhada em outro diagrama v5
endlegend
@enduml
