@startuml SEG_Classes
title Segurança, integridade e operação (transversal)\nDiagrama de classes — acesso: gate de desenvolvedor, cliente da API, filtros e configuração de segurança
!include _estilo.iuml
left to right direction

package "frontend · lib/gate e lib/safe-next.ts" <<Frame>> {
  class GateConfig <<interface TS>> {
    enabled : boolean
    mode : "builtin" | "cloudflare"
    user : string
    pinHash : string | null
    secret : string | null «≥ 32»
    apiToken : "legacy" | "v2"
    google : boolean
    allowedEmails : string[]
    publicUrl : string | null
    cloudflare : {teamDomain, aud}
  }
  class "token.ts" as Token <<module>> {
    GATE_TTL_SECONDS = 12 h
    GATE_API_TTL_SECONDS = 1 h
    GATE_API_RENEW_BEFORE_SECONDS = 20 min
    MIN_SECRET_LENGTH = 32 · MIN_PIN_LENGTH = 8
    +gateConfig() : GateConfig
    +signGate(kind, id, jti, secret, ttl) : string
    +verifyGate(kind, token, cfg) : GateIdentity?
    +signApiToken(cfg, id, jti, ttl) : string
    +signLegacyApiToken(user, secret, ttl) : string
    +apiTokenMatches(cfg, token) : boolean
    +verifyCloudflareAccess(jwt, cfg) : GateIdentity?
    +maskIdentity(id) : string
  }
  class GateIdentity <<interface TS>> {
    id : string
    jti : string
    exp : number
  }
  class "safeNext(next, fallback)" as SafeNext <<function>>
  Token ..> GateConfig
  Token ..> GateIdentity
}

package "frontend · lib/api/client.ts" <<Frame>> {
  class tokenStore <<objeto em memória>> {
    +access : string?
    +restorable : boolean «cookie fai_rt_h»
    +set(token)
    +clear()
  }
  class "client.ts" as ApiClient <<module>> {
    +api.get · post · put · patch · delete · upload
    +restoreSession() : Promise<boolean>
    -renewGate() «POST /gate/renew»
    -withRefreshLock(fn) «Web Lock fai-auth-refresh»
    -tryRefresh() «POST /bff/auth/refresh»
    -checkPath(path) «recusa .., %2f e controle»
  }
  ApiClient --> tokenStore
}

package "fai-web · support e security" <<Frame>> {
  class CorrelationIdFilter <<HIGHEST_PRECEDENCE>> {
    HEADER = "X-Correlation-Id"
  }
  class DevGateFilter <<@Order(-103)>> {
    HEADER = "X-Dev-Gate"
    CLOUDFLARE_HEADER = "Cf-Access-Jwt-Assertion"
    MIN_SECRET_LENGTH = 32
    -OPEN = /actuator/health · /actuator/info · /media/
    -enabled · cloudflareMode · acceptLegacy
    -allowed : Set<String>
    ~valid(token, secret, allowed, now) : boolean
    ~validLegacy(token, secret, user, now) : boolean
    -validCloudflare(jwt) : boolean
  }
  class ClientIpResolver {
    SIGNED_IP · SIGNED_TS · SIGNED_SIG
    MAX_SKEW_SECONDS = 60
    MIN_SECRET_LENGTH = 32
    +resolve(request) : String
    ~signature(secret, ip, ts) : String
  }
  class AuthRateLimitFilter <<@Order(-102)>> {
    ~RULES : List<Rule>
    -hashing : Semaphore
    -hashWaitMillis = 2000
    ~ruleFor(method, path) : Optional<Rule>
    ~defaultHashPermits(cores, dbPool) : int
  }
  class "Rule" as Rule <<record>> {
    method · path · limit
    window : Duration
    hashes : boolean
  }
  class SecurityConfig {
    -PUBLIC_GET : String[]
    «/api/admin/** e /actuator/** → ADMIN»
    «/media/restricted/** → ADMIN»
  }
  class SessionActiveFilter {
    «depois do BearerTokenAuthenticationFilter»
    «sessão encerrada → 401»
  }
  class FashionAuthorization {
    +canAccessUser(targetUserId, authentication) : boolean
  }
  class Argon2PasswordHasher
  AuthRateLimitFilter *-- Rule
  AuthRateLimitFilter ..> ClientIpResolver
  SecurityConfig ..> SessionActiveFilter : addFilterAfter
}

package "fai-application" <<Frame>> {
  interface PasswordHasherPort <<port>>
  interface RateLimitPort <<port>> {
    +tryAcquire(owner, bucket, limit, window) : boolean
    +release(owner, bucket)
  }
  class Guard {
    +requireCanCreate(user)
    +requireOwner(user, ownerId, resource)
    +requireAdmin(user)
    +canView(viewer, ownerId, visibility) : boolean
  }
}

Argon2PasswordHasher ..|> PasswordHasherPort
AuthRateLimitFilter --> RateLimitPort : balde por IP
ApiClient ..> DevGateFilter : X-Dev-Gate (cookie fai_gate_a)
Token ..> DevGateFilter : mesmo formato "ga"\n(vetor cruzado nos testes)
@enduml
