@startuml RF1_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF1 — Cadastrar usuário na plataforma com dados de acesso (perfil Pessoal, Restaurante, Chef ou Marca de alimentos)\nDiagrama de componentes — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)

package "Frontend (Next.js 15 · React 19 · TanStack Query)" {
  component "Tela de Cadastro (/signup)" as FE
  component "lib/api (OpenAPI client gerado)" as APIC
}
package "Borda" {
  component "CloudFront + WAF" as CDN
  component "Spring Cloud Gateway\n(JWT, rate limit, CORS)" as GW
}
package "dine-web (REST · Spring Boot 4.0)" {
  component "AuthController\nPOST /api/auth/register\nGET /api/auth/username-suggestions\nPOST /api/auth/verify-email\nPOST /api/auth/verify-email/resend\nPOST /api/auth/passkeys/register" as CT
}
package "dine-application (Spring Modulith · casos de uso)" {
  component "IdentityService" as SV
  component "PasswordHasherPort\n«Argon2PasswordHasher»" as PT0 <<port>>
  component "EmailSenderPort\n«SesEmailSender»" as PT1 <<port>>
  component "CnpjLookupPort\n«ReceitaWsAdapter»" as PT2 <<port>>
  component "GeocodingPort\n«MapboxGeocoder»" as PT3 <<port>>
  component "RateLimitPort\n«RedisRateLimit»" as PT4 <<port>>
}
package "dine-domain (entidades + repositórios)" {
  component "UserRepository\nUserPreferencesRepository\nRestaurantProfileRepository\nChefProfileRepository\nFoodBrandProfileRepository\nUserConsentRepository\nVerificationCodeRepository" as REPO_MySQL
  component "AuditEventRepository" as REPO_Cassandra
}
database "MySQL 8.4\n(Spring Data JPA + Flyway)\n• users\n• user_preferences\n• restaurant_profiles\n• chef_profiles\n• food_brand_profiles\n• user_consents\n• verification_codes" as DB_MySQL
database "Cassandra 5\n(Spring Data Cassandra)\n• audit_events" as DB_Cassandra
cloud "AWS SES" as EX0
cloud "ReceitaWS" as EX1
cloud "Mapbox" as EX2
component "Observabilidade\n(Micrometer + OpenTelemetry\n→ Grafana/Tempo/Loki)" as OBS
FE --> APIC
APIC --> CDN : HTTPS/JSON
CDN --> GW
GW --> CT
CT --> SV
SV ..> OBS
SV --> PT0
SV --> PT1
SV --> PT2
SV --> PT3
SV --> PT4
SV --> REPO_MySQL
REPO_MySQL --> DB_MySQL
SV --> REPO_Cassandra
REPO_Cassandra --> DB_Cassandra
PT1 --> EX0
PT2 --> EX1
PT3 --> EX2
@enduml
