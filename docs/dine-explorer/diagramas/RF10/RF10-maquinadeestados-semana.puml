@startuml RF10_MaquinaDeEstados_Semana
!pragma layout smetana
title RF10 — Gerar recomendações de esquemas de alimentação & de peças de alimento através da aba "Copilot"\nDiagrama de máquina de estados — Semana — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)
skinparam backgroundColor #FFFFFF
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  ArrowColor #52606D
}
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
state "Vazia" as VAZ
state "Gerando" as GER
state "Proposta" as PRO
state "Ajustando" as AJU
state "Confirmada" as CON

[*] --> VAZ
VAZ --> GER : gerar
GER --> PRO : stream concluído
PRO --> AJU : trocar refeição
AJU --> PRO
PRO --> CON : salvar
GER --> VAZ : falha/timeout
@enduml
