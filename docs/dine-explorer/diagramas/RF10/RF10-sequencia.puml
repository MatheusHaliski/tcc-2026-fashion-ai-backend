@startuml RF10_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."

title RF10 — Gerar recomendações de esquemas de alimentação & de peças de alimento através da aba "Copilot"\nDiagrama de sequência — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)

actor "Pessoa usuária" as U
boundary "App (Next.js / RN)" as P
participant "API Gateway\n(Spring Cloud Gateway)" as GW
control "CopilotController" as C
participant "CopilotService" as S
participant "LlmPort\n(Spring AI ChatClient)" as P0
participant "VectorStorePort\n(OpenSearch k-NN)" as P1
participant "CachePort\n(Redis semântico)" as P2
participant "ConsentPort (PERSONALIZACAO_IA)" as P3
database "MySQL 8.4\n(Spring Data JPA + Flyway)" as DB_MySQL
database "Redis 7\n(Spring Data Redis)" as DB_Redis
database "Cassandra 5\n(Spring Data Cassandra)" as DB_Cassandra
queue "Kafka" as K
== Chat Copilot ==
U -> P : interage na tela
P -> GW : POST /api/copilot/recommendations (SSE)\nAuthorization: Bearer JWT
GW -> GW : valida JWT (ES256) + rate limit (Redis)
GW -> C : POST /api/copilot/recommendations (SSE)
C -> S : recommend()
activate S
S -> DB_Redis : GET cache / lock
S -> DB_MySQL : SELECT recommendations, taste_dna, meal_schemes
alt sem consentimento ia
S --> C : SEM_CONSENTIMENTO_IA
C --> P : 4xx ProblemDetail {code: SEM_CONSENTIMENTO_IA}
P --> U : mostra aviso
end
alt cota excedida
S --> C : COTA_EXCEDIDA
C --> P : 4xx ProblemDetail {code: COTA_EXCEDIDA}
P --> U : mostra aviso
end
S -> P0 : recommend()
P0 --> S : ok
S -> P1 : weekPlan()
P1 --> S : ok
S -> P2 : save()
P2 --> S : ok
S -> P3 : save()
P3 --> S : ok
S -> DB_MySQL : INSERT/UPDATE (@Transactional)
S -> DB_Cassandra : INSERT ai_inference_log
S -> DB_Redis : SET/ZADD (invalida cache)
S ->> K : evento de domínio (outbox)
deactivate S
S --> C : DTO (record)
C --> P : 200/201 JSON
P --> U : atualiza a tela
== Restrições (kcal, dieta, orçamento, tempo) ==
U -> P : Restrições (kcal, dieta, orçamento, tempo)
P -> C : POST /api/copilot/week-plan
C -> S : weekPlan()
S --> C : resultado
C --> P : 200 JSON
== Plano semanal gerado (arrastar e soltar) ==
U -> P : Plano semanal gerado (arrastar e soltar)
P -> C : POST /api/copilot/{id}/save
C -> S : weekPlan()
S --> C : resultado
C --> P : 200 JSON
@enduml
