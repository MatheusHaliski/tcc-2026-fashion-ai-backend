@startuml RF11_MaquinaDeEstados_Arte
!pragma layout smetana
title RF11 — Utilizar o "Background Studio" para confeccionar a arte de estilo e personalização de esquemas & peças de a…\nDiagrama de máquina de estados — Arte — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)
skinparam backgroundColor #FFFFFF
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  ArrowColor #52606D
}
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
state "Editando" as EDI
state "Renderizando" as REN
state "Pronta" as PRT
state "Aplicada" as APL

[*] --> EDI
EDI --> REN : salvar
REN --> PRT : ok
REN --> EDI : erro
PRT --> APL : aplicar ao card
@enduml
