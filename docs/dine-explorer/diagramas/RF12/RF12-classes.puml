title RF12 — Visualizar & Editar a página "Minhas Fotos" — fotos cadastradas através da adição de peças & criação de esq…\nDiagrama de classes — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)

package "S3" {
  class FoodPhoto <<s3://dine-media/food/{ownerId}/{photoId}.webp>> {
    +key: String
    +originalKey: String
    +width: int
    +height: int
    +contentType: image/webp
    +variants: thumb/card/full
    +blurHash: String
  }
}
package "MySQL" {
  class FoodPiece <<food_pieces>> {
    +id: UUID
    +owner: User
    +name: String
    +category: FoodCategory
    +cuisine: Cuisine
    +originCountry: String
    +ingredients: List<Ingredient>
    +allergens: Set<Allergen>
    +kcalPer100g: int
    +proteinG: decimal
    +carbsG: decimal
    +fatG: decimal
    +portionG: int
    +status: PieceStatus
    +visibility: Visibility
    +photoKey: String
    +createdAt: Instant
  }
}
package "dominio (enums)" {
  enum BatchItemStatus {
    NA_FILA
    ENVIANDO
    RECONHECENDO
    PRONTO
    ERRO
  }
}
package "aplicacao (casos de uso)" {
  class PhotoService <<@Service>> {
    +list()
    +batchUpload()
    +delete()
  }
  class PhotoController <<@RestController>> {
    +GET /api/photos
    +POST /api/photos/batch
    +DELETE /api/photos/{id}
  }
  interface MediaStoragePort <<port>>
  PhotoService ..> MediaStoragePort
}
PhotoController --> PhotoService
PhotoService ..> FoodPhoto : usa
PhotoService ..> FoodPiece : usa
