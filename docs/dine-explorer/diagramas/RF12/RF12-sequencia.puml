@startuml RF12_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."

title RF12 — Visualizar & Editar a página "Minhas Fotos" — fotos cadastradas através da adição de peças & criação de esq…\nDiagrama de sequência — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)

actor "Pessoa usuária" as U
boundary "App (Next.js / RN)" as P
participant "API Gateway\n(Spring Cloud Gateway)" as GW
control "PhotoController" as C
participant "PhotoService" as S
participant "MediaStoragePort\n(S3 presigned)" as P0
database "Amazon S3\n(AWS SDK v2)" as DB_S3
database "MySQL 8.4\n(Spring Data JPA + Flyway)" as DB_MySQL
queue "Kafka" as K
== Galeria (grid com blurhash) ==
U -> P : interage na tela
P -> GW : POST /api/photos/batch\nAuthorization: Bearer JWT
GW -> GW : valida JWT (ES256) + rate limit (Redis)
GW -> C : POST /api/photos/batch
C -> S : list()
activate S
S -> DB_MySQL : SELECT food_pieces
alt limite lote
S --> C : LIMITE_LOTE
C --> P : 4xx ProblemDetail {code: LIMITE_LOTE}
P --> U : mostra aviso
end
alt foto em uso
S --> C : FOTO_EM_USO
C --> P : 4xx ProblemDetail {code: FOTO_EM_USO}
P --> U : mostra aviso
end
S -> P0 : list()
P0 --> S : ok
S -> DB_MySQL : INSERT/UPDATE (@Transactional)
S -> DB_S3 : PUT/GET presigned s3://dine-media/food/{ownerId}/{photoId}.webp
S ->> K : evento de domínio (outbox)
deactivate S
S --> C : DTO (record)
C --> P : 200/201 JSON
P --> U : atualiza a tela
== Upload em lote com fila ==
U -> P : Upload em lote com fila
P -> C : POST /api/photos/batch
C -> S : batchUpload()
S --> C : resultado
C --> P : 200 JSON
== Detalhe da foto → peças vinculadas ==
U -> P : Detalhe da foto → peças vinculadas
P -> C : DELETE /api/photos/{id}
C -> S : batchUpload()
S --> C : resultado
C --> P : 200 JSON
@enduml
