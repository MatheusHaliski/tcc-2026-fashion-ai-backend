@startuml RF13_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF13 — Criar um esquema de identidade pessoal de alimentação na página "DNA de Alimentação"\nDiagrama de componentes — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)

package "Frontend (Next.js 15 · React 19 · TanStack Query)" {
  component "DNA de Alimentação (/dna)" as FE
  component "lib/api (OpenAPI client gerado)" as APIC
}
package "Borda" {
  component "CloudFront + WAF" as CDN
  component "Spring Cloud Gateway\n(JWT, rate limit, CORS)" as GW
}
package "dine-web (REST · Spring Boot 4.0)" {
  component "TasteDnaController\nGET /api/dna\nPUT /api/dna\nPOST /api/dna/quiz" as CT
}
package "dine-application (Spring Modulith · casos de uso)" {
  component "TasteDnaService" as SV
  component "EmbeddingPort\n«Spring AI»" as PT0 <<port>>
  component "ConsentPort (PERSONALIZACAO_IA)" as PT1 <<port>>
}
package "dine-domain (entidades + repositórios)" {
  component "TasteDnaRepository\nUserPreferencesRepository" as REPO_MySQL
}
database "MySQL 8.4\n(Spring Data JPA + Flyway)\n• taste_dna\n• user_preferences" as DB_MySQL
cloud "Spring AI" as EX0
component "Observabilidade\n(Micrometer + OpenTelemetry\n→ Grafana/Tempo/Loki)" as OBS
FE --> APIC
APIC --> CDN : HTTPS/JSON
CDN --> GW
GW --> CT
CT --> SV
SV ..> OBS
SV --> PT0
SV --> PT1
SV --> REPO_MySQL
REPO_MySQL --> DB_MySQL
PT0 --> EX0
@enduml
