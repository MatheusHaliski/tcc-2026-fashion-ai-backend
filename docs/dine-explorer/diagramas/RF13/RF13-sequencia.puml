@startuml RF13_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."

title RF13 — Criar um esquema de identidade pessoal de alimentação na página "DNA de Alimentação"\nDiagrama de sequência — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)

actor "Pessoa usuária" as U
boundary "App (Next.js / RN)" as P
participant "API Gateway\n(Spring Cloud Gateway)" as GW
control "TasteDnaController" as C
participant "TasteDnaService" as S
participant "EmbeddingPort\n(Spring AI)" as P0
participant "ConsentPort (PERSONALIZACAO_IA)" as P1
database "MySQL 8.4\n(Spring Data JPA + Flyway)" as DB_MySQL
queue "Kafka" as K
== Quiz de paladar (cards swipe) ==
U -> P : interage na tela
P -> GW : PUT /api/dna\nAuthorization: Bearer JWT
GW -> GW : valida JWT (ES256) + rate limit (Redis)
GW -> C : PUT /api/dna
C -> S : get()
activate S
S -> DB_MySQL : SELECT taste_dna, user_preferences
alt quiz incompleto
S --> C : QUIZ_INCOMPLETO
C --> P : 4xx ProblemDetail {code: QUIZ_INCOMPLETO}
P --> U : mostra aviso
end
S -> P0 : get()
P0 --> S : ok
S -> P1 : update()
P1 --> S : ok
S -> DB_MySQL : INSERT/UPDATE (@Transactional)
S ->> K : evento de domínio (outbox)
deactivate S
S --> C : DTO (record)
C --> P : 200/201 JSON
P --> U : atualiza a tela
== Radar de sabores ==
U -> P : Radar de sabores
P -> C : PUT /api/dna
C -> S : update()
S --> C : resultado
C --> P : 200 JSON
== Cozinhas do coração (mapa) ==
U -> P : Cozinhas do coração (mapa)
P -> C : POST /api/dna/quiz
C -> S : update()
S --> C : resultado
C --> P : 200 JSON
@enduml
