@startuml RF14_Classes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  StereotypeFontColor #6B6470
}
hide empty members
left to right direction
title RF14 — Visualizar a aba "Marcas" — Feed de Perfil de Marcas de alimentos cadastradas no Dine Explorer\nDiagrama de classes — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)

package "MySQL" {
  class FoodBrandProfile <<food_brand_profiles>> {
    +id: UUID
    +owner: User
    +brandName: String
    +slug: String
    +cnpj: String
    +category: BrandCategory
    +countryCode: String
    +logoUrl: String
    +approvalStatus: ApprovalStatus
  }
  class SchemeBrandLink <<scheme_brand_links>> {
    +id: UUID
    +scheme: MealScheme
    +brand: FoodBrandProfile
    +status: LinkStatus
    +requestedAt: Instant
    +decidedAt: Instant
  }
  class Follow <<follows>> {
    +id: UUID
    +follower: User
    +followee: User
    +status: FollowStatus
    +createdAt: Instant
  }
}
package "dominio (enums)" {
  enum BrandCategory {
    LATICINIOS
    BEBIDAS
    CONGELADOS
    SNACKS
    ORGANICOS
    PADARIA
  }
}
package "aplicacao (casos de uso)" {
  class BrandService <<@Service>> {
    +list()
    +profile()
  }
  class BrandController <<@RestController>> {
    +GET /api/brands
    +GET /api/brands/{slug}
  }
  interface SearchIndexPort <<port>>
  BrandService ..> SearchIndexPort
}
BrandController --> BrandService
BrandService ..> FoodBrandProfile : usa
BrandService ..> SchemeBrandLink : usa
BrandService ..> Follow : usa
FoodBrandProfile --> BrandCategory
SchemeBrandLink "*" --> "1" FoodBrandProfile : brand
@enduml
