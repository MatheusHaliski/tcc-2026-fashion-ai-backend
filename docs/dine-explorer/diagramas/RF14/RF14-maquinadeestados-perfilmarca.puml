@startuml RF14_MaquinaDeEstados_PerfilMarca
!pragma layout smetana
title RF14 — Visualizar a aba "Marcas" — Feed de Perfil de Marcas de alimentos cadastradas no Dine Explorer\nDiagrama de máquina de estados — PerfilMarca — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)
skinparam backgroundColor #FFFFFF
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  ArrowColor #52606D
}
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
state "Pendente" as PEN
state "Aprovada" as APR
state "Suspensa" as SUS

[*] --> PEN
PEN --> APR : moderação
APR --> SUS : violação
SUS --> APR : recurso
@enduml
