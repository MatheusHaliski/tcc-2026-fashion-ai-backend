@startuml RF14_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."

title RF14 — Visualizar a aba "Marcas" — Feed de Perfil de Marcas de alimentos cadastradas no Dine Explorer\nDiagrama de sequência — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)

actor "Pessoa usuária" as U
boundary "App (Next.js / RN)" as P
participant "API Gateway\n(Spring Cloud Gateway)" as GW
control "BrandController" as C
participant "BrandService" as S
participant "SearchIndexPort\n(OpenSearch)" as P0
database "MySQL 8.4\n(Spring Data JPA + Flyway)" as DB_MySQL
queue "Kafka" as K
== Top bar de filtros ==
U -> P : interage na tela
P -> GW : GET /api/brands\nAuthorization: Bearer JWT
GW -> GW : valida JWT (ES256) + rate limit (Redis)
GW -> C : GET /api/brands
C -> S : list()
activate S
S -> DB_MySQL : SELECT food_brand_profiles, scheme_brand_links, follows
alt marca inexistente
S --> C : MARCA_INEXISTENTE
C --> P : 4xx ProblemDetail {code: MARCA_INEXISTENTE}
P --> U : mostra aviso
end
S -> P0 : list()
P0 --> S : ok
S -> DB_MySQL : INSERT/UPDATE (@Transactional)
S ->> K : evento de domínio (outbox)
deactivate S
S --> C : DTO (record)
C --> P : 200/201 JSON
P --> U : atualiza a tela
== Grade de marcas ==
U -> P : Grade de marcas
P -> C : GET /api/brands/{slug}
C -> S : profile()
S --> C : resultado
C --> P : 200 JSON
@enduml
