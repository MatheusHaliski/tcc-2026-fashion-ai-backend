@startuml RF15_MaquinaDeEstados_Foto
!pragma layout smetana
title RF15 — Editar a fotografia de uma peça de alimento através de um Editor Canvas Interativo 2D\nDiagrama de máquina de estados — Foto — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)
skinparam backgroundColor #FFFFFF
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  ArrowColor #52606D
}
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
state "Original" as ORI
state "Editada (receita)" as EDI
state "Renderizada" as REN

[*] --> ORI
ORI --> EDI : aplicar operação
EDI --> REN : salvar
REN --> EDI : editar de novo
EDI --> ORI : reverter
@enduml
