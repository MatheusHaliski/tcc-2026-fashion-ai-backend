hide empty members
left to right direction
title RF16 — Implementar geração de imagem 3D das peças de alimento do inventário utilizando serviços de API externas\nDiagrama de classes — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)

package "MySQL" {
  class Food3DJob <<food_3d_jobs>> {
    +id: UUID
    +piece: FoodPiece
    +provider: String
    +status: JobStatus
    +attempts: int
    +glbKey: String
    +requestedAt: Instant
    +finishedAt: Instant
  }
  class FoodPiece <<food_pieces>> {
    +id: UUID
    +owner: User
    +name: String
    +category: FoodCategory
    +cuisine: Cuisine
    +originCountry: String
    +ingredients: List<Ingredient>
    +allergens: Set<Allergen>
    +kcalPer100g: int
    +proteinG: decimal
    +carbsG: decimal
    +fatG: decimal
    +portionG: int
    +status: PieceStatus
    +visibility: Visibility
    +photoKey: String
    +createdAt: Instant
  }
}
package "S3" {
  class Food3DModel <<s3://dine-media/3d/{pieceId}.glb>> {
    +key: String
    +polycount: int
    +textureRes: int
    +usdzKey: String
  }
}
package "dominio (enums)" {
  enum JobStatus {
    NA_FILA
    PROCESSANDO
    CONCLUIDO
    FALHOU
    CANCELADO
  }
}
package "aplicacao (casos de uso)" {
  class Food3DService <<@Service>> {
    +request()
    +status()
    +onProviderCallback()
  }
  class Food3DController <<@RestController>> {
    +POST /api/pieces/{id}/3d
    +GET /api/3d-jobs/{id}
  }
  interface Model3DProviderPort <<port>>
  Food3DService ..> Model3DProviderPort
  interface MediaStoragePort <<port>>
  Food3DService ..> MediaStoragePort
  interface JobQueuePort <<port>>
  Food3DService ..> JobQueuePort
}
Food3DController --> Food3DService
Food3DService ..> Food3DJob : usa
Food3DService ..> Food3DModel : usa
Food3DService ..> FoodPiece : usa
Food3DJob "*" --> "1" FoodPiece : piece
Food3DJob --> JobStatus
@enduml
