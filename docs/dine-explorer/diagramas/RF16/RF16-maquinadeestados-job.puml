@startuml RF16_MaquinaDeEstados_Job
!pragma layout smetana
title RF16 — Implementar geração de imagem 3D das peças de alimento do inventário utilizando serviços de API externas\nDiagrama de máquina de estados — Job — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)
skinparam backgroundColor #FFFFFF
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  ArrowColor #52606D
}
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
state "Na fila" as FIL
state "Processando" as PRO
state "Concluído" as CON
state "Falhou" as FAL

[*] --> FIL
FIL --> PRO : worker
PRO --> CON : callback ok
PRO --> FAL : erro
FAL --> FIL : retry (≤3, backoff)
@enduml
