@startuml RF17_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."

title RF17 — Visualizar a página de perfil de outros Usuários cadastrados na rede social do Dine Explorer\nDiagrama de sequência — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)

actor "Pessoa usuária" as U
boundary "App (Next.js / RN)" as P
participant "API Gateway\n(Spring Cloud Gateway)" as GW
control "ProfileController" as C
participant "ProfileService" as S
participant "CachePort\n(Redis)" as P0
participant "FeedFanoutPort\n(Kafka)" as P1
database "MySQL 8.4\n(Spring Data JPA + Flyway)" as DB_MySQL
queue "Kafka" as K
== Cabeçalho do perfil ==
U -> P : interage na tela
P -> GW : POST /api/users/{id}/follow\nAuthorization: Bearer JWT
GW -> GW : valida JWT (ES256) + rate limit (Redis)
GW -> C : POST /api/users/{id}/follow
C -> S : publicProfile()
activate S
S -> DB_MySQL : SELECT users, follows, meal_schemes
alt perfil privado
S --> C : PERFIL_PRIVADO
C --> P : 4xx ProblemDetail {code: PERFIL_PRIVADO}
P --> U : mostra aviso
end
alt usuario bloqueado
S --> C : USUARIO_BLOQUEADO
C --> P : 4xx ProblemDetail {code: USUARIO_BLOQUEADO}
P --> U : mostra aviso
end
S -> P0 : publicProfile()
P0 --> S : ok
S -> P1 : follow()
P1 --> S : ok
S -> DB_MySQL : INSERT/UPDATE (@Transactional)
S ->> K : evento de domínio (outbox)
deactivate S
S --> C : DTO (record)
C --> P : 200/201 JSON
P --> U : atualiza a tela
== Abas Esquemas · Peças · Restaurantes favoritos · DNA ==
U -> P : Abas Esquemas · Peças · Restaurantes favoritos · D
P -> C : POST /api/users/{id}/follow
C -> S : follow()
S --> C : resultado
C --> P : 200 JSON
== Seguir / Mensagem / Denunciar ==
U -> P : Seguir / Mensagem / Denunciar
P -> C : DELETE /api/users/{id}/follow
C -> S : follow()
S --> C : resultado
C --> P : 200 JSON
@enduml
