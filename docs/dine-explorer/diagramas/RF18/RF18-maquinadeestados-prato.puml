@startuml RF18_MaquinaDeEstados_Prato
!pragma layout smetana
title RF18 — Possibilitar ao usuário o uso do Criador de prato virtual 2D do Dine Explorer\nDiagrama de máquina de estados — Prato — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)
skinparam backgroundColor #FFFFFF
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  ArrowColor #52606D
}
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
state "Vazio" as VAZ
state "Montando" as MON
state "Salvo no esquema" as SAL

[*] --> VAZ
VAZ --> MON : arrastar peça
MON --> MON : mover/escalar
MON --> SAL : salvar
SAL --> MON : editar
@enduml
