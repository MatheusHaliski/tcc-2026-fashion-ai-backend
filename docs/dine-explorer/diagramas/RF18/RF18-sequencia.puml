@startuml RF18_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."

title RF18 — Possibilitar ao usuário o uso do Criador de prato virtual 2D do Dine Explorer\nDiagrama de sequência — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)

actor "Pessoa usuária" as U
boundary "App (Next.js / RN)" as P
participant "API Gateway\n(Spring Cloud Gateway)" as GW
control "PlateBuilderController" as C
participant "PlateBuilderService" as S
participant "MediaStoragePort\n(S3)" as P0
database "MySQL 8.4\n(Spring Data JPA + Flyway)" as DB_MySQL
database "Amazon S3\n(AWS SDK v2)" as DB_S3
queue "Kafka" as K
== Mesa e louça (prato raso, bowl, tábua, bento) ==
U -> P : interage na tela
P -> GW : POST /api/schemes/{id}/plate\nAuthorization: Bearer JWT
GW -> GW : valida JWT (ES256) + rate limit (Redis)
GW -> C : POST /api/schemes/{id}/plate
C -> S : tableware()
activate S
S -> DB_MySQL : SELECT meal_scheme_items, meal_schemes
alt peca sem recorte
S --> C : PECA_SEM_RECORTE
C --> P : 4xx ProblemDetail {code: PECA_SEM_RECORTE}
P --> U : mostra aviso
end
S -> P0 : tableware()
P0 --> S : ok
S -> DB_MySQL : INSERT/UPDATE (@Transactional)
S -> DB_S3 : PUT/GET presigned s3://dine-media/art/{artId}.webp
S ->> K : evento de domínio (outbox)
deactivate S
S --> C : DTO (record)
C --> P : 200/201 JSON
P --> U : atualiza a tela
== Arrastar peças do inventário ==
U -> P : Arrastar peças do inventário
P -> C : POST /api/schemes/{id}/plate
C -> S : savePlate()
S --> C : resultado
C --> P : 200 JSON
@enduml
