@startuml RF19_Classes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  StereotypeFontColor #6B6470
}
hide empty members
left to right direction
title RF19 — Usar as interações de rede social culinárias (curtir, comentar, compartilhar, salvar + reações Delicioso, S…\nDiagrama de classes — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)

package "MySQL" {
  class Reaction <<reactions>> {
    +id: UUID
    +user: User
    +targetType: TargetType (PIECE/SCHEME/RESTAURANT)
    +targetId: UUID
    +kind: ReactionKind
    +createdAt: Instant
  }
  class Comment <<comments>> {
    +id: UUID
    +author: User
    +targetType: TargetType
    +targetId: UUID
    +parentId: UUID
    +body: String (≤ 1000)
    +status: CommentStatus
    +toxicityScore: decimal
    +createdAt: Instant
  }
  class SavedItem <<saved_items>> {
    +id: UUID
    +user: User
    +targetType: TargetType
    +targetId: UUID
    +collection: String
    +createdAt: Instant
  }
}
package "Cassandra" {
  class ReactionCounter <<reaction_counters_by_target>> {
    +targetId: UUID (partition)
    +kind: text (clustering)
    +count: counter
  }
  class ShareEvent <<share_events_by_target>> {
    +targetId: UUID (partition)
    +ts: TimeUUID
    +userId: UUID
    +channel: ShareChannel
  }
  class EngagementEvent <<engagement_events_by_target_day>> {
    +targetId: UUID (partition)
    +day: date (partition)
    +ts: TimeUUID
    +userId: UUID
    +event: EngagementType
    +weight: float
    +countryCode: text
    +regionCode: text
  }
  class Notification <<notifications_by_user>> {
    +userId: UUID (partition)
    +createdAt: TimeUUID (clustering DESC)
    +type: NotificationType
    +title: String
    +body: String
    +deepLink: String
    +readAt: Instant
  }
}
package "dominio (enums)" {
  enum ReactionKind {
    CURTIR
    DELICIOSO
    SABOROSO
    ENJOEI
    ECA
    SAUDAVEL
    APIMENTADO
    COMIDA_DE_VO
    QUERO_PROVAR
    VALE_O_PRECO
    GOURMET
    VICIANTE
    SEM_SAL
  }
}
package "aplicacao (casos de uso)" {
  class InteractionService <<@Service>> {
    +react()
    +unreact()
    +comment()
    +share()
    +save()
  }
  class InteractionController <<@RestController>> {
    +PUT /api/{targetType}/{id}/reactions/{kind}
    +DELETE /api/{targetType}/{id}/reactions/{kind}
    +POST /api/{targetType}/{id}/comments
    +POST /api/{targetType}/{id}/share
    +POST /api/{targetType}/{id}/save
  }
  interface ModerationPort <<port>>
  InteractionService ..> ModerationPort
  interface EventPublisherPort <<port>>
  InteractionService ..> EventPublisherPort
  interface CounterPort <<port>>
  InteractionService ..> CounterPort
  interface NotificationService <<port>>
  InteractionService ..> NotificationService
}
InteractionController --> InteractionService
InteractionService ..> Reaction : usa
InteractionService ..> ReactionCounter : usa
InteractionService ..> Comment : usa
InteractionService ..> ShareEvent : usa
InteractionService ..> SavedItem : usa
InteractionService ..> EngagementEvent : usa
InteractionService ..> Notification : usa
Reaction --> ReactionKind
@enduml
