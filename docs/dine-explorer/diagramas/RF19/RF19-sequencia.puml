@startuml RF19_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."

title RF19 — Usar as interações de rede social culinárias (curtir, comentar, compartilhar, salvar + reações Delicioso, S…\nDiagrama de sequência — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)

actor "Pessoa usuária" as U
boundary "App (Next.js / RN)" as P
participant "API Gateway\n(Spring Cloud Gateway)" as GW
control "InteractionController" as C
participant "InteractionService" as S
participant "ModerationPort\n(Spring AI classificador)" as P0
participant "EventPublisherPort\n(Kafka engagement-events)" as P1
participant "CounterPort\n(Cassandra counters)" as P2
participant "NotificationService" as P3
database "MySQL 8.4\n(Spring Data JPA + Flyway)" as DB_MySQL
database "Cassandra 5\n(Spring Data Cassandra)" as DB_Cassandra
queue "Kafka" as K
== Barra de ações do card (♥ · 💬 · ↗ · 🔖) ==
U -> P : interage na tela
P -> GW : PUT /api/{targetType}/{id}/reactions/{kind}\nAuthorization: Bearer JWT
GW -> GW : valida JWT (ES256) + rate limit (Redis)
GW -> C : PUT /api/{targetType}/{id}/reactions/{kind}
C -> S : react()
activate S
S -> DB_MySQL : SELECT reactions, comments, saved_items
alt reacao invalida
S --> C : REACAO_INVALIDA
C --> P : 4xx ProblemDetail {code: REACAO_INVALIDA}
P --> U : mostra aviso
end
alt comentario toxico
S --> C : COMENTARIO_TOXICO
C --> P : 4xx ProblemDetail {code: COMENTARIO_TOXICO}
P --> U : mostra aviso
end
S -> P0 : react()
P0 --> S : ok
S -> P1 : unreact()
P1 --> S : ok
S -> P2 : comment()
P2 --> S : ok
S -> P3 : share()
P3 --> S : ok
S -> DB_MySQL : INSERT/UPDATE (@Transactional)
S -> DB_Cassandra : INSERT reaction_counters_by_target, share_events_by_target
S ->> K : evento de domínio (outbox)
deactivate S
S --> C : DTO (record)
C --> P : 200/201 JSON
P --> U : atualiza a tela
== Seletor de reações culinárias (long-press) ==
U -> P : Seletor de reações culinárias (long-press)
P -> C : DELETE /api/{targetType}/{id}/reactions/{kind}
C -> S : unreact()
S --> C : resultado
C --> P : 200 JSON
== Folha de comentários com respostas ==
U -> P : Folha de comentários com respostas
P -> C : POST /api/{targetType}/{id}/comments
C -> S : unreact()
S --> C : resultado
C --> P : 200 JSON
@enduml
