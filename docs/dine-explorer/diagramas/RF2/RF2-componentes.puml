@startuml RF2_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF2 — Autenticar usuário na plataforma com credenciais de acesso\nDiagrama de componentes — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)

package "Frontend (Next.js 15 · React 19 · TanStack Query)" {
  component "Tela de Login (/login)" as FE
  component "lib/api (OpenAPI client gerado)" as APIC
}
package "Borda" {
  component "CloudFront + WAF" as CDN
  component "Spring Cloud Gateway\n(JWT, rate limit, CORS)" as GW
}
package "dine-web (REST · Spring Boot 4.0)" {
  component "AuthController\nPOST /api/auth/login\nPOST /api/auth/login/2fa\nPOST /api/auth/refresh\nPOST /api/auth/passkeys/assert\nPOST /api/auth/password/forgot\n(+1 rotas)" as CT
}
package "dine-application (Spring Modulith · casos de uso)" {
  component "IdentityService" as SV
  component "PasswordHasherPort\n«Argon2PasswordHasher»" as PT0 <<port>>
  component "TokenIssuerPort\n«JwtTokenIssuer (ES256)»" as PT1 <<port>>
  component "RateLimitPort\n«RedisRateLimit»" as PT2 <<port>>
  component "OidcPort\n«Spring Security OAuth2 Client»" as PT3 <<port>>
  component "EmailSenderPort\n«SesEmailSender»" as PT4 <<port>>
}
package "dine-domain (entidades + repositórios)" {
  component "UserRepository\nRefreshTokenRepository\nVerificationCodeRepository" as REPO_MySQL
  component "SessionCacheRepository" as REPO_Redis
  component "AuditEventRepository" as REPO_Cassandra
}
database "MySQL 8.4\n(Spring Data JPA + Flyway)\n• users\n• refresh_tokens\n• verification_codes" as DB_MySQL
database "Redis 7\n(Spring Data Redis)\n• session:{jti}" as DB_Redis
database "Cassandra 5\n(Spring Data Cassandra)\n• audit_events" as DB_Cassandra
cloud "Google OIDC" as EX0
cloud "Apple Sign-In" as EX1
cloud "AWS SES" as EX2
component "Observabilidade\n(Micrometer + OpenTelemetry\n→ Grafana/Tempo/Loki)" as OBS
FE --> APIC
APIC --> CDN : HTTPS/JSON
CDN --> GW
GW --> CT
CT --> SV
SV ..> OBS
SV --> PT0
SV --> PT1
SV --> PT2
SV --> PT3
SV --> PT4
SV --> REPO_MySQL
REPO_MySQL --> DB_MySQL
SV --> REPO_Redis
REPO_Redis --> DB_Redis
SV --> REPO_Cassandra
REPO_Cassandra --> DB_Cassandra
PT3 --> EX0
SV --> EX1
PT4 --> EX2
@enduml
