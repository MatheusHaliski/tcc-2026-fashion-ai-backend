title RF20 — Criar & publicar um esquema de alimentação vinculado a uma marca de alimentos cadastrada (aba "Marcas de al…\nDiagrama de classes — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)

package "MySQL" {
  class SchemeBrandLink <<scheme_brand_links>> {
    +id: UUID
    +scheme: MealScheme
    +brand: FoodBrandProfile
    +status: LinkStatus
    +requestedAt: Instant
    +decidedAt: Instant
  }
  class FoodBrandProfile <<food_brand_profiles>> {
    +id: UUID
    +owner: User
    +brandName: String
    +slug: String
    +cnpj: String
    +category: BrandCategory
    +countryCode: String
    +logoUrl: String
    +approvalStatus: ApprovalStatus
  }
  class MealScheme <<meal_schemes>> {
    +id: UUID
    +owner: User
    +title: String
    +mealType: MealType
    +occasion: Occasion
    +cuisine: Cuisine
    +servings: int
    +prepMinutes: int
    +difficulty: Difficulty
    +totalKcal: int
    +healthScore: int (0-100)
    +status: SchemeStatus
    +visibility: Visibility
    +backgroundArtId: UUID
    +restaurant: RestaurantProfile (opcional)
    +publishedAt: Instant
  }
}
package "dominio (enums)" {
  enum LinkStatus {
    SOLICITADO
    APROVADO
    RECUSADO
    REVOGADO
  }
}
package "aplicacao (casos de uso)" {
  class BrandLinkService <<@Service>> {
    +request()
    +decide()
  }
  class BrandLinkController <<@RestController>> {
    +POST /api/schemes/{id}/brand-links
    +PATCH /api/brand-links/{id}
  }
  interface NotificationService <<port>>
  BrandLinkService ..> NotificationService
}
BrandLinkController --> BrandLinkService
BrandLinkService ..> SchemeBrandLink : usa
BrandLinkService ..> FoodBrandProfile : usa
BrandLinkService ..> MealScheme : usa
SchemeBrandLink "*" --> "1" MealScheme : scheme
SchemeBrandLink "*" --> "1" FoodBrandProfile : brand
SchemeBrandLink --> LinkStatus
@enduml
