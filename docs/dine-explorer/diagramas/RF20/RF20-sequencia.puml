@startuml RF20_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."

title RF20 — Criar & publicar um esquema de alimentação vinculado a uma marca de alimentos cadastrada (aba "Marcas de al…\nDiagrama de sequência — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)

actor "Pessoa usuária" as U
boundary "App (Next.js / RN)" as P
participant "API Gateway\n(Spring Cloud Gateway)" as GW
control "BrandLinkController" as C
participant "BrandLinkService" as S
participant "NotificationService" as P0
database "MySQL 8.4\n(Spring Data JPA + Flyway)" as DB_MySQL
queue "Kafka" as K
== Buscar marca e produto ==
U -> P : interage na tela
P -> GW : POST /api/schemes/{id}/brand-links\nAuthorization: Bearer JWT
GW -> GW : valida JWT (ES256) + rate limit (Redis)
GW -> C : POST /api/schemes/{id}/brand-links
C -> S : request()
activate S
S -> DB_MySQL : SELECT scheme_brand_links, food_brand_profiles, meal_schemes
alt marca nao aprovada
S --> C : MARCA_NAO_APROVADA
C --> P : 4xx ProblemDetail {code: MARCA_NAO_APROVADA}
P --> U : mostra aviso
end
S -> P0 : request()
P0 --> S : ok
S -> DB_MySQL : INSERT/UPDATE (@Transactional)
S ->> K : evento de domínio (outbox)
deactivate S
S --> C : DTO (record)
C --> P : 200/201 JSON
P --> U : atualiza a tela
== Pedido de vínculo ==
U -> P : Pedido de vínculo
P -> C : PATCH /api/brand-links/{id}
C -> S : decide()
S --> C : resultado
C --> P : 200 JSON
@enduml
