@startuml RF22_Classes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  StereotypeFontColor #6B6470
}
hide empty members
left to right direction
title RF22 — Criar um esquema de alimentação através do BioDine™ Snapshot — Sensor IoT de Captura Fotográfica do Prato\nDiagrama de classes — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)

package "MySQL" {
  class PlateSnapshot <<plate_snapshots>> {
    +id: UUID
    +device: BioDineDevice
    +imageKey: String
    +detectedPieces: JSON
    +confidence: decimal
    +status: SnapshotStatus
    +schemeId: UUID
    +capturedAt: Instant
  }
  class MealScheme <<meal_schemes>> {
    +id: UUID
    +owner: User
    +title: String
    +mealType: MealType
    +occasion: Occasion
    +cuisine: Cuisine
    +servings: int
    +prepMinutes: int
    +difficulty: Difficulty
    +totalKcal: int
    +healthScore: int (0-100)
    +status: SchemeStatus
    +visibility: Visibility
    +backgroundArtId: UUID
    +restaurant: RestaurantProfile (opcional)
    +publishedAt: Instant
  }
}
package "S3" {
  class PlateSnapshotImage <<s3://dine-iot/snapshots/{deviceId}/{id}.jpg>> {
    +key: String
    +width: int
    +height: int
    +exif: removido
  }
}
package "Cassandra" {
  class BioDineReading <<biodine_readings_by_device_day>> {
    +deviceId: UUID (partition)
    +day: date (partition)
    +ts: TimeUUID
    +weightG: int
    +temperatureC: decimal
    +humidity: decimal
    +kcalEstimated: int
  }
}
package "dominio (enums)" {
  enum SnapshotStatus {
    CAPTURADO
    DETECTANDO
    PARA_REVISAO
    CONFIRMADO
    DESCARTADO
  }
}
package "aplicacao (casos de uso)" {
  class SnapshotService <<@Service>> {
    +ingest()
    +detect()
    +confirm()
  }
  class SnapshotController <<@RestController>> {
    +POST /api/iot/snapshots
    +GET /api/snapshots/{id}
    +POST /api/snapshots/{id}/confirm
  }
  interface FoodVisionPort <<port>>
  SnapshotService ..> FoodVisionPort
  interface MediaStoragePort <<port>>
  SnapshotService ..> MediaStoragePort
  interface IotPort <<port>>
  SnapshotService ..> IotPort
}
SnapshotController --> SnapshotService
SnapshotService ..> PlateSnapshot : usa
SnapshotService ..> PlateSnapshotImage : usa
SnapshotService ..> BioDineReading : usa
SnapshotService ..> MealScheme : usa
PlateSnapshot --> SnapshotStatus
@enduml
