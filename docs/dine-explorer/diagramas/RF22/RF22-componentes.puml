@startuml RF22_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF22 — Criar um esquema de alimentação através do BioDine™ Snapshot — Sensor IoT de Captura Fotográfica do Prato\nDiagrama de componentes — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)

package "Frontend (Next.js 15 · React 19 · TanStack Query)" {
  component "BioDine™ Snapshot" as FE
  component "lib/api (OpenAPI client gerado)" as APIC
}
package "Borda" {
  component "CloudFront + WAF" as CDN
  component "Spring Cloud Gateway\n(JWT, rate limit, CORS)" as GW
}
package "dine-web (REST · Spring Boot 4.0)" {
  component "SnapshotController\nPOST /api/iot/snapshots\nGET /api/snapshots/{id}\nPOST /api/snapshots/{id}/confirm" as CT
}
package "dine-application (Spring Modulith · casos de uso)" {
  component "SnapshotService" as SV
  component "FoodVisionPort\n«Spring AI visão»" as PT0 <<port>>
  component "MediaStoragePort\n«S3»" as PT1 <<port>>
  component "IotPort\n«AWS IoT Core»" as PT2 <<port>>
}
package "dine-domain (entidades + repositórios)" {
  component "PlateSnapshotRepository\nMealSchemeRepository" as REPO_MySQL
  component "BioDineReadingRepository" as REPO_Cassandra
}
database "MySQL 8.4\n(Spring Data JPA + Flyway)\n• plate_snapshots\n• meal_schemes" as DB_MySQL
database "Amazon S3\n(AWS SDK v2)\n• s3://dine-iot/snapshots/{deviceId}/{id}.jpg" as DB_S3
database "Cassandra 5\n(Spring Data Cassandra)\n• biodine_readings_by_device_day" as DB_Cassandra
cloud "AWS IoT Core" as EX0
cloud "Modelo de visão" as EX1
component "Observabilidade\n(Micrometer + OpenTelemetry\n→ Grafana/Tempo/Loki)" as OBS
FE --> APIC
APIC --> CDN : HTTPS/JSON
CDN --> GW
GW --> CT
CT --> SV
SV ..> OBS
SV --> PT0
SV --> PT1
SV --> PT2
SV --> REPO_MySQL
REPO_MySQL --> DB_MySQL
SV --> REPO_Cassandra
REPO_Cassandra --> DB_Cassandra
PT1 --> DB_S3
PT2 --> EX0
SV --> EX1
@enduml
