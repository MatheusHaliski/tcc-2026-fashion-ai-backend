@startuml RF22_MaquinaDeEstados_Snapshot
!pragma layout smetana
title RF22 — Criar um esquema de alimentação através do BioDine™ Snapshot — Sensor IoT de Captura Fotográfica do Prato\nDiagrama de máquina de estados — Snapshot — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)
skinparam backgroundColor #FFFFFF
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  ArrowColor #52606D
}
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
state "Capturado" as CAP
state "Detectando" as DET
state "Para revisão" as REV
state "Confirmado" as CON
state "Descartado" as DES

[*] --> CAP
CAP --> DET
DET --> REV
REV --> CON : usuário confirma
REV --> DES : descartar
CAP --> DES : TTL 24h
@enduml
