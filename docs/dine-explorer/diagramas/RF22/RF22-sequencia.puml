@startuml RF22_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."

title RF22 — Criar um esquema de alimentação através do BioDine™ Snapshot — Sensor IoT de Captura Fotográfica do Prato\nDiagrama de sequência — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)

actor "Pessoa usuária" as U
boundary "App (Next.js / RN)" as P
participant "API Gateway\n(Spring Cloud Gateway)" as GW
control "SnapshotController" as C
participant "SnapshotService" as S
participant "FoodVisionPort\n(Spring AI visão)" as P0
participant "MediaStoragePort\n(S3)" as P1
participant "IotPort\n(AWS IoT Core)" as P2
database "MySQL 8.4\n(Spring Data JPA + Flyway)" as DB_MySQL
database "Amazon S3\n(AWS SDK v2)" as DB_S3
database "Cassandra 5\n(Spring Data Cassandra)" as DB_Cassandra
queue "Kafka" as K
== Notificação 'Prato capturado' ==
U -> P : interage na tela
P -> GW : POST /api/iot/snapshots (device)\nAuthorization: Bearer JWT
GW -> GW : valida JWT (ES256) + rate limit (Redis)
GW -> C : POST /api/iot/snapshots (device)
C -> S : ingest()
activate S
S -> DB_MySQL : SELECT plate_snapshots, meal_schemes
alt imagem ilegivel
S --> C : IMAGEM_ILEGIVEL
C --> P : 4xx ProblemDetail {code: IMAGEM_ILEGIVEL}
P --> U : mostra aviso
end
S -> P0 : ingest()
P0 --> S : ok
S -> P1 : detect()
P1 --> S : ok
S -> P2 : confirm()
P2 --> S : ok
S -> DB_MySQL : INSERT/UPDATE (@Transactional)
S -> DB_Cassandra : INSERT biodine_readings_by_device_day
S -> DB_S3 : PUT/GET presigned s3://dine-iot/snapshots/{deviceId}/{id}.jpg
S ->> K : evento de domínio (outbox)
deactivate S
S --> C : DTO (record)
C --> P : 200/201 JSON
P --> U : atualiza a tela
== Revisão das peças detectadas ==
U -> P : Revisão das peças detectadas
P -> C : GET /api/snapshots/{id}
C -> S : detect()
S --> C : resultado
C --> P : 200 JSON
== Confirmar → esquema (RF5) ==
U -> P : Confirmar → esquema (RF5)
P -> C : POST /api/snapshots/{id}/confirm
C -> S : detect()
S --> C : resultado
C --> P : 200 JSON
@enduml
