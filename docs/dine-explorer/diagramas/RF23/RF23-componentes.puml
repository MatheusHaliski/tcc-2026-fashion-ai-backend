@startuml RF23_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF23 — Criar as telas de configuração do usuário (Conta, Privacidade/LGPD, Aparência, Idioma, Seus dados) no padrã…\nDiagrama de componentes — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)

package "Frontend (Next.js 15 · React 19 · TanStack Query)" {
  component "Configurações (/settings)" as FE
  component "lib/api (OpenAPI client gerado)" as APIC
}
package "Borda" {
  component "CloudFront + WAF" as CDN
  component "Spring Cloud Gateway\n(JWT, rate limit, CORS)" as GW
}
package "dine-web (REST · Spring Boot 4.0)" {
  component "PreferencesController\nGET /api/me/preferences\nPUT /api/me/preferences\nGET /api/me/consents\nPUT /api/me/privacy\nGET /api/me/exports\n(+1 rotas)" as CT
}
package "dine-application (Spring Modulith · casos de uso)" {
  component "PreferencesService" as SV
  component "CachePort\n«Redis»" as PT0 <<port>>
  component "MediaStoragePort\n«S3»" as PT1 <<port>>
  component "I18nPort\n«MessageSource + ICU4J»" as PT2 <<port>>
}
package "dine-domain (entidades + repositórios)" {
  component "UserPreferencesRepository\nUserRepository\nUserConsentRepository\nDataExportRequestRepository" as REPO_MySQL
  component "AuditEventRepository" as REPO_Cassandra
}
database "MySQL 8.4\n(Spring Data JPA + Flyway)\n• user_preferences\n• users\n• user_consents\n• data_export_requests" as DB_MySQL
database "Amazon S3\n(AWS SDK v2)\n• s3://dine-lgpd-exports/{userId}/{id}.zip" as DB_S3
database "Cassandra 5\n(Spring Data Cassandra)\n• audit_events" as DB_Cassandra
cloud "AWS S3" as EX0
component "Observabilidade\n(Micrometer + OpenTelemetry\n→ Grafana/Tempo/Loki)" as OBS
FE --> APIC
APIC --> CDN : HTTPS/JSON
CDN --> GW
GW --> CT
CT --> SV
SV ..> OBS
SV --> PT0
SV --> PT1
SV --> PT2
SV --> REPO_MySQL
REPO_MySQL --> DB_MySQL
SV --> REPO_Cassandra
REPO_Cassandra --> DB_Cassandra
PT1 --> DB_S3
SV --> EX0
@enduml
