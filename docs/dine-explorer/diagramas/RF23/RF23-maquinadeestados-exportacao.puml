@startuml RF23_MaquinaDeEstados_Exportacao
!pragma layout smetana
title RF23 — Criar as telas de configuração do usuário (Conta, Privacidade/LGPD, Aparência, Idioma, Seus dados) no padrã…\nDiagrama de máquina de estados — Exportacao — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)
skinparam backgroundColor #FFFFFF
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  ArrowColor #52606D
}
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
state "Solicitada" as SOL
state "Processando" as PRO
state "Pronta\n(link 24h)" as PRT
state "Baixada" as BAI
state "Expirada" as EXP
state "Falhou" as FAL

[*] --> SOL : POST /api/me/exports
SOL --> PRO : worker
PRO --> PRT : ZIP no S3 + e-mail
PRO --> FAL : erro
FAL --> SOL : tentar de novo
PRT --> BAI : download
PRT --> EXP : 7 dias
BAI --> EXP : 7 dias
EXP --> [*]
note right of SOL
  Prazo legal de resposta: 15 dias (art. 19, II).
  O sistema entrega em minutos.
end note
@enduml
