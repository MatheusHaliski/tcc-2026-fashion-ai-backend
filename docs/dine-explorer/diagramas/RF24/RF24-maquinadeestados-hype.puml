@startuml RF24_MaquinaDeEstados_Hype
!pragma layout smetana
title RF24 — Calcular e exibir as métricas da rede social (DineHype Score, engajamento, sentimento culinário e rankings)\nDiagrama de máquina de estados — Hype — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)
skinparam backgroundColor #FFFFFF
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  ArrowColor #52606D
}
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
state "Frio (< 20)" as FRI
state "Morno (20–49)" as MOR
state "Quente (50–79)" as QUE
state "Viral (≥ 80)" as VIR

[*] --> FRI : publicado
FRI --> MOR : engajamento ↑
MOR --> QUE : engajamento ↑
QUE --> VIR : engajamento ↑\n+ entra no Top
VIR --> QUE : decaimento 48h
QUE --> MOR : decaimento
MOR --> FRI : decaimento
note right of FRI
  hype = Σ peso(evento)·e^(−λ·Δt) normalizado 0–100;
  reações negativas reduzem o sentimento,
  não o alcance. Antifraude: 1 voto/usuário/alvo/tipo.
end note
@enduml
