@startuml RF24_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."

title RF24 — Calcular e exibir as métricas da rede social (DineHype Score, engajamento, sentimento culinário e rankings)\nDiagrama de sequência — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)

actor "Pessoa usuária" as U
boundary "App (Next.js / RN)" as P
participant "API Gateway\n(Spring Cloud Gateway)" as GW
control "MetricsController" as C
participant "MetricsService" as S
participant "EventStreamPort\n(Kafka Streams)" as P0
participant "CounterPort\n(Cassandra)" as P1
participant "RankingPort\n(Redis ZSET)" as P2
participant "SearchIndexPort\n(OpenSearch (atualiza hype))" as P3
database "Cassandra 5\n(Spring Data Cassandra)" as DB_Cassandra
database "MySQL 8.4\n(Spring Data JPA + Flyway)" as DB_MySQL
database "Redis 7\n(Spring Data Redis)" as DB_Redis
queue "Kafka" as K
== Insights do meu perfil (gráficos 7/30/90 dias) ==
U -> P : interage na tela
P -> GW : GET /api/metrics/{targetType}/{id}?period=\nAuthorization: Bearer JWT
GW -> GW : valida JWT (ES256) + rate limit (Redis)
GW -> C : GET /api/metrics/{targetType}/{id}?period=
C -> S : ingest()
activate S
S -> DB_Redis : GET cache / lock
S -> DB_MySQL : SELECT metric_snapshots, dine_hype_scores
alt periodo invalido
S --> C : PERIODO_INVALIDO
C --> P : 4xx ProblemDetail {code: PERIODO_INVALIDO}
P --> U : mostra aviso
end
alt metrica privada
S --> C : METRICA_PRIVADA
C --> P : 4xx ProblemDetail {code: METRICA_PRIVADA}
P --> U : mostra aviso
end
S -> P0 : ingest()
P0 --> S : ok
S -> P1 : aggregate()
P1 --> S : ok
S -> P2 : computeHype()
P2 --> S : ok
S -> P3 : rankings()
P3 --> S : ok
S -> DB_MySQL : INSERT/UPDATE (@Transactional)
S -> DB_Cassandra : INSERT engagement_events_by_target_day, reaction_counters_by_target
S -> DB_Redis : SET/ZADD (invalida cache)
S ->> K : evento de domínio (outbox)
deactivate S
S --> C : DTO (record)
C --> P : 200/201 JSON
P --> U : atualiza a tela
== Painel do restaurante (alcance, sentimento, conversão em pedidos) ==
U -> P : Painel do restaurante (alcance, sentimento, conver
P -> C : GET /api/rankings?scope=WORLD|REGION&region=
C -> S : aggregate()
S --> C : resultado
C --> P : 200 JSON
== Distribuição das reações culinárias ==
U -> P : Distribuição das reações culinárias
P -> C : GET /api/me/insights
C -> S : aggregate()
S --> C : resultado
C --> P : 200 JSON
@enduml
