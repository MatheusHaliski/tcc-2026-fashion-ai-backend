@startuml RF25_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."

title RF25 — Definir e aplicar as diretrizes dos esquemas: Esquema de Alimentação, Esquema de Peça de Alimento e Esquema…\nDiagrama de sequência — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)

actor "Pessoa usuária" as U
boundary "App (Next.js / RN)" as P
participant "API Gateway\n(Spring Cloud Gateway)" as GW
control "GuidelineController" as C
participant "GuidelineService" as S
participant "RuleEnginePort\n(SpEL + Jakarta Validation)" as P0
participant "CachePort\n(Redis (diretriz vigente))" as P1
database "MySQL 8.4\n(Spring Data JPA + Flyway)" as DB_MySQL
queue "Kafka" as K
== Painel de diretrizes (admin): versões, regras, severidade ==
U -> P : interage na tela
P -> GW : POST /api/guidelines/{kind}/validate\nAuthorization: Bearer JWT
GW -> GW : valida JWT (ES256) + rate limit (Redis)
GW -> C : POST /api/guidelines/{kind}/validate
C -> S : current()
activate S
S -> DB_MySQL : SELECT scheme_guidelines, guideline_rules, scheme_validation_reports
alt viola diretriz
S --> C : VIOLA_DIRETRIZ
C --> P : 4xx ProblemDetail {code: VIOLA_DIRETRIZ}
P --> U : mostra aviso
end
alt versao inexistente
S --> C : VERSAO_INEXISTENTE
C --> P : 4xx ProblemDetail {code: VERSAO_INEXISTENTE}
P --> U : mostra aviso
end
S -> P0 : current()
P0 --> S : ok
S -> P1 : validate()
P1 --> S : ok
S -> DB_MySQL : INSERT/UPDATE (@Transactional)
S ->> K : evento de domínio (outbox)
deactivate S
S --> C : DTO (record)
C --> P : 200/201 JSON
P --> U : atualiza a tela
== Validação inline nos formulários (RF4, RF5, RF26) ==
U -> P : Validação inline nos formulários (RF4, RF5, RF26)
P -> C : POST /api/guidelines/{kind}/validate
C -> S : validate()
S --> C : resultado
C --> P : 200 JSON
== Relatório de violações antes de publicar ==
U -> P : Relatório de violações antes de publicar
P -> C : POST /api/admin/guidelines
C -> S : validate()
S --> C : resultado
C --> P : 200 JSON
@enduml
