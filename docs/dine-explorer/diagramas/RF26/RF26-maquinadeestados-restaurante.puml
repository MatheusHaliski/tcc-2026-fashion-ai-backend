@startuml RF26_MaquinaDeEstados_Restaurante
!pragma layout smetana
title RF26 — Criar & gerenciar o Esquema de Restaurante (card do restaurante, cardápio, pratos assinatura e horários)\nDiagrama de máquina de estados — Restaurante — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)
skinparam backgroundColor #FFFFFF
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  ArrowColor #52606D
}
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
state "Rascunho" as RAS
state "Publicado (aberto)" as PUB
state "Fechado agora" as FEC
state "Pausado" as PAU
state "Encerrado" as ENC

[*] --> RAS
RAS --> PUB : publicar [diretriz ok]
PUB --> FEC : fora do horário
FEC --> PUB : abriu
PUB --> PAU : pausar pedidos
PAU --> PUB : retomar
PUB --> ENC : encerrar atividades
@enduml
