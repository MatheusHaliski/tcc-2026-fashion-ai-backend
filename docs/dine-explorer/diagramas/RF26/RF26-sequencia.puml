@startuml RF26_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."

title RF26 — Criar & gerenciar o Esquema de Restaurante (card do restaurante, cardápio, pratos assinatura e horários)\nDiagrama de sequência — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)

actor "Pessoa usuária" as U
boundary "App (Next.js / RN)" as P
participant "API Gateway\n(Spring Cloud Gateway)" as GW
control "RestaurantController" as C
participant "RestaurantService" as S
participant "GuidelinePort (RF25)" as P0
participant "SearchIndexPort\n(OpenSearch idx_restaurants)" as P1
participant "MediaStoragePort\n(S3)" as P2
database "MySQL 8.4\n(Spring Data JPA + Flyway)" as DB_MySQL
database "OpenSearch 2\n(opensearch-java)" as DB_OpenSearch
queue "Kafka" as K
== Card do restaurante (capa, selo, faixa de preço, cozinhas) ==
U -> P : interage na tela
P -> GW : PUT /api/restaurants/{id}/scheme\nAuthorization: Bearer JWT
GW -> GW : valida JWT (ES256) + rate limit (Redis)
GW -> C : PUT /api/restaurants/{id}/scheme
C -> S : upsertScheme()
activate S
S -> DB_MySQL : SELECT restaurant_schemes, restaurant_profiles, menu_items
alt restaurante nao aprovado
S --> C : RESTAURANTE_NAO_APROVADO
C --> P : 4xx ProblemDetail {code: RESTAURANTE_NAO_APROVADO}
P --> U : mostra aviso
end
alt viola diretriz
S --> C : VIOLA_DIRETRIZ
C --> P : 4xx ProblemDetail {code: VIOLA_DIRETRIZ}
P --> U : mostra aviso
end
S -> P0 : upsertScheme()
P0 --> S : ok
S -> P1 : addMenuItem()
P1 --> S : ok
S -> P2 : updateMenuItem()
P2 --> S : ok
S -> DB_MySQL : INSERT/UPDATE (@Transactional)
S -> DB_OpenSearch : index/search idx_restaurants
S ->> K : evento de domínio (outbox)
deactivate S
S --> C : DTO (record)
C --> P : 200/201 JSON
P --> U : atualiza a tela
== Cardápio por seções com preços e disponibilidade ==
U -> P : Cardápio por seções com preços e disponibilidade
P -> C : POST /api/restaurants/{id}/menu-items
C -> S : addMenuItem()
S --> C : resultado
C --> P : 200 JSON
== Pratos assinatura ==
U -> P : Pratos assinatura
P -> C : PATCH /api/menu-items/{id}
C -> S : addMenuItem()
S --> C : resultado
C --> P : 200 JSON
@enduml
