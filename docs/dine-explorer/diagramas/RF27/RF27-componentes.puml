@startuml RF27_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF27 — Acessar a aba "Explorador": globo 3D animado com comidas de cada região do mundo, mapas de calor e rankings\nDiagrama de componentes — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)

package "Frontend (Next.js 15 · React 19 · TanStack Query)" {
  component "Explorador (/explore) — Globo" as FE
  component "GlobeView\n(React Three Fiber + three-globe\n+ deck.gl H3HexagonLayer + Lottie/Rive)" as FE3D
  component "lib/api (OpenAPI client gerado)" as APIC
}
package "Borda" {
  component "CloudFront + WAF" as CDN
  component "Spring Cloud Gateway\n(JWT, rate limit, CORS)" as GW
}
package "dine-web (REST · Spring Boot 4.0)" {
  component "ExplorerController\nGET /api/explorer/layers\nGET /api/explorer/layers/{code}?bbox=&zoom=\nGET /api/explorer/dishes?region=\nGET /api/rankings?scope=REGION&region=&limit=20\nGET /api/rankings?scope=WORLD&limit=10" as CT
}
package "dine-application (Spring Modulith · casos de uso)" {
  component "ExplorerService" as SV
  component "GeoAggregationPort\n«OpenSearch geohex_grid»" as PT0 <<port>>
  component "RankingPort\n«Redis ZSET»" as PT1 <<port>>
  component "TileStoragePort\n«S3 + CloudFront»" as PT2 <<port>>
  component "OpenDataPort\n«OMS GHO API»" as PT3 <<port>>
}
package "dine-domain (entidades + repositórios)" {
  component "GlobeLayerRepository\nRegionalDishRepository\nHealthIndicatorRepository" as REPO_MySQL
  component "GlobeLayerCacheRepository\nHypeRankingRepository" as REPO_Redis
  component "RestaurantDocRepository" as REPO_OpenSearch
}
database "MySQL 8.4\n(Spring Data JPA + Flyway)\n• globe_layers\n• regional_dishes\n• health_indicators" as DB_MySQL
database "Amazon S3\n(AWS SDK v2)\n• s3://dine-globe/{layer}/{version}/h3-{res}.pbf\n• s3://dine-globe/illustrations/{dishId}.lottie" as DB_S3
database "Redis 7\n(Spring Data Redis)\n• globe:{layer}:{bbox}:{zoom}\n• rank:{scope}:{region}:{period}" as DB_Redis
database "OpenSearch 2\n(opensearch-java)\n• idx_restaurants" as DB_OpenSearch
cloud "OMS Global Health Observatory" as EX0
cloud "CloudFront CDN" as EX1
cloud "Mapbox/Natural Earth" as EX2
component "Observabilidade\n(Micrometer + OpenTelemetry\n→ Grafana/Tempo/Loki)" as OBS
FE --> APIC
FE --> FE3D
FE3D --> CDN : tiles H3 / Lottie
APIC --> CDN : HTTPS/JSON
CDN --> GW
GW --> CT
CT --> SV
SV ..> OBS
SV --> PT0
SV --> PT1
SV --> PT2
SV --> PT3
SV --> REPO_MySQL
REPO_MySQL --> DB_MySQL
SV --> REPO_Redis
REPO_Redis --> DB_Redis
SV --> REPO_OpenSearch
REPO_OpenSearch --> DB_OpenSearch
PT2 --> DB_S3
PT3 --> EX0
PT2 --> EX1
SV --> EX2
@enduml
