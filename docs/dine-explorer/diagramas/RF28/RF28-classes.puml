left to right direction
title RF28 — Visualizar a sub-aba "Restaurantes do Mundo" do Explorador, com filtros na top bar (como a sub-aba Marcas),…\nDiagrama de classes — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)

package "OpenSearch" {
  class RestaurantDoc <<idx_restaurants>> {
    +id: keyword
    +name: text
    +cuisines: keyword[]
    +priceLevel: integer
    +location: geo_point
    +countryCode: keyword
    +regionCode: keyword
    +city: keyword
    +rating: float
    +hype: float
    +avgTicketUsd: float
    +dietOptions: keyword[]
    +openNow: boolean
  }
}
package "MySQL" {
  class RestaurantProfile <<restaurant_profiles>> {
    +id: UUID
    +owner: User
    +tradeName: String
    +slug: String
    +cnpj: String
    +razaoSocial: String
    +cuisineTypes: Set<Cuisine>
    +priceLevel: int (1-4)
    +latitude: double
    +longitude: double
    +address: Address
    +countryCode: String
    +regionCode: String
    +openingHours: JSON
    +approvalStatus: ApprovalStatus
    +logoUrl: String
    +coverUrl: String
    +deliveryEnabled: boolean
    +reservationEnabled: boolean
  }
  class RestaurantScheme <<restaurant_schemes>> {
    +id: UUID
    +restaurant: RestaurantProfile
    +headline: String
    +signatureDishes: List<FoodPiece>
    +ambience: Set<Ambience>
    +priceLevel: int
    +avgTicket: Money
    +dietOptions: Set<Diet>
    +status: SchemeStatus
    +backgroundArtId: UUID
    +publishedAt: Instant
  }
  class DineHypeScore <<dine_hype_scores>> {
    +id: UUID
    +targetType: TargetType
    +targetId: UUID
    +score: decimal
    +algorithmVersion: String
    +computedAt: Instant
    +regionCode: String
    +countryCode: String
  }
}
package "dominio (enums)" {
  enum RestaurantSort {
    POPULARIDADE
    AVALIACAO
    PRECO_ASC
    PRECO_DESC
    DISTANCIA
    NOVOS
  }
}
package "aplicacao (casos de uso)" {
  class RestaurantExplorerService <<@Service>> {
    +search()
    +facets()
    +importOpenData()
  }
  class RestaurantExplorerController <<@RestController>> {
    +GET /api/explorer/restaurants?continent=&country=&city=&cuisine=&price=&diet=&openNow=&sort=&after=
    +GET /api/explorer/restaurants/facets
  }
  interface SearchIndexPort <<port>>
  RestaurantExplorerService ..> SearchIndexPort
  interface CachePort <<port>>
  RestaurantExplorerService ..> CachePort
  interface PlacesImportPort <<port>>
  RestaurantExplorerService ..> PlacesImportPort
}
RestaurantExplorerController --> RestaurantExplorerService
RestaurantExplorerService ..> RestaurantDoc : usa
RestaurantExplorerService ..> RestaurantProfile : usa
RestaurantExplorerService ..> RestaurantScheme : usa
RestaurantExplorerService ..> DineHypeScore : usa
RestaurantScheme "*" --> "1" RestaurantProfile : restaurant
@enduml
