@startuml RF28_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."

title RF28 — Visualizar a sub-aba "Restaurantes do Mundo" do Explorador, com filtros na top bar (como a sub-aba Marcas),…\nDiagrama de sequência — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)

actor "Pessoa usuária" as U
boundary "App (Next.js / RN)" as P
participant "API Gateway\n(Spring Cloud Gateway)" as GW
control "RestaurantExplorerController" as C
participant "RestaurantExplorerService" as S
participant "SearchIndexPort\n(OpenSearch (geo_distance, aggs, search_after))" as P0
participant "CachePort\n(Redis facets)" as P1
participant "PlacesImportPort\n(Overture/OSM batch)" as P2
database "OpenSearch 2\n(opensearch-java)" as DB_OpenSearch
database "MySQL 8.4\n(Spring Data JPA + Flyway)" as DB_MySQL
queue "Kafka" as K
== Top bar de filtros (chips + dropdowns, contagem por facet) ==
U -> P : interage na tela
P -> GW : GET /api/explorer/restaurants?continent=&country=&city=&cuisine=&price=&diet=&openNow=&sort=&after=\nAuthorization: Bearer JWT
GW -> GW : valida JWT (ES256) + rate limit (Redis)
GW -> C : GET /api/explorer/restaurants?continent=&country=&city=&cuisine=&price=&diet=&openNow=&sort=&after=
C -> S : search()
activate S
S -> DB_MySQL : SELECT restaurant_profiles, restaurant_schemes, dine_hype_scores
alt filtro invalido
S --> C : FILTRO_INVALIDO
C --> P : 4xx ProblemDetail {code: FILTRO_INVALIDO}
P --> U : mostra aviso
end
alt cursor expirado
S --> C : CURSOR_EXPIRADO
C --> P : 4xx ProblemDetail {code: CURSOR_EXPIRADO}
P --> U : mostra aviso
end
S -> P0 : search()
P0 --> S : ok
S -> P1 : facets()
P1 --> S : ok
S -> P2 : importOpenData()
P2 --> S : ok
S -> DB_MySQL : INSERT/UPDATE (@Transactional)
S -> DB_OpenSearch : index/search idx_restaurants
S ->> K : evento de domínio (outbox)
deactivate S
S --> C : DTO (record)
C --> P : 200/201 JSON
P --> U : atualiza a tela
== Alternar Grade · Mapa · Lista ==
U -> P : Alternar Grade · Mapa · Lista
P -> C : GET /api/explorer/restaurants/facets
C -> S : facets()
S --> C : resultado
C --> P : 200 JSON
@enduml
