@startuml RF29_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."

title RF29 — Realizar pedidos (delivery/retirada) e reservas de mesa nos restaurantes — varejo culinário\nDiagrama de sequência — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)

actor "Pessoa usuária" as U
boundary "App (Next.js / RN)" as P
participant "API Gateway\n(Spring Cloud Gateway)" as GW
control "OrderController" as C
participant "OrderService" as S
participant "PaymentPort\n(Gateway (Stripe/Pagar.me) tokenizado)" as P0
participant "CartPort\n(Redis)" as P1
participant "EventPublisherPort\n(Kafka)" as P2
participant "NotificationService" as P3
database "Redis 7\n(Spring Data Redis)" as DB_Redis
database "MySQL 8.4\n(Spring Data JPA + Flyway)" as DB_MySQL
database "Cassandra 5\n(Spring Data Cassandra)" as DB_Cassandra
queue "Kafka" as K
== Cardápio do restaurante com 'Adicionar' ==
U -> P : interage na tela
P -> GW : PUT /api/cart/items\nAuthorization: Bearer JWT
GW -> GW : valida JWT (ES256) + rate limit (Redis)
GW -> C : PUT /api/cart/items
C -> S : addToCart()
activate S
S -> DB_Redis : GET cache / lock
S -> DB_MySQL : SELECT orders, order_items, reservations
alt restaurante fechado
S --> C : RESTAURANTE_FECHADO
C --> P : 4xx ProblemDetail {code: RESTAURANTE_FECHADO}
P --> U : mostra aviso
end
alt item indisponivel
S --> C : ITEM_INDISPONIVEL
C --> P : 4xx ProblemDetail {code: ITEM_INDISPONIVEL}
P --> U : mostra aviso
end
S -> P0 : addToCart()
P0 --> S : ok
S -> P1 : checkout()
P1 --> S : ok
S -> P2 : track()
P2 --> S : ok
S -> P3 : reserve()
P3 --> S : ok
S -> DB_MySQL : INSERT/UPDATE (@Transactional)
S -> DB_Cassandra : INSERT order_tracking_by_order
S -> DB_Redis : SET/ZADD (invalida cache)
S ->> K : evento de domínio (outbox)
deactivate S
S --> C : DTO (record)
C --> P : 200/201 JSON
P --> U : atualiza a tela
== Carrinho ==
U -> P : Carrinho
P -> C : POST /api/orders
C -> S : checkout()
S --> C : resultado
C --> P : 200 JSON
== Checkout (endereço, pagamento Pix/cartão, cupom) ==
U -> P : Checkout (endereço, pagamento Pix/cartão, cupom)
P -> C : GET /api/orders/{id}/stream (SSE)
C -> S : checkout()
S --> C : resultado
C --> P : 200 JSON
@enduml
