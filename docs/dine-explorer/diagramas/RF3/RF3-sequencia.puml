@startuml RF3_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."

title RF3 — Gerenciar a conta: dados pessoais, sessão, segurança, privacidade (LGPD) e notificações\nDiagrama de sequência — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)

actor "Pessoa usuária" as U
boundary "App (Next.js / RN)" as P
participant "API Gateway\n(Spring Cloud Gateway)" as GW
control "MeController" as C
participant "AccountService" as S
participant "MediaStoragePort\n(S3MediaStorageAdapter)" as P0
participant "EmailSenderPort\n(SesEmailSender)" as P1
participant "PushPort\n(FirebaseCloudMessaging)" as P2
participant "EventPublisherPort\n(Kafka (Spring Cloud Stream))" as P3
database "MySQL 8.4\n(Spring Data JPA + Flyway)" as DB_MySQL
database "Redis 7\n(Spring Data Redis)" as DB_Redis
database "Amazon S3\n(AWS SDK v2)" as DB_S3
database "Cassandra 5\n(Spring Data Cassandra)" as DB_Cassandra
queue "Kafka" as K
== Dados pessoais (nome, @username, foto, capa, bio, cidade, dieta, alergias) ==
U -> P : interage na tela
P -> GW : PATCH /api/me/profile\nAuthorization: Bearer JWT
GW -> GW : valida JWT (ES256) + rate limit (Redis)
GW -> C : PATCH /api/me/profile
C -> S : updateProfile()
activate S
S -> DB_Redis : GET cache / lock
S -> DB_MySQL : SELECT users, user_preferences, refresh_tokens
alt reautenticacao necessaria
S --> C : REAUTENTICACAO_NECESSARIA
C --> P : 4xx ProblemDetail {code: REAUTENTICACAO_NECESSARIA}
P --> U : mostra aviso
end
alt email em uso
S --> C : EMAIL_EM_USO
C --> P : 4xx ProblemDetail {code: EMAIL_EM_USO}
P --> U : mostra aviso
end
S -> P0 : updateProfile()
P0 --> S : ok
S -> P1 : updateSensitive()
P1 --> S : ok
S -> P2 : listSessions()
P2 --> S : ok
S -> P3 : revokeSession()
P3 --> S : ok
S -> DB_MySQL : INSERT/UPDATE (@Transactional)
S -> DB_Cassandra : INSERT notifications_by_user, audit_events
S -> DB_S3 : PUT/GET presigned s3://dine-lgpd-exports/{userId}/{id}.zip
S -> DB_Redis : SET/ZADD (invalida cache)
S ->> K : evento de domínio (outbox)
deactivate S
S --> C : DTO (record)
C --> P : 200/201 JSON
P --> U : atualiza a tela
== Segurança (senha, e-mail, telefone, 2FA TOTP, passkeys, códigos de recuperação) ==
U -> P : Segurança (senha, e-mail, telefone, 2FA TOTP, pass
P -> C : PATCH /api/me/profile
C -> S : updateSensitive()
S --> C : resultado
C --> P : 200 JSON
== Sessões e dispositivos (lista, encerrar uma, encerrar todas) ==
U -> P : Sessões e dispositivos (lista, encerrar uma, encer
P -> C : PATCH /api/me/sensitive
C -> S : updateSensitive()
S --> C : resultado
C --> P : 200 JSON
@enduml
