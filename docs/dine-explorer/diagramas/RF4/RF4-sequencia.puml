@startuml RF4_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."

title RF4 — Adicionar uma nova peça de alimento ao inventário pessoal através de formulário e fotografia\nDiagrama de sequência — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)

actor "Pessoa usuária" as U
boundary "App (Next.js / RN)" as P
participant "API Gateway\n(Spring Cloud Gateway)" as GW
control "FoodPieceController" as C
participant "FoodPieceService" as S
participant "MediaStoragePort\n(S3)" as P0
participant "FoodVisionPort\n(Spring AI + modelo de visão)" as P1
participant "NutritionPort\n(USDA FoodData / TACO)" as P2
participant "SearchIndexPort\n(OpenSearch)" as P3
database "MySQL 8.4\n(Spring Data JPA + Flyway)" as DB_MySQL
database "Amazon S3\n(AWS SDK v2)" as DB_S3
database "OpenSearch 2\n(opensearch-java)" as DB_OpenSearch
database "Cassandra 5\n(Spring Data Cassandra)" as DB_Cassandra
queue "Kafka" as K
== Captura/Upload de foto (recorte 4:5, remoção de fundo) ==
U -> P : interage na tela
P -> GW : POST /api/pieces/photo (multipart / presigned)\nAuthorization: Bearer JWT
GW -> GW : valida JWT (ES256) + rate limit (Redis)
GW -> C : POST /api/pieces/photo (multipart / presigned)
C -> S : uploadPhoto()
activate S
S -> DB_MySQL : SELECT food_pieces, food_inventories
alt foto invalida
S --> C : FOTO_INVALIDA
C --> P : 4xx ProblemDetail {code: FOTO_INVALIDA}
P --> U : mostra aviso
end
alt campo obrigatorio
S --> C : CAMPO_OBRIGATORIO
C --> P : 4xx ProblemDetail {code: CAMPO_OBRIGATORIO}
P --> U : mostra aviso
end
S -> P0 : uploadPhoto()
P0 --> S : ok
S -> P1 : recognize()
P1 --> S : ok
S -> P2 : create()
P2 --> S : ok
S -> P3 : changeStatus()
P3 --> S : ok
S -> DB_MySQL : INSERT/UPDATE (@Transactional)
S -> DB_Cassandra : INSERT ai_inference_log
S -> DB_OpenSearch : index/search idx_food_pieces
S -> DB_S3 : PUT/GET presigned s3://dine-media/food/{ownerId}/{photoId}.webp
S ->> K : evento de domínio (outbox)
deactivate S
S --> C : DTO (record)
C --> P : 200/201 JSON
P --> U : atualiza a tela
== Formulário: nome, categoria, cozinha, país de origem, ingredientes, alérgenos, p ==
U -> P : Formulário: nome, categoria, cozinha, país de orig
P -> C : POST /api/pieces/recognize
C -> S : recognize()
S --> C : resultado
C --> P : 200 JSON
== Sugestões da IA com nível de confiança ==
U -> P : Sugestões da IA com nível de confiança
P -> C : POST /api/pieces
C -> S : recognize()
S --> C : resultado
C --> P : 200 JSON
@enduml
