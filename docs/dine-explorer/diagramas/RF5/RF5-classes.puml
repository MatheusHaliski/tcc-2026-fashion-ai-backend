@startuml RF5_Classes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  StereotypeFontColor #6B6470
}
hide empty members
left to right direction
title RF5 — Criar um esquema de alimentação & sua respectiva lista de peças de alimento, através da aba "Criar Prato"\nDiagrama de classes — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)

package "MySQL" {
  class MealScheme <<meal_schemes>> {
    +id: UUID
    +owner: User
    +title: String
    +mealType: MealType
    +occasion: Occasion
    +cuisine: Cuisine
    +servings: int
    +prepMinutes: int
    +difficulty: Difficulty
    +totalKcal: int
    +healthScore: int (0-100)
    +status: SchemeStatus
    +visibility: Visibility
    +backgroundArtId: UUID
    +restaurant: RestaurantProfile (opcional)
    +publishedAt: Instant
  }
  class MealSchemeItem <<meal_scheme_items>> {
    +id: UUID
    +scheme: MealScheme
    +piece: FoodPiece
    +quantityG: int
    +layer: PlateLayer
    +posX: decimal
    +posY: decimal
    +zIndex: int
    +note: String
  }
  class FoodPiece <<food_pieces>> {
    +id: UUID
    +owner: User
    +name: String
    +category: FoodCategory
    +cuisine: Cuisine
    +originCountry: String
    +ingredients: List<Ingredient>
    +allergens: Set<Allergen>
    +kcalPer100g: int
    +proteinG: decimal
    +carbsG: decimal
    +fatG: decimal
    +portionG: int
    +status: PieceStatus
    +visibility: Visibility
    +photoKey: String
    +createdAt: Instant
  }
}
package "OpenSearch" {
  class MealSchemeDoc <<idx_meal_schemes>> {
    +id: keyword
    +title: text
    +cuisine: keyword
    +mealType: keyword
    +countryCode: keyword
    +location: geo_point
    +healthScore: integer
    +hype: float
    +publishedAt: date
  }
}
package "Cassandra" {
  class FeedEntry <<home_feed_by_user>> {
    +userId: UUID (partition)
    +ts: TimeUUID (clustering DESC)
    +targetType: text
    +targetId: UUID
    +reason: text
  }
}
package "dominio (enums)" {
  enum MealType {
    CAFE_DA_MANHA
    ALMOCO
    JANTAR
    LANCHE
    CEIA
    BRUNCH
  }
  enum SchemeStatus {
    RASCUNHO
    VALIDANDO
    PUBLICADO
    PRIVADO
    ARQUIVADO
    REMOVIDO
  }
}
package "aplicacao (casos de uso)" {
  class MealSchemeService <<@Service>> {
    +createDraft()
    +setItems()
    +computeNutrition()
    +publish()
    +assist()
  }
  class MealSchemeController <<@RestController>> {
    +POST /api/schemes
    +PUT /api/schemes/{id}/items
    +POST /api/schemes/{id}/publish
    +POST /api/schemes/assist
  }
  interface GuidelinePort <<port>>
  MealSchemeService ..> GuidelinePort
  interface SearchIndexPort <<port>>
  MealSchemeService ..> SearchIndexPort
  interface FeedFanoutPort <<port>>
  MealSchemeService ..> FeedFanoutPort
  interface LlmPort <<port>>
  MealSchemeService ..> LlmPort
}
MealSchemeController --> MealSchemeService
MealSchemeService ..> MealScheme : usa
MealSchemeService ..> MealSchemeItem : usa
MealSchemeService ..> FoodPiece : usa
MealSchemeService ..> MealSchemeDoc : usa
MealSchemeService ..> FeedEntry : usa
MealScheme --> MealType
MealScheme --> SchemeStatus
MealSchemeItem "*" --> "1" MealScheme : scheme
MealSchemeItem "*" --> "1" FoodPiece : piece
@enduml
