@startuml RF5_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF5 — Criar um esquema de alimentação & sua respectiva lista de peças de alimento, através da aba "Criar Prato"\nDiagrama de componentes — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)

package "Frontend (Next.js 15 · React 19 · TanStack Query)" {
  component "Criar Prato (/create)" as FE
  component "lib/api (OpenAPI client gerado)" as APIC
}
package "Borda" {
  component "CloudFront + WAF" as CDN
  component "Spring Cloud Gateway\n(JWT, rate limit, CORS)" as GW
}
package "dine-web (REST · Spring Boot 4.0)" {
  component "MealSchemeController\nPOST /api/schemes\nPUT /api/schemes/{id}/items\nPOST /api/schemes/{id}/publish\nPOST /api/schemes/assist" as CT
}
package "dine-application (Spring Modulith · casos de uso)" {
  component "MealSchemeService" as SV
  component "GuidelinePort (RF25)" as PT0 <<port>>
  component "SearchIndexPort\n«OpenSearch»" as PT1 <<port>>
  component "FeedFanoutPort\n«Kafka → Cassandra»" as PT2 <<port>>
  component "LlmPort\n«Spring AI»" as PT3 <<port>>
}
package "dine-domain (entidades + repositórios)" {
  component "MealSchemeRepository\nMealSchemeItemRepository\nFoodPieceRepository" as REPO_MySQL
  component "MealSchemeDocRepository" as REPO_OpenSearch
  component "FeedEntryRepository" as REPO_Cassandra
}
database "MySQL 8.4\n(Spring Data JPA + Flyway)\n• meal_schemes\n• meal_scheme_items\n• food_pieces" as DB_MySQL
database "OpenSearch 2\n(opensearch-java)\n• idx_meal_schemes" as DB_OpenSearch
database "Cassandra 5\n(Spring Data Cassandra)\n• home_feed_by_user" as DB_Cassandra
cloud "Kafka" as EX0
cloud "Spring AI (LLM)" as EX1
component "Observabilidade\n(Micrometer + OpenTelemetry\n→ Grafana/Tempo/Loki)" as OBS
FE --> APIC
APIC --> CDN : HTTPS/JSON
CDN --> GW
GW --> CT
CT --> SV
SV ..> OBS
SV --> PT0
SV --> PT1
SV --> PT2
SV --> PT3
SV --> REPO_MySQL
REPO_MySQL --> DB_MySQL
SV --> REPO_OpenSearch
REPO_OpenSearch --> DB_OpenSearch
SV --> REPO_Cassandra
REPO_Cassandra --> DB_Cassandra
PT2 --> EX0
PT3 --> EX1
@enduml
