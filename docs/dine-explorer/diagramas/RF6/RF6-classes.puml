@startuml RF6_Classes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  StereotypeFontColor #6B6470
}
hide empty members
left to right direction
title RF6 — Acessar & Gerenciar a página do Inventário de Alimentação Virtual do perfil Usuário\nDiagrama de classes — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)

package "MySQL" {
  class FoodInventory <<food_inventories>> {
    +id: UUID
    +owner: User
    +name: String
    +totalPieces: int
    +totalSchemes: int
    +updatedAt: Instant
  }
  class FoodPiece <<food_pieces>> {
    +id: UUID
    +owner: User
    +name: String
    +category: FoodCategory
    +cuisine: Cuisine
    +originCountry: String
    +ingredients: List<Ingredient>
    +allergens: Set<Allergen>
    +kcalPer100g: int
    +proteinG: decimal
    +carbsG: decimal
    +fatG: decimal
    +portionG: int
    +status: PieceStatus
    +visibility: Visibility
    +photoKey: String
    +createdAt: Instant
  }
  class MealScheme <<meal_schemes>> {
    +id: UUID
    +owner: User
    +title: String
    +mealType: MealType
    +occasion: Occasion
    +cuisine: Cuisine
    +servings: int
    +prepMinutes: int
    +difficulty: Difficulty
    +totalKcal: int
    +healthScore: int (0-100)
    +status: SchemeStatus
    +visibility: Visibility
    +backgroundArtId: UUID
    +restaurant: RestaurantProfile (opcional)
    +publishedAt: Instant
  }
  class SavedItem <<saved_items>> {
    +id: UUID
    +user: User
    +targetType: TargetType
    +targetId: UUID
    +collection: String
    +createdAt: Instant
  }
}
package "dominio (enums)" {
  enum BulkAction {
    ARQUIVAR
    RESTAURAR
    MUDAR_STATUS
    MOVER_COLECAO
    EXCLUIR
  }
}
package "aplicacao (casos de uso)" {
  class InventoryService <<@Service>> {
    +overview()
    +listPieces()
    +listSchemes()
    +bulkAction()
    +setDishOfTheDay()
  }
  class InventoryController <<@RestController>> {
    +GET /api/inventory
    +GET /api/inventory/pieces
    +GET /api/inventory/schemes
    +POST /api/inventory/bulk
  }
  interface SearchIndexPort <<port>>
  InventoryService ..> SearchIndexPort
  interface CachePort <<port>>
  InventoryService ..> CachePort
}
InventoryController --> InventoryService
InventoryService ..> FoodInventory : usa
InventoryService ..> FoodPiece : usa
InventoryService ..> MealScheme : usa
InventoryService ..> SavedItem : usa
@enduml
