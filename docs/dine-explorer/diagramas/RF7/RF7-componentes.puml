@startuml RF7_Componentes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam component {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #4A4852
}
skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A4852
}
skinparam cloud {
  BackgroundColor #F0FBF6
  BorderColor #4A4852
}
left to right direction
title RF7 — Acessar um item de peça de alimento disponível na lista de um esquema de alimentação salvo\nDiagrama de componentes — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)

package "Frontend (Next.js 15 · React 19 · TanStack Query)" {
  component "Detalhe da Peça (/pieces/{id})" as FE
  component "lib/api (OpenAPI client gerado)" as APIC
}
package "Borda" {
  component "CloudFront + WAF" as CDN
  component "Spring Cloud Gateway\n(JWT, rate limit, CORS)" as GW
}
package "dine-web (REST · Spring Boot 4.0)" {
  component "FoodPieceController\nGET /api/pieces/{id}\nGET /api/pieces/{id}/schemes\nGET /api/pieces/{id}/where-to-eat" as CT
}
package "dine-application (Spring Modulith · casos de uso)" {
  component "FoodPieceService" as SV
  component "SearchIndexPort\n«OpenSearch geo»" as PT0 <<port>>
  component "CachePort\n«Redis»" as PT1 <<port>>
}
package "dine-domain (entidades + repositórios)" {
  component "FoodPieceRepository\nMealSchemeItemRepository\nMenuItemRepository" as REPO_MySQL
  component "RestaurantDocRepository" as REPO_OpenSearch
}
database "MySQL 8.4\n(Spring Data JPA + Flyway)\n• food_pieces\n• meal_scheme_items\n• menu_items" as DB_MySQL
database "OpenSearch 2\n(opensearch-java)\n• idx_restaurants" as DB_OpenSearch
component "Observabilidade\n(Micrometer + OpenTelemetry\n→ Grafana/Tempo/Loki)" as OBS
FE --> APIC
APIC --> CDN : HTTPS/JSON
CDN --> GW
GW --> CT
CT --> SV
SV ..> OBS
SV --> PT0
SV --> PT1
SV --> REPO_MySQL
REPO_MySQL --> DB_MySQL
SV --> REPO_OpenSearch
REPO_OpenSearch --> DB_OpenSearch
@enduml
