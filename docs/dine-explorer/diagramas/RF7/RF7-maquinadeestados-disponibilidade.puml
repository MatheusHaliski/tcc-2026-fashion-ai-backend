@startuml RF7_MaquinaDeEstados_Disponibilidade
!pragma layout smetana
title RF7 — Acessar um item de peça de alimento disponível na lista de um esquema de alimentação salvo\nDiagrama de máquina de estados — Disponibilidade — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)
skinparam backgroundColor #FFFFFF
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  ArrowColor #52606D
}
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
state "Disponível no inventário" as DISP
state "Acabou" as ACAB
state "Na lista de compras" as COMP

[*] --> DISP
DISP --> ACAB : consumi
ACAB --> COMP : adicionar à lista
COMP --> DISP : comprei
@enduml
