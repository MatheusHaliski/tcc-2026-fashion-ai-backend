@startuml RF8_MaquinaDeEstados_Esquema
!pragma layout smetana
title RF8 — Visualizar esquemas de alimentação & peças de alimento criados por outros usuários na rede social, através …\nDiagrama de máquina de estados — Esquema — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)
skinparam backgroundColor #FFFFFF
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  ArrowColor #52606D
}
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
state "Visível" as VIS
state "Oculto p/ mim" as OCU
state "Denunciado" as DEN

[*] --> VIS
VIS --> OCU : não tenho interesse
VIS --> DEN : denunciar
OCU --> VIS : desfazer
@enduml
