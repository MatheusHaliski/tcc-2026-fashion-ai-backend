@startuml RF8_Sequencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam sequence {
  ArrowColor #4A4852
  LifeLineBorderColor #CBC6BE
  ParticipantBackgroundColor #F4F2EF
  ParticipantBorderColor #4A4852
  ActorBorderColor #4A4852
  GroupBorderColor #CBC6BE
  GroupBackgroundColor #FAF8F5
}
autonumber "<b>0."

title RF8 — Visualizar esquemas de alimentação & peças de alimento criados por outros usuários na rede social, através …\nDiagrama de sequência — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)

actor "Pessoa usuária" as U
boundary "App (Next.js / RN)" as P
participant "API Gateway\n(Spring Cloud Gateway)" as GW
control "SearchController" as C
participant "SearchService" as S
participant "SearchIndexPort\n(OpenSearch (BM25 + k-NN híbrido))" as P0
participant "CachePort\n(Redis)" as P1
database "OpenSearch 2\n(opensearch-java)" as DB_OpenSearch
database "MySQL 8.4\n(Spring Data JPA + Flyway)" as DB_MySQL
queue "Kafka" as K
== Barra de busca com autocomplete ==
U -> P : interage na tela
P -> GW : GET /api/search?q=&filters=\nAuthorization: Bearer JWT
GW -> GW : valida JWT (ES256) + rate limit (Redis)
GW -> C : GET /api/search?q=&filters=
C -> S : search()
activate S
S -> DB_MySQL : SELECT dine_hype_scores
alt consulta invalida
S --> C : CONSULTA_INVALIDA
C --> P : 4xx ProblemDetail {code: CONSULTA_INVALIDA}
P --> U : mostra aviso
end
S -> P0 : search()
P0 --> S : ok
S -> P1 : suggest()
P1 --> S : ok
S -> DB_MySQL : INSERT/UPDATE (@Transactional)
S -> DB_OpenSearch : index/search idx_meal_schemes, idx_food_pieces
S ->> K : evento de domínio (outbox)
deactivate S
S --> C : DTO (record)
C --> P : 200/201 JSON
P --> U : atualiza a tela
== Chips de filtro ==
U -> P : Chips de filtro
P -> C : GET /api/search/suggest
C -> S : suggest()
S --> C : resultado
C --> P : 200 JSON
@enduml
