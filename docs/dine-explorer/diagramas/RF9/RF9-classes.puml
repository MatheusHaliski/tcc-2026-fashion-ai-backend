@startuml RF9_Classes
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam roundcorner 14
skinparam ArrowColor #52606D
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
skinparam class {
  BackgroundColor #F4F2EF
  BorderColor #4A4852
  ArrowColor #4A4852
  StereotypeFontColor #6B6470
}
hide empty members
left to right direction
title RF9 — Editar os dados de um esquema de alimentação & seus respectivos esquemas de peça de alimento salvos\nDiagrama de classes — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)

package "MySQL" {
  class MealScheme <<meal_schemes>> {
    +id: UUID
    +owner: User
    +title: String
    +mealType: MealType
    +occasion: Occasion
    +cuisine: Cuisine
    +servings: int
    +prepMinutes: int
    +difficulty: Difficulty
    +totalKcal: int
    +healthScore: int (0-100)
    +status: SchemeStatus
    +visibility: Visibility
    +backgroundArtId: UUID
    +restaurant: RestaurantProfile (opcional)
    +publishedAt: Instant
  }
  class MealSchemeItem <<meal_scheme_items>> {
    +id: UUID
    +scheme: MealScheme
    +piece: FoodPiece
    +quantityG: int
    +layer: PlateLayer
    +posX: decimal
    +posY: decimal
    +zIndex: int
    +note: String
  }
  class FoodPiece <<food_pieces>> {
    +id: UUID
    +owner: User
    +name: String
    +category: FoodCategory
    +cuisine: Cuisine
    +originCountry: String
    +ingredients: List<Ingredient>
    +allergens: Set<Allergen>
    +kcalPer100g: int
    +proteinG: decimal
    +carbsG: decimal
    +fatG: decimal
    +portionG: int
    +status: PieceStatus
    +visibility: Visibility
    +photoKey: String
    +createdAt: Instant
  }
  class SchemeValidationReport <<scheme_validation_reports>> {
    +id: UUID
    +schemeKind: SchemeKind
    +schemeId: UUID
    +guidelineVersion: String
    +passed: boolean
    +violations: JSON
    +validatedAt: Instant
  }
}
package "dominio (enums)" {
  enum EditOutcome {
    SALVO
    CONFLITO
    VIOLA_DIRETRIZ
  }
}
package "aplicacao (casos de uso)" {
  class MealSchemeService <<@Service>> {
    +update()
    +updatePiece()
    +versions()
    +restoreVersion()
  }
  class MealSchemeController <<@RestController>> {
    +PATCH /api/schemes/{id}
    +PATCH /api/pieces/{id}
    +GET /api/schemes/{id}/versions
  }
  interface GuidelinePort <<port>>
  MealSchemeService ..> GuidelinePort
  interface SearchIndexPort <<port>>
  MealSchemeService ..> SearchIndexPort
}
MealSchemeController --> MealSchemeService
MealSchemeService ..> MealScheme : usa
MealSchemeService ..> MealSchemeItem : usa
MealSchemeService ..> FoodPiece : usa
MealSchemeService ..> SchemeValidationReport : usa
MealSchemeItem "*" --> "1" MealScheme : scheme
MealSchemeItem "*" --> "1" FoodPiece : piece
@enduml
