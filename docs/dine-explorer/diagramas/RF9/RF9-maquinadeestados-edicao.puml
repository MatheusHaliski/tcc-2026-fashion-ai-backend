@startuml RF9_MaquinaDeEstados_Edicao
!pragma layout smetana
title RF9 — Editar os dados de um esquema de alimentação & seus respectivos esquemas de peça de alimento salvos\nDiagrama de máquina de estados — Edicao — Dine Explorer · Spring Boot 4.0 · Java 25 (virtual threads)
skinparam backgroundColor #FFFFFF
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  ArrowColor #52606D
}
skinparam note {
  BackgroundColor #FFFDEB
  BorderColor #D8CE78
  FontColor #554F24
}
state "Limpo" as LIM
state "Alterações não salvas" as SUJ
state "Salvando" as SAL
state "Conflito" as CON

[*] --> LIM
LIM --> SUJ : editar
SUJ --> SAL : salvar
SAL --> LIM : 200
SAL --> CON : 409 versão
CON --> SUJ : mesclar
@enduml
