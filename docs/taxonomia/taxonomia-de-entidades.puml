@startuml Taxonomia_Entidades
!pragma layout smetana
title Taxonomia de entidades do FashionAI — 107 entidades em 14 áreas (relações JPA)
skinparam backgroundColor #FFFFFF
skinparam shadowing false
hide empty members
hide circle
skinparam class {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  ArrowColor #8792A2
}
skinparam package {
  BorderColor #CBC6BE
  FontColor #2D2438
}
left to right direction
