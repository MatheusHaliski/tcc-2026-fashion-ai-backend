<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>br.com.fashionai</groupId>
        <artifactId>fashion-ai-api</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <!--
      Cobertura do backend inteiro (rubrica): junta o jacoco.exec de cada módulo num relatório só, em
      fai-coverage/target/site/jacoco-aggregate/index.html, depois de `mvn verify` na raiz. Não tem código próprio.
    -->
    <artifactId>fai-coverage</artifactId>
    <packaging>pom</packaging>

    <dependencies>
        <dependency>
            <groupId>br.com.fashionai</groupId>
            <artifactId>fai-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.com.fashionai</groupId>
            <artifactId>fai-application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.com.fashionai</groupId>
            <artifactId>fai-web</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.com.fashionai</groupId>
            <artifactId>persistence-mysql</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.com.fashionai</groupId>
            <artifactId>persistence-cassandra</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.com.fashionai</groupId>
            <artifactId>cache-redis</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.com.fashionai</groupId>
            <artifactId>search-opensearch</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.com.fashionai</groupId>
            <artifactId>storage-s3</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.com.fashionai</groupId>
            <artifactId>ai-providers</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.com.fashionai</groupId>
            <artifactId>platform</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
