{
  "name": "fashion-ai-web",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend Next.js do Fashion AI (TCC 2026) — consome a API Java em NEXT_PUBLIC_API_BASE_URL",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/i18n/check.js --fail",
    "i18n:scan": "node scripts/i18n/scan.js --fail",
    "i18n:qa": "node scripts/i18n/qa.js",
    "prebuild": "node scripts/avatar3d/copy-mediapipe.mjs && node scripts/i18n/check.js --fail && node scripts/i18n/scan.js --fail",
    "predev": "node scripts/avatar3d/copy-mediapipe.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.17",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.0",
    "@vladmandic/face-api": "1.7.15",
    "d3-geo": "^3.1.1",
    "next": "^16.3.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.10.1",
    "three": "^0.186.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@react-three/test-renderer": "^9.1.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "postcss": "^8.5.0"
  }
}
