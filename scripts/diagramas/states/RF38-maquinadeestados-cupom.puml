@startuml RF38_MaquinaDeEstados_Cupom
!pragma layout smetana
title RF38 — Direito ao cupom (coupon_rights) e cupom emitido (promotion/flair_redemptions)
skinparam backgroundColor #FFFFFF
skinparam state {
  BackgroundColor #F8F4FF
  BorderColor #B695F5
  FontColor #2D2438
  ArrowColor #52606D
}
state "Direito ao cupom" as D {
  [*] --> PENDENTE : CouponRightsCheck\n(selo aprovado / vitória FLAIR)
  PENDENTE --> RESGATADO : "Sim, resgatar"
  PENDENTE --> DISPENSADO : "Dispensar"
}
state "Cupom Fashion AI" as C {
  [*] --> EMITIDO : código único, desconto,\nvalidade, storeUrl
  EMITIDO --> USADO : loja valida no caixa
  EMITIDO --> EXPIRADO : passa a validade
}
RESGATADO --> C : emite
DISPENSADO --> [*]
USADO --> [*]
EXPIRADO --> [*]
@enduml
