# Copie para .env (nunca versione o .env). Gere segredos com: openssl rand -hex 32

# --- Acesso à API ----------------------------------------------------------------------------------------------
# Recomendado: uma chave por cliente, só o SHA-256 fica aqui. Gere com:
#   python -m services.garment_gpu.security fashionai-backend --scopes "submit|read"
# Escopos: submit (enviar/excluir os próprios jobs), read (consultar), review (aprovar/reprovar reconstruções de
# qualquer cliente), admin (tudo, inclusive /v1/admin/queues).
FAI_API_KEYS=
# Alternativa legada (uma chave bruta com todos os escopos, cliente "default"). Mínimo de 32 caracteres.
FAI_API_KEY=
RATE_LIMIT_PER_MINUTE=30
MAX_ACTIVE_JOBS_PER_CLIENT=20
MAX_UPLOAD_MB=12
MAX_PIXELS=16000000
METRICS_PUBLIC=true                   # false = /metrics só com chave admin (o Caddy já bloqueia /metrics de fora)

# --- Fila e armazenamento ----------------------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
# REDIS_URL é montada pelo compose a partir de REDIS_PASSWORD; defina só fora do compose.
S3_ACCESS_KEY=CHANGE_ME_S3_USER
S3_SECRET_KEY=CHANGE_ME_LONG_S3_PASSWORD
S3_BUCKET=fai-garment-assets
# S3_ENDPOINT=https://s3.amazonaws.com  # outro S3 compatível (AWS, GCS interoperável, R2); padrão: RustFS do compose
RETENTION_DAYS=30                     # fotos, máscaras e PNGs expiram (lifecycle do bucket). 0 = não expira
JOB_TTL_SECONDS=604800                # registro do job no Redis (7 dias)

# --- Modelos (pesos abertos baixados uma vez para o volume hf-models) ----------------------------------------------
HF_HOME=/models
# HF_HUB_OFFLINE=1                    # depois do primeiro download: nenhuma chamada externa
FAI_DEVICE=cuda
DETECTOR_MODEL=IDEA-Research/grounding-dino-tiny
SEGMENTER_MODEL=facebook/sam2.1-hiera-tiny
BOX_THRESHOLD=0.30
TEXT_THRESHOLD=0.25
RECON_MODEL=Qwen/Qwen-Image-Edit-2511
RECON_STEPS=40
RECON_TRUE_CFG=4.0
RECON_OFFLOAD=none                    # none (80 GB) | model (L40S 48 GB) | sequential (24 GB, bem mais lento)
RECON_MAX_SIDE=1024
RECON_MAX_ATTEMPTS=2                  # novas sementes quando o QA não aprova
RECON_LORA_PATH=                      # ex.: /loras/fai-garment-v1.safetensors (pasta ./loras montada no worker)
RECON_LORA_SCALE=1.0

# --- Critérios do QA automático (calibre com fotos reais; ver README) -------------------------------------------
QA_MIN_SCORE=0.62
QA_MAX_DELTA_E=10

# --- Workers ----------------------------------------------------------------------------------------------------
SEGMENT_GPU=0                         # índice da GPU de cada worker neste servidor
RECONSTRUCT_GPU=0
WORKER_MAX_IDLE_SECONDS=0             # >0: o worker encerra ocioso (escala a zero no RunPod/Kubernetes)
SEGMENT_TIMEOUT_SECONDS=600
RECONSTRUCT_TIMEOUT_SECONDS=1800

# --- Rede, HTTPS e monitoramento ---------------------------------------------------------------------------------
API_PORT=8000
PRIVATE_BIND=127.0.0.1                # IP da rede privada (WireGuard/Tailscale) para workers remotos
DOMAIN=gpu.example.com                # perfil edge: Caddy emite o certificado TLS
CLOUDFLARE_TUNNEL_TOKEN=              # perfil tunnel: token do túnel (Zero Trust → Networks → Tunnels); use METRICS_PUBLIC=false
ALLOWED_CIDRS="0.0.0.0/0 ::/0"        # restrinja aos IPs do backend Java (Railway) e da sua equipe
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA
