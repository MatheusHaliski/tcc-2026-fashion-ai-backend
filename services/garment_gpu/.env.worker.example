# Worker GPU remoto (compose.worker.yaml). Endereços pela rede privada até o servidor central.
WORKER_STAGE=reconstruct
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@10.8.0.1:6379/0
S3_ENDPOINT=http://10.8.0.1:9000
S3_ACCESS_KEY=CHANGE_ME_S3_USER
S3_SECRET_KEY=CHANGE_ME_LONG_S3_PASSWORD
S3_BUCKET=fai-garment-assets
RETENTION_DAYS=30
HF_HOME=/models
FAI_DEVICE=cuda
DETECTOR_MODEL=IDEA-Research/grounding-dino-tiny
SEGMENTER_MODEL=facebook/sam2.1-hiera-tiny
RECON_MODEL=Qwen/Qwen-Image-Edit-2511
RECON_OFFLOAD=none
RECON_STEPS=40
RECON_LORA_PATH=
QA_MIN_SCORE=0.62
QA_MAX_DELTA_E=10
WORKER_MAX_IDLE_SECONDS=0
GPU_IDS=0
PRIVATE_BIND=10.8.0.2                 # IP privado DESTA máquina (Prometheus central coleta as métricas aqui)
